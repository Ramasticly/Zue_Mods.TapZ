+    // ---- sequencia: marcadores calculados pela simulacao + edicao dos campos do golpe ----
+
+    private java.util.List<SeqMark> seqMarks = new java.util.ArrayList<SeqMark>();
+    private String seqKey = "";
+
+    /** Hits que conectariam (e trocariam de ANO) se o golpe comecasse na ANO dada; vazio sem simulacao. Pesado: chamar fora da UI thread. */
+    public java.util.List<BattleSim.HitEvent> probeHits(int ano) {
+        BattleSim s = sim;
+        return s == null ? new java.util.ArrayList<BattleSim.HitEvent>() : s.probeHits(ano);
+    }
+
+    /** Hits que conectam no ANO atual e disparariam ANIM_SEQ / ANIM_END (cache; recalcula so quando algo muda). */
+    public java.util.List<SeqMark> sequenceMarks() {
+        Ano a = sim == null ? null : currentAno();
+        if (a == null || data == null || data.move == null || data.move.generic) {
+            if (!seqMarks.isEmpty()) seqMarks = new java.util.ArrayList<SeqMark>();
+            return seqMarks;
+        }
+        CharData.Move mv = data.move;
+        String key = a.index + ":" + editVersion + ":" + System.identityHashCode(data) + ":" + distance + ":" + height + ":" + BattleSim.oppHeightPx
+                + ":" + mv.animSeqChao + ":" + mv.animSeqAr + ":" + mv.animEndChao + ":" + mv.animEndAr
+                + ":" + mv.animAoAcertar + ":" + BattleSim.lockFromTick + ":" + BattleSim.landingOn + ":" + sim.transitions().size() + ":" + BattleSim.extendTime
+                + ":" + mv.flags + ":" + data.attacker.data.pullDistance() + ":" + mv.animInicial;
+        if (key.equals(seqKey)) return seqMarks;
+        seqKey = key;
+        java.util.List<SeqMark> out = new java.util.ArrayList<SeqMark>();
+        java.util.HashSet<Integer> seen = new java.util.HashSet<Integer>();
+        for (BattleSim.HitEvent e : sim.probeHits(a.index)) {
+            if (e.kind > SeqMark.HIT || e.ano != a.index || !seen.add(e.pat * 8 + e.kind)) continue;
+            SeqMark m = new SeqMark();
+            m.kind = e.kind; m.pat = e.pat; m.target = e.target; m.target2 = e.target2; m.air = e.air; m.blocked = e.blocked; m.projectile = e.projectile;
+            out.add(m);
+        }
+        for (BattleSim.Trans t : sim.transitions()) {
+            if (t.kind < 0 || t.kind > SeqMark.HIT) continue;      // pouso e queda sao fisica, nao algo editavel
+            if (t.fromAno == a.index) {
+                SeqMark hit = null;
+                for (SeqMark q : out) if (q.kind == t.kind && q.pat == t.fromPat && !q.incoming) hit = q;
+                if (hit == null) {
+                    hit = new SeqMark();
+                    hit.kind = t.kind; hit.pat = t.fromPat; hit.target = t.toAno;
+                    out.add(hit);
+                }
+                hit.real = true; hit.tick = t.tick;
+            }
+            if (t.toAno == a.index && t.fromAno != a.index) {
+                SeqMark in = new SeqMark();
+                in.kind = t.kind; in.pat = 0; in.incoming = true; in.real = true;
+                in.fromAno = t.fromAno; in.fromPat = t.fromPat; in.tick = t.tick; in.target = t.toAno;
+                out.add(in);
+            }
+        }
+        // simplifica: por tipo, so a troca que de fato vale (a real, ou a primeira que conecta); bloqueadas antes dela continuam para poder desbloquear
+        java.util.Collections.sort(out, new java.util.Comparator<SeqMark>() {
+            @Override public int compare(SeqMark x, SeqMark y) { return x.pat != y.pat ? x.pat - y.pat : x.kind - y.kind; }
+        });
+        java.util.List<SeqMark> kept = new java.util.ArrayList<SeqMark>();
+        for (SeqMark q : out) if (q.incoming) kept.add(q);
+        for (int k = 0; k <= SeqMark.HIT; k++) {
+            boolean realExists = false;
+            for (SeqMark q : out) if (q.kind == k && q.real && !q.incoming) realExists = true;
+            for (SeqMark q : out) {
+                if (q.kind != k || q.incoming) continue;
+                if (q.real) { kept.add(q); break; }
+                if (q.blocked) { kept.add(q); continue; }
+                if (realExists) continue;
+                kept.add(q);
+                break;
+            }
+        }
+        // agarrao (md 882): no fim do ANO inicial, ou no 1o frame com a janela 512; e quase uma transicao (vai para ANIM_INICIAL + 1)
+        if (mv.grabWorks() && a.index == mv.animInicial) {
+            int gp = a.mpts.length - 1;
+            for (int i = 0; i < a.mpts.length; i++) if (ObjModel.optFlagBit(a.mpts[i], ObjModel.VF_WINDOW)) { gp = i; break; }
+            SeqMark g = new SeqMark();
+            g.kind = SeqMark.GRAB; g.pat = gp; g.target = a.index + 1;
+            kept.add(g);
+        }
+        out = kept;
+        java.util.Collections.sort(out, new java.util.Comparator<SeqMark>() {
+            @Override public int compare(SeqMark x, SeqMark y) { return x.pat != y.pat ? x.pat - y.pat : x.kind - y.kind; }
+        });
+        seqMarks = out;
+        return out;
+    }
