+    /**
+     * Tira de todas as ANOs do DAC do atacante os frames que tocam algum dos sons {@code ses} (flag de som desligada, se = -1).
+     * Uma unica entrada de desfazer. Devolve quantos frames mudaram.
+     */
+    public int clearSoundUses(java.util.Set<Integer> ses) {
+        if (data == null || ses.isEmpty()) return 0;
+        final Dac dac = data.attacker.dac;
+        final java.util.ArrayList<Ano> olds = new java.util.ArrayList<Ano>();
+        int frames = 0;
+        for (int i = 0; i < dac.size(); i++) {
+            Ano a = dac.getAno(i);
+            if (a == null || !a.present) continue;
+            Ano.Mpt[] ms = a.mpts;
+            Ano.Mpt[] nm = null;
+            for (int k = 0; k < ms.length; k++) {
+                Ano.Mpt m = ms[k];
+                if ((m.flags & 8) == 0 || !ses.contains(Integer.valueOf(m.se))) continue;
+                if (nm == null) nm = ms.clone();
+                Ano.Mpt c = m.copy();
+                c.flags &= ~8;
+                c.se = -1;
+                nm[k] = c;
+                frames++;
+            }
+            if (nm != null) {
+                olds.add(a);
+                dac.setAno(i, new Ano(a.index, a.present, a.flags, a.priority, a.links, nm));
+            }
+        }
+        if (frames == 0) return 0;
+        pushUndo(null, UndoEdits.swapAnos(dac, olds));
+        editVersion++;
+        rebuild(frame);
+        return frames;
+    }
