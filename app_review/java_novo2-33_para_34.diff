+    private void drawNotice(Canvas c) {
+        noticeRects.clear();
+        noticeActs.clear();
+        noticeBox.setEmpty();
+        noticeClose.setEmpty();
+        if (!noticeVisible()) return;
+        QuickNotice n = notice;
+        float w = getWidth(), h = getHeight(), pad = 10f * density, margin = 8f * density;
+        float xs = 26f * density;                                  // lado do botao X
+        warnText.setColor(0xFFFFFFFF);
+        warnText.setTextSize((noticeExpanded ? 15f : 12f) * density);
+        warnText.setTextAlign(Paint.Align.LEFT);
+        float maxW = (noticeExpanded ? w - 2 * margin : w * 0.8f) - 2 * pad - xs;
+        java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
+        float widest = 0;
+        for (String para : n.shown(noticeExpanded).split("\n")) {
+            String rest = para.trim();
+            if (rest.isEmpty()) continue;
+            while (rest.length() > 0) {
+                int k = warnText.breakText(rest, true, maxW, null);
+                if (k < rest.length()) {
+                    int sp = rest.lastIndexOf(' ', k);
+                    if (sp > 0) k = sp;
+                }
+                String ln = rest.substring(0, k).trim();
+                lines.add(ln);
+                widest = Math.max(widest, warnText.measureText(ln));
+                rest = rest.substring(k).trim();
+            }
+        }
+        float lh = warnText.getFontSpacing();
+        float btnH = lh + pad, gap = 6f * density;
+        float leftW = rowWidth(n.left, pad, gap), rightW = rowWidth(n.right, pad, gap);
+        widest = Math.max(widest, leftW + rightW + (leftW > 0 && rightW > 0 ? 2 * pad : 0));
+        boolean hasBtn = !n.left.isEmpty() || !n.right.isEmpty();
+        float bw = widest + 2 * pad + xs, bh = Math.max(lines.size() * lh, xs) + 2 * pad + (hasBtn ? pad + btnH : 0);
+        float x, y;
+        if (noticeExpanded) {
+            x = margin; y = margin; bw = w - 2 * margin; bh = h - 2 * margin;
+        } else {
+            x = (w - bw) / 2f; y = 40f * density;
+        }
+        noticeBox.set(x, y, x + bw, y + bh);
+        warnBg.setColor(noticeExpanded ? (n.color & 0x00FFFFFF) | 0xE6000000 : n.color);
+        c.drawRoundRect(noticeBox, 8f * density, 8f * density, warnBg);
+        float base = y + pad - warnText.ascent();
+        for (int i = 0; i < lines.size(); i++) I18nUi.drawText(c, lines.get(i), x + pad, base + i * lh, warnText);
+        // X: fecha sem ocultar
+        noticeClose.set(x + bw - pad / 2f - xs, y + pad / 2f, x + bw - pad / 2f, y + pad / 2f + xs);
+        warnBg.setColor(n.buttonColor);
+        c.drawRoundRect(noticeClose, 6f * density, 6f * density, warnBg);
+        Paint.Align al = warnText.getTextAlign();
+        warnText.setTextAlign(Paint.Align.CENTER);
+        I18nUi.drawText(c, "\u2715", noticeClose.centerX(), noticeClose.centerY() - (warnText.ascent() + warnText.descent()) / 2f, warnText);
+        warnText.setTextAlign(al);
+        float by = y + bh - pad - btnH;
+        drawRow(c, n.left, x + pad, by, btnH, pad, gap, n.buttonColor);
+        drawRow(c, n.right, x + bw - pad - rightW, by, btnH, pad, gap, n.buttonColor);
+    }
+
+    private float rowWidth(java.util.List<QuickNotice.Action> row, float pad, float gap) {
+        float t = 0;
+        for (int i = 0; i < row.size(); i++) t += warnText.measureText(row.get(i).label) + 2 * pad + (i > 0 ? gap : 0);
+        return t;
+    }
+
+    private void drawRow(Canvas c, java.util.List<QuickNotice.Action> row, float x, float y, float h, float pad, float gap, int color) {
+        float lh = warnText.getFontSpacing();
+        for (int i = 0; i < row.size(); i++) {
+            QuickNotice.Action a = row.get(i);
+            float bw = warnText.measureText(a.label) + 2 * pad;
+            android.graphics.RectF r = new android.graphics.RectF(x, y, x + bw, y + h);
+            warnBg.setColor(color);
+            c.drawRoundRect(r, 6f * density, 6f * density, warnBg);
+            I18nUi.drawText(c, a.label, x + pad, y + (h - lh) / 2f - warnText.ascent(), warnText);
+            noticeRects.add(r);
+            noticeActs.add(a);
+            x += bw + gap;
+        }
+    }
+
+    /** Toque num botao do aviso aberto; true se consumiu. */
+    private boolean noticeTouch(float tx, float ty) {
+        if (!noticeVisible()) return false;
+        if (noticeClose.contains(tx, ty)) { hideNotice(); return true; }
+        for (int i = 0; i < noticeRects.size(); i++) {
+            if (noticeRects.get(i).contains(tx, ty)) {
+                QuickNotice.Action a = noticeActs.get(i);
+                if (a.closes) hideNotice();
+                if (a.run != null) a.run.run();
+                return true;
+            }
+        }
+        if (noticeBox.contains(tx, ty)) {                           // area do aviso: expande / recolhe
+            noticeExpanded = !noticeExpanded;
+            if (noticeExpanded) noticeUntil = Long.MAX_VALUE;
+            else if (notice.durationMs > 0) {
+                noticeUntil = SystemClock.uptimeMillis() + notice.durationMs;
+                postInvalidateDelayed(notice.durationMs + 30);
+            }
+            invalidate();
+            return true;
+        }
+        return false;
+    }
