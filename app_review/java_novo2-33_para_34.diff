+    /** ANO do defensor onde o jogo deixa defender (DamageChange, var25): fora de 6-9, 82, 83 e de 20 em diante (exceto 13, 25, 80, 81). */
+    static boolean guardableAno(int ano) {
+        if (ano == 6 || ano == 7 || ano == 8 || ano == 9 || ano == 82 || ano == 83) return false;
+        return ano <= 19 || ano == 80 || ano == 81 || ano == 25 || ano == 13;
+    }
+
+    /** O hit pode ser defendido agora? (DEF ligado, defensor vivo e fora de reacao, ANO que defende, golpe sem a flag 26 "inimigo nao defende"). */
+    private boolean canGuard(Opt1 op) {
+        if (!defend || !op.valid || inDamage || lifeO <= 0 || lifeA <= 0) return false;
+        AttackSim.Obj d = opp.root();
+        if (d == null || !guardableAno(d.ano.index)) return false;
+        return !hasFlag(atk.root(), 26);
+    }
+
+    /** Hit do corpo a corpo ou de projetil: defendido (DEF) ou dano normal. true = o hit foi registrado (vale a confirmacao do md 882). */
+    private boolean hitOrGuard(Opt1 op, int[] pos, String who, int dmg, int hitAno) {
+        if (canGuard(op)) { applyGuard(op, pos, who, dmg, hitAno); return true; }
+        applyHit(op, pos, who, dmg, hitAno);
+        return inDamage;
+    }
+
+    /** DamageChange com var15 == 2 (md 908): sem reacao, empurrao, efeito ANO 2, SE 8 e o arranhao de 2 em golpes ANO >= 40. */
+    private void applyGuard(Opt1 op, int[] pos, String who, int dmg, int hitAno) {
+        lastHit = who + " - DEFENDIDO - " + op.describe();
+        lastDamage = 0;
+        combo = 0;                                  // md 908 chama DamageEnd todo tick: o combo zera e a defesa nao conta combo
+        if (hitAno >= 40 && dmg != 0 && hitAno != 92) {
+            int before = lifeO;
+            lifeDec(true, GUARD_CHIP);
+            lastDamage = before - lifeO;
+            totalDamage += lastDamage;
+            lastHit += " [arranhao " + lastDamage + ", vida " + lifeO + "/" + maxO + "]";
+        }
+        if (lifeO <= 0) { enterDamage(op, hitAno); return; }      // o arranhao matou: segue a reacao de KO
+        faceAttacker();
+        if (op.effectAno >= 0 && fxDac != null) {
+            fxs.add(newFx(new AttackSim(fxDac, GUARD_EFFECT_ANO, false, pos[0] * PX, pos[1] * PX)));
+            sounds.add(new Snd(true, GUARD_SE, 0));
+        }
+        gMove = op.pushes ? guardBack : 0;
+        int want = oppY != 0 ? GUARD_AIR_ANO : GUARD_STAND_ANO;
+        AttackSim.Obj d = opp.root();
+        Ano wa = defDac == null ? null : defDac.getAno(want);
+        boolean haveGuardAno = wa != null && wa.present && wa.mpts.length > 0;
+        if (!guardActive && (d == null || d.ano.index != want) && haveGuardAno) setOppAct(want);
+        gTime = HIT_STOP + 5;
+        guardActive = true;
+        grabHitAno = hitAno;
+        lastHit += (haveGuardAno ? " [guarda ANO " + want : " [guarda sem ANO " + want + " no DAC") + ", empurrao " + gMove + "]";
+    }
+
+    /** Defensor em guarda (md 908): empurrao que decai 2 por tick; sai da guarda quando o empurrao, o hitstop e o GuardCancelTime (HIT_STOP + 5 ticks) acabam. */
+    private void stepGuard() {
+        AttackSim.Obj r = opp.root();
+        if (gMove != 0) {
+            if (oppFlip) oppX += gMove << 15; else oppX -= gMove << 15;
+            gMove -= 2;
+            if (gMove < 0) gMove = 0;
+        }
+        if (r != null) {
+            r.x = oppX;
+            r.y = oppY;
+            opp.step(hsDef > 0);
+            oppX = r.x;
+            oppY = r.y;
+            consumeSe(opp, 1);
+        }
+        if (gTime > 0) gTime--;
+        if (gMove == 0 && gTime == 0 && hsDef == 0) {
+            guardActive = false;
+            setOppAct(0);
+        }
+    }
