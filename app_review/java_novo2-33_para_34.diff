+        check("os outros blocos ficam como estavam", Saver.findBlock(r1, "REACAO_DANO_15") != null && r1.contains("$HDAT_31:{$info:{$COL: 14, $ROW: 0"), true);
+        String r2 = Saver.patchReaction(r1, two, 17, f);
