+
+    /**
+     * SE de um frame do DAC (_ActReqMain): id < 80 toca se_(id-1) na hora (id 8 -> se_07);
+     * id >= 80 e audio do personagem (80 = primeiro), tocado pelo ChrSePlay da raiz, com o
+     * deslocamento da quantidade de WAVs do atacante quando o dono e o jogador 1.
+     * SE de links so tocam se forem < 80 (o obj.se >= 80 de um link nunca e consumido).
+     */
+    private void consumeSe(AttackSim s, int owner) {
+        AttackSim.Obj r = s.root();
+        if (r == null) return;
+        if (r.pendingSe >= 0) {
+            int se = r.pendingSe;
+            r.pendingSe = -1;
+            // ChrSePlay: o jogador 1 soma ChrSoundCount[3] (n. de audios do jogador 0) a qualquer SE
+            pushSe(se, owner);
+        }
+        AttackSim.Obj[] ch = s.children();
+        for (int i = 0; i < ch.length; i++) {
+            AttackSim.Obj c = ch[i];
+            if (c == null || c.pendingSe < 0) continue;
+            int se = c.pendingSe;
+            c.pendingSe = -1;
+            int cn = SoundIds.commonOf(se);
+            if (cn >= 0) sounds.add(new Snd(true, cn, 0));      // links so tocam sons globais
+        }
+    }
+
+    /** SE do frame (byte sem sinal): 1..79 e 100..255 = global se_(id-1); 80..99 = audio do personagem (o jogador 1 soma os audios do jogador 0). */
+    private void pushSe(int se, int owner) {
+        if (SoundIds.isCharId(se)) {
+            int idx = se - SoundIds.CHAR_FIRST;
+            if (owner == 1 && atkWavCount > 0) idx += atkWavCount;
+            if (idx < atkWavCount) sounds.add(new Snd(false, idx, 0));
+            else sounds.add(new Snd(false, idx - atkWavCount, 1));
+            return;
+        }
+        int cn = SoundIds.commonOf(se);
+        if (cn >= 0) sounds.add(new Snd(true, cn, 0));
+    }
+
+    /** PushSE: < 80 = se_NN comum; >= 80 = audio de personagem na lista [atacante..., defensor...]. */
+    private void pushRaw(int id) {
+        if (id < 0) return;
+        if (id < 80) {
+            sounds.add(new Snd(true, id, 0));
+            return;
+        }
+        int idx = id - 80;
+        if (idx < atkWavCount) sounds.add(new Snd(false, idx, 0));
+        else sounds.add(new Snd(false, idx - atkWavCount, 1));
+    }
+
+    public boolean hasSounds() { return !sounds.isEmpty(); }
+
+    public List<Snd> drainSounds() {
+        List<Snd> out = new ArrayList<Snd>(sounds);
+        sounds.clear();
+        return out;
+    }
+
+    // ============================================================ para a interface
+
+    /** Camadas na ordem de desenho: defensor, atacante, projeteis, efeitos. */
+    /** Sombra: ANO 15 do effect, sprite unico. Jogo: y = 248 no mundo (8 px abaixo da linha dos pes), x do personagem, alpha 128, flip do personagem. */
+    private static final int SHADOW_ANO = 15, SHADOW_Y = 8, SHADOW_ALPHA = 128;
+    private AttackSim shadowA, shadowD;
+
+    private AttackSim shadowFor(AttackSim shadow, AttackSim who, int x) {
+        if (fxDac == null) return null;
+        if (shadow == null) {
+            Ano an = fxDac.getAno(SHADOW_ANO);
+            if (an == null || !an.present) return null;
+            shadow = new AttackSim(fxDac, SHADOW_ANO, false, x, SHADOW_Y * PX);
+        }
+        AttackSim.Obj o = shadow.root();
+        if (o == null) return null;
+        AttackSim.Obj w = who == null ? null : who.root();
+        o.x = w != null ? w.x : x;
+        o.y = SHADOW_Y * PX;
+        o.alpha = SHADOW_ALPHA;
+        applyFlip(shadow, w != null && (w.objFlags & 16) != 0);
+        return shadow;
+    }
+
+    public List<Layer> layers() {
+        layers.clear();
+        shadowD = shadowFor(shadowD, opp, oppX);
+        shadowA = projRoot() || effectRoot() ? null : shadowFor(shadowA, atk, 0);      // projetil e efeito nao tem sombra de lutador
+        // DrawExec do jogo: todos os objetos juntos, ordenados por (prio - iActPrio) e, empatando, por iTaskPrio (task do dono)
+        List<DrawItem> items = new ArrayList<DrawItem>();
+        if (!hiddenDraw[1]) collect(items, shadowD, OWNER_SHADOW, 17, TASK_AUX + 1);       // task 936: _SetObj(17); PlayerState & 0x1000000 a esconde
+        if (!hiddenDraw[0]) collect(items, shadowA, OWNER_SHADOW, 17, TASK_AUX);
+        if (!hiddenDraw[1]) collect(items, opp, OWNER_DEFENDER, oppPrio(), TASK_OPP);
+        if (!hiddenDraw[0]) {
+            collect(items, atk, OWNER_ATTACKER, atkPrio(), TASK_ATK);
+            for (int i = 0; i < auras.size(); i++) collect(items, auras.get(i).sim, auras.get(i).owner, atkPrio(), TASK_AUX);
+        }
+        if (!grabPaused) collect(items, grab, OWNER_PROJECTILE, 131, TASK_AUX + 1);                        // md 939: _SetObj(131)
+        for (int i = 0; i < projs.size(); i++) collect(items, projs.get(i).sim, OWNER_PROJECTILE, 153, TASK_PROJ);   // md 970: _SetObj(153 + 4p)
+        for (int i = 0; i < cuts.size(); i++) {
+            Cut c = cuts.get(i);
+            int kind = c.owner == OWNER_ATTACKER || c.owner == OWNER_DEFENDER ? 1 : -1;     // animacao do personagem, nao o corpo
+            collect(items, c.sim, c.owner, c.z, TASK_CUT, kind);
+        }
+        for (int i = 0; i < fxs.size(); i++) {
+            AttackSim.Obj r = fxs.get(i).sim.root();
+            collect(items, fxs.get(i).sim, OWNER_EFFECT, r != null && r.ano.index == 2 ? 328 : 200, TASK_FX);   // md 965: 200 (328 na ANO 2)
+        }
+        for (int i = 1; i < items.size(); i++) {                 // insercao estavel por (key, tie)
+            DrawItem cur = items.get(i);
+            int j = i - 1;
+            while (j >= 0 && (items.get(j).key > cur.key || (items.get(j).key == cur.key && items.get(j).tie > cur.tie))) { items.set(j + 1, items.get(j)); j--; }
+            items.set(j + 1, cur);
+        }
+        java.util.HashSet<AttackSim> seenSims = new java.util.HashSet<AttackSim>();
+        for (int i = 0; i < items.size(); i++) {
+            DrawItem d = items.get(i);
+            Layer l = new Layer();
+            l.sim = d.sim; l.owner = d.owner; l.only = d.obj; l.kind = d.kind >= 0 ? d.kind : kindOf(d.owner);
+            l.firstOfSim = seenSims.add(d.sim);
+            layers.add(l);
+        }
+        return layers;
+    }
