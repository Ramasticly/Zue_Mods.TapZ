+    /** x do mapa em que a tela comeca/termina e as bordas do mapa (para desenhar). */
+    /** Topo da tela em coordenadas do mundo (16.16): -240 px, subindo |iBackYPos| quando os lutadores estao no ar. */
+    public int screenTop() { return edgeMode == 0 ? -15728640 : -15728640 + camYFix; }
