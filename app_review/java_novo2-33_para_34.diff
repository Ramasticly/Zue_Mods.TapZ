+    /**
+     * md 977: a aura (effect 10-17 ou char 71-125) herda o flip do dono (wObjFlag & 16), menos quando o frame dela tem um hit de flag 0;
+     * md 978: as bolhas charf (41-70) nunca viram (so o x do offset e espelhado).
+     */
+    private static boolean auraFlip(int owner, AttackSim.Obj ownerObj, AttackSim.Obj aura) {
+        if (owner == OWNER_AURA_CHARF || ownerObj == null || (ownerObj.objFlags & 16) == 0) return false;
+        if (aura != null) for (int i = 0; i < aura.hits.length; i++) if (aura.hits[i].flag == 0) return false;
+        return true;
+    }
