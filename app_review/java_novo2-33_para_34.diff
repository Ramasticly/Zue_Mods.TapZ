+    private int[] tickTableFor(Ano a) {
+        String key = a.index + ":" + a.mpts.length + ":" + editVersion + ":" + length + ":" + System.identityHashCode(data)
+                + ":" + BattleSim.lockFromTick + ":" + BattleSim.landingOn + ":" + distance + ":" + height + ":" + BattleSim.oppHeightPx + ":" + BattleSim.extendTime;
+        if (tickTable == null || !key.equals(tickTableKey)) {
+            tickTable = sim.firstTicks(a.index, a.mpts.length, Math.max(length, 600));
+            tickTableKey = key;
+        }
+        return tickTable;
+    }
+
+    private int[][] tickElapsed;
+    private String tickElapsedKey = "";
+
+    /** Tabela (frame, tick dentro do frame) -> tick da simulacao: a timeline conta so ticks de frame, entao o hitstop nao ocupa lugar nela. */
+    private int[][] tickElapsedFor(Ano a) {
+        tickTableFor(a);                              // atualiza tickTableKey
+        if (tickElapsed == null || !tickTableKey.equals(tickElapsedKey)) {
+            int[] dur = new int[a.mpts.length];
+            for (int i = 0; i < dur.length; i++) dur[i] = a.mpts[i].hasTime ? a.mpts[i].time : 0;
+            tickElapsed = sim.firstTicksElapsed(a.index, dur, Math.max(length, 600));
+            tickElapsedKey = tickTableKey;
+        }
+        return tickElapsed;
+    }
