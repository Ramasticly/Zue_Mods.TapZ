+    /** CheckOptFlag roda no PlayerTail de cada lutador a cada frame novo: o do oponente tambem (tremor e flag 20 do HDAT 13 dele). */
+    private void oppFrameFlags() {
+        AttackSim.Obj od = opp.root();
+        if (od != null && (od != lastOppObj || od.serial != lastOppSerial)) {
+            lastOppObj = od;
