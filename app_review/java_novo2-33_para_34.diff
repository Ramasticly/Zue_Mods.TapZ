+        check("bloco existente mas vazio: preenchido e ROW 2", f[0] && r2.substring(hb31[0], hb31[2] + 1).contains("$ROW: 2") && r2.substring(hb31[0], hb31[2] + 1).contains("$FR_1"), true);
