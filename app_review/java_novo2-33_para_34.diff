+/**
+ * Gaveta do editor de reacoes, no padrao da gaveta da tela principal ({@code TimelineTools.root}): flutua por cima, ancorada acima do transporte,
+ * com alca de arrastar (puxar para cima / baixo; tocar alterna as alturas), botao Y (grava a altura atual como padrao), cabecalho
+ * (titulo, desfazer, fechar, aplicar) e corpo que rola. A altura padrao e a que sobe ate a base da previa.
+ */
+final class ReactionSheet {
+    /** Limites da gaveta, definidos pelo layout: altura maxima e altura padrao (ao abrir). */
+    interface Geo { int maxH(); int defH(); }
+
+    private static final int HANDLE_DP = 26;
+
+    final LinearLayout root;
+    final LinearLayout body;
+    private final ScrollView scroll;
+    private final TextView title;
+    private final float d;
+    private final Geo geo;
+
+    ReactionSheet(Context c, Geo geo, Runnable onUndo, Runnable onBack, Runnable onDismiss, Runnable onApply, Runnable saveHeight) {
+        this.geo = geo;
+        this.d = c.getResources().getDisplayMetrics().density;
+        root = new LinearLayout(c);
+        root.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(LayoutManager.BG);
+        float rad = dp(14);
+        bg.setCornerRadii(new float[]{rad, rad, rad, rad, 0, 0, 0, 0});
+        bg.setStroke(dp(1), LayoutManager.PANEL_HI);
+        root.setBackground(bg);
+
+        // alca de arrastar ("-"): puxe para cima/baixo; arraste rapido para baixo fecha
+        FrameLayout hbox = new FrameLayout(c);
+        View bar = new View(c);
+        GradientDrawable barBg = new GradientDrawable();
+        barBg.setColor(LayoutManager.DIM);
+        barBg.setCornerRadius(dp(3));
+        bar.setBackground(barBg);
+        hbox.addView(bar, new FrameLayout.LayoutParams(dp(44), dp(5), Gravity.CENTER));
+        final Runnable close = onDismiss;
+        hbox.setOnTouchListener(new View.OnTouchListener() {
+            float downY, prevY, vel; long prevT; int startH; boolean moved;
+            @Override public boolean onTouch(View v, MotionEvent e) {
+                switch (e.getActionMasked()) {
+                    case MotionEvent.ACTION_DOWN:
+                        downY = prevY = e.getRawY(); prevT = e.getEventTime(); vel = 0; moved = false;
+                        startH = root.getHeight();
+                        return true;
+                    case MotionEvent.ACTION_MOVE: {
+                        float y = e.getRawY();
+                        long t = e.getEventTime();
+                        if (t > prevT) vel = vel * 0.6f + (y - prevY) / (t - prevT) * 1000f * 0.4f;
+                        prevY = y; prevT = t;
+                        if (Math.abs(y - downY) > dp(4)) moved = true;
+                        if (moved) setHeight(startH - (int) (y - downY));
+                        return true;
+                    }
+                    case MotionEvent.ACTION_UP: {
+                        if (!moved) { tapHandle(); return true; }
+                        float want = startH - (e.getRawY() - downY);
+                        if (vel > 1800f || want < peekH() - dp(50)) { if (close != null) close.run(); }
+                        return true;
+                    }
+                    default: return true;
+                }
+            }
+        });
