+    /**
+     * Aviso de pouso: aparece 2 s ao escolher/alterar o golpe e de novo toda vez que, tocando, o personagem pousa antes da hora;
+     * dar play o esconde. OCULTAR (esquerda) o desliga para esta combinacao golpe/altura/distancia/lado; POS (direita) abre as posicoes.
+     */
+    private void checkLandWarning() {
+        measuredEarly = sim != null && data != null && sim.measuredLandedEarly();
+        warnKey = data == null ? "" : data.moveIndex + ":" + height + ":" + distance + ":" + facingLeft;
+        hideNotice();
+        if (measuredEarly) showLandWarning();
