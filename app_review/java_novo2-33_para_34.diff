+
+        // ---- eventos 8/9 com cam != 0: _SetXY(0, 0) so no 1o tick; depois o objeto anda sozinho em coordenadas de tela
+        {
+            int[] z = {0, 0, 0, 0, 0, 0, 0, 0};
