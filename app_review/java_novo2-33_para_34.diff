+        43, 43, 43, 43, 43, 43, 43, 44, 44, 44, 44, 44, 44, 44, 44, 44, 45, 45, 45, 45,
+        45, 45, 45, 45, 45, 46, 46, 46, 46, 46, 46, 46, 46, 46, 47, 47, 47, 47, 47, 47,
+        47, 47, 47, 48, 48, 48, 48, 48, 48, 48, 48, 48, 49, 49, 49, 49, 49, 49, 49, 49,
+        49, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 51, 51, 51, 51, 51, 51, 51, 51, 51,
+        52, 52, 52, 52, 52, 52, 52, 52, 52, 52, 53, 53, 53, 53, 53, 53, 53, 53, 53, 53,
+        54, 54, 54, 54, 54, 54, 54, 54, 54, 54, 55, 55, 55, 55, 55, 55, 55, 55, 55, 55,
+        55, 56, 56, 56, 56, 56, 56, 56, 56, 56, 56, 57, 57, 57, 57, 57, 57, 57, 57, 57,
+        57, 57, 58, 58, 58, 58, 58, 58, 58, 58, 58, 58, 58, 59, 59, 59, 59, 59, 59, 59,
+        59, 59, 59, 59, 59, 60, 60, 60, 60, 60, 60, 60, 60, 60, 60, 60, 61, 61, 61, 61,
+        61, 61, 61, 61, 61, 61, 61, 61, 62, 62, 62, 62, 62, 62, 62, 62, 62, 62, 62, 62,
+        63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 64,
+    };
+
+    /** GetAtanTable(dx, dy): angulo em 1/512 de volta (0..511) do vetor (dx, dy), dx/dy em 16.16. */
+    static int atan512(int dx, int dy) {
+        if (dx == 0) return dy > 0 ? 128 : 384;
+        if (dy == 0) return dx > 0 ? 0 : 256;
+        int s;
+        try {
+        if (dx > 0) {
+            float f3 = dx >> 16;
+            float f4 = dy >> 16;
+            if (dy < 0) {
+                float f5 = f4 * (-1.0f);
+                if (f5 > f3) s = ATAN[(int) ((f3 * 512.0f) / f5)] + 384;
+                else s = (512 - ATAN[(int) ((512.0f * f5) / f3)]) & 511;
+            } else if (f4 > f3) {
+                s = 128 - ATAN[(int) ((512.0f * f3) / f4)];
+            } else {
+                s = ATAN[(int) ((f4 * 512.0f) / f3)];
+            }
+        } else {
+            float f6 = dy >> 16;
+            float f7 = (dx >> 16) * (-1.0f);
+            if (dy <= 0) {
+                float f8 = f6 * (-1.0f);
+                if (f8 > f7) s = 384 - ATAN[(int) ((512.0f * f7) / f8)];
+                else s = ATAN[(int) ((f8 * 512.0f) / f7)] + 256;
+            } else if (f6 > f7) {
+                s = ATAN[(int) ((f7 * 512.0f) / f6)] + 128;
+            } else {
+                s = 256 - ATAN[(int) ((512.0f * f6) / f7)];
+            }
+        }
+        } catch (RuntimeException e) {
+            return 0;                                // o jogo captura a excecao (divisao por 0 com |dx| < 1 px) e devolve 0
+        }
+        return s;
+    }
+}
