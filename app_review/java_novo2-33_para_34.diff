+    /** Copia os campos de movimento de {@code from} para {@code to}. */
+    private static void copyMove(Ano.Mpt from, Ano.Mpt to) {
+        to.flags = (to.flags & ~4) | (from.flags & 4);
+        to.moveMask = from.moveMask;
+        to.speedX = from.speedX; to.speedY = from.speedY; to.accelX = from.accelX; to.accelY = from.accelY;
+    }
