+        s.add(new Section(ToolbarOrder.HIDE, "HIDE-EFF",
+                "Esconde efeitos, auras, cenas (bobj) e projéteis e deixa só atacante e oponente. Serve para ver o que é do personagem e o que é do efeito."));
+        s.add(new Section(ToolbarOrder.GHOST, "FR-PREVIEW",
+                "Frame preview: desenha o frame anterior (PREV) ou o próximo (NEXT) em transparência por cima do atual, para alinhar sprites e hitboxes entre frames. "
+                + "Em TELA > FR-PREVIEW SET dá para ajustar a transparência e incluir projéteis e efeitos."));
+        s.add(new Section(ToolbarOrder.SCREEN, "TELA",
+                "Opções do que aparece na preview: grade, sons, cenas (cutscenes da flag 20), travar (modo cinemático do jogo), box amarela de todos os sprites e FR-PREVIEW SET. "
+                + "Desligar cenas ou sons ajuda a editar sem distração; o jogo sempre os executa."));
+        s.add(new Section(ToolbarOrder.HELP, "AJUDA",
+                "Abre este menu de ajuda: descreve cada botão do menu superior e do resto da tela e tem o botão RESTAURAR ORDEM, que devolve os botões do menu à ordem padrão."));
+        return s;
+    }
+
+    /** Resto da tela (nao e botao do menu superior). */
+    static List<Section> screen() {
+        List<Section> s = new ArrayList<Section>();
+        s.add(new Section(null, "MODO: GOLPES / ANO",
+                "GOLPES lista os golpes do personagem (cada um com seus ANOs, projéteis e reações). ANO lista os ANOs soltos, para abrir e editar uma animação isolada, "
+                + "sem o golpe em volta. Ao tocar no seletor ao lado, escolhe-se o golpe ou o ANO."));
+        s.add(new Section(null, "Barra de tempo e transporte",
+                "A barra mostra o tick da simulação (e o frame/total). INÍCIO volta ao tick 0, -1 e +1 andam um tick (para conferir frame a frame), "
+                + "PAUSAR/PLAY reproduz, e o botão de velocidade alterna a velocidade da reprodução. "
+                + "A preview roda a batalha inteira: atacante, oponente, projéteis, efeitos, câmera, zoom, tremor e cutscenes, como o jogo."));
