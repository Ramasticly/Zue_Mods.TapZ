diff -ruN a/test/RootKindTest.java b/test/RootKindTest.java
--- a/test/RootKindTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/RootKindTest.java	2026-10-28 13:30:58.391727597 +0000
@@ -0,0 +1,61 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** ANO de projetil/efeito aberto sozinho no editor: nao e o personagem (sem pouso 13, queda 89 nem sombra); no chao segue o md 971. */
+public class RootKindTest {
+    static BattleSim run(int kind, int projChao, int steps) throws Exception {
+        A[] a = SpawnDiagTest.anos();
+        a[40] = new A().mpt(new M().time(30).speedY(2 << 16));
+        a[50] = new A().mpt(new M().time(20));
+        CharData ch = chr(move(new int[]{2, 40}, new int[]{40, projChao}), new byte[][] {});
+        CharData.Move mv = CharData.genericFrom(40, ch.moves[0]);
+        mv.rootKind = kind;
+        BattleSim s = SpawnDiagTest.sim(dac(a), ch, mv, 200, 0, 0);
+        for (int i = 0; i < steps; i++) s.step();
+        return s;
+    }
+
+    static boolean hasShadow(BattleSim s) {
+        for (BattleSim.Layer l : s.layers()) if (l.owner == BattleSim.OWNER_SHADOW) return true;
+        return false;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // personagem avulso: ao tocar o chao pousa (ANO 13), como sempre
+        BattleSim c = run(CharData.Move.ROOT_CHAR, 0, 4);
+        check("personagem avulso: pousa no ANO 13", c.attacker().root().ano.index, 13);
+
+        // projetil sem PROJETIL_COLISAO_CHAO: continua no mesmo ANO, y preso ao chao, velocidade intacta
+        BattleSim p = run(CharData.Move.ROOT_PROJ, 0, 4);
+        check("projetil: continua no ANO 40", p.attacker().root().ano.index, 40);
+        check("projetil: y preso ao chao", p.attacker().root().y, 0);
+        check("projetil: velocidade Y nao e zerada", p.attacker().root().speedY, 2 << 16);
+        check("projetil: sem sombra de lutador", hasShadow(p), false);
+
+        // com PROJETIL_COLISAO_CHAO = 50: troca para esse ANO
+        BattleSim q = run(CharData.Move.ROOT_PROJ, 50, 4);
+        check("projetil com COLISAO_CHAO: vai para o ANO 50", q.attacker().root().ano.index, 50);
+        check("projetil com COLISAO_CHAO: y no chao", q.attacker().root().y <= 0, true);
+        BattleSim q2 = run(CharData.Move.ROOT_PROJ, 50, 12);
+        check("depois de trocar fica no ANO 50 (nao volta nem pousa no 13)", q2.attacker().root() == null || q2.attacker().root().ano.index == 50, true);
+
+        // efeito: nada de chao
+        BattleSim e = run(CharData.Move.ROOT_EFFECT, 50, 6);
+        check("efeito: continua no ANO 40", e.attacker().root().ano.index, 40);
+        check("efeito: atravessa o chao (sem clamp)", e.attacker().root().y > 0, true);
+        check("efeito: sem sombra", hasShadow(e), false);
+
+        // quem e quem quando o ANO e aberto sozinho
+        CharData ch = chr(move(new int[]{2, 40}, new int[]{4, 30}, new int[]{40, 31}), new byte[][] {});
+        check("ANIM_INICIAL = personagem", ch.rootKindOf(40), CharData.Move.ROOT_CHAR);
+        check("PROJETIL_ANIM_NORMAL = projetil", ch.rootKindOf(30), CharData.Move.ROOT_PROJ);
+        check("PROJETIL_COLISAO_CHAO = projetil", ch.rootKindOf(31), CharData.Move.ROOT_PROJ);
+        check("ANO 201..255 = efeito", ch.rootKindOf(210), CharData.Move.ROOT_EFFECT);
+        check("ANO qualquer = personagem", ch.rootKindOf(5), CharData.Move.ROOT_CHAR);
+        check("copia mantem o tipo", CharData.genericFrom(30, null).copy().rootKind, CharData.Move.ROOT_CHAR);
+        CharData.Move cm = new CharData.Move(); cm.rootKind = CharData.Move.ROOT_EFFECT;
+        check("copy() copia rootKind", cm.copy().rootKind, CharData.Move.ROOT_EFFECT);
+        System.out.println("RootKindTest fails=" + fails);
+    }
+}
diff -ruN a/test/SaverCopyTest.java b/test/SaverCopyTest.java
--- a/test/SaverCopyTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/SaverCopyTest.java	2026-10-24 17:19:34.789945894 +0000
@@ -0,0 +1,77 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.io.File;
+
+/** Salvar em pasta separada: copia completa do personagem para Tap Battle/TBRE/Chars e a mesma gravacao do Runtime na copia. */
+public class SaverCopyTest {
+    static void put(File f, String text) throws Exception { f.getParentFile().mkdirs(); Saver.write(f, text); }
+
+    public static void main(String[] args) throws Exception {
+        File tb = new File(System.getProperty("java.io.tmpdir"), "savercopy_test_tapbattle");
+        Saver.deleteTree(tb);
+        File src = new File(tb, "assets/char03");
+        A[] anos = new A[6];
+        for (int i = 0; i < 6; i++) anos[i] = new A().mpt(new M().time(5).img(1));
+        Dac dac = dac(anos);
+        CharData cd = chr(move(new int[]{0, 4}, new int[]{2, 3}), new byte[][] {});
+        put(new File(src, "000.dac.txt"), Saver.dacText(dac, null));
+        put(new File(src, "000.bin.txt"), "BIN_CNV_ {\n" + DacText.move(cd.moves[0], 0) + "\n}\n");
+        put(new File(src, "000.cnv.txt"), "CNV_TXT_ {\n}\n");
+        put(new File(src, "000.dac"), "binario");
+        put(new File(src, "000.png"), "folha");
+        put(new File(src, "sons/001.wav"), "wav1");
+        put(new File(src, "salvos/velho.txt"), "arquivo da pasta antiga");
+        String dac0 = Saver.readText(new File(src, "000.dac.txt")), bin0 = Saver.readText(new File(src, "000.bin.txt"));
+
+        File dst = Saver.separateDir(src, src.getName());
+        check("pasta separada = Tap Battle/TBRE/Chars/char03", dst.getPath().endsWith("savercopy_test_tapbattle/TBRE/Chars/char03"), true);
+        final int[] last = new int[2];
+        Saver.copyChar(src, dst, false, new Saver.CopyProgress() { public void on(String f, int done, int total) { last[0] = done; last[1] = total; } });
+        check("copia completa: txt, binario, folha e subpasta", new File(dst, "000.dac.txt").isFile() && new File(dst, "000.bin.txt").isFile() && new File(dst, "000.dac").isFile()
+                && new File(dst, "000.png").isFile() && new File(dst, "sons/001.wav").isFile() && new File(dst, "000.cnv.txt").isFile(), true);
+        check("a velha pasta salvos/ nao vai", new File(dst, "salvos").exists(), false);
+        check("progresso chegou ao fim (6 arquivos, sem o de salvos/)", last[0] + "/" + last[1], "6/6");
+        check("conteudo igual", Saver.readText(new File(dst, "000.png")).equals("folha") && Saver.readText(new File(dst, "sons/001.wav")).equals("wav1"), true);
+
+        // salvar golpe 0 na copia: altera o golpe do HDAT 4 e nao toca no original
+        cd.moves[0].animInicial = 4;
+        String r = Saver.saveInto(dst, dac, cd, 0, 0, 0);
+        String binCopy = Saver.readText(new File(dst, "000.bin.txt"));
+        check("a copia recebeu o golpe editado", binCopy.replaceAll("\\s", "").contains("$ANIM_INICIAL:4,"), true);
+        check("o original continua igual", Saver.readText(new File(src, "000.bin.txt")).equals(bin0) && Saver.readText(new File(src, "000.dac.txt")).equals(dac0), true);
+        check("resumo do salvamento", r.contains("1 golpe(s)"), true);
+
+        // ANO: edita o ANO 2 em memoria e salva so ele
+        Ano a2 = dac.getAno(2);
+        Ano.Mpt[] m2 = a2.mpts.clone();
+        m2[0] = m2[0].copy();
+        m2[0].time = 77;
+        dac.setAno(2, new Ano(2, true, a2.flags, a2.priority, a2.links, m2));
+        String r2 = Saver.saveInto(dst, dac, cd, 1, 0, 2);
+        check("salvar ANO 2 na copia", Saver.readText(new File(dst, "000.dac.txt")).contains("$TIME: 77") && !Saver.readText(new File(src, "000.dac.txt")).contains("$TIME: 77") && r2.contains("1 ANO(s)"), true);
+        String all = Saver.saveInto(dst, dac, cd, 4, 0, 0);
+        check("salvar tudo na copia", all.contains("6 ANO(s)") && all.contains("golpe(s)"), true);
+
+        // unir: nao sobrescreve o que ja esta na copia, so acrescenta o que falta
+        put(new File(dst, "000.png"), "folha editada na copia");
+        new File(dst, "sons/001.wav").delete();
+        Saver.copyChar(src, dst, true, null);
+        check("unir: arquivo existente fica como esta", Saver.readText(new File(dst, "000.png")), "folha editada na copia");
+        check("unir: arquivo que faltava volta", new File(dst, "sons/001.wav").isFile(), true);
+        Saver.copyChar(src, dst, false, null);
+        check("sem unir: sobrescreve", Saver.readText(new File(dst, "000.png")), "folha");
+
+        // outro nome e delecao segura
+        check("nome livre: char03_2, depois char03_3", Saver.freeName(src, "char03"), "char03_2");
+        new File(Saver.separateDir(src, "char03_2"), "x").mkdirs();
+        check("nome livre pula o existente", Saver.freeName(src, "char03"), "char03_3");
+        check("so pastas dentro de TBRE/Chars podem ser apagadas", Saver.isSeparateCopy(dst) + ":" + Saver.isSeparateCopy(src) + ":" + Saver.isSeparateCopy(new File(tb, "TBRE/Chars")), "true:false:false");
+        Saver.deleteTree(dst);
+        check("deletar a copia", dst.exists() + ":" + src.exists(), "false:true");
+
+        Saver.deleteTree(tb);
+        System.out.println("SaverCopyTest fails=" + BattleTest.fails);
+    }
+}
