+        int[] flow = {move.animAoAcertar, move.animSeqChao, move.animEndChao, move.animSeqAr, move.animEndAr, move.pousoErrar, move.pousoAcertar};
+        for (int ano : flow) {
+            if (ano <= 0 || visitedAnos.contains(ano)) continue;
+            Ano a = atkDac.getAno(ano);
+            if (a == null || !a.present || !hasSpawnHit(a)) continue;
+            String where = "ele nasce no ANO " + ano + (ano == move.animSeqChao || ano == move.animSeqAr ? " (ANIM_SEQ)"
+                    : ano == move.animEndChao || ano == move.animEndAr ? " (ANIM_END)" : ano == move.animAoAcertar ? " (ANIM_AO_ACERTAR)" : " (pouso)");
+            if (lockFromTick >= 0)
+                noteSpawn("O projétil não nasceu: " + where + ", que não tocou porque TRANSIÇÃO está TRAVADA. Destrave para ver o fluxo completo.", false);
+            else if (lifeO <= 0)
+                noteSpawn("O projétil não nasceu: " + where + ", mas o oponente foi derrotado antes (flags 39/40 encerram o ANO quando o alvo morre, como no jogo).", false);
