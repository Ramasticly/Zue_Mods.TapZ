+    // ---- SPEEDLINE: pontos e linhas verdes da trajetoria do movimento (arrastar muda so a speed; tocar abre o menu do ponto) ----
+    private boolean speedLineOn;
+    private String slKey = "";
+    private double[][] slAnchor = new double[0][];           // por cadeia: {x, y, lado x, lado y} do personagem no inicio da cadeia
+    private Ano.Mpt[] slWork;                                // durante o arrasto: os frames ja editados (so na tela; grava ao soltar)
+    private int slDragHead = -1, slDragK = -1;
+    private float slDownX, slDownY;
+    private boolean slMoved;
+
+    public void setSpeedLine(boolean on) { speedLineOn = on; slKey = ""; slWork = null; slDragHead = -1; invalidate(); }
+    public boolean isSpeedLine() { return speedLineOn; }
+
+    /** Ancoras (posicao do personagem no inicio de cada cadeia de movimento) da ANO atual; refeitas quando a edicao muda. */
+    private void slPrepare(Ano a) {
+        int[] tt = tickTableFor(a);
+        String key = tickTableKey + ":" + System.identityHashCode(a.mpts);
+        if (key.equals(slKey) && slWork == null) return;
+        if (slWork != null && slAnchor.length > 0) return;       // arrastando: mantem as ancoras
+        java.util.List<SpeedLine.Chain> chains = SpeedLine.chains(a.mpts);
+        double[][] an = new double[chains.size()][];
+        for (int i = 0; i < an.length; i++) {
+            int t = chains.get(i).head < tt.length ? tt[chains.get(i).head] : -1;
+            if (t < 0) continue;
+            BattleSim s = sim.copyAt(t);
+            AttackSim.Obj r = s.timelineAtk().root();
+            if (r == null) continue;
+            an[i] = new double[] {r.x / 65536.0, r.y / 65536.0, (r.objFlags & 16) != 0 ? -1 : 1, (r.objFlags & 32) != 0 ? -1 : 1};
+        }
+        slAnchor = an;
+        slKey = key;
+    }
+
+    private double[] slWorld(double[] an, SpeedLine.Pt p) { return new double[] {an[0] + an[2] * p.x, an[1] + an[3] * p.y}; }
+
+    private void drawSpeedLine(Canvas c) {
+        Ano a = currentAno();
+        if (!speedLineOn || a == null || sim == null) return;
+        slPrepare(a);
+        Ano.Mpt[] m = slWork != null ? slWork : a.mpts;
+        java.util.List<SpeedLine.Chain> chains = SpeedLine.chains(m);
+        float sw = Math.max(0.5f, 2f * density / scale), dot = 4.5f * density / scale;
+        Paint line = new Paint(Paint.ANTI_ALIAS_FLAG), fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        line.setStyle(Paint.Style.STROKE);
+        line.setStrokeWidth(sw);
+        line.setColor(0xD93DDC84);
+        int cur = currentPat();
+        for (int ci = 0; ci < chains.size() && ci < slAnchor.length; ci++) {
+            double[] an = slAnchor[ci];
+            if (an == null) continue;
+            SpeedLine.Chain ch = chains.get(ci);
+            android.graphics.Path path = new android.graphics.Path();
+            boolean first = true;
+            for (SpeedLine.Pt p : ch.pts) {
+                double[] w = slWorld(an, p);
+                if (first) { path.moveTo((float) w[0], (float) w[1]); first = false; } else path.lineTo((float) w[0], (float) w[1]);
+            }
+            c.drawPath(path, line);
+            for (SpeedLine.Pt p : ch.pts) {
+                double[] w = slWorld(an, p);
+                boolean here = p.kind != SpeedLine.APEX && p.frame == cur;
+                fill.setStyle(Paint.Style.FILL);
+                fill.setColor(here ? 0xFFB6FFD6 : p.kind == SpeedLine.APEX ? 0x993DDC84 : 0xFF3DDC84);
+                c.drawCircle((float) w[0], (float) w[1], here ? dot * 1.8f : p.kind == SpeedLine.APEX ? dot * 0.6f : dot, fill);
+                if (here) {
+                    fill.setStyle(Paint.Style.STROKE);
+                    fill.setStrokeWidth(sw);
+                    fill.setColor(0xFFFFFFFF);
+                    c.drawCircle((float) w[0], (float) w[1], dot * 1.8f, fill);
+                }
+            }
+            // numero do Frame em cada ponto (e o tick no ponto de tick); contorno escuro para ler sobre qualquer sprite
+            Paint txt = new Paint(Paint.ANTI_ALIAS_FLAG), outline = new Paint(Paint.ANTI_ALIAS_FLAG);
+            txt.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
+            outline.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
+            outline.setStyle(Paint.Style.STROKE);
+            outline.setColor(0xE60D0F13);
+            double[] prevW = null;
+            int stack = 0;
+            for (SpeedLine.Pt p : ch.pts) {
+                double[] w = slWorld(an, p);
+                boolean here = p.kind != SpeedLine.APEX && p.frame == cur;
+                float size = (here ? 13f : 11f) * density / scale;
+                txt.setTextSize(size);
+                outline.setTextSize(size);
+                outline.setStrokeWidth(3f * density / scale);
+                txt.setColor(here ? 0xFFFFFFFF : p.kind == SpeedLine.APEX ? 0xFFFFE066 : 0xFFB6FFD6);
+                // pontos quase no mesmo lugar (frame sem velocidade): o texto sobe um pouco para nao encavalar
+                stack = prevW != null && Math.hypot(w[0] - prevW[0], w[1] - prevW[1]) < 10f * density / scale ? stack + 1 : 0;
+                prevW = w;
+                float tx = (float) w[0] + dot * 1.6f, ty = (float) w[1] - dot * 1.2f - stack * size * 1.05f;
+                String label = SpeedLine.label(p);
+                c.drawText(label, tx, ty, outline);
+                c.drawText(label, tx, ty, txt);
+            }
+            if (cur >= ch.head && cur <= ch.last) {              // o personagem andando dentro do frame atual
+                double[] pos = ch.posAt(m, cur, currentElapsed());
+                fill.setStyle(Paint.Style.FILL);
+                fill.setColor(0xFFFFE066);
+                c.drawCircle((float) (an[0] + an[2] * pos[0]), (float) (an[1] + an[3] * pos[1]), dot * 0.9f, fill);
+            }
+        }
+    }
