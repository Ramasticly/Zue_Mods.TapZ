+    /** ＋: cria no passo selecionado (passo novo, ou abre a gaveta da faixa para preencher voz, parede, SEQ e speed). */
+    private void addMenu(View anchor) {
+        android.widget.PopupMenu m = new android.widget.PopupMenu(c, anchor);
+        m.getMenu().add(0, 0, 0, "Passo novo (depois do selecionado)");
+        m.getMenu().add(0, 1, 1, "Speed neste passo");
+        m.getMenu().add(0, 2, 2, "Voz neste passo");
+        m.getMenu().add(0, 3, 3, "Efeito de parede neste passo");
+        m.getMenu().add(0, 4, 4, "Próxima reação (SEQ) neste passo");
+        m.getMenu().add(0, 5, 5, "Mover passo para trás ◀");
+        m.getMenu().add(0, 6, 6, "Mover passo para frente ▶");
+        m.getMenu().add(0, 7, 7, "Σ Total (deslocamento)");
+        m.setOnMenuItemClickListener(new android.widget.PopupMenu.OnMenuItemClickListener() {
+            @Override public boolean onMenuItemClick(android.view.MenuItem it) {
+                int id = it.getItemId();
+                if (id == 0) { addRow(); return true; }
+                if (id == 5 || id == 6) { moveRow(id == 5 ? -1 : 1); return true; }
+                if (id == 7) { openDrawer(P_TOTAL); return true; }
+                final ReactionTable t = table();
+                if (t == null || sel < 0 || sel >= t.rows) return true;
+                if (id == 1) {
+                    selLane = ReactionTimelineView.LANE_SPEED;
+                    if (ReactionRuns.keeps(t, sel, air)) {
+                        view.editReaction(type, new Runnable() { public void run() { ReactionRuns.startRun(t, air, sel); } });
+                        refresh();
+                    }
+                }
+                else selLane = id == 2 ? ReactionTimelineView.LANE_VOZ : id == 3 ? ReactionTimelineView.LANE_EFEITOS : ReactionTimelineView.LANE_SEQ;
+                tl.setSelectedLane(selLane);
+                openDrawer(id == 1 ? P_SPEED : id == 2 ? P_VOICE : id == 3 ? P_EFFECTS : P_SEQ);
+                return true;
+            }
+        });
+        m.show();
+    }
