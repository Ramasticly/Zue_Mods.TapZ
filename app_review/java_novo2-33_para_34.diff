+    }
+
+    void hide() { root.setVisibility(View.GONE); }
+
+    void setHeight(int h) {
+        h = Math.max(peekH(), Math.min(maxH(), h));
+        ViewGroup.LayoutParams p = root.getLayoutParams();
+        if (p != null && p.height != h) { p.height = h; root.setLayoutParams(p); }
+    }
+
+    void scrollToTop() { scroll.scrollTo(0, 0); }
+
+    private void tapHandle() {
+        int h = root.getHeight(), mx = maxH();
+        int df = Math.min(mx, geo.defH());
+        if (h <= peekH() + dp(10)) setHeight(df);
+        else if (h < mx - dp(20) && h < df - dp(20)) setHeight(df);
+        else if (h < mx - dp(20)) setHeight(mx);
+        else setHeight(df);
+    }
+
+    private TextView edgeBtn(String t, View.OnClickListener l) {
