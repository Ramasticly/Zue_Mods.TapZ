@@ -0,0 +1,368 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/**
+ * Cutscenes da flag 20 (task md 996 do jogo, tabela HDAT 13): posicao (_SetXY antes do _ActReq), duracao (morre sem ser
+ * desenhada no tick do fim), mapas de camera/teleporte e stun (md 925). Cada expectativa vem do TCBManajer.java do jogo.
+ */
+public class CutsceneTest {
+    static final int PX = 65536;
+
+    /** Personagem com 1 golpe (ANO 40) e a tabela HDAT 13 dada (linha = {alvo, sync, z, animN, animF, cam, stun, mapa}). */
+    static CharData chrEv(int[]... rows) throws Exception {
+        byte[][] t = new byte[40][];
+        int[] cols = new int[40], rowsN = new int[40];
+        for (int i = 0; i < 40; i++) t[i] = new byte[0];
+        t[4] = move(new int[]{2, 40});
+        cols[4] = 48;
+        rowsN[4] = 1;
+        Buf ev = new Buf();
+        for (int[] r : rows) for (int v : r) ev.u16(v);
+        t[13] = ev.get();
+        cols[13] = 8;
+        rowsN[13] = rows.length;
+        return CharData.read(hdat(t, cols, rowsN));
+    }
+
+    /** Dac do atacante: ANO 40 = frame 0 (10 ticks) com os hits dados, frame 1 (10 ticks), frame 2 (40 ticks). */
+    static Dac atkDac(int[]... hits) throws Exception {
+        A[] a = new A[45];
+        for (int i = 0; i < 45; i++) a[i] = new A().mpt(new M().time(1));
+        M m0 = new M().time(10);
+        for (int[] h : hits) m0.hit(h);
+        a[40] = new A().mpt(m0).mpt(new M().time(10)).mpt(new M().time(40));
+        return dac(a);
+    }
+
+    /** Pack effect: ANO 20/21 = cutscene de 50 ticks que anda 3 px/tick; ANO 22 tem um link (ANO 23) que anda 2 px/tick. */
+    static Dac fxDac() throws Exception {
+        A[] a = new A[30];
+        for (int i = 0; i < 30; i++) a[i] = new A().mpt(new M().time(50));
+        a[20] = new A().mpt(new M().time(50).speedX(3 * PX));
+        a[21] = new A().mpt(new M().time(50).speedX(3 * PX));
+        a[23] = new A().mpt(new M().time(50).speedX(2 * PX));
+        Dac d = dac(a);
+        Ano p = d.getAno(22);
+        d.setAno(22, new Ano(22, true, p.flags, p.priority, new Ano.Link[]{new Ano.Link(0, 0, 23)}, p.mpts));
+        return d;
+    }
+
+    /** Oponente: ANO 0 com 4 frames de 3 ticks (para ver se ele congela) e hurtbox. */
+    static Dac defDac() throws Exception {
+        A[] a = new A[25];
+        for (int i = 0; i < 25; i++) a[i] = new A().mpt(new M().time(30));
+        a[0] = new A().mpt(new M().time(3).hit(1, -10, -60, 20, 60)).mpt(new M().time(3)).mpt(new M().time(3)).mpt(new M().time(3));
+        return dac(a);
+    }
+
+    static BattleSim sim(CharData ch, Dac atk, Dac fx) throws Exception {
+        BattleSim.edgeMode = 1;
+        BattleSim.cutscenes = true;
+        return new BattleSim(atk, ch, ch.moves[0], false, defDac(), fx, gd(new byte[][] {}), 300, 0, 0);
+    }
+
+    static int fxLayers(BattleSim s) {
+        int n = 0;
+        for (BattleSim.Layer l : s.layers()) if (l.owner == BattleSim.OWNER_EFFECT) n++;
+        return n;
+    }
+
+    static AttackSim.Obj fxRoot(BattleSim s) {
+        for (BattleSim.Layer l : s.layers()) if (l.owner == BattleSim.OWNER_EFFECT && l.only == null) return l.sim.root();
+        for (BattleSim.Layer l : s.layers()) if (l.owner == BattleSim.OWNER_EFFECT) return l.sim.root();
+        return null;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // ---- posicao: _SetXY(ancora) antes do _ActReq => raiz = ancora + 1 tick de velocidade, nunca acumula
+        {
+            CharData ch = chrEv(new int[]{0, 1, 0, 20, 21, 0, 0, 0});
+            BattleSim s = sim(ch, atkDac(new int[]{20, 5, -10, 0, 0}), fxDac());
+            int ax = s.attacker().root().x;
+            check("cutscene nasce no frame 0 (1a execucao da task)", s.cutsceneCount(), 1);
+            check("1a execucao: raiz exatamente na ancora", fxRoot(s).x - ax - 5 * PX, 0);
+            check("1a execucao: y da ancora", fxRoot(s).y, s.attacker().root().y - 10 * PX);
+            s.step();
+            check("2a execucao: ancora + 1 tick de velocidade", fxRoot(s).x - ax - 5 * PX, 3 * PX);
+            for (int i = 0; i < 5; i++) s.step();
+            check("raiz nao acumula velocidade (re-pino a cada tick)", fxRoot(s).x - ax - 5 * PX, 3 * PX);
+        }
+
+        // ---- links da cutscene voltam para a raiz a cada _SetXY (nao acumulam)
+        {
+            CharData ch = chrEv(new int[]{0, 1, 0, 22, 22, 0, 0, 0});
+            BattleSim s = sim(ch, atkDac(new int[]{20, 5, -10, 0, 0}), fxDac());
+            int ax = s.attacker().root().x;
+            for (int i = 0; i < 6; i++) s.step();
+            AttackSim.Obj kid = null;
+            for (BattleSim.Layer l : s.layers()) if (l.owner == BattleSim.OWNER_EFFECT && l.sim.children().length > 0) kid = l.sim.children()[0];
+            check("cutscene tem o link", kid != null, true);
+            if (kid != null) check("link anda so a velocidade de 1 tick a partir da ancora", kid.x - ax - 5 * PX, 2 * PX);
+        }
+
+        // ---- duracao: a task morre no tick em que o ANO passa do sync e _KillObj tira o objeto antes do desenho
+        {
+            CharData ch = chrEv(new int[]{0, 1, 0, 20, 21, 0, 0, 0});
+            BattleSim s = sim(ch, atkDac(new int[]{20, 0, 0, 0, 0}), fxDac());
+            for (int i = 0; i < 9; i++) s.step();
+            check("viva ate o tick anterior ao fim", s.cutsceneCount() + ":" + fxLayers(s), "1:1");
+            s.step();
+            check("no tick do fim ja nao e desenhada", s.cutsceneCount() + ":" + fxLayers(s), "0:0");
+        }
+
