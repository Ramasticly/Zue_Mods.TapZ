+    // ---- auras / bolhas (hitbox flags 10-17, 41-70, 71-125)
+
+    private void updateAuras() {
+        AttackSim.Obj r = atk.root();
+        // chaves ativas no frame atual (so a raiz, como o jogo)
+        java.util.LinkedHashMap<Integer, Ano.Hit> active = new java.util.LinkedHashMap<Integer, Ano.Hit>();
+        if (r != null && (r.objFlags & 1) == 0 && !hidden[0]) {
+            for (int i = 0; i < r.hits.length; i++) {
+                int f = r.hits[i].flag;
+                boolean ok = (f >= 10 && f <= 17) || (f >= 41 && f <= 70) || (f >= 71 && f <= 125);
+                if (ok) active.put(Integer.valueOf(f), r.hits[i]);                 // AuraPosition recebe o ultimo hit com a mesma flag
+            }
+        }
+        for (int i = auras.size() - 1; i >= 0; i--) {
+            if (!active.containsKey(Integer.valueOf(auras.get(i).key))) auras.remove(i);
+        }
+        if (r == null) return;
+        int fl = (r.actFlags & 48) ^ (r.objFlags & 48);
+        for (java.util.Map.Entry<Integer, Ano.Hit> e : active.entrySet()) {
+            int f = e.getKey().intValue();
+            Ano.Hit h = e.getValue();
+            int ox = (fl & 16) != 0 ? -h.x : h.x;
+            int x = r.x + (ox << 16);
+            int y = r.y + (h.y << 16);
+            Aura a = null;
+            for (int i = 0; i < auras.size(); i++) if (auras.get(i).key == f) { a = auras.get(i); break; }
+            if (a != null) {
+                AttackSim.Obj o = a.sim.root();
+                if (o != null) { o.x = x; o.y = y; }
+                applyFlip(a.sim, auraFlip(a.owner, r, o));
+                a.sim.step(hsAtk > 0 || stunAny());
+                consumeSe(a.sim, 0);
+                continue;
+            }
+            Dac dac;
+            int ano, owner;
+            if (f <= 17) { dac = fxDac; ano = 50 + f - 10; owner = OWNER_AURA_EFFECT; }
+            else if (f <= 70) { dac = charfDac; ano = f - 41 + 3; owner = OWNER_AURA_CHARF; }
+            else { dac = atkDac; ano = 201 + f - 71; owner = OWNER_AURA_CHAR; }
+            if (dac == null) continue;
+            Ano an = dac.getAno(ano);
+            if (an == null || !an.present) continue;
+            a = new Aura();
+            a.key = f;
+            a.owner = owner;
+            a.sim = new AttackSim(dac, ano, false, x, y);
+            a.sim.clearPause = true;
+            applyFlip(a.sim, auraFlip(owner, r, a.sim.root()));
+            auras.add(a);
+            consumeSe(a.sim, 0);
+        }
+    }
