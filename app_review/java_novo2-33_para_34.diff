+    private int overrideSlot = -1;
+    private ReactionTable overrideTable;
+
+    /** Previa de candidata: o slot {@code slot} (0..19) de reacao do personagem passa a usar {@code t} nesta simulacao, sem tocar no personagem. */
+    public void overrideCharReaction(int slot, ReactionTable t) {
+        overrideSlot = t == null ? -1 : slot;
+        overrideTable = t;
+    }
+
+    private ReactionTable table(boolean charSrc, int type) {
+        if (charSrc && type == overrideSlot && overrideTable != null) return overrideTable;
+        return charSrc ? atkChar.reaction(type) : (gd == null ? null : gd.reaction(type));
+    }
