+    private void dupRow() {
+        final ReactionTable t = table();
+        final int row = sel;
+        view.editReaction(type, new Runnable() { public void run() { t.duplicateRow(row); } });
+        sel = row + 1;
+        onChanged.run();
+        refresh();
