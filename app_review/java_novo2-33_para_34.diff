+    /** x do mapa em que a tela comeca/termina e as bordas do mapa (para desenhar). */
+    /** Topo da tela em coordenadas do mundo (16.16): -240 px, subindo |iBackYPos| quando os lutadores estao no ar. */
+    public int screenTop() { return edgeMode == 0 ? -15728640 : -15728640 + camYFix; }
+
+    /**
+     * Port do md 19/3 (vertical): iBackYOffset = media da altura dos dois (cada uma no maximo 240 px abaixo do chao);
+     * iBackYPos = (offset < -40) ? offset*2/3 + 13 : 0, nunca positivo. A tela sobe esse tanto.
+     */
+    /** BackShakePos do jogo: 3 tipos (flags 3..5) x 7 passos; indexado por tipo*7 + iBackShake/2. */
+    private static final int[] SHAKE_POS = {-1, -1, 0, 0, -3, -3, 0, -2, -2, 0, 0, -6, -6, 0, -3, -3, 0, 0, -9, -9, 0};
+    private int camShake, camShakeType, lastOppSerial = -1;
+    private AttackSim.Obj lastOppObj;
+
+    /** CheckOptFlag do jogo (todo tick): hit com flag 3..5 => iBackShakeType = flag-3, iBackShake = 12. */
+    private void shakeFlags(AttackSim.Obj o, int player) {
+        if (o == null || optAbort(o, player)) return;
+        for (int i = 0; i < o.hits.length; i++) {
+            int f = o.hits[i].flag;
+            if (f >= 3 && f <= 5) { camShakeType = f - 3; camShake = 12; }       // o ultimo hit 3-5 do frame vale
+        }
+    }
