+    /** ANO de projetil aberto sozinho no editor (md 970/971): a raiz e o projetil, nao o personagem. */
+    private boolean projRoot() { return move != null && move.generic && move.rootKind == CharData.Move.ROOT_PROJ; }
+
+    /** ANO de efeito/aura aberto sozinho (md 965/977). */
+    private boolean effectRoot() { return move != null && move.generic && move.rootKind == CharData.Move.ROOT_EFFECT; }
+
+    /**
+     * Chao do projetil (md 971, jogo:24569+): ao tocar o chao troca para PROJETIL_COLISAO_CHAO (SUBPROJETIL_COLISAO_CHAO no sub-projetil) se
+     * houver e o ANO atual for outro; senao segue como esta. Sempre limita y ao chao, sem zerar a velocidade, sem som de pouso e sem POUSO/QUEDA.
+     */
+    private void projFloor(AttackSim.Obj r) {
+        if (r.y <= 0) return;
+        int cur = r.ano.index;
+        int ground = move.animInicial == move.subId && move.subId != 0 ? move.subChao : move.projChao;
+        if (ground != 0 && ground != cur && switchAtk(ground)) {
+            lastHit += " -> CHAO " + ground;
+            AttackSim.Obj nr = atk.root();
+            if (nr != null && nr.y > 0) nr.y = 0;
+            return;
+        }
+        r.y = 0;
+    }
