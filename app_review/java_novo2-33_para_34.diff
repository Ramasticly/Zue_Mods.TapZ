+    public void changeMpt(final int pat, Ano.Mpt m) {
+        final Ano a = currentAno();
+        if (a == null || pat < 0 || pat >= a.mpts.length) return;
+        m.normalize();
+        final Ano.Mpt prev = a.mpts[pat];
+        a.mpts[pat] = m;
+        pushUndo("m:" + a.index + ":" + pat, UndoEdits.swapMpts(a, new int[] {pat}, new Ano.Mpt[] {prev}));
+        editVersion++;
+        rebuild(frame);
+    }
+
+    /** Troca varios MPTs de uma vez (um unico desfazer e uma unica reconstrucao). */
+    public void changeMpts(final int[] pats, Ano.Mpt[] ms) {
+        final Ano a = currentAno();
+        if (a == null || pats.length == 0) return;
+        final Ano.Mpt[] prev = new Ano.Mpt[pats.length];
+        for (int i = 0; i < pats.length; i++) {
+            if (pats[i] < 0 || pats[i] >= a.mpts.length) return;
+            prev[i] = a.mpts[pats[i]];
+        }
+        for (int i = 0; i < pats.length; i++) { ms[i].normalize(); a.mpts[pats[i]] = ms[i]; }
+        pushUndo("r:" + a.index + ":" + pats[0] + ":" + pats.length, UndoEdits.swapMpts(a, pats, prev));
+        editVersion++;
+        rebuild(frame);
+    }
