+    /** Primeiro tick em que o atacante esta no frame {@code pat} da ANO {@code anoIdx}, ou -1. */
+    public int firstTickOf(int anoIdx, int pat, int max) {
+        BattleSim s = fresh();
+        for (int t = 0; t <= max; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r != null && r.ano.index == anoIdx && r.pat == pat) return t;
+            s.step();
+        }
+        return -1;
+    }
+
+    /**
+     * Primeiro tick da simulacao de cada ponto (pat, elapsed) do atacante na ANO {@code anoIdx}, numa unica passada (elapsed = ticks do frame
+     * ja decorridos; {@code durations[pat]} = ticks do frame). Os ticks da timeline sao so os dos frames: ticks que so a simulacao tem (hitstop...)
+     * repetem o mesmo ponto e valem o primeiro. -1 = esse ponto nunca ocorre.
+     */
+    public int[][] firstTicksElapsed(int anoIdx, int[] durations, int max) {
+        int[][] out = new int[durations.length][];
+        for (int i = 0; i < out.length; i++) { out[i] = new int[Math.max(1, durations[i])]; java.util.Arrays.fill(out[i], -1); }
+        BattleSim s = fresh();
+        for (int t = 0; t <= max; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r != null && r.ano.index == anoIdx && r.pat >= 0 && r.pat < out.length) {
+                int dur = durations[r.pat];
+                int el = dur <= 0 ? 0 : dur - r.time;
+                if (el >= 0 && el < out[r.pat].length && out[r.pat][el] < 0) out[r.pat][el] = t;
+            }
+            s.step();
+        }
+        return out;
+    }
+
+    /** Primeiro tick de cada frame (pat) da ANO {@code anoIdx}, numa unica passada; -1 = nunca aparece. */
+    public int[] firstTicks(int anoIdx, int frames, int max) {
+        int[] out = new int[frames];
+        java.util.Arrays.fill(out, -1);
+        BattleSim s = fresh();
+        for (int t = 0; t <= max; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r != null && r.ano.index == anoIdx && r.pat >= 0 && r.pat < frames && out[r.pat] < 0) out[r.pat] = t;
+            s.step();
+        }
+        return out;
+    }
