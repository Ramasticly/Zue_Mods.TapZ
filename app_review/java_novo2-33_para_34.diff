+    private void stepDefender() {
+        if (!inDamage && guardActive) { stepGuard(); return; }
+        if (!inDamage) {
+            AttackSim.Obj r = opp.root();
+            if (r != null) {
+                r.x = oppX;
+                r.y = oppY;
+                opp.step(false);
+                oppX = r.x;
+                oppY = r.y;
+                consumeSe(opp, 1);
+                if (endAnim >= 0 && (r.isDone() || r.isHolding())) {
+                    if (dead) endAnim = -1;         // fica no ultimo frame da ANO 24
+                    else { endAnim = -1; setOppAct(0); }
+                }
+            }
+            return;
+        }
+        tickDamage(0);
+    }
