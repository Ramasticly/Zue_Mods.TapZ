+
+    private void delRow() {
+        final ReactionTable t = table();
+        if (t.rows <= 1) { I18nUi.toast(c, "A reação precisa de ao menos um passo", android.widget.Toast.LENGTH_SHORT).show(); return; }
+        final int row = sel;
+        view.editReaction(type, new Runnable() { public void run() { t.removeRow(row); } });
+        onChanged.run();
+        refresh();
+    }
+
+    private void moveRow(final int dir) {
+        final ReactionTable t = table();
+        final int from = sel, to = Math.max(0, Math.min(t.rows - 1, from + dir));
+        if (to == from) return;
+        view.editReaction(type, new Runnable() { public void run() { t.moveRow(from, to); } });
+        sel = to;
+        onChanged.run();
+        refresh();
+    }
