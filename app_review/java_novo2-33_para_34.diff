+    private void stepImpl() {
+        ticks++;
+        hiddenDraw[0] = hidden[0];
+        hiddenDraw[1] = hidden[1];
+        AttackSim.Obj rd = atk.root();
+        if (rd != null && rd.isDone()) { if (doneSince < 0) doneSince = ticks - 1; } else doneSince = -1;
+        if (cineLeft > 0) {
+            // md 926: o jogador nao passa por PlayerTail (sem ActReq) e o oponente fica em md 925:
+            // todo mundo congelado; so o cenario/efeito (task 965) continua.
+            cineLeft--;
+            if (cineLeft == 0) oppHold = 11;          // task 924: o atacante ainda esta em md 928 neste tick; conta 10 ticks em 881 e solta no seguinte
+            pinStunned();                            // PlayerTail do oponente (md 925) ainda faz _SetXY
+            stepCuts();                              // as tasks (cutscenes da flag 20) continuam rodando
+            camera();                                // md 19/3 sao tasks proprias: a camera segue rodando durante a trava
+            if (camShake != 0) camShake--;
+            updateCamY();
+            zoomTick();                              // md 29: o zoom da trava (200 %) e a volta a 100 % continuam rodando
+            for (int i = fxs.size() - 1; i >= 0; i--) {
+                Fx f = fxs.get(i);
+                stepFx(f);
+                if (f.sim.root() == null || f.sim.root().isDone()) fxs.remove(i);
+            }
+            syncScreenCuts();
+            return;
+        }
+        if (oppHold >= 0) {                          // task 924 (prio 13066): roda antes de todo o resto do tick
+            if (oppHold == 0) { oppHold = -1; stunned[1] = false; } else oppHold--;
+        }
+        detect();                                    // hit do tick anterior: o ANO troca no PlayerTail do tick seguinte (jogo: T+13)
+        applyPendingMoves();                         // teleporte (flags 39/40, mapas 13-15) so aparece no PlayerTail do tick seguinte
+        // 1. atacante
+        AttackSim.Obj r0 = atk.root();
+        atkFrozen = extendTime && !idleMode && r0 != null && r0.isDone() && !atk.hasWrapped() && grounded(r0);
+        if (atkFrozen && lockFromTick < 0 && r0.ano.index != 0 && !projRoot() && !effectRoot()) {
+            Ano idle = atkDac.getAno(0);
+            if (idle != null && idle.present) {
+                preIdle = physHold != null ? physHold : atk;
+                atk = new AttackSim(atkDac, 0, atkLeft, r0.x, r0.y);
+                atk.rebaseLinks = true; atk.clearPause = true;
+                idleMode = true;
+                lastSerial = -1;
+                spawnedSerial = -1;
+                armed = false;
+                atkFrozen = false;
+            }
+        }
+        if (stunned[0]) {
+            // md 925: o PlayerTail roda sem _ActReq (parado, mas com _SetXY); projeteis, auras e agarrao nao andam
+            pinStunned();
+        } else if (atkFrozen) {
+            updateAuras();
+        } else {
+            atk.step(hsAtk > 0);
+            clampAttacker();
+            tryPull();
+            checkEnd();
+            checkAttackOver();
+            updateAuras();
+            afterAtkFrame();
+            consumeSe(atk, 0);
+        }
+        // 2. projeteis
+        for (int i = 0; i < projs.size(); i++) stepProj(projs.get(i));
+        for (int i = projs.size() - 1; i >= 0; i--) if (projs.get(i).dead) projs.remove(i);
+        // 3. defensor
+        if (!stunned[1]) stepDefender(); else pinStunned();
+        stepGrab();                                   // md 939-941 (13696): depois dos lutadores e dos projeteis
+        defShaking = !stunned[1] && inDamage && !dCharSrc && hsDef > 0 && ((hsDef & 3) == 1 || (hsDef & 3) == 3);
+        oppFrameFlags();
+        endPhase();
+        // 4. efeitos
+        for (int i = fxs.size() - 1; i >= 0; i--) {
+            Fx f = fxs.get(i);
+            stepFx(f);
+            if (f.sim.root() == null || f.sim.root().isDone()) fxs.remove(i);
+        }
+        // 5. hitstop (a deteccao roda no INICIO do proximo tick, como o PlayerTail do jogo)
+        if (hsAtk > 0) hsAtk--;
+        if (hsDef > 0) hsDef--;
+        for (int i = 0; i < projs.size(); i++) if (projs.get(i).hs > 0) projs.get(i).hs--;
+        if (grabHs > 0) grabHs--;
+        syncScreenCuts();
+        settleFighters();
+    }
