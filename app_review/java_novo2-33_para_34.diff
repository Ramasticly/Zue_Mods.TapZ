+    private boolean switchAtk(int ano) {
+        if (probe) return false;
+        if (lockFromTick >= 0 && ticks > lockFromTick && !(landingOn && (transKind == 3 || transKind == 4))) return false;
+        AttackSim.Obj r = atk.root();
+        Ano a = atkDac.getAno(ano);
+        if (r == null || a == null || !a.present) return false;
+        Trans tr = new Trans();
+        tr.tick = ticks; tr.fromAno = r.ano.index; tr.fromPat = Math.max(0, r.pat); tr.toAno = ano; tr.kind = transKind;
+        trans.add(tr);
+        if ((transKind == 3 || transKind == 4) && physHold == null && !idleMode) physHold = atk;
+        transKind = -1;
+        atk = new AttackSim(atkDac, ano, atkLeft, r.x, r.y);
+        atk.rebaseLinks = true; atk.clearPause = true;
+        lastSerial = -1;
+        spawnedSerial = -1;
+        armed = false;
+        afterAtkFrame();
+        consumeSe(atk, 0);
+        return true;
+    }
