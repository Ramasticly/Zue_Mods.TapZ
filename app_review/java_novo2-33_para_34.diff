+    private void setProjAct(Proj p, int ano) {
+        AttackSim.Obj o = p.sim.root();
+        p.sim = new AttackSim(atkDac, ano, p.flip, o.x, o.y);
+        p.sim.clearPause = true;
+        p.lastSerial = -1;
+        p.spawnedSerial = -1;
+    }
+
+    private void stepProj(Proj p) {
+        if (p.main && p.runs == 0 && p.bornTick == ticks) return;      // _TaskMake com prio menor que a task atual: roda a partir do proximo tick
+        boolean firstRun = p.runs++ == 0;                                // 1a execucao (md 970 -> 971): _ActReq so carrega o frame 0
+        p.life++;
+        AttackSim.Obj o = p.sim.root();
+        if (o == null || ((o.actFlags & 2) != 0 && !o.holdLast) || p.life > 1200
+                || Math.abs(o.x >> 16) > 3000 || Math.abs(o.y >> 16) > 3000) {
+            p.dead = true;
+            return;
+        }
+        if (p.hitFlag && !p.hitOnce) p.hitOnce = true;
+
+        if ((p.hitFlag && (move.flags & 1) == 0) || o.y > 0) {
+            boolean hit = p.hitFlag;
+            p.hitFlag = false;
+            int cur = o.ano.index;
+            boolean globalOk = !inDamage || (hit && globalHitAnimOnHit);
+            if (cur != p.globalAno && p.globalAno != 0 && globalOk) {
+                setProjAct(p, p.globalAno);
+                p.hitAnim = false;
+            } else if (cur != p.groundAno && o.y > 0 && p.groundAno != 0) {
+                setProjAct(p, p.groundAno);
+                p.hitAnim = false;
+            }
+            if (p.hitAnim) {
+                if (p.hitAno == 0) {
+                    p.dead = true;
+                    return;
+                }
+                if (p.sim.root().ano.index != p.hitAno) setProjAct(p, p.hitAno);
+            }
+            o = p.sim.root();
+            if (o.y > 0) o.y = 0;
+        }
+
+        boolean frozen = p.hs > 0 || stunAny();      // md 925 de qualquer jogador pausa o projetil (wActFlag |= 4); so o DONO em dano descongela (nunca no simulador)
+
+        // homing (HOMING == 0): persegue o oponente depois que comecou a se mover e ate o primeiro hit
+        if (!frozen && !firstRun && move.homing == 0) {
+            int spd = move.homingSpeed;
+            if (!p.flagged && p.moved) {
+                boolean right = (o.objFlags & 16) == 0;
+                AttackSim.Obj ar = atk.root();
+                int tx;
+                if (right && oppX < o.x) tx = ar.x + 31457280;
+                else if (!right && oppX > o.x) tx = ar.x - 31457280;
+                else tx = oppX;
+                int deg = GameTables.atan512(tx - o.x, o.y - oppY) * 360 / 512;
+                int cos = SIN[(deg + 90) % 360];
+                int sin = SIN[deg % 360];
+                o.x += (cos * spd << 16) / 64;
+                o.y -= (sin * spd << 16) / 32;
+            }
+        }
+        if (!p.haveFirstX) {
+            p.haveFirstX = true;
+            p.firstX = o.x;
+        }
+        if (p.firstX != o.x) p.moved = true;
+
+        if (!firstRun) p.sim.step(frozen);
+        o = p.sim.root();
+        if (o != null) {
+            if (o.x == p.stillX && o.y == p.stillY && o.frozenOnLast()) p.still++; else p.still = 0;
+            p.stillX = o.x; p.stillY = o.y;
+        }
+        consumeSe(p.sim, 0);
+
+        if (o.serial != p.lastSerial) {
+            p.lastSerial = o.serial;
+            p.armed = o.hits.length > 0;
+        }
+
+        if (!frozen) {
+            // md 971: sem anim de impacto o projetil so some quando o DONO esta em dano (md 876/877),
+            // o que nunca acontece aqui. O oponente em dano NAO remove o projetil.
+            if (p.spawnedSerial != o.serial) {
+                p.spawnedSerial = o.serial;
+                for (int i = 0; i < o.hits.length; i++) {
+                    if (o.hits[i].flag == 0) spawnSub(p, o, o.hits[i]);
+                }
+                if (!optAbort(o, 0)) {                                           // md 971 tambem chama CheckOptFlag (so fora da pausa)
+                    teleportFlags(o, 0, 0);
+                    if (cutscenes) cutsceneFlags(o, 0, p);
+                }
+            }
+        }
+    }
