+            Bitmap full = lib.cut(i);
+            if (full != null) {
+                float s = Math.min(1f, 96f / Math.max(full.getWidth(), full.getHeight()));
+                tb = s >= 1f ? full : Bitmap.createScaledBitmap(full, Math.max(1, (int) (full.getWidth() * s)), Math.max(1, (int) (full.getHeight() * s)), true);
+                if (tb != full) full.recycle();
+                thumbs.put(Integer.valueOf(i), tb);
+            }
+        }
+        return tb;
+    }
+
+    /** Substitui a SPR_{@code dstIdx} do personagem pela sprite {@code srcIdx} do CNV de outro pac (ampliada se a escala for menor). */
+    private static void replaceWith(final Activity a, final SpriteLib src, final SpriteLib target, final int srcIdx, final int dstIdx, final int factor, final Runnable uiOnly) {
+        final BusyDialog busy = BusyDialog.show(a, "Substituindo sprite");
+        busy.set("SPR_" + srcIdx, 0, 0);
+        new Thread(new Runnable() {
+            @Override public void run() {
+                String err = null;
+                Bitmap b = null;
+                try {
+                    b = src.cut(srcIdx);
+                    if (b == null) { String why = src.cutProblem(srcIdx); err = why != null ? why : "o recorte nao gerou imagem"; }
+                    else {
+                        if (factor > 1) {
+                            Bitmap big = Bitmap.createScaledBitmap(b, b.getWidth() * factor, b.getHeight() * factor, false);
+                            b.recycle();
+                            b = big;
+                        }
+                        target.replace(dstIdx, b);
+                        busy.set("Gravando as folhas de sprites...", 0, 0);
+                        target.commit();
+                    }
+                } catch (Throwable t) {
+                    err = t.getMessage() == null ? t.toString() : t.getMessage();
+                } finally {
+                    if (b != null && !b.isRecycled()) b.recycle();
+                    src.release();
+                }
+                busy.dismiss();
+                final String fe = err;
+                a.runOnUiThread(new Runnable() {
+                    @Override public void run() {
+                        uiOnly.run();
+                        if (fe != null) {
+                            java.util.ArrayList<String> l = new java.util.ArrayList<String>();
+                            l.add("SPR_" + srcIdx + " -> SPR_" + dstIdx + ": " + fe);
+                            ErrorListDialog.show(a, "Erro ao substituir a sprite", l);
+                        } else SpriteListScreen.toast(a, "SPR_" + dstIdx + " substituida");
+                    }
+                });
+            }
+        }).start();
+    }
+
+    /** Recorta cada sprite marcada da origem, amplia se preciso e adiciona ao personagem; grava as folhas uma vez no fim. */
+    private static void addAll(final Activity a, final SpriteLib src, final SpriteLib target, final List<Integer> chosen, final int factor, final Runnable uiOnly) {
+        final BusyDialog busy = BusyDialog.show(a, "Adicionando sprites");
+        final int first = target.count();
+        new Thread(new Runnable() {
+            @Override public void run() {
+                int added = 0, bad = 0;
+                final java.util.ArrayList<String> fails = new java.util.ArrayList<String>();
+                final int total = chosen.size();
+                for (int k = 0; k < total; k++) {
+                    int idx = chosen.get(k).intValue();
+                    busy.set("SPR_" + idx, k, total);
+                    Bitmap b = null;
+                    try {
+                        b = src.cut(idx);
+                        if (b == null) { bad++; String why = src.cutProblem(idx); fails.add("SPR_" + idx + ": " + (why != null ? why : "o recorte nao gerou imagem")); continue; }
+                        if (factor > 1) {
+                            Bitmap big = Bitmap.createScaledBitmap(b, b.getWidth() * factor, b.getHeight() * factor, false);   // sem suavizar: pixel art
+                            b.recycle();
+                            b = big;
+                        }
+                        target.add(b);
+                        added++;
+                    } catch (Throwable t) {
+                        bad++;
+                        fails.add("SPR_" + idx + ": " + (t.getMessage() != null ? t.getMessage() : t.toString()));
+                    } finally {
+                        if (b != null && !b.isRecycled()) b.recycle();
+                    }
+                }
+                src.release();
+                busy.set("Gravando as folhas de sprites...", 0, 0);
+                try { target.commit(); } catch (Exception ex) { fails.add("gravar as folhas: " + (ex.getMessage() != null ? ex.getMessage() : ex.toString())); }
+                busy.dismiss();
+                final int fa = added, fb = bad;
+                a.runOnUiThread(new Runnable() {
+                    @Override public void run() {
+                        uiOnly.run();
+                        SpriteListScreen.toast(a, fa + " sprite(s) adicionada(s)" + (fa > 0 ? " (SPR_" + first + " a SPR_" + (first + fa - 1) + ")" : "")
+                                + (fb > 0 ? ", " + fb + " falharam" : "")
+                                + (target.downscaled > 0 ? ". " + target.downscaled + " reduzida(s) para no maximo " + SpriteLib.MAX_SIDE + " px" : ""));
+                        target.downscaled = 0;
+                        if (!fails.isEmpty()) ErrorListDialog.show(a, "Erro ao adicionar sprites", fails);
+                    }
+                });
+            }
+        }).start();
+    }
+}
