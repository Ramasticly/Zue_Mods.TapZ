+            check("todas as citacoes jogo:N cabem no arquivo do jogo (" + maxLine + " <= " + src.size() + ")", maxLine <= src.size(), true);
+            String[][] defs = {{"boolean CommonNormal", "CommonNormal"}, {"CheckOptFlag", "CheckOptFlag"}, {"StartPlayerAttack", "StartPlayerAttack"}, {"_ActReqMain", "_ActReqMain"},
+                    {"DamageChange", "DamageChange"}, {"void AttackEnd", "AttackEnd"}, {"PlayerTail", "PlayerTail"}, {"DamageEnd", "DamageEnd"}, {"CheckObjHit", "CheckObjHit"}, {"BulletAction", "BulletAction"}};
+            StringBuilder gone2 = new StringBuilder();
+            StringBuilder all = new StringBuilder();
+            for (String l : src) all.append(l).append('\n');
+            for (String[] d : defs) if (!all.toString().contains(d[0]) || !sec15.contains(d[1])) gone2.append(d[0]).append("; ");
+            check("nomes reais do motor existem no codigo do jogo e na secao 15 " + gone2, gone2.length(), 0);
+            // cada \"jogo:N\" colado a um nome de metodo do jogo (CommonNormal, StartPlayerAttack...) aponta para linha dentro de um metodo com esse nome nas proximidades
+            java.util.regex.Matcher mm = java.util.regex.Pattern.compile("`(CheckOptFlag|CheckObjHit|DamageChange|DamageEnd|AttackEnd)`[^`\\n]{0,25}?jogo:(\\d+)").matcher(sec15);
+            int checked = 0, wrong = 0;
+            StringBuilder wrongList = new StringBuilder();
+            while (mm.find()) {
+                int line = Integer.parseInt(mm.group(2));
+                boolean near = false;
+                for (int k = Math.max(1, line - 400); k <= Math.min(src.size(), line + 40) && !near; k++) near = src.get(k - 1).contains(mm.group(1));
+                checked++;
+                if (!near) { wrong++; wrongList.append(mm.group(1)).append("@").append(line).append(' '); }
+            }
+            check("citacoes de metodos do jogo (" + checked + ") caem perto do metodo citado " + wrongList, wrong, 0);
+        }
