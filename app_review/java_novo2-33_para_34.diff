+    public int screenLeft() { return edgeMode == 0 ? -SCREEN_FULL / 2 : camLeft + camXOff; }
+    public int screenRight() { return screenLeft() + SCREEN_W; }
+    public int mapLeft() { return camLeft - camBase; }
+    public int mapRight() { return camLeft - camBase + MAP_BASE_MAX + SCREEN_W; }
