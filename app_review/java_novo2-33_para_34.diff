+++ b/AiHelp.java	2026-10-24 22:23:41.568778628 +0000
@@ -0,0 +1,183 @@
+package com.zue.attackeditor;
+
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Monta o TBRHelp.md ("Ajuda de IA"): um Markdown em ingles, escrito para uma IA, que o usuario envia a ela para depois perguntar como criar ou
+ * editar ataques. O texto fixo esta em {@link AiHelpDoc}; aqui entram os trechos gerados pelo proprio app (exemplos de DAC / HDAT / reacao / CNV
+ * lidos e escritos pelos mesmos conversores, tabela do HDAT 4, grupos de reacao, limites do jogo) e o anexo com a ajuda do app (HelpText).
+ * Java puro, determinístico.
+ */
+final class AiHelp {
+    private AiHelp() { }
+
+    /** Nome do arquivo gravado em Download/. */
+    static final String FILE_NAME = "TBRHelp.md";
+
+    // ---- exemplos (entrada -> leitor -> escritor do app) ----
+
+    private static final String SAMPLE_ANO =
+            "$ANO_5: {\n   $PRIO: 3,\n   $LNKS:{\n      $LINK_0: {$BX: 0, $BY: -20, $SYNC{SPAWN_POS: YES, XY: YES, MPT: NOT}, $ANO: 230},\n   },\n   $MPTS:{\n"
+            + "      $MPT_0:{ $TIME: 4, $IMG: 12, $MID:[8, 40],\n         $HITS:{ $HT_0:{$FLAG: 1, $COORDS: [-10,-60,20,60]}, },\n      },\n"
+            + "      $MPT_1:{ $TIME: 6, $IMG: 13, $WACTFLAG: 64, $SE: 81,\n         $MOVE:{$XSPEED: 2.5, $XACCEL: 0.25, },\n"
+            + "         $HITS:{ $HT_0:{$FLAG: 1, $COORDS: [-10,-60,20,60]}, $HT_1:{$FLAG: 2, $COORDS: [10,-50,40,20]}, $HT_2:{$FLAG: 0, $COORDS: [30,-40,0,0]}, },\n"
+            + "         $OPT:{$FLAG: 0, $DATA: B[12,52,0,0]},\n      },\n"
+            + "      $MPT_2:{ $TIME: 5, $IMG: 14,\n         $RAZ:{$ROT: 15, $ALPHA: 0, $XZOOM: 100, $YZOOM: 100},\n      },\n   },\n},";
+
+    private static final String SAMPLE_CNV = "$SPR_0:{$src:0, $x:0, $y:0, $w:128, $h:192}, $SPR_1:{$src:0, $x:128, $y:0, $w:96, $h:160},";
+
+    /** Texto do ANO de exemplo ja relido e reescrito pelo conversor do app (cai no texto cru se algo falhar). */
+    static String sampleAno() {
+        String body;
+        try { body = DacText.ano(DacText.parseAno(SAMPLE_ANO, 5, null), -1); } catch (Exception e) { body = SAMPLE_ANO; }
+        return "DAC_ACT_ {\n" + Saver.indent(body) + "\n   // ... the other ANOs ...\n}";
+    }
+
+    static String sampleGolpe() {
+        CharData.Move m = new CharData.Move();
+        m.animInicial = 5;
+        m.projNormal = 21;
+        m.animSeqChao = 6;
+        m.animEndChao = 7;
+        m.animSeqAr = 8;
+        m.animEndAr = 7;
+        return DacText.move(m, 2);
+    }
+
+    static String sampleReaction() {
+        byte[] rows = new byte[2 * ReactionTable.STRIDE];
+        int[][] r = {{6, 9, 3, 10, 0, 0, 0, 10, 0, 0, 0, 0, 0, 0}, {4, 5, 4, -1, 0, 2, 0, -1, 0, 2, 0, 0, 0, 9}};
+        for (int i = 0; i < r.length; i++) for (int c = 0; c < ReactionTable.STRIDE; c++) rows[i * ReactionTable.STRIDE + c] = (byte) r[i][c];
+        return "// slot 3 of the character = HDAT 17\n" + Saver.reactionText(new ReactionTable(rows, 0), 3).replaceAll("\\s+$", "");
+    }
+
+    static String sampleCnv() {
+        try {
+            Cnv c = Cnv.fromTxt(SAMPLE_CNV, true);
+            if (c != null) return c.toTxt().replaceAll("\\s+$", "");
+        } catch (Exception e) { /* texto cru abaixo */ }
+        return "CNV_TXT_ {\n   " + SAMPLE_CNV + "\n}";
+    }
+
+    // ---- tabelas geradas ----
+
+    /** Descricao de cada campo do HDAT 4, na ordem de {@link DacText#MOVE_KEYS}. */
+    static final String[] MOVE_DOC = {
+        "Option bits (table below). Sum the bits you want.",
+        "The ANO that starts the move.",
+        "Projectile ANO when the opponent is at about the same height as the attacker (0 = none). With TRIPLE (4) the ANOs +1 and +2 are thrown too.",
+        "Projectile ANO when the **attacker** is far below the opponent (Y difference ≥ 51 px; the attacker is lower).",
+        "Projectile ANO when the **attacker** is far above the opponent (Y difference ≥ 37 px; the attacker is higher).",
+        "Projectile \"global hit\" ANO (projectile-related animation played on a hit; exact trigger not verified — copy from an existing move).",
+        "Projectile ANO played after the projectile hits (its hit/explosion animation).",
+        "Projectile ANO played when the projectile touches the floor.",
+        "Projectile chases the opponent (0 = off).",
+        "Turn speed of the chase.",
+        "Projectile repeat count (> 0 repeats; uses the frame window 512, so the move cannot also grab).",
+        "Sub-projectile ANO (spawned by a flag-0 hit inside a projectile ANO).",
+        "Sub-projectile ANO after it hits.",
+        "Sub-projectile ANO when it touches the floor.",
+        "SEQ_PROJETIL: ANO the attacker switches to when the first hit of a projectile connects (applies to the whole move).",
+        "SEQ on the ground: ANO to go to when a hit connects while the attacker is on the ground.",
+        "END on the ground: ANO to go to on a new hit while in the SEQ ANO (the END ANO has no further transition).",
+        "SEQ in the air: like SEQ on the ground but while airborne.",
+        "END in the air.",
+        "Landing after a MISSED aerial move: ANO to switch to when touching the floor.",
+        "Landing after a CONNECTED aerial move.",
+        "Defender's ANO while being grabbed (grab moves).",
+        "Unknown (offset 44): keep the value of an existing move.",
+        "Unknown (offset 46): keep the value of an existing move.",
+    };
+
+    /** Texto que acompanha o arquivo no compartilhamento, no idioma da interface (o TBRHelp.md em si nao muda). */
+    static String shareMessage() {
+        return I18n.tr("Leia este arquivo (" + FILE_NAME + "): ele descreve o app Attack Editor. Depois responda às minhas perguntas sobre como criar e editar ataques.");
+    }
+
+    /** Titulo da janela de compartilhamento, no idioma da interface. */
+    static String chooserTitle() { return I18n.tr("Enviar " + FILE_NAME + " para uma IA"); }
+
+    /** Byte dentro do registro de 48 bytes do HDAT 4, na ordem de {@link DacText#MOVE_KEYS} (igual ao leitor de CharData). */
+    static final int[] MOVE_BYTE = {0, 2, 4, 34, 36, 38, 6, 40, 26, 28, 30, 18, 20, 42, 32, 10, 12, 14, 16, 8, 22, 24, 44, 46};
+
+    static String hdat4Table() {
+        StringBuilder sb = new StringBuilder("| # | byte offset | `$KEY` | Meaning |\n|---|---|---|---|\n");
+        for (int i = 0; i < DacText.MOVE_KEYS.length; i++)
+            sb.append("| ").append(i).append(" | ").append(MOVE_BYTE[i]).append(" | `").append(DacText.MOVE_KEYS[i]).append("` | ").append(i < MOVE_DOC.length ? MOVE_DOC[i] : "").append(" |\n");
+        sb.append("\nAll values are 16-bit integers (0..32767); the \"byte offset\" column is where the field sits inside the 48-byte HDAT 4 record (the game stores them in its own order, which differs from this text-key order). A value of 0 means \"none\" for ANO fields.");
+        return sb.toString();
+    }
+
+    private static final String[] GROUP_NAMES = {"normal", "alternate sound", "strong", "light", "no effect"};
+
+    static String opt1Groups() {
+        StringBuilder sb = new StringBuilder("| Group | Name | `OPT1` range | Hit effect (effect-pack ANO) | Hit sound | Pushes the defender | Hitstop |\n|---|---|---|---|---|---|---|\n");
+        for (int g = 0; g < GROUP_NAMES.length; g++) {
+            Opt1 o = new Opt1(g * 50);
+            sb.append("| ").append(g).append(" | ").append(GROUP_NAMES[g]).append(" | ").append(g * 50).append("–").append(g * 50 + 49).append(" | ")
+              .append(o.effectAno < 0 ? "none" : String.valueOf(o.effectAno)).append(" | ")
+              .append(o.sound < 0 ? "none" : "se_" + (o.sound < 10 ? "0" : "") + o.sound).append(" | ")
+              .append(o.pushes ? "yes" : "no").append(" | ")
+              .append(o.hitstopMode == 2 ? "none" : o.hitstopMode == 1 ? "half (melee)" : "normal").append(" |\n");
+        }
+        return sb.toString().replaceAll("\\s+$", "");
+    }
+
+    static String limits() {
+        return "| Limit | Value | If exceeded |\n|---|---|---|\n"
+                + "| Boxes (`$HITS`) per frame | " + GameRules.MAX_HITS + " | **fatal** — the game array `hit[50]` (5 numbers per box) overflows and the game closes |\n"
+                + "| Links per ANO | " + GameRules.MAX_LINKS + " | **fatal** — `lnk[13]`; one level only, a link's own links/boxes are ignored |\n"
+                + "| Frames (`$MPT`) per ANO | " + GameRules.MAX_MPTS + " | **fatal** — the DAC stores the count in 1 byte |\n"
+                + "| `$TIME` per frame | " + GameRules.MAX_TIME + " | **fatal** — 1-byte field |\n"
+                + "| `OPT1` (reaction code) with a hitbox | " + GameRules.MAX_OPT1 + " (group 0–4) | **fatal** — the group does not exist |\n"
+                + "| Live projectiles | 8 | the 9th is silently not created |\n"
+                + "| Interpolation (`$OPT` d2) with a next frame that has other box counts | — | **fatal/garbage** — wrong rotation/alpha/zoom or reads garbage |\n"
+                + "| Image index not in the CNV | — | the frame has no drawing (warning) |";
+    }
+
+    // ---- montagem ----
+
+    /** Anexo: o texto da ajuda do app (portugues), fiel, capitulo a capitulo. */
+    static String appendix() {
+        StringBuilder sb = new StringBuilder("## Appendix A — The app's own in-app help (verbatim, Portuguese)\n\n"
+                + "Source text of the AJUDA screen; the UI labels you will see on the user's phone are exactly these. Use it to confirm button names and behaviours.\n\n");
+        for (HelpText.Chapter ch : HelpText.chapters()) {
+            sb.append("### ").append(ch.title).append("\n\n_").append(ch.summary).append("_\n\n");
+            for (HelpText.Section s : ch.sections) sb.append("#### ").append(s.title).append("\n\n").append(s.body).append("\n\n");
+        }
+        return sb.toString();
+    }
+
+    private static String toc(String doc) {
+        StringBuilder sb = new StringBuilder();
+        for (String line : doc.split("\n")) if (line.startsWith("## ")) sb.append("- ").append(line.substring(3)).append('\n');
+        return sb.toString().replaceAll("\\s+$", "");
+    }
+
+    /** O documento completo. {@code buildLabel}: versao do app (so informativo). */
+    static String build(String buildLabel) {
+        StringBuilder sb = new StringBuilder();
+        for (String p : AiHelpDoc.PARTS) sb.append(p);
+        String doc = sb.toString();
+        doc = doc.replace("{{BUILD}}", buildLabel == null ? "unknown" : buildLabel)
+                .replace("{{SAMPLE_ANO}}", sampleAno())
+                .replace("{{SAMPLE_GOLPE}}", sampleGolpe())
+                .replace("{{SAMPLE_REACTION}}", sampleReaction())
+                .replace("{{SAMPLE_CNV}}", sampleCnv())
+                .replace("{{OPT1_GROUPS}}", opt1Groups())
+                .replace("{{HDAT4_TABLE}}", hdat4Table())
+                .replace("{{LIMITS}}", limits());
+        doc = doc.replace("{{TOC}}", toc(doc + "## Appendix A — The app's own in-app help (verbatim, Portuguese)\n"));
+        return doc.replaceAll("\\s+$", "") + "\n\n" + appendix().replaceAll("\\s+$", "") + "\n";
+    }
+
+    /** Linhas do documento que começam com "## " (secoes), para conferir. */
+    static List<String> sectionTitles(String doc) {
+        List<String> out = new java.util.ArrayList<String>();
+        for (String line : doc.split("\n")) if (line.startsWith("## ")) out.add(line.substring(3).trim());
+        return out;
+    }
+
+    static String sizeLabel(String doc) { return String.format(Locale.US, "%.1f KB", doc.getBytes(java.nio.charset.Charset.forName("UTF-8")).length / 1024.0); }
+}
diff -ruN a/AiHelpDoc.java b/AiHelpDoc.java
--- a/AiHelpDoc.java	1970-01-01 00:00:00.000000000 +0000
+++ b/AiHelpDoc.java	2026-10-24 23:27:08.408192868 +0000
@@ -0,0 +1,844 @@
+package com.zue.attackeditor;
+
+/** Texto fixo do TBRHelp.md (gerado a partir de aihelp_src/*.md); os {{MARCADORES}} sao preenchidos por {@link AiHelp}. Nao editar a mao. */
+final class AiHelpDoc {
+    private AiHelpDoc() { }
+
+    static final String[] PARTS = {
+        "# TBR Attack Editor — Reference file for AI assistants (TBRHelp.md)\n" +
+        "\n" +
+        "> Generated by the app itself (\"Ajuda de IA\" button, menu AJUDA). App build: {{BUILD}}.\n" +
+        "\n" +
+        "**Contents**\n" +
+        "\n" +
+        "{{TOC}}\n" +
+        "\n" +
+        "## 0. READ THIS FIRST (instructions addressed to the AI)\n" +
+        "\n" +
+        "**Language.** This file is written in English only because that is convenient for you. It is **not necessarily the user's language**. Detect the language of the user's messages and **always answer in the user's language**. Keep file names, `$KEYS`, flag numbers and code blocks exactly as written here (never translate them).\n" +
+        "\n" +
+        "**Who the user is.** Someone who edits fighting-game characters (moves, animations, projectiles, hit reactions) with the Android app *Attack Editor* (package `com.zue.attackeditor`, \"TBRE\"). The game being edited is the Android fighting game *Tap Battle* (its engine class is `TCBManajer`). The user may be a beginner or may have difficulty with technical language. The user will upload this file once and then ask questions. Typical questions:\n" +
+        "\n" +
+        "- \"How do I make a new attack / combo / projectile / special move?\"\n" +
+        "- \"Where do I save? Why did my change not appear in the game?\"\n" +
+        "- \"How do I test it? What does this warning mean?\"\n" +
+        "- \"What does button X do? What are the limits? Which file do I send you?\"\n" +
+        "\n" +
+        "**Two modes — decide which one the user is in, every time.**\n" +
+        "\n" +
+        "- **Mode A — the user has a question about the app or \"how do I…?\"** (what a button does, where something is, how to test, what a warning means, how to change a number). Teach **only through the app's own functions**: numbered taps with the exact button names, what the user should see after each tap. **Never** teach editing the binaries (`000.dac`, `000.bin`, `000.cnv`) and **never** send the user to the `▲ DADOS / EDITAR` panel (the text tabs and the pencil `✎`) or ask the user to paste text anywhere. If the app has no function for what the user wants, say so honestly instead of inventing a workaround.\n" +
+        "- **Mode B — the user asks you to generate or change an attack** (new move, projectile, combo, animation, reaction). Ask first for the character's `000.dac.txt`, `000.bin.txt` and `000.cnv.txt` (section 4). Return the modified **`.txt` content** following the output contract (section 12). The user puts the `.txt` in the character folder and taps the reload button `↻` in the title bar to load it without restarting the app. Never produce or describe binary files, and never tell the user to paste into `▲ DADOS / EDITAR`.\n" +
+        "\n" +
+        "**How to behave.**\n" +
+        "\n" +
+        "1. Be concrete. Give numbered, short, tap-by-tap steps that use the **exact button names of the app** (they are in capitals in this file, e.g. `SALVAR`, `DIVIDIR`). Say what the user should see after each step.\n" +
+        "2. **Never invent** fields, flags, files or buttons. If something is not in this file, say you are not sure and ask the user for a screenshot or (Mode B) the relevant `.txt` (see section 4). The sections marked *(unknown)* are known gaps: copy values from an existing, working frame/move instead of guessing.\n" +
+        "3. If the request needs data you do not have (the character's `.txt` files), **ask for them first** (section 4). Do not produce a whole move blind.\n" +
+        "4. In Mode B, follow the **output contract** (section 12) exactly: complete `.txt` content in fenced code blocks, each preceded by a one-line instruction saying which file it belongs to, where to put the file and how to test it (`↻`).\n" +
+        "5. Before you answer with data, run the **validation checklist** (section 9). Stay inside the limits; the game **crashes** (closes) when some limits are exceeded.\n" +
+        "6. Prefer the smallest change that achieves the goal. Prefer copying an existing similar move/ANO/frame and editing numbers over creating from zero.\n" +
+        "7. Remind the user to **keep a backup**: the app makes backups in `Tap Battle/TBRE/Backups/` when it transplants a move, and the recommended save mode (separate folder) never touches the original character folder.\n" +
+        "8. You cannot create or edit **images (PNG) or sounds (WAV)** for the user. You can tell them which ones are needed and how to import them with the app (section 11).\n" +
+        "9. The app is tested only by running it; you cannot run it. Tell the user honestly what they must check in the preview.\n" +
+        "\n" +
+        "**Vocabulary (the app uses Portuguese names).** ANO = an animation (a list of frames). MPT / frame / sprite = one frame of an ANO. DAC = the animation file. BIN = the data file (moves, reactions…). CNV = the sprite-cut table. GOLPE = a move (one row of HDAT 4). SEQ = sequence (go to another ANO when a hit connects). END = ANO to go to after a sequence. Reação = hit reaction (what the defender does when hit). Hurtbox = body area; hitbox = attack area. Tick = 1/60 s. \"Runtime\" = the character folder the game reads.\n" +
+        "\n" +
+        "## 1. What the app is and how the user works\n" +
+        "\n" +
+        "*Attack Editor* loads a character's files from the phone, **simulates a whole fight in a preview** (attacker, opponent, projectiles, effects, camera, cutscenes) the same way the game does, and lets the user edit animations, moves, projectiles and hit reactions with a **timeline** (like a video editor) and edit menus. The user then saves, and the game reads the saved text files.\n" +
+        "\n" +
+        "Screen (portrait), top to bottom: title bar (`Attack Editor by Zue Mods`, buttons `↻` reload folders, `PT/EN/ES` language, `AJUDA`); the **top menu** (14 buttons, section 11); `MODO: GOLPES | ANO` and the move/animation selector; a status/warning line; the **preview** (square); the **timeline** with its tool row (`DIVIDIR`, `DUPLICAR`, `EXCLUIR`, `DESFAZER`, tabs `＋` and `#`); a collapsed `▲ DADOS / EDITAR` panel (do not teach it); and the fixed transport bar (`INICIO`, `-1`, play/pause, `+1`, speed). Tapping an item on the timeline opens an **edit drawer** (bottom sheet) over the screen; drag its handle to resize, `Y` saves the height as default, `T` puts the timeline above the menu.\n" +
+        "\n" +
+        "Two modes: **GOLPES** (moves: a move is one row of HDAT 4 with its ANOs, projectiles, sequence and reactions) and **ANO** (play/edit one single animation, ignoring the move around it).\n" +
+        "\n" +
+        "## 2. Files and folders (Android, \"all files access\")\n" +
+        "\n" +
+        "```\n" +
+        "/storage/emulated/0/Tap Battle/\n" +
+        "  assets/\n" +
+        "    charNN/            one folder per character (NN = 2 digits). The game reads this (\"Runtime\").\n" +
+        "      000.dac          binary animations      (never rewritten by the app)\n" +
+        "      000.bin          binary data/HDATs       (never rewritten by the app)\n" +
+        "      000.cnv          binary sprite-cut table (never rewritten by the app)\n" +
+        "      000.dac.txt      readable animations     -> the app WRITES here\n" +
+        "      000.bin.txt      readable data (moves, reactions) -> the app WRITES here\n" +
+        "      000.cnv.txt      readable sprite cuts    -> the app WRITES here\n" +
+        "      NNN.png          sprite sheets (000.png, 001.png, ...) — read-only for the app (kept intact)\n" +
+        "      *.wav            character sounds (ids 80, 81, ... in file-name order)\n" +
+        "    effect/            shared effects pack (dac + cnv + sheets)\n" +
+        "    charfNN/           auxiliary pack (CHARF auras/bubbles)\n" +
+        "    bobjNN/            scenery objects used by cutscenes\n" +
+        "  TBRE/\n" +
+        "    Chars/charNN/      \"separate folder\" saves: a COMPLETE copy of the character with the changes applied, ready to use\n" +
+        "    Backups/           safety copies (e.g. before transplanting a move into another character)\n" +
+        "```\n" +
+        "\n" +
+        "**The `.txt` files win over the binaries.** When loading, the app (and the game build) takes `$ANO_n` blocks from `000.dac.txt`, moves (`$GOLPE_n`) and reactions (`$REACAO_DANO_n`) from `000.bin.txt`, and sprite cuts from `000.cnv.txt` when they exist. ANOs that exist only in the `.txt` (beyond the binary's last ANO) are appended to the animation table. So **a change is delivered as text** and the binaries need not be touched.\n" +
+        "\n" +
+        "To make the app re-read the disk after files were changed outside the app: pick the character again in `CHAR` (or restart the app).\n" +
+        "\n" +
+        "## 3. Text formats (exact grammar; the samples below are generated by the app's own writer and re-read by its own parser)\n" +
+        "\n" +
+        "General syntax of all `.txt` data: `$KEY: value` pairs; blocks are `$KEY: { ... }`; separators are commas or line breaks (trailing commas are fine); `//` starts a comment until end of line; numbers are decimal, `&1F` is hexadecimal (parsed only where a number is read); arrays are `[a, b]` or `B[a, b, c, d]` (bytes). Key names are case-insensitive when read, but write them **in capitals exactly as shown**. Unknown keys inside an ANO/frame are a **parse error** (the app refuses the paste and shows the error with the line).\n" +
+        "\n" +
+        "### 3.1 `000.dac.txt` — animations\n" +
+        "\n" +
+        "The file is `DAC_ACT_ { $ANO_0: {...}, $ANO_1: {...}, ... }`. One block per animation (ANO). An empty/absent ANO is `$ANO_n: { },`.\n" +
+        "\n" +
+        "```\n" +
+        "{{SAMPLE_ANO}}\n" +
+        "```\n" +
+        "\n" +
+        "- `$ANO_n` — `n` is the ANO number (0-based). `$PRIO` (optional) is the draw priority of this ANO. `$LNKS` (optional) = linked animations that spawn together with this one. `$MPTS` = the frames, in order, numbered `$MPT_0`, `$MPT_1`, … consecutively with no gaps.\n" +
+        "- **Frame (`$MPT_i`)** fields (only write the ones you need; `$IMG` is **required**):\n" +
+        "  - `$TIME: t` — duration in ticks (1..255). **Without `$TIME` the frame never advances** (it freezes; the ANO never finishes). Don't omit it unless a frozen frame is intended.\n" +
+        "  - `$IMG: n` — sprite index = entry `$SPR_n` of `000.cnv.txt`. `-1` = no image.\n" +
+        "  - `$MID: [x, y]` — sprite anchor offset in pixels.\n" +
+        "  - `$WACTFLAG: n` — 16-bit state/behaviour flags of the frame. Known bits: **1 = loop back to the first frame when this frame ends**; **16 / 32 = flip X / flip Y**; **64 = keep the speed of the previous frame (instead of resetting to 0)**; 0x2000 (8192) and 0x8000 (32768) = frame/position synchronised with the parent (for linked animations). Other bits *(unknown)*: copy from existing frames.\n" +
+        "  - `$SE: n` — sound id played at the start of the frame (see 5.6).\n" +
+        "  - `$MOVE: { $XSPEED: v, $YSPEED: v, $XACCEL: v, $YACCEL: v }` — movement in **pixels per tick** (decimals allowed, e.g. `2.5`); any subset of the four. Positive X = forward (facing direction), positive Y = down. See 6.2.\n" +
+        "  - `$HITS: { $HT_0: {$FLAG: f, $COORDS: [x, y, w, h]}, ... }` — \"boxes\"/actions of the frame (hitbox, hurtbox, spawn points, effects…); `x,y` relative to the character (x mirrored with facing); `w,h` size. See 5.2. **At most 10 per frame.**\n" +
+        "  - `$OPT: { $FLAG: n, $DATA: B[d0, d1, d2, d3] }` — extra data, see 5.3 (damage, reaction code, interpolation).\n" +
