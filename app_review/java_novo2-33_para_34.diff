diff -ruN a/test/I18nTest.java b/test/I18nTest.java
--- a/test/I18nTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/I18nTest.java	2026-10-24 21:49:36.523786446 +0000
@@ -0,0 +1,86 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Idioma da interface: troca PT/EN/ES, texto exato, modelos {0}, fragmentos por palavra, termos neutros e PT intacto. */
+public class I18nTest {
+    static String[] e(String pt, String en, String es) { return new String[]{pt, en, es}; }
+
+    public static void main(String[] args) throws Exception {
+        List<String[]> cat = new ArrayList<String[]>();
+        cat.add(e("AJUDA", "HELP", "AYUDA"));
+        cat.add(e("Salvar", "Save", "Guardar"));
+        cat.add(e("Salvar golpe atual", "Save current move", "Guardar golpe actual"));
+        cat.add(e("Salvando em {0}", "Saving to {0}", "Guardando en {0}"));
+        cat.add(e("{0} de {1}", "{0} of {1}", "{0} de {1}"));
+        cat.add(e("Reação {0}", "Reaction {0}", "Reacción {0}"));
+        cat.add(e("forte", "strong", "fuerte"));
+        cat.add(e("Golpe", "Move", "Golpe"));
+        cat.add(e("Som", "Sound", "Sonido"));
+        cat.add(e("ANO", "ANO", "ANO"));
+        cat.add(e("transição", "transition", "transición"));
+        cat.add(e("Duração: {0} ticks", "Duration: {0} ticks", "Duración: {0} ticks"));
+        cat.add(e("Tocar", "Play", "Reproducir"));
+        I18n.useEntries(cat);
+        try {
+            I18n.set(I18n.PT);
+            check("PT: nada muda", I18n.tr("Salvando em char01") + "|" + I18n.tr("AJUDA"), "Salvando em char01|AJUDA");
+            check("PT: codigo", I18n.code(), "PT");
+
+            I18n.set(I18n.EN);
+            check("EN: texto exato", I18n.tr("AJUDA"), "HELP");
+            I18n.set(I18n.ES);
+            check("ES: texto exato", I18n.tr("AJUDA"), "AYUDA");
+            I18n.set(I18n.EN);
+            check("espacos nas pontas ficam", "[" + I18n.tr(" AJUDA ") + "]", "[ HELP ]");
+            check("modelo {0}", I18n.tr("Salvando em char01"), "Saving to char01");
+            check("modelo com dois grupos", I18n.tr("3 de 12"), "3 of 12");
+            check("modelo traduz o grupo com letras", I18n.tr("Reação forte"), "Reaction strong");
+            check("modelo vence o fragmento (nome com varias palavras)", I18n.tr("Salvando em minha pasta"), "Saving to minha pasta");
+            check("mais longo primeiro: 'Salvar golpe atual'", I18n.tr("Salvar golpe atual"), "Save current move");
+            check("fragmentos em texto concatenado", I18n.tr("Golpe 3 (forte)"), "Move 3 (strong)");
+            check("fragmento so por palavra inteira (Somente nao vira Sonidoente)", I18n.tr("Somente leitura"), "Somente leitura");
+            check("fragmento de palavra inteira com pontuacao", I18n.tr("Som: 5"), "Sound: 5");
+            check("termo neutro igual nos tres idiomas", I18n.tr("ANO 5"), "ANO 5");
+            check("so numeros e simbolos ficam", I18n.tr("12/40  Δ 3,0") + "|" + I18n.tr(""), "12/40  Δ 3,0|");
+            check("null seguro", I18n.tr(null), null);
+            check("acento e caixa respeitados como no catalogo (transição)", I18n.tr("Bloqueada a transição agora"), "Bloqueada a transition agora");
+            check("modelo com numero", I18n.tr("Duração: 12 ticks"), "Duration: 12 ticks");
+            I18n.set(I18n.ES);
+            check("ES: modelo e fragmento", I18n.tr("Salvando em char02") + "|" + I18n.tr("Golpe 3 (forte)"), "Guardando en char02|Golpe 3 (fuerte)");
+            check("ES: transição", I18n.tr("a transição"), "a transición");
+
+            // idempotencia basica: traduzir de novo o que ja saiu em EN/ES nao estraga
+            I18n.set(I18n.EN);
+            String once = I18n.tr("Golpe 3 (forte)");
+            check("traduzir o resultado de novo nao muda", I18n.tr(once), once);
+
+            // troca de idioma limpa o cache
+            I18n.set(I18n.PT);
+            check("volta ao PT", I18n.tr("Golpe 3 (forte)"), "Golpe 3 (forte)");
+            I18n.set(I18n.EN);
+            check("cache nao vaza entre idiomas", I18n.tr("AJUDA"), "HELP");
+            I18n.set(I18n.ES);
+            check("EN->ES refaz", I18n.tr("AJUDA"), "AYUDA");
+
+            // ciclo
+            I18n.set(I18n.PT);
+            int a = I18n.next(), b = I18n.next(), c = I18n.next();
+            check("ciclo PT>EN>ES>PT", a + "" + b + "" + c, "120");
+            check("fromCode", I18n.fromCode("en") + ":" + I18n.fromCode("ES") + ":" + I18n.fromCode("xx"), "1:2:0");
+            check("trTo nao muda o idioma atual", I18n.trTo("AJUDA", I18n.ES) + ":" + I18n.code(), "AYUDA:PT");
+        } finally {
+            I18n.set(I18n.PT);
+            I18n.useEntries(null);
+        }
+        // o catalogo real carrega e e coerente
+        List<String[]> real = I18n.entries();
+        boolean shape = !real.isEmpty();
+        for (String[] r : real) shape &= r.length == 3 && r[0].length() > 0 && r[1].length() > 0 && r[2].length() > 0;
+        check("catalogo real: toda entrada tem PT/EN/ES nao vazios", shape, true);
+        System.out.println("I18nTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/InterpolationTest.java b/test/InterpolationTest.java
--- a/test/InterpolationTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/InterpolationTest.java	2026-10-30 00:12:06.497578350 +0000
@@ -0,0 +1,33 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** Interpolacao (OPT d2): o frame COM a flag vai ate o proximo; o de antes nao interpola para ele; no ultimo frame o "proximo" e o frame 0. */
+public class InterpolationTest {
+    static int rotAfter(Dac d, int ticks) {
+        AttackSim s = new AttackSim(d, 0, false);
+        for (int i = 0; i < ticks; i++) s.step();
+        return s.root().rot;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // frame 0 (sem rotacao) -> frame 1 (rotacao 450, com $RAZ); a flag no frame 0 faz o frame 0 caminhar para a rotacao do frame 1
+        Dac withFlag = dac(new A().mpt(new M().time(10).interp()).mpt(new M().time(10).raz(450, 0, 100, 100)));
+        int r5 = rotAfter(withFlag, 5);
+        check("frame com a flag interpola para o proximo (rotacao sobe durante o frame 0)", r5 > 0 && r5 < 450, true);
+        Dac noFlag = dac(new A().mpt(new M().time(10)).mpt(new M().time(10).raz(450, 0, 100, 100)));
+        check("sem a flag o frame 0 nao se mexe", rotAfter(noFlag, 5), 0);
+        // a flag no frame DE DEPOIS nao interpola o de antes para ele
+        Dac flagAfter = dac(new A().mpt(new M().time(10)).mpt(new M().time(10).raz(450, 0, 100, 100).interp()).mpt(new M().time(10)));
+        check("o frame de antes nao interpola para o que tem a flag", rotAfter(flagAfter, 5), 0);
+        // ultimo frame com flag: o proximo e o frame 0 (volta ao inicio), mesmo sem LOOP
+        Dac last = dac(new A().mpt(new M().time(10).raz(300, 0, 100, 100)).mpt(new M().time(10).interp()));
+        int rl = rotAfter(last, 15);
+        check("ultimo frame com flag interpola em direcao ao frame 1 (rotacao 300 do frame 0)", rl > 0 && rl < 300, true);
+        // frame sem tempo nao interpola
+        Dac zero = dac(new A().mpt(new M().interp()).mpt(new M().time(10).raz(450, 0, 100, 100)));
+        check("frame sem tempo nao interpola", rotAfter(zero, 3), 0);
+        check("proximo frame do ultimo = 1 (base 1)", ObjModel.interpTarget(5, 4) + ":" + ObjModel.interpTarget(5, 1), "1:3");
+        System.out.println("InterpolationTest fails=" + fails);
+    }
+}
diff -ruN a/test/LayerOpsTest.java b/test/LayerOpsTest.java
--- a/test/LayerOpsTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/LayerOpsTest.java	2026-10-29 12:29:51.519039133 +0000
@@ -0,0 +1,26 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** CAMADA da ANO: maior = mais em cima (o $PRIO do jogo e o contrario). */
+public class LayerOpsTest {
+    static Ano ano(int flags, int prio) { return new Ano(7, true, flags, prio, new Ano.Link[0], new Ano.Mpt[] {new Ano.Mpt()}); }
+
+    public static void main(String[] args) throws Exception {
+        check("ANO sem $PRIO: camada 0", LayerOps.layerOf(ano(0, 0)), 0);
+        check("$PRIO 5 (mais atras no jogo) = camada -5", LayerOps.layerOf(ano(4, 5)), -5);
+        Ano up = LayerOps.setLayer(ano(0, 0), 3);
+        check("camada 3 grava $PRIO -3 com o bit 4", up.priority + ":" + (up.flags & 4), "-3:4");
+        check("camada de volta", LayerOps.layerOf(up), 3);
+        Ano down = LayerOps.setLayer(up, -2);
+        check("camada -2 grava $PRIO 2", down.priority + ":" + (down.flags & 4), "2:4");
+        Ano zero = LayerOps.setLayer(down, 0);
+        check("camada 0 limpa o $PRIO e o bit 4", zero.priority + ":" + (zero.flags & 4), "0:0");
+        check("mantem indice, links e frames", zero.index + ":" + (zero.mpts == down.mpts) + ":" + (zero.links == down.links), "7:true:true");
+        check("preserva os outros bits de flags", LayerOps.setLayer(ano(3, 0), 1).flags, 3 | 4);
+        check("limite de cima: $PRIO -128", LayerOps.setLayer(ano(0, 0), 999).priority, -128);
+        check("limite de baixo: $PRIO 127", LayerOps.setLayer(ano(0, 0), -999).priority, 127);
+        check("clamp", LayerOps.clamp(500) + ":" + LayerOps.clamp(-500), "128:-127");
+        System.out.println("LayerOpsTest fails=" + fails);
+    }
+}
diff -ruN a/test/LinkHierarchyTest.java b/test/LinkHierarchyTest.java
--- a/test/LinkHierarchyTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/LinkHierarchyTest.java	2026-10-22 08:42:23.738914806 +0000
@@ -0,0 +1,112 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Hierarquia de links do jogo (_SetAct / _ActReq): so a RAIZ cria links; o link nao cria os dele (a tabela de links do link e pulada);
+ * hits/OPT de um link nao valem. Animacoes disparadas por flag (efeito de hit, projetil...) sao raizes: mostram os proprios links.
+ */
+public class LinkHierarchyTest {
+    static A[] anos(int n) {
+        A[] a = new A[n];
+        for (int i = 0; i < n; i++) a[i] = new A().mpt(new M().time(5).img(1));
+        return a;
+    }
+
+    /** Poe links no ANO {@code idx} do DAC (os frames ficam como estao). */
+    static void link(Dac d, int idx, int... targets) {
+        Ano old = d.getAno(idx);
+        Ano.Link[] ls = new Ano.Link[targets.length];
+        for (int i = 0; i < targets.length; i++) ls[i] = new Ano.Link(0, 0, 0x4000 | targets[i]);
+        d.setAno(idx, new Ano(idx, true, old.flags | 2, old.priority, ls, old.mpts));
+    }
+
+    static Set<Integer> shown(BattleSim s, int owner) {
+        Set<Integer> out = new HashSet<Integer>();
+        for (BattleSim.Layer l : s.layers()) if (l.owner == owner && l.only != null) out.add(Integer.valueOf(l.only.ano.index));
+        return out;
+    }
+
+    static BattleSim battle(Dac atk, CharData ch, Dac fx, int dist) throws Exception {
+        A[] def = new A[25];
+        for (int i = 0; i < 25; i++) def[i] = new A().mpt(new M().time(5).hit(1, -10, -60, 20, 60));
+        GameData g = gd(new byte[][] { null, null, null, react(new int[]{4, 4, 20, 10, 0, 0, 0, 10, 0, 0, 0, 0, 0, 0}) });
+        BattleSim s = new BattleSim(atk, ch, ch.moves[0], false, dac(def), fx, g, dist, 0, 0);
+        s.reset();
+        return s;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // ---- link de link nunca nasce
+        Dac d = dac(anos(20));
+        link(d, 10, 11);
+        link(d, 11, 12);
+        AttackSim sim = new AttackSim(d, 10, false);
+        boolean c12 = false;
+        for (AttackSim.Obj o : sim.children()) if (o != null && o.ano.index == 12) c12 = true;
+        check("ANO 10: so o link 11 nasce", sim.children().length + ":" + sim.children()[0].ano.index + ":" + c12, "1:11:false");
+        AttackSim asLink = new AttackSim(d, 11, false);
+        check("o mesmo ANO 11 como raiz mostra o proprio link 12", asLink.children().length + ":" + asLink.children()[0].ano.index, "1:12");
+        link(d, 10, 11, 11, 11);
+        check("varios links do mesmo ANO nascem (1 nivel)", new AttackSim(d, 10, false).children().length, 3);
+
+        // ---- hit flag 0 / 39 dentro de um link nao vale; na raiz vale
+        A[] a = anos(60);
+        a[40] = new A().mpt(new M().time(30));
+        a[31] = new A().mpt(new M().time(30).hit(0, 10, -30, 4, 4));
+        a[30] = new A().mpt(new M().time(60).speedX(2 << 16));
+        CharData ch = chr(move(new int[]{2, 40}, new int[]{4, 30}), new byte[][] {});
+        Dac dl = dac(a);
+        link(dl, 40, 31);
+        BattleSim bl = battle(dl, ch, dac(anos(2)), 120);
+        int most = 0;
+        for (int i = 0; i < 20; i++) { bl.step(); most = Math.max(most, bl.projectileCount()); }
+        check("flag 0 num link nao cria projetil", most, 0);
+        a[40] = new A().mpt(new M().time(30).hit(0, 10, -30, 4, 4));
+        BattleSim br = battle(dac(a), ch, dac(anos(2)), 120);
+        most = 0;
+        for (int i = 0; i < 20; i++) { br.step(); most = Math.max(most, br.projectileCount()); }
+        check("flag 0 na raiz cria projetil (controle)", most >= 1, true);
+
+        A[] t = anos(60);
+        t[40] = new A().mpt(new M().time(30));
+        t[31] = new A().mpt(new M().time(30).hit(39, 0, 0, 16, 16));
+        Dac dt = dac(t);
+        link(dt, 40, 31);
+        BattleSim tl = battle(dt, ch, dac(anos(2)), 120);
+        for (int i = 0; i < 12; i++) tl.step();
+        int xLink = (int) tl.attackerX();
+        t[40] = new A().mpt(new M().time(30).hit(39, 0, 0, 16, 16));
+        BattleSim tr = battle(dac(t), ch, dac(anos(2)), 120);
+        for (int i = 0; i < 12; i++) tr.step();
+        check("flag 39 num link nao teleporta; na raiz teleporta", xLink + ":" + ((int) tr.attackerX() != 0), "0:true");
+
+        // ---- projetil e efeito de hit sao raizes: mostram os proprios links, e so 1 nivel
+        A[] p = anos(60);
+        p[40] = new A().mpt(new M().time(40).hit(0, 10, -30, 4, 4));
+        p[30] = new A().mpt(new M().time(60).speedX(1 << 16));
+        Dac dp = dac(p);
+        link(dp, 30, 32);
+        link(dp, 32, 33);
+        BattleSim bp = battle(dp, ch, dac(anos(2)), 400);
+        for (int i = 0; i < 6; i++) bp.step();
+        Set<Integer> ps = shown(bp, BattleSim.OWNER_PROJECTILE);
+        check("projetil mostra o link 32 e nao o link do link (33)", ps.contains(Integer.valueOf(30)) + ":" + ps.contains(Integer.valueOf(32)) + ":" + ps.contains(Integer.valueOf(33)), "true:true:false");
+
+        A[] h = anos(60);
+        h[40] = new A().mpt(new M().time(3).hit(2, 20, -40, 40, 20).opt1(3)).mpt(new M().time(30));
+        CharData hc = chr(move(new int[]{2, 40}), new byte[][] {});
+        Dac fx = dac(anos(5));
+        link(fx, 0, 1);
+        link(fx, 1, 2);
+        BattleSim bh = battle(dac(h), hc, fx, 30);
+        Set<Integer> fs = new HashSet<Integer>();
+        for (int i = 0; i < 12; i++) { bh.step(); fs.addAll(shown(bh, BattleSim.OWNER_EFFECT)); }
+        check("efeito de hit mostra o link 1 e nao o link do link (2)", fs.contains(Integer.valueOf(0)) + ":" + fs.contains(Integer.valueOf(1)) + ":" + fs.contains(Integer.valueOf(2)), "true:true:false");
+
+        System.out.println("LinkHierarchyTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/MoveTransplantTest.java b/test/MoveTransplantTest.java
--- a/test/MoveTransplantTest.java	1970-01-01 00:00:00.000000000 +0000
