diff -ruN a/FrameTools.java b/FrameTools.java
--- a/FrameTools.java	1970-01-01 00:00:00.000000000 +0000
+++ b/FrameTools.java	2026-10-22 09:51:09.127228289 +0000
@@ -0,0 +1,220 @@
+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Regras puras (sem Android) das paginas Tempo / Movimento / Som da gaveta de sprite.
+ * Velocidade como o jogo: ao carregar um frame, sem o bit 64 (manter velocidade) speed = 0; accel = 0 sempre; depois cada campo do MOVE
+ * ATRIBUI (substitui) o valor. A cada tick com tempo > 0: x += speed, depois speed += accel. Logo a velocidade que o proximo frame recebe
+ * e (speed inicial + accel * ticks) do anterior: conta como SPEED, nao como accel, e e substituida se o frame tem speed proprio.
+ */
+final class FrameTools {
+    private FrameTools() { }
+
+    static final double ONE = 65536.0;
+
+    /** Ticks que o frame realmente anda (sem TIME o jogo nao avanca nem soma accel). */
+    static int ticks(Ano.Mpt m) { return m.hasTime ? Math.max(0, m.time) : 0; }
+
+    /** O frame {@code f} carrega o bit 64 (manter velocidade do anterior)? */
+    static boolean keeps(Ano.Mpt[] m, int f) {
+        return f > 0 && f < m.length && (m[f].flags & 2) != 0 && (m[f].wActFlag & 64) != 0;
+    }
+
+    private static boolean has(Ano.Mpt m, int bit) { return (m.flags & 4) != 0 && (m.moveMask & bit) != 0; }
+
+    /** Velocidade (px/tick) no inicio do frame, ja com a substituicao do speed proprio. */
+    static double[] startSpeed(Ano.Mpt[] m, int f) {
+        double[] v = keeps(m, f) ? endSpeed(m, f - 1) : new double[]{0, 0};
+        if (has(m[f], 1)) v[0] = m[f].speedX / ONE;
+        if (has(m[f], 2)) v[1] = m[f].speedY / ONE;
+        return v;
+    }
+
+    /** Velocidade no fim do frame (a que o proximo frame recebe se mantiver). */
+    static double[] endSpeed(Ano.Mpt[] m, int f) {
+        double[] v = startSpeed(m, f);
+        int t = ticks(m[f]);
+        if (has(m[f], 4)) v[0] += m[f].accelX / ONE * t;
+        if (has(m[f], 8)) v[1] += m[f].accelY / ONE * t;
+        return v;
+    }
+
+    /** Velocidade recebida do frame anterior (0,0 se o frame nao mantem). */
+    static double[] received(Ano.Mpt[] m, int f) {
+        return keeps(m, f) ? endSpeed(m, f - 1) : new double[]{0, 0};
+    }
+
+    /** Deslocamento total {dx, dy} em px e ticks, dos frames head..last. */
+    static double[] totalPixels(Ano.Mpt[] m, int head, int last) {
+        double x = 0, y = 0;
+        int ticks = 0;
+        for (int f = head; f <= last && f < m.length; f++) {
+            double[] v = startSpeed(m, f);
+            double ax = has(m[f], 4) ? m[f].accelX / ONE : 0, ay = has(m[f], 8) ? m[f].accelY / ONE : 0;
+            int t = ticks(m[f]);
+            for (int k = 0; k < t; k++) { x += v[0]; y += v[1]; v[0] += ax; v[1] += ay; }
+            ticks += t;
+        }
+        return new double[]{x, y, ticks};
+    }
+
+    /** O frame tem speed proprio (x ou y)? */
+    static boolean ownSpeed(Ano.Mpt m) { return (m.flags & 4) != 0 && (m.moveMask & 3) != 0; }
+
+    /** Aceleracao so aparece se o frame ja tem speed normal (proprio e diferente de 0) ou ja tinha accel. */
+    static boolean showAccel(Ano.Mpt m) {
+        boolean speed = ownSpeed(m) && ((has(m, 1) && m.speedX != 0) || (has(m, 2) && m.speedY != 0));
+        return speed || (m.flags & 4) != 0 && (m.moveMask & 12) != 0;
+    }
+
+    /** Liga (on) ou apaga o campo de speed do eixo (0 = x, 1 = y), em px/tick absolutos. */
+    static Ano.Mpt setSpeed(Ano.Mpt cur, int axis, double pxPerTick, boolean on) {
+        Ano.Mpt c = cur.copy();
+        int bit = axis == 0 ? 1 : 2;
+        int raw = (int) Math.round(pxPerTick * ONE);
+        if (on) {
+            c.flags |= 4;
+            c.moveMask |= bit;
+            if (axis == 0) c.speedX = raw; else c.speedY = raw;
+        } else {
+            c.moveMask &= ~bit;
+            if (axis == 0) c.speedX = 0; else c.speedY = 0;
+            if (c.moveMask == 0) c.flags &= ~4;
+        }
+        c.normalize();
+        return c;
+    }
+
+    /** Aceleracao (px/tick^2) do eixo; 0 apaga o campo. */
+    static Ano.Mpt setAccel(Ano.Mpt cur, int axis, double v) {
+        Ano.Mpt c = cur.copy();
+        int bit = axis == 0 ? 4 : 8;
+        int raw = (int) Math.round(v * ONE);
+        if (raw != 0) {
+            c.flags |= 4;
+            c.moveMask |= bit;
+            if (axis == 0) c.accelX = raw; else c.accelY = raw;
+        } else {
+            c.moveMask &= ~bit;
+            if (axis == 0) c.accelX = 0; else c.accelY = 0;
+            if (c.moveMask == 0) c.flags &= ~4;
+        }
+        c.normalize();
+        return c;
+    }
+
+    /** Tempo 0 = sem o campo TIME (o frame fica travado). */
+    static Ano.Mpt setTime(Ano.Mpt cur, int ticks) {
+        Ano.Mpt c = cur.copy();
+        if (ticks <= 0) { c.flags &= ~0x20; c.time = 0; }
+        else { c.flags |= 0x20; c.time = Math.min(255, ticks); }
+        c.normalize();
+        return c;
+    }
+
+    /** O frame seguinte mantem a velocidade deste? */
+    static boolean keepsNext(Ano.Mpt[] m, int f) { return keeps(m, f + 1); }
+
+    /**
+     * Liga/desliga "manter velocidade" deste frame para o seguinte. Desligar corta o trecho aqui: os frames depois dele que
+     * dependiam do trecho tambem perdem o bit 64. Devolve null se nao ha frame seguinte (ligar) ou nada a fazer.
+     */
+    static Ano.Mpt[] setKeepNext(Ano.Mpt[] m, int f, boolean on) {
+        if (f < 0 || f >= m.length) return null;
+        int head = FrameOps.moveHeadOf(m, f);
+        if (on) {
+            if (f + 1 >= m.length) return null;
+            if (head >= 0) return FrameOps.setMoveRun(m, head, f + 1);
+            Ano.Mpt[] out = m.clone();
+            Ano.Mpt c = m[f + 1].copy();
+            c.flags |= 2;
+            c.wActFlag |= 64;
+            c.normalize();
+            out[f + 1] = c;
+            return out;
+        }
+        if (head >= 0) return FrameOps.setMoveRun(m, head, f);
+        if (!keeps(m, f + 1)) return null;
+        Ano.Mpt[] out = m.clone();
+        Ano.Mpt c = m[f + 1].copy();
+        c.wActFlag &= ~64;
+        if (c.wActFlag == 0) c.flags &= ~2;
+        c.normalize();
+        out[f + 1] = c;
+        return out;
+    }
+
+    /** Desliga o bit 64 do frame {@code f} e de todo o trecho depois dele (botao "Remover" da velocidade recebida). */
+    static Ano.Mpt[] removeReceived(Ano.Mpt[] m, int f) {
+        if (!keeps(m, f)) return null;
+        Ano.Mpt[] out = m.clone();
+        for (int k = f; k < m.length && keeps(m, k); k++) {
+            Ano.Mpt c = m[k].copy();
+            c.wActFlag &= ~64;
+            if (c.wActFlag == 0) c.flags &= ~2;
+            if ((c.flags & 4) != 0 && (c.moveMask & 3) == 0) { c.flags &= ~4; c.moveMask = 0; c.accelX = c.accelY = 0; }
+            c.normalize();
+            out[k] = c;
+        }
+        return out;
+    }
+
+    /** Move o inicio do trecho de velocidade para outro frame mantendo a quantidade de frames; null se nao cabe ou bate em outra velocidade. */
+    static Ano.Mpt[] moveRunTo(Ano.Mpt[] m, int head, int newHead) {
+        if (head < 0 || head >= m.length || newHead < 0 || newHead >= m.length || !FrameOps.isMoveHead(m[head])) return null;
+        if (newHead == head) return m;
+        int n = FrameOps.moveRunEnd(m, head) - head + 1;
+        Ano.Mpt src = m[head].copy();
+        Ano.Mpt[] out = FrameOps.setMoveRun(m, head, head);
+        Ano.Mpt h0 = out[head].copy();
+        FrameOps.clear(FrameOps.MOV, h0);
+        out[head] = h0;
+        int last = Math.min(out.length - 1, newHead + n - 1);
+        for (int f = newHead; f <= last; f++) if (FrameOps.isMoveHead(out[f])) return null;
+        Ano.Mpt t = out[newHead].copy();
+        FrameOps.copyProp(FrameOps.MOV, src, t);
+        t.wActFlag &= ~64;
+        if (t.wActFlag == 0) t.flags &= ~2;
+        t.normalize();
+        out[newHead] = t;
+        return FrameOps.setMoveRun(out, newHead, last);
+    }
+
+    // ---- sons: ids validos 0 -> se_max -> 80 -> 80 + wav - 1 ----
+
+    static List<Integer> soundIds(int seMax, int wavCount) {
+        List<Integer> l = new ArrayList<Integer>();
+        for (int i = 0; i <= Math.min(79, Math.max(0, seMax)); i++) l.add(Integer.valueOf(i));
+        for (int i = 0; i < wavCount; i++) l.add(Integer.valueOf(80 + i));
+        return l;
+    }
+
+    /** Proximo id valido na direcao dir (+1/-1); se o atual nao e valido, vai para o mais proximo na direcao; nas pontas fica. */
+    static int stepSound(int cur, int dir, int seMax, int wavCount) {
+        List<Integer> l = soundIds(seMax, wavCount);
+        int idx = l.indexOf(Integer.valueOf(cur));
+        if (idx < 0) {
+            if (dir > 0) { for (Integer v : l) if (v.intValue() > cur) return v.intValue(); return l.get(l.size() - 1).intValue(); }
+            for (int i = l.size() - 1; i >= 0; i--) if (l.get(i).intValue() < cur) return l.get(i).intValue();
+            return l.get(0).intValue();
+        }
+        return l.get(Math.max(0, Math.min(l.size() - 1, idx + (dir > 0 ? 1 : -1)))).intValue();
+    }
+
+    /** O frame e inicio de trecho de velocidade (tem speed proprio, mesmo mantendo a do anterior)? */
+    static boolean moveRunHeadOk(Ano.Mpt[] m, int f) { return FrameOps.isMoveHead(m[f]); }
+
+    /** "N.Ns" (ticks a 60 por segundo, uma casa). */
+    static String seconds(int ticks) {
+        return String.format(java.util.Locale.US, "%.1fs", ticks / 60.0);
+    }
+
+    /** px/tick com ate 2 casas, sem zeros sobrando. */
+    static String px(double v) {
+        String s = String.format(java.util.Locale.US, "%.2f", v);
+        while (s.contains(".") && (s.endsWith("0") || s.endsWith("."))) s = s.substring(0, s.length() - 1);
+        return s.equals("-0") ? "0" : s;
+    }
+}
diff -ruN a/GameRules.java b/GameRules.java
--- a/GameRules.java	1970-01-01 00:00:00.000000000 +0000
+++ b/GameRules.java	2026-10-22 08:40:32.981997767 +0000
@@ -0,0 +1,149 @@
+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Limites do jogo que o editor deixaria passar: o simulador aceita, mas no jogo a ANO estoura um array (ArrayIndexOutOfBounds dentro do
+ * Run() do TCBManajer fecha o jogo) ou e ignorada. Java puro, sem Android.
+ */
+final class GameRules {
+    private GameRules() { }
+
+    /** Maximos do jogo (ObjReq.hit = int[50], ObjReq.lnk = ObjReq[13], MPT e time em 1 byte). */
+    static final int MAX_HITS = 10, MAX_LINKS = 13, MAX_MPTS = 255, MAX_TIME = 255, MAX_OPT1 = 249;
+
+    static final class Issue {
+        final int ano, mpt;
+        /** true = o jogo fecha ou le lixo; false = o jogo ignora o campo. */
+        final boolean fatal;
+        final String text;
+
+        Issue(int ano, int mpt, boolean fatal, String text) {
+            this.ano = ano;
+            this.mpt = mpt;
+            this.fatal = fatal;
+            this.text = text;
+        }
+
+        @Override public String toString() { return "ANO " + ano + (mpt >= 0 ? " MPT " + mpt : "") + ": " + text; }
+    }
+
+    /** cnvEntries <= 0 desliga a checagem de imagem. */
+    static List<Issue> check(Dac dac, java.util.Collection<Integer> anos, int cnvEntries) {
+        List<Issue> out = new ArrayList<Issue>();
+        if (dac == null) return out;
+        boolean[] isLink = new boolean[dac.size()];
+        for (int i = 0; i < dac.size(); i++) {
+            Ano a = dac.getAno(i);
+            if (a == null || !a.present) continue;
+            for (int k = 0; k < a.links.length; k++) {
+                int t = a.links[k].getAno();
+                if (t >= 0 && t < isLink.length) isLink[t] = true;
+            }
+        }
+        if (anos == null) {
+            for (int i = 0; i < dac.size(); i++) checkAno(dac, dac.getAno(i), isLink, cnvEntries, out);
+        } else {
+            for (Integer i : anos) if (i.intValue() >= 0 && i.intValue() < dac.size()) checkAno(dac, dac.getAno(i.intValue()), isLink, cnvEntries, out);
+        }
+        return out;
+    }
+
+    private static void checkAno(Dac dac, Ano a, boolean[] isLink, int cnvEntries, List<Issue> out) {
+        if (a == null || !a.present) return;
+        int ix = a.index;
+        if (a.mpts.length > MAX_MPTS)
+            out.add(new Issue(ix, -1, true, a.mpts.length + " frames: o DAC guarda a quantidade em 1 byte (maximo " + MAX_MPTS + ")"));
+        if (a.links.length > MAX_LINKS)
+            out.add(new Issue(ix, -1, true, a.links.length + " links: o jogo so tem " + MAX_LINKS + " (lnk[13]) e fecha ao criar o excedente"));
+        for (int p = 0; p < a.mpts.length; p++) {
+            Ano.Mpt m = a.mpts[p];
+            if (m.hits.length > MAX_HITS)
+                out.add(new Issue(ix, p, true, m.hits.length + " caixas no frame: o jogo guarda no maximo " + MAX_HITS + " (hit[50]) e fecha ao ler o excedente"));
+            if (m.hasTime && m.time > MAX_TIME)
+                out.add(new Issue(ix, p, true, "tempo " + m.time + ": o campo e 1 byte (maximo " + MAX_TIME + ")"));
+            if (cnvEntries > 0 && m.image >= cnvEntries)
+                out.add(new Issue(ix, p, false, "imagem " + m.image + " nao existe no CNV (" + cnvEntries + " entradas): o frame fica sem desenho"));
+            if (m.hasOpt && m.optData[1] > MAX_OPT1 && hasHitbox(m))
+                out.add(new Issue(ix, p, true, "OPT 1 = " + m.optData[1] + " com hitbox: o grupo " + (m.optData[1] / 50) + " nao existe (maximo " + MAX_OPT1 + ")"));
+            if (m.hasOpt && m.optData[2] != 0 && m.time > 0) {
+                // _Hokan: o "proximo" do ultimo frame e o frame 0. So le lixo quando o frame seguinte tem caixas E rotacao/alfa/zoom (campo 128),
+                // porque o laco que pula as caixas usa o iHitNum do frame ATUAL; o OPT (64) so avanca o ponteiro, sem ler nada.
+                Ano.Mpt n = a.mpts[(p + 1) % a.mpts.length];
+                if (n.hasRaz && n.hits.length > 0 && n.hits.length != m.hits.length)
+                    out.add(new Issue(ix, p, true, "interpolacao: o jogo le o frame seguinte pulando " + m.hits.length + " caixa(s) (as do frame ATUAL) em vez de " + n.hits.length
+                            + "; a rotacao/alfa/zoom do alvo saem errados"));
+            }
+        }
+    }
+
+    /** Flag de hitbox que cria animacao/efeito: projetil (0), tremor (3-5), poeira (10-17), cutscene (20), zoom (30/31), teleporte (39/40), charf/auras (41-125). */
+    private static boolean spawnsAnimation(int f) {
+        return f == 0 || (f >= 3 && f <= 5) || (f >= 10 && f <= 17) || f == 20 || f == 30 || f == 31 || f == 39 || f == 40 || (f >= 41 && f <= 125);
+    }
+
+    /** O ANO, usado como link, tem links proprios ou algo que cria animacao/efeito (hit flags, poeira do OPT)? O jogo so le isso na raiz. */
+    private static boolean hasIgnoredExtras(Ano c) {
+        if (c.links.length > 0) return true;
+        for (int p = 0; p < c.mpts.length; p++) {
+            Ano.Mpt m = c.mpts[p];
+            if (m.hasOpt && (m.optFlag & 0xF000) != 0) return true;
+            for (int h = 0; h < m.hits.length; h++) if (spawnsAnimation(m.hits[h].flag)) return true;
+        }
+        return false;
+    }
+
+    /** ANOs (de {@code anos}; null = todos) que tem algum link com links proprios ou animacoes/efeitos: no jogo esses nao aparecem. */
+    static List<Integer> nestedLinkParents(Dac dac, java.util.Collection<Integer> anos) {
+        List<Integer> out = new ArrayList<Integer>();
+        if (dac == null) return out;
+        java.util.TreeSet<Integer> ids = new java.util.TreeSet<Integer>();
+        if (anos == null) for (int i = 0; i < dac.size(); i++) ids.add(Integer.valueOf(i)); else ids.addAll(anos);
+        for (Integer id : ids) {
+            Ano a = id.intValue() >= 0 && id.intValue() < dac.size() ? dac.getAno(id.intValue()) : null;
+            if (a == null || !a.present) continue;
+            for (int k = 0; k < a.links.length; k++) {
+                Ano c = dac.getAno(a.links[k].getAno());
+                if (c != null && c.present && c != a && hasIgnoredExtras(c)) { out.add(id); break; }
+            }
+        }
+        return out;
+    }
+
+    /** Linha para a lista de avisos; "" se nao ha o que avisar. */
+    static String nestedLinksNote(Dac dac, java.util.Collection<Integer> anos) {
+        List<Integer> p = nestedLinkParents(dac, anos);
+        if (p.isEmpty()) return "";
+        StringBuilder b = new StringBuilder(p.size() == 1 ? "O ANO " : "Os ANOs ");
+        for (int i = 0; i < p.size(); i++) {
+            if (i > 0) b.append(i == p.size() - 1 ? " e " : ", ");
+            b.append(p.get(i));
+        }
+        return b.append(p.size() == 1 ? " tem" : " t\u00eam").append(" links que t\u00eam outros links ou anima\u00e7\u00f5es/efeitos; esses n\u00e3o aparecem (o jogo s\u00f3 l\u00ea a raiz): o link mostra apenas as sprites do link.").toString();
+    }
+
+    private static boolean hasHitbox(Ano.Mpt m) {
+        for (int i = 0; i < m.hits.length; i++) if (m.hits[i].flag == 2) return true;
+        return false;
+    }
+
+    /** Todas as linhas (fatais primeiro), uma por problema: o aviso expandido mostra isto em vez do "+N" do resumo. */
+    static String details(List<Issue> issues) {
+        if (issues == null || issues.isEmpty()) return "";
+        StringBuilder b = new StringBuilder();
+        for (int pass = 0; pass < 2; pass++)
+            for (Issue i : issues) if (i.fatal == (pass == 0)) b.append(b.length() > 0 ? "\n" : "").append(i.fatal ? "O JOGO FECHA/ERRA: " : "Aviso do jogo: ").append(i);
+        return b.toString();
+    }
+
+    /** Uma linha para a barra de avisos; "" se tudo certo. */
+    static String summary(List<Issue> issues) {
+        if (issues == null || issues.isEmpty()) return "";
+        int fatal = 0;
+        for (Issue i : issues) if (i.fatal) fatal++;
+        Issue first = issues.get(0);
+        for (Issue i : issues) if (i.fatal) { first = i; break; }
+        return (fatal > 0 ? "O JOGO FECHA/ERRA: " : "Aviso do jogo: ") + first + (issues.size() > 1 ? " (+" + (issues.size() - 1) + ")" : "");
+    }
+}
