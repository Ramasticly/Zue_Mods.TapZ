+            r.speedY = 0;
+            r.accelY = 0;
+            r.speedX = 0;
+            r.accelX = 0;
+            sounds.add(new Snd(true, 12, 0));
+            int land = (phase == 5 || move.generic) ? 13 : (hitConfirmed ? move.pousoAcertar : move.pousoErrar);
+            if (land == 0) land = 13;
