+    /** LIFE_DEC: o jogo so tira vida se o outro lutador ainda esta vivo. */
+    private void lifeDec(boolean toOpp, int d) {
+        if (toOpp) { if (lifeA > 0) lifeO = Math.max(0, lifeO - d); }
+        else { if (lifeO > 0) lifeA = Math.max(0, lifeA - d); }
+    }
+
+    /**
+     * DamageChange (parte do dano): OptData[0] com ataque/defesa (a menos da flag 28), escala por combo
+     * (HDAT 5 do gamedata), limite pela vida restante, LIFE_DEC e ComboCount (nao conta com a flag 37).
+     */
+    private void applyDamage(Opt1 op, int dmg, int hitAno) {
+        AttackSim.Obj ar = atk.root();
+        boolean f28 = hasFlag(ar, 28), f37 = hasFlag(ar, 37);
+        int d = dmg;
+        if (!f28 && d != 0) {
+            int def = oppChar == null ? 0 : oppChar.defenceMul(LEVEL);
+            if (def < 0) def = 0;
+            int atkMul = atkChar == null ? 100 : atkChar.attackMul(LEVEL);
+            d = atkMul * d / 100 * (100 - def) / 100;
+            if (d < 2) d = 2;
+        }
+        if (hitAno == 92) d = 0;
+        int idx = combo;
+        if (combo >= 2) idx = Math.min(combo, 15) - 2;
+        if (d != 0 && gd != null) {
+            d = gd.comboScale(idx) * d / 100;
+            if (d == 0) d = 1;
+        }
+        if (lifeO < d) d = lifeO;
+        totalDamage += d;
+        lastDamage = d;
+        lifeDec(true, d);
+        if (op.effectAno == 0 || op.effectAno == 1) {      // o jogo so conta combo quando o efeito e o Ano 0 ou 1
+            if (!f37) { combo = Math.min(99, combo + 1); }
+        }
+    }
+
+    /** SelfDamage (hitbox flag 32): o atacante perde OptData[0] de vida, mas nunca morre (fica com 1). */
+    private void selfDamage(int d) {
+        if (lifeA <= d) lifeA = 1; else lifeDec(false, d);
+        lastSelf = d;
+    }
+
+    private void applyHit(Opt1 op, int[] pos, String who, int dmg, int hitAno) {
+        lastHit = who + " - " + op.describe();
+        if (!op.valid) return;
+        if (lifeA > 0) {
+            applyDamage(op, dmg, hitAno);
+            lastHit += " [dano " + lastDamage + ", vida " + lifeO + "/" + maxO + ", combo " + combo + "]";
+        }
+        ReactionTable tb = table(op.fromChar, op.type);
+        if (tb == null || tb.rows == 0) {
+            lastHit += " [tabela ausente]";
+            return;
+        }
+        // efeito e som de impacto
+        if (op.effectAno >= 0 && fxDac != null) {
+            fxs.add(newFx(new AttackSim(fxDac, op.effectAno, false, pos[0] * PX, pos[1] * PX)));
+        }
+        if (op.sound >= 0) sounds.add(new Snd(true, op.sound, 0));
+        // o defensor vira para o atacante e entra no estado de dano
+        AttackSim.Obj ar = atk.root();
+        int flipRef = (move.projectile || ar == null) ? refAtkX : ar.x;
+        if (oppX != flipRef) oppFlip = oppX >= flipRef;
+        applyFlip(opp, oppFlip);
+        inDamage = true;
+        grabHitAno = hitAno;                        // DamageHitActNo
+        dmgWall = false;                            // DamageChange zera DamageWall (jogo:2386)
+        stunned[1] = false;                         // DamageChange troca o md do defensor por 876/877: o stun (md 925) acaba
+        endAnim = -1;
+        dCharSrc = op.fromChar;
+        dType = op.type;
+        dIdx = 0;
+        dTime = 0;
+        dOldType = op.type;
+        dOldIdx = 0;
+        dMove = op.pushes ? hitBack : 0;
+        dead = false;
+        if (lifeO <= 0) {                           // KO: o jogo troca a reacao pelo tipo 2 do gamedata (md 876)
+            dCharSrc = false;
+            dType = 2;
+            dOldType = 2;
+        }
+    }
