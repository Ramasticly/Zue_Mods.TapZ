+    /** PULAR do aviso da trava cinematica: passa por todos os ticks que faltam e libera o tick (sem tocar os sons dos ticks pulados). */
+    public void skipCinematic() {
+        if (sim == null) return;
+        pause();
+        int guard = 0;
+        while (sim.cinematicActive() && frame + 1 < length && guard++ < 400) {
+            liveStep();
+            frame++;
+            sim.drainSounds();
+        }
+        clearHitstopNotice();
+        hsNotice.afterStep(frame, sim.hitstopAttacker());
+        updateHitstopNotice();
+        watchLanding();
+        notifyUi();
+        invalidate();
+    }
