+    public String describe() {
+        StringBuilder sb = new StringBuilder(atk.describeMain());
+        sb.append('\n').append(atk.describeExtra()).append(" \u00b7 proj ").append(projs.size());
+        if (hsAtk > 0 || hsDef > 0) sb.append(" \u00b7 hitstop ").append(Math.max(hsAtk, hsDef));
+        return sb.toString();
+    }
+
+    public String describeDefender() {
+        StringBuilder sb = new StringBuilder();
+        if (inDamage) {
+            sb.append("reacao ").append(dCharSrc ? "char " : "gamedata ").append(dType)
+              .append(" \u00b7 linha ").append(dIdx).append(" \u00b7 t=").append(dTime)
+              .append(" \u00b7 vel ").append(dXs * 10 / 128).append(',').append(dYs * 10 / 128);
+        } else if (endAnim >= 0) {
