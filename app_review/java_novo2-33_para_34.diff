+    public void stepForward() {
+        pause();
+        if (sim == null) return;
+        if (frame + 1 >= length) return;          // avancar Frame nao da a volta: so a reproducao repete
+        stopSounds();
+        liveStep();
+        frame++;
+        hsNotice.afterStep(frame, sim.hitstopAttacker());
+        cineNotice.afterStep(frame, sim.cinematicLeft());
+        updateHitstopNotice();
+        watchLanding();
+        playSounds();
+        notifyUi();
+        invalidate();
+    }
