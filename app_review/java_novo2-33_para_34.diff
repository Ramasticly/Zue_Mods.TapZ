+        t.setGravity(Gravity.CENTER);
+        t.setSingleLine(true);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setTextColor(on ? Color.WHITE : LayoutManager.TEXT);
+        t.setPadding(dp(10), dp(7), dp(10), dp(7));
+        GradientDrawable g = new GradientDrawable();
+        g.setColor(on ? LayoutManager.ACCENT : LayoutManager.PANEL);
+        g.setCornerRadius(dp(7));
+        t.setBackground(g);
+        t.setClickable(true);
+        t.setOnClickListener(new View.OnClickListener() { @Override public void onClick(View v) { if (r != null) r.run(); } });
+        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(-2, -2);
+        p.setMargins(dp(3), 0, dp(3), 0);
+        t.setLayoutParams(p);
+        return t;
+    }
+}
