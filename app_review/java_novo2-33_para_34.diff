+
+    private static boolean loopBit(Ano.Mpt m) { return (m.flags & 2) != 0 && (m.wActFlag & ObjModel.LOOP) != 0; }
+
+    /**
+     * O loop e do ANO, nao de um frame: se estava ligado no ultimo frame de {@code before}, depois de uma edicao
+     * (apagar, adicionar, duplicar, dividir...) ele fica so no ultimo frame de {@code after}. Quem desliga o loop e o usuario
+     * (ObjModel.setLoop), que nao passa por aqui. O bit 2 (fim) acompanha. Devolve {@code after} se nada muda.
+     */
+    static Ano.Mpt[] normalizeLoop(Ano.Mpt[] before, Ano.Mpt[] after) {
+        if (before == null || after == null || before.length == 0 || after.length == 0) return after;
+        Ano.Mpt oldLast = before[before.length - 1];
+        if (!loopBit(oldLast)) return after;
+        int last = after.length - 1;
+        boolean ok = loopBit(after[last]);
+        for (int i = 0; i < last && ok; i++) if (loopBit(after[i])) ok = false;
