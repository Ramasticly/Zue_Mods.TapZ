@@ -0,0 +1,157 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.List;
+
+/** GameRules: limites do jogo (hit[50], lnk[13], bytes do DAC, OPT 1, links de 1 nivel, quirk do _Hokan). */
+public class GameRulesTest {
+    static Ano.Hit hit(int flag) {
+        Ano.Hit h = new Ano.Hit();
+        h.flag = flag;
+        return h;
+    }
+
+    static Ano.Mpt mpt(int hits, int flag) {
+        Ano.Mpt m = new Ano.Mpt();
+        m.hasTime = true;
+        m.time = 5;
+        m.image = 1;
+        m.hits = new Ano.Hit[hits];
+        for (int i = 0; i < hits; i++) m.hits[i] = hit(flag);
+        return m;
+    }
+
+    static Dac base(int n) throws Exception {
+        A[] a = new A[n];
+        for (int i = 0; i < n; i++) a[i] = new A().mpt(new M().time(1));
+        return dac(a);
+    }
+
+    static int count(List<GameRules.Issue> l, boolean fatal) {
+        int n = 0;
+        for (GameRules.Issue i : l) if (i.fatal == fatal) n++;
+        return n;
+    }
+
+    public static void main(String[] args) throws Exception {
+        Dac d = base(20);
+        check("limpo: nada a avisar", GameRules.check(d, null, 0).size(), 0);
+        check("limpo: resumo vazio", GameRules.summary(GameRules.check(d, null, 0)), "");
+
+        // 10 caixas passam, 11 fecham o jogo (hit[50])
+        d.setAno(3, new Ano(3, true, 0, 0, null, new Ano.Mpt[]{mpt(10, 1)}));
+        check("10 caixas ok", GameRules.check(d, null, 0).size(), 0);
+        d.setAno(3, new Ano(3, true, 0, 0, null, new Ano.Mpt[]{mpt(11, 1)}));
+        check("11 caixas e fatal", count(GameRules.check(d, null, 0), true), 1);
+
+        // 13 links passam, 14 fecham (lnk[13])
+        Ano.Link[] l13 = new Ano.Link[13], l14 = new Ano.Link[14];
+        for (int i = 0; i < 14; i++) { if (i < 13) l13[i] = new Ano.Link(0, 0, 4); l14[i] = new Ano.Link(0, 0, 4); }
+        d = base(20);
+        d.setAno(5, new Ano(5, true, 2, 0, l13, new Ano.Mpt[]{mpt(0, 1)}));
+        check("13 links ok", GameRules.check(d, null, 0).size(), 0);
+        d.setAno(5, new Ano(5, true, 2, 0, l14, new Ano.Mpt[]{mpt(0, 1)}));
+        check("14 links e fatal", count(GameRules.check(d, null, 0), true), 1);
+
+        // tempo e quantidade de frames em 1 byte
+        d = base(20);
+        Ano.Mpt slow = mpt(0, 1);
+        slow.time = 300;
+        d.setAno(6, new Ano(6, true, 0, 0, null, new Ano.Mpt[]{slow}));
+        check("tempo 300 e fatal", count(GameRules.check(d, null, 0), true), 1);
+        Ano.Mpt[] many = new Ano.Mpt[256];
+        for (int i = 0; i < 256; i++) many[i] = mpt(0, 1);
+        d.setAno(6, new Ano(6, true, 0, 0, null, many));
+        check("256 frames e fatal", count(GameRules.check(d, null, 0), true), 1);
+
+        // imagem fora do CNV: aviso (o jogo nao fecha, o frame fica sem desenho)
+        d = base(20);
+        Ano.Mpt far = mpt(0, 1);
+        far.image = 9;
+        d.setAno(7, new Ano(7, true, 0, 0, null, new Ano.Mpt[]{far}));
+        List<GameRules.Issue> img = GameRules.check(d, null, 5);
+        check("imagem fora do CNV e so aviso", count(img, false) + ":" + count(img, true), "1:0");
+        check("sem CNV a checagem desliga", GameRules.check(d, null, 0).size(), 0);
+
+        // OPT 1 acima de 249 com hitbox
+        d = base(20);
+        Ano.Mpt o = mpt(1, 2);
+        o.hasOpt = true;
+        o.optData[1] = 250;
+        d.setAno(8, new Ano(8, true, 0, 0, null, new Ano.Mpt[]{o}));
+        check("OPT 1 = 250 com hitbox e fatal", count(GameRules.check(d, null, 0), true), 1);
+        o.optData[1] = 249;
+        check("OPT 1 = 249 ok", GameRules.check(d, null, 0).size(), 0);
+
+        // link de link e caixas em ANO de link: o jogo ignora
+        d = base(20);
+        d.setAno(9, new Ano(9, true, 2, 0, new Ano.Link[]{new Ano.Link(0, 0, 10)}, new Ano.Mpt[]{mpt(0, 1)}));
+        d.setAno(10, new Ano(10, true, 2, 0, new Ano.Link[]{new Ano.Link(0, 0, 11)}, new Ano.Mpt[]{mpt(1, 2)}));
+        d.setAno(11, new Ano(11, true, 0, 0, null, new Ano.Mpt[]{mpt(0, 1)}));
+        List<GameRules.Issue> lk = GameRules.check(d, null, 0);
+        check("link de link nao e mais aviso de tela (vai para a lista de avisos)", lk.size(), 0);
+        check("ANO com link que tem link: so o ANO 9", GameRules.nestedLinkParents(d, null).toString(), "[9]");
+        check("texto da lista (1 ANO)", GameRules.nestedLinksNote(d, null).startsWith("O ANO 9 tem links que t\u00eam outros links"), true);
+        // link com efeito: flag de aura/poeira/cutscene e poeira do OPT no link tambem nao aparecem
+        d.setAno(12, new Ano(12, true, 2, 0, new Ano.Link[]{new Ano.Link(0, 0, 13), new Ano.Link(0, 0, 14)}, new Ano.Mpt[]{mpt(0, 1)}));
+        d.setAno(13, new Ano(13, true, 0, 0, null, new Ano.Mpt[]{mpt(1, 90)}));
+        Ano.Mpt dust = mpt(0, 1);
+        dust.hasOpt = true;
+        dust.optFlag = 4096;
+        d.setAno(14, new Ano(14, true, 0, 0, null, new Ano.Mpt[]{dust}));
+        d.setAno(15, new Ano(15, true, 2, 0, new Ano.Link[]{new Ano.Link(0, 0, 16)}, new Ano.Mpt[]{mpt(0, 1)}));
+        d.setAno(16, new Ano(16, true, 0, 0, null, new Ano.Mpt[]{mpt(2, 27)}));
+        check("pais: 9 (link de link), 12 (aura/poeira no link); 15 nao (flag 27 e so estado)", GameRules.nestedLinkParents(d, null).toString(), "[9, 12]");
+        check("texto com varios", GameRules.nestedLinksNote(d, null).startsWith("Os ANOs 9 e 12 t\u00eam links"), true);
+        check("filtro por ANOs", GameRules.nestedLinkParents(d, java.util.Arrays.asList(Integer.valueOf(12), Integer.valueOf(15))).toString(), "[12]");
+        check("nada a avisar", GameRules.nestedLinksNote(base(20), null), "");
+        // details: todas as linhas, fatais primeiro
+        d = base(20);
+        d.setAno(3, new Ano(3, true, 0, 0, null, new Ano.Mpt[]{mpt(2, 1), mpt(11, 1)}));
+        d.setAno(4, new Ano(4, true, 0, 0, null, new Ano.Mpt[]{mpt(1, 1)}));
+        Ano.Mpt tm = mpt(1, 1);
+        tm.image = 500;
+        d.setAno(5, new Ano(5, true, 0, 0, null, new Ano.Mpt[]{tm}));
+        List<GameRules.Issue> iss = GameRules.check(d, null, 100);
+        String det = GameRules.details(iss);
+        check("details: uma linha por problema", det.split("\n").length, iss.size());
+        check("details: fatal primeiro", det.startsWith("O JOGO FECHA/ERRA"), true);
+        check("details nao tem +N", det.contains("(+"), false);
+        QuickNotice qn = new QuickNotice(GameRules.summary(iss)).full(det);
+        check("aviso: recolhido = resumo (+N), expandido = tudo", qn.shown(false).contains("(+") + ":" + qn.shown(true).equals(det), "true:true");
+        check("aviso sem full: expandir mantem o texto", new QuickNotice("x").shown(true), "x");
+
+        // quirk do _Hokan: o laco que pula as caixas do frame SEGUINTE usa o iHitNum do frame ATUAL; so le lixo se o seguinte tem caixas e rotacao/alfa/zoom
+        d = base(20);
+        Ano.Mpt a0 = mpt(1, 1), a1 = mpt(2, 1);
+        a0.hasOpt = true;
+        a0.optData[2] = 1;
+        a1.hasRaz = true;
+        d.setAno(12, new Ano(12, true, 0, 0, null, new Ano.Mpt[]{a0, a1}));
+        check("seguinte com caixas + raz e contagem diferente e fatal", count(GameRules.check(d, null, 0), true), 1);
+        a1.hits = new Ano.Hit[]{hit(1)};
+        check("mesma contagem de caixas ok", GameRules.check(d, null, 0).size(), 0);
+        a1.hits = new Ano.Hit[0];
+        check("seguinte sem caixas: o jogo nao pula nada, ok", GameRules.check(d, null, 0).size(), 0);
+        a1.hits = new Ano.Hit[]{hit(1), hit(1)};
+        a1.hasRaz = false;
+        a1.hasOpt = true;
+        check("seguinte so com OPT (sem raz) nao le nada depois das caixas, ok", GameRules.check(d, null, 0).size(), 0);
+        // o proximo do ultimo frame e o frame 0 (pat >= mpt => 0)
+        Ano.Mpt b0 = mpt(2, 1), b1 = mpt(1, 1);
+        b0.hasRaz = true;
+        b1.hasOpt = true;
+        b1.optData[2] = 1;
+        d.setAno(13, new Ano(13, true, 0, 0, null, new Ano.Mpt[]{b0, b1}));
+        check("interpolacao do ultimo frame olha o frame 0", count(GameRules.check(d, java.util.Arrays.asList(Integer.valueOf(13)), 0), true), 1);
+
+        // so as ANOs pedidas
+        d = base(20);
+        d.setAno(3, new Ano(3, true, 0, 0, null, new Ano.Mpt[]{mpt(11, 1)}));
+        check("filtro por ANOs", GameRules.check(d, java.util.Arrays.asList(Integer.valueOf(4)), 0).size() + ":" + GameRules.check(d, java.util.Arrays.asList(Integer.valueOf(3)), 0).size(), "0:1");
+        check("resumo do fatal", GameRules.summary(GameRules.check(d, null, 0)).startsWith("O JOGO FECHA/ERRA: ANO 3 MPT 0"), true);
+
+        System.out.println("GameRulesTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/LinkHierarchyTest.java b/test/LinkHierarchyTest.java
--- a/test/LinkHierarchyTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/LinkHierarchyTest.java	2026-10-22 08:42:23.738914806 +0000
@@ -0,0 +1,112 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Hierarquia de links do jogo (_SetAct / _ActReq): so a RAIZ cria links; o link nao cria os dele (a tabela de links do link e pulada);
+ * hits/OPT de um link nao valem. Animacoes disparadas por flag (efeito de hit, projetil...) sao raizes: mostram os proprios links.
+ */
+public class LinkHierarchyTest {
+    static A[] anos(int n) {
+        A[] a = new A[n];
+        for (int i = 0; i < n; i++) a[i] = new A().mpt(new M().time(5).img(1));
+        return a;
+    }
+
+    /** Poe links no ANO {@code idx} do DAC (os frames ficam como estao). */
+    static void link(Dac d, int idx, int... targets) {
+        Ano old = d.getAno(idx);
+        Ano.Link[] ls = new Ano.Link[targets.length];
+        for (int i = 0; i < targets.length; i++) ls[i] = new Ano.Link(0, 0, 0x4000 | targets[i]);
+        d.setAno(idx, new Ano(idx, true, old.flags | 2, old.priority, ls, old.mpts));
+    }
+
+    static Set<Integer> shown(BattleSim s, int owner) {
+        Set<Integer> out = new HashSet<Integer>();
+        for (BattleSim.Layer l : s.layers()) if (l.owner == owner && l.only != null) out.add(Integer.valueOf(l.only.ano.index));
+        return out;
+    }
+
+    static BattleSim battle(Dac atk, CharData ch, Dac fx, int dist) throws Exception {
+        A[] def = new A[25];
+        for (int i = 0; i < 25; i++) def[i] = new A().mpt(new M().time(5).hit(1, -10, -60, 20, 60));
+        GameData g = gd(new byte[][] { null, null, null, react(new int[]{4, 4, 20, 10, 0, 0, 0, 10, 0, 0, 0, 0, 0, 0}) });
+        BattleSim s = new BattleSim(atk, ch, ch.moves[0], false, dac(def), fx, g, dist, 0, 0);
+        s.reset();
+        return s;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // ---- link de link nunca nasce
+        Dac d = dac(anos(20));
+        link(d, 10, 11);
+        link(d, 11, 12);
+        AttackSim sim = new AttackSim(d, 10, false);
+        boolean c12 = false;
+        for (AttackSim.Obj o : sim.children()) if (o != null && o.ano.index == 12) c12 = true;
+        check("ANO 10: so o link 11 nasce", sim.children().length + ":" + sim.children()[0].ano.index + ":" + c12, "1:11:false");
+        AttackSim asLink = new AttackSim(d, 11, false);
+        check("o mesmo ANO 11 como raiz mostra o proprio link 12", asLink.children().length + ":" + asLink.children()[0].ano.index, "1:12");
+        link(d, 10, 11, 11, 11);
+        check("varios links do mesmo ANO nascem (1 nivel)", new AttackSim(d, 10, false).children().length, 3);
+
+        // ---- hit flag 0 / 39 dentro de um link nao vale; na raiz vale
+        A[] a = anos(60);
+        a[40] = new A().mpt(new M().time(30));
+        a[31] = new A().mpt(new M().time(30).hit(0, 10, -30, 4, 4));
+        a[30] = new A().mpt(new M().time(60).speedX(2 << 16));
+        CharData ch = chr(move(new int[]{2, 40}, new int[]{4, 30}), new byte[][] {});
+        Dac dl = dac(a);
+        link(dl, 40, 31);
+        BattleSim bl = battle(dl, ch, dac(anos(2)), 120);
+        int most = 0;
+        for (int i = 0; i < 20; i++) { bl.step(); most = Math.max(most, bl.projectileCount()); }
+        check("flag 0 num link nao cria projetil", most, 0);
+        a[40] = new A().mpt(new M().time(30).hit(0, 10, -30, 4, 4));
+        BattleSim br = battle(dac(a), ch, dac(anos(2)), 120);
+        most = 0;
+        for (int i = 0; i < 20; i++) { br.step(); most = Math.max(most, br.projectileCount()); }
+        check("flag 0 na raiz cria projetil (controle)", most >= 1, true);
+
+        A[] t = anos(60);
+        t[40] = new A().mpt(new M().time(30));
+        t[31] = new A().mpt(new M().time(30).hit(39, 0, 0, 16, 16));
+        Dac dt = dac(t);
+        link(dt, 40, 31);
+        BattleSim tl = battle(dt, ch, dac(anos(2)), 120);
+        for (int i = 0; i < 12; i++) tl.step();
+        int xLink = (int) tl.attackerX();
+        t[40] = new A().mpt(new M().time(30).hit(39, 0, 0, 16, 16));
+        BattleSim tr = battle(dac(t), ch, dac(anos(2)), 120);
+        for (int i = 0; i < 12; i++) tr.step();
+        check("flag 39 num link nao teleporta; na raiz teleporta", xLink + ":" + ((int) tr.attackerX() != 0), "0:true");
+
+        // ---- projetil e efeito de hit sao raizes: mostram os proprios links, e so 1 nivel
+        A[] p = anos(60);
+        p[40] = new A().mpt(new M().time(40).hit(0, 10, -30, 4, 4));
+        p[30] = new A().mpt(new M().time(60).speedX(1 << 16));
+        Dac dp = dac(p);
+        link(dp, 30, 32);
+        link(dp, 32, 33);
+        BattleSim bp = battle(dp, ch, dac(anos(2)), 400);
+        for (int i = 0; i < 6; i++) bp.step();
+        Set<Integer> ps = shown(bp, BattleSim.OWNER_PROJECTILE);
+        check("projetil mostra o link 32 e nao o link do link (33)", ps.contains(Integer.valueOf(30)) + ":" + ps.contains(Integer.valueOf(32)) + ":" + ps.contains(Integer.valueOf(33)), "true:true:false");
+
+        A[] h = anos(60);
+        h[40] = new A().mpt(new M().time(3).hit(2, 20, -40, 40, 20).opt1(3)).mpt(new M().time(30));
+        CharData hc = chr(move(new int[]{2, 40}), new byte[][] {});
+        Dac fx = dac(anos(5));
+        link(fx, 0, 1);
+        link(fx, 1, 2);
+        BattleSim bh = battle(dac(h), hc, fx, 30);
+        Set<Integer> fs = new HashSet<Integer>();
+        for (int i = 0; i < 12; i++) { bh.step(); fs.addAll(shown(bh, BattleSim.OWNER_EFFECT)); }
+        check("efeito de hit mostra o link 1 e nao o link do link (2)", fs.contains(Integer.valueOf(0)) + ":" + fs.contains(Integer.valueOf(1)) + ":" + fs.contains(Integer.valueOf(2)), "true:true:false");
+
+        System.out.println("LinkHierarchyTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/ObjMoveTest.java b/test/ObjMoveTest.java
--- a/test/ObjMoveTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/ObjMoveTest.java	2026-10-23 16:37:47.833245606 +0000
@@ -0,0 +1,208 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.List;
+
+/** ObjModel.move / locate: "Frame de inicio" do menu de Hitbox/Hurtbox (move a box inteira; colisao vira outra faixa) e as cores das faixas. */
+public class ObjMoveTest {
+    static Ano.Mpt mpt(int image) {
+        Ano.Mpt m = new Ano.Mpt();
+        m.image = image; m.flags |= 0x20; m.time = 4; m.normalize();
+        return m;
+    }
+
+    static Ano.Hit hit(int flag, int x) {
+        Ano.Hit h = new Ano.Hit(); h.flag = flag; h.x = x; h.y = 1; h.width = 10; h.height = 11; return h;
+    }
+
+    static Ano.Mpt[] frames(int n) {
+        Ano.Mpt[] m = new Ano.Mpt[n];
+        for (int i = 0; i < n; i++) m[i] = mpt(i);
+        return m;
+    }
+
+    static void put(Ano.Mpt[] m, int f, Ano.Hit... h) {
+        Ano.Hit[] old = (m[f].flags & 0x10) != 0 ? m[f].hits : new Ano.Hit[0];
+        Ano.Hit[] n = new Ano.Hit[old.length + h.length];
+        System.arraycopy(old, 0, n, 0, old.length);
+        System.arraycopy(h, 0, n, old.length, h.length);
+        m[f].hits = n;
+        m[f].flags |= 0x10;
+        m[f].normalize();
+    }
+
+    static ObjModel.Obj find(Ano.Mpt[] m, int flag, int occ) {
+        for (ObjModel.Obj o : ObjModel.objects(m)) if (o.flag == flag && o.occ == occ) return o;
+        return null;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // hitbox (flag 2) nos frames 1-2 (valores diferentes em cada), hurtbox (flag 1) no frame 0
+        Ano.Mpt[] m = frames(6);
+        put(m, 0, hit(1, 50));
+        put(m, 1, hit(2, 10));
+        put(m, 2, hit(2, 20));
+        ObjModel.Obj o = find(m, 2, 0);
+        check("objeto inicial: 2 frames com valores diferentes sao 2 objetos", o != null && o.f0 == 1 && o.f1 == 1, true);
+        // junta: mesmo valor nos dois frames
+        m[2].hits[0].x = 10;
+        o = find(m, 2, 0);
+        check("objeto de 2 frames", o != null && o.f0 == 1 && o.f1 == 2, true);
+
+        Ano.Mpt[] mv = ObjModel.move(m, o, 3);
+        ObjModel.Obj n = ObjModel.locate(mv, 2, 3);
+        check("mover: comeca no frame novo e mantem a duracao", n != null && n.f0 == 3 && n.f1 == 4, true);
+        check("mover: some dos frames antigos", ObjModel.find(mv[1], 2, 0) == null && ObjModel.find(mv[2], 2, 0) == null, true);
+        check("mover: mantem os valores do hit", ObjModel.find(mv[3], 2, 0).x == 10 && ObjModel.find(mv[4], 2, 0).width == 10, true);
+        check("mover: hurtbox e outros frames intactos", ObjModel.find(mv[0], 1, 0).x == 50 && mv[5] == m[5], true);
+        check("mover: nao altera a lista original", ObjModel.find(m[1], 2, 0) != null && ObjModel.find(m[3], 2, 0) == null, true);
+
+        // limite do fim: 2 frames numa ANO de 6 => inicio maximo 4
+        Ano.Mpt[] end = ObjModel.move(m, o, 99);
+        ObjModel.Obj e = ObjModel.locate(end, 2, 4);
+        check("mover: prende no fim da ANO", e != null && e.f0 == 4 && e.f1 == 5, true);
+        Ano.Mpt[] start = ObjModel.move(m, o, -5);
+        check("mover: prende no inicio", ObjModel.locate(start, 2, 0) != null && ObjModel.locate(start, 2, 0).f1 == 1, true);
+        check("mover para o mesmo inicio nao muda", ObjModel.move(m, o, o.f0) == m, true);
+
+        // mover para sobrepor o proprio trecho (1-2 -> 2-3): sem colisao consigo mesmo
+        Ano.Mpt[] ov = ObjModel.move(m, o, 2);
+        ObjModel.Obj on = ObjModel.locate(ov, 2, 2);
+        check("mover sobrepondo o proprio trecho: 1 so objeto de 2 frames", on != null && on.f0 == 2 && on.f1 == 3 && on.occ == 0 && ObjModel.find(ov[1], 2, 0) == null, true);
+
+        // colisao: outra hitbox igual (flag 2) nos frames 3-4; mover a primeira para la nao recusa e cria a segunda faixa
+        Ano.Mpt[] c = frames(6);
+        put(c, 1, hit(2, 10));
+        put(c, 2, hit(2, 10));
+        put(c, 3, hit(2, 99));
+        put(c, 4, hit(2, 99));
+        ObjModel.Obj first = find(c, 2, 0);
+        ObjModel.Obj a0 = null;
+        for (ObjModel.Obj k : ObjModel.objects(c)) if (k.flag == 2 && k.f0 == 1) a0 = k;
+        check("colisao: objeto de origem achado", a0 != null && a0.f1 == 2, true);
+        Ano.Mpt[] cm = ObjModel.move(c, a0, 3);
+        check("colisao: nao recusa (devolve outro array)", cm != c, true);
+        check("colisao: frame de destino tem 2 hitboxes (outra faixa)", ObjModel.count(cm[3], 2) == 2 && ObjModel.count(cm[4], 2) == 2, true);
+        ObjModel.Obj moved = ObjModel.locate(cm, 2, 3);
+        check("colisao: locate acha a movida na faixa seguinte (occ 1) com os valores dela", moved != null && moved.occ == 1 && ObjModel.find(cm[3], 2, 1).x == 10, true);
+        check("colisao: a original continua na faixa 0", ObjModel.find(cm[3], 2, 0).x == 99, true);
+        int lanes = 0;
+        for (ObjModel.Obj k : ObjModel.objects(cm)) if (k.flag == 2) lanes = Math.max(lanes, k.occ + 1);
+        check("colisao: a timeline passa a ter 2 faixas dessa flag", lanes, 2);
+
+        // dano e reacao (OPT 0 e 1) acompanham a hitbox, cada frame leva o seu
+        Ano.Mpt[] d = frames(6);
+        put(d, 1, hit(2, 10));
+        put(d, 2, hit(2, 10));
+        d[1] = ObjModel.setOptField(ObjModel.setOptField(d[1], 0, 77), 1, 105);
+        d[2] = ObjModel.setOptField(ObjModel.setOptField(d[2], 0, 66), 1, 72);
+        ObjModel.Obj od = find(d, 2, 0);
+        check("dano: objeto de 2 frames", od != null && od.f0 == 1 && od.f1 == 2, true);
+        Ano.Mpt[] dm = ObjModel.move(d, od, 3);
+        check("dano e reacao andam junto, cada frame com o seu",
+                ObjModel.optField(dm[3], 0) == 77 && ObjModel.optField(dm[3], 1) == 105 && ObjModel.optField(dm[4], 0) == 66 && ObjModel.optField(dm[4], 1) == 72, true);
+        check("dano e reacao somem do frame antigo e o bloco OPT vazio sai", ObjModel.optField(dm[1], 0) == 0 && ObjModel.optField(dm[1], 1) == 0 && (dm[1].flags & 0x40) == 0 && (dm[2].flags & 0x40) == 0, true);
+        check("mover nao altera os frames originais", ObjModel.optField(d[1], 0) == 77, true);
+
+        // outros campos do OPT (optFlag e dados 2-3) ficam; so dano/reacao saem
+        Ano.Mpt[] f = frames(5);
+        put(f, 1, hit(2, 10));
+        f[1] = ObjModel.setOptField(ObjModel.setOptField(f[1], 0, 9), 1, 33);
+        f[1].optData[2] = 4;
+        f[1] = ObjModel.setOptFlagBit(f[1], 512, true);
+        Ano.Mpt[] fm = ObjModel.move(f, find(f, 2, 0), 3);
+        check("OPT: flags e dados 2-3 ficam no frame antigo", (fm[1].flags & 0x40) != 0 && fm[1].optData[2] == 4 && ObjModel.optFlagBit(fm[1], 512)
+                && ObjModel.optField(fm[1], 0) == 0 && ObjModel.optField(fm[1], 1) == 0, true);
+        check("OPT: destino recebe so dano e reacao", ObjModel.optField(fm[3], 0) == 9 && ObjModel.optField(fm[3], 1) == 33 && fm[3].optData[2] == 0 && !ObjModel.optFlagBit(fm[3], 512), true);
+
+        // frame antigo com 2a hitbox: o valor fica (vale para ela tambem)
+        Ano.Mpt[] g = frames(5);
+        put(g, 1, hit(2, 10), hit(2, 50));
+        g[1] = ObjModel.setOptField(ObjModel.setOptField(g[1], 0, 20), 1, 40);
+        ObjModel.Obj g0 = null;
+        for (ObjModel.Obj k : ObjModel.objects(g)) if (k.flag == 2 && k.occ == 0) g0 = k;
+        Ano.Mpt[] gm = ObjModel.move(g, g0, 3);
+        check("2a hitbox no frame antigo: dano e reacao ficam la e tambem vao", ObjModel.optField(gm[1], 0) == 20 && ObjModel.optField(gm[3], 0) == 20 && ObjModel.optField(gm[3], 1) == 40, true);
+
+        // colisao: o destino ja tem hitbox com dano proprio, que e mantido
+        Ano.Mpt[] h2 = frames(5);
+        put(h2, 1, hit(2, 10));
+        put(h2, 3, hit(2, 99));
+        h2[1] = ObjModel.setOptField(ObjModel.setOptField(h2[1], 0, 11), 1, 22);
+        h2[3] = ObjModel.setOptField(ObjModel.setOptField(h2[3], 0, 88), 1, 77);
+        ObjModel.Obj h0 = null;
+        for (ObjModel.Obj k : ObjModel.objects(h2)) if (k.flag == 2 && k.f0 == 1) h0 = k;
+        Ano.Mpt[] hm = ObjModel.move(h2, h0, 3);
+        check("colisao: o destino mantem o dano e a reacao dele; o antigo e limpo",
+                ObjModel.optField(hm[3], 0) == 88 && ObjModel.optField(hm[3], 1) == 77 && ObjModel.optField(hm[1], 0) == 0 && ObjModel.count(hm[3], 2) == 2, true);
+
+        // hurtbox nao mexe no OPT
+        Ano.Mpt[] u = frames(5);
+        put(u, 1, hit(1, 10));
+        u[1] = ObjModel.setOptField(u[1], 0, 5);
+        Ano.Mpt[] um = ObjModel.move(u, find(u, 1, 0), 3);
+        check("hurtbox: o OPT nao anda", ObjModel.optField(um[1], 0) == 5 && ObjModel.optField(um[3], 0) == 0, true);
+
+        // mover dentro do proprio trecho (1-2 -> 2-3): dano de cada frame segue a box
+        Ano.Mpt[] w = frames(6);
+        put(w, 1, hit(2, 10));
+        put(w, 2, hit(2, 10));
+        w[1] = ObjModel.setOptField(w[1], 0, 31);
+        w[2] = ObjModel.setOptField(w[2], 0, 32);
+        Ano.Mpt[] wm = ObjModel.move(w, find(w, 2, 0), 2);
+        check("mover sobrepondo o proprio trecho: dano segue frame a frame", ObjModel.optField(wm[2], 0) == 31 && ObjModel.optField(wm[3], 0) == 32 && ObjModel.optField(wm[1], 0) == 0, true);
+
+        // ---- duracao (trim): dano e reacao tambem sao copiados / zerados
+        Ano.Mpt[] t = frames(8);
+        put(t, 2, hit(2, 10));
+        put(t, 3, hit(2, 10));
+        t[2] = ObjModel.setOptField(ObjModel.setOptField(t[2], 0, 40), 1, 105);
+        t[3] = ObjModel.setOptField(ObjModel.setOptField(t[3], 0, 41), 1, 106);
+        ObjModel.Obj ot = find(t, 2, 0);
+        Ano.Mpt[] tf = ObjModel.trim(t, ot, 2, 5);      // cresce para frente: copia o par da borda (frame 3)
+        check("trim para frente copia o dano e a reacao da borda", ObjModel.optField(tf[4], 0) == 41 && ObjModel.optField(tf[5], 1) == 106 && ObjModel.optField(tf[3], 0) == 41, true);
+        check("trim: hit nos frames novos", ObjModel.find(tf[4], 2, 0) != null && ObjModel.find(tf[5], 2, 0) != null && ObjModel.find(tf[6], 2, 0) == null, true);
+        Ano.Mpt[] tb = ObjModel.trim(t, ot, 0, 3);      // cresce para tras: copia o par da borda (frame 2)
+        check("trim para tras copia o dano e a reacao da borda", ObjModel.optField(tb[0], 0) == 40 && ObjModel.optField(tb[1], 1) == 105, true);
+        Ano.Mpt[] ts = ObjModel.trim(t, ot, 2, 2);      // encolhe: o frame que sai perde dano e reacao
+        check("trim encolhendo zera dano e reacao do frame que sai", ObjModel.optField(ts[3], 0) == 0 && ObjModel.optField(ts[3], 1) == 0 && (ts[3].flags & 0x40) == 0 && ObjModel.optField(ts[2], 0) == 40, true);
+        check("trim nao altera a lista original", ObjModel.optField(t[3], 0) == 41 && ObjModel.optField(t[4], 0) == 0, true);
+
+        // destino com hitbox propria (colisao) mantem o dano dele
+        Ano.Mpt[] tc = frames(6);
+        put(tc, 1, hit(2, 10));
+        put(tc, 2, hit(2, 99));
+        tc[1] = ObjModel.setOptField(tc[1], 0, 5);
+        tc[2] = ObjModel.setOptField(tc[2], 0, 66);
+        ObjModel.Obj o1 = null;
+        for (ObjModel.Obj k : ObjModel.objects(tc)) if (k.flag == 2 && k.f0 == 1) o1 = k;
+        Ano.Mpt[] tcm = ObjModel.trim(tc, o1, 1, 2);
+        check("trim sobre outra hitbox: o destino mantem o dano dele", ObjModel.optField(tcm[2], 0) == 66 && ObjModel.count(tcm[2], 2) == 2, true);
+
+        // hurtbox: o OPT nao muda
+        Ano.Mpt[] th = frames(6);
+        put(th, 1, hit(1, 10));
+        th[1] = ObjModel.setOptField(th[1], 0, 5);
+        Ano.Mpt[] thm = ObjModel.trim(th, find(th, 1, 0), 1, 3);
+        check("trim de hurtbox nao copia dano", ObjModel.optField(thm[2], 0) == 0 && ObjModel.optField(thm[1], 0) == 5, true);
+
+        // ---- avancar a simulacao ate um frame (previa parada)
+        A[] aa = new A[1];
+        aa[0] = new A().mpt(new M().time(5).img(1)).mpt(new M().time(5).img(2).hit(1, -10, -60, 20, 60)).mpt(new M().time(5).img(3).hit(2, 10, -50, 30, 20)).mpt(new M().time(5).img(4));
+        Dac dd = dac(aa);
+        AttackSim s0 = new AttackSim(dd, 0, false);
+        check("advanceToPat chega ao frame pedido", AnimPreview.advanceToPat(s0, 2) && s0.root().pat == 2, true);
+        check("no frame pedido as boxes sao as dele (so a hitbox)", s0.root().hits.length == 1 && s0.root().hits[0].flag == 2, true);
+        AttackSim s1 = new AttackSim(dd, 0, false);
+        check("advanceToPat no frame 0 nao anda", AnimPreview.advanceToPat(s1, 0) && s1.root().pat == 0, true);
+        AttackSim s2 = new AttackSim(dd, 0, false);
+        check("advanceToPat de frame inexistente devolve false e para no fim", !AnimPreview.advanceToPat(s2, 99), true);
+
+        // cores das faixas: hitbox vermelha, audio azul (ver TimelineView.C_AUDIO)
+        check("cor da faixa Hitbox = vermelho", ObjModel.KIND_COLORS[ObjModel.HITBOX], 0xFFE5484D);
+        check("cor da faixa Hurtbox continua verde", ObjModel.KIND_COLORS[ObjModel.HURTBOX], 0xFF3DDC84);
+
+        System.out.println("ObjMoveTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/SpawnDiagTest.java b/test/SpawnDiagTest.java
--- a/test/SpawnDiagTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/SpawnDiagTest.java	2026-10-24 00:00:42.026154800 +0000
@@ -0,0 +1,206 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/**
+ * Projetil que o golpe pede (hit flag 0) e nao nasce: o simulador copia o jogo (StartPlayerAttack escolhe PROJETIL_ANIM_NORMAL /
+ * ABAIXO / ACIMA pela altura relativa; zero = nada nasce; BulletNum < 8), entao o aviso diz QUAL campo/limite falhou.
+ */
+public class SpawnDiagTest {
+    static final int N = 60;
+
+    static A[] anos() {
+        A[] a = new A[N];
+        for (int i = 0; i < N; i++) a[i] = new A().mpt(new M().time(1));
+        return a;
+    }
+
+    static BattleSim sim(Dac d, CharData ch, CharData.Move mv, int dist, int atkH, int oppH) throws Exception {
+        A[] def = new A[25];
+        for (int i = 0; i < 25; i++) def[i] = new A().mpt(new M().time(5).hit(1, -10, -60, 20, 60));
+        GameData g = gd(new byte[][] { null, null, null, react(new int[]{4, 4, 20, 10, 0, 0, 0, 10, 0, 0, 0, 0, 0, 0}) });
+        Dac fx = dac(new A().mpt(new M().time(4)), new A().mpt(new M().time(4)));
+        // oppHeightPx e estatico e fresh() (usado por measureLength) o le de novo: fica ligado ate o fim da medicao
+        BattleSim.oppHeightPx = oppH;
+        return new BattleSim(d, ch, mv, false, dac(def), fx, g, dist, atkH, 0);
+    }
+
+    static String problem(Dac d, CharData ch, CharData.Move mv, int dist, int atkH, int oppH) throws Exception {
+        try {
+            BattleSim s = sim(d, ch, mv, dist, atkH, oppH);
+            check("antes da medicao nada a avisar", s.spawnProblem(), "");
+            s.measureLength();
+            return s.spawnProblem();
+        } finally { BattleSim.oppHeightPx = 0; }
+    }
+
+    static boolean has(String s, String... parts) {
+        for (String p : parts) if (!s.contains(p)) return false;
+        return true;
+    }
+
+    public static void main(String[] args) throws Exception {
+        A[] a = anos();
+        a[40] = new A().mpt(new M().time(2).hit(0, 10, -30, 4, 4)).mpt(new M().time(20));
+        a[30] = new A().mpt(new M().time(60).speedX(2 << 16).hit(2, 0, -30, 16, 20).opt1(3));
+        Dac d = dac(a);
+
+        // tudo certo: PROJETIL_ANIM_NORMAL = 30 e ANO existe
+        CharData ok = chr(move(new int[]{2, 40}, new int[]{4, 30}), new byte[][] {});
+        check("projetil nasce: sem aviso", problem(d, ok, ok.moves[0], 120, 0, 0), "");
+
+        // campo NORMAL vazio
+        CharData noNormal = chr(move(new int[]{2, 40}, new int[]{36, 30}), new byte[][] {});
+        String p = problem(d, noNormal, noNormal.moves[0], 120, 0, 0);
+        check("NORMAL vazio: aponta o campo", has(p, "PROJETIL_ANIM_NORMAL", "vazio"), true);
+        BattleSim s = sim(d, noNormal, noNormal.moves[0], 120, 0, 0);
+        s.measureLength();
+        check("NORMAL vazio: ajuste nao e a altura", s.spawnProblemByHeight(), false);
+        BattleSim.oppHeightPx = 0;
+
+        // oponente 60 px acima do chao e atacante no chao => atacante 60 px ABAIXO => PROJETIL_ANIM_ABAIXO (offset 34) vazio
+        CharData onlyNormal = chr(move(new int[]{2, 40}, new int[]{4, 30}), new byte[][] {});
+        s = sim(d, onlyNormal, onlyNormal.moves[0], 120, 0, 60);
+        s.measureLength();
+        BattleSim.oppHeightPx = 0;
+        p = s.spawnProblem();
+        check("ABAIXO vazio: campo, diferenca e valor do NORMAL", has(p, "PROJETIL_ANIM_ABAIXO", "60 px abaixo", "PROJETIL_ANIM_NORMAL = 30", "POS"), true);
+        check("ABAIXO vazio: resolve pela altura (botao POS)", s.spawnProblemByHeight(), true);
+        // mesma situacao com o campo preenchido: nasce
+        CharData withBelow = chr(move(new int[]{2, 40}, new int[]{4, 30}, new int[]{34, 30}), new byte[][] {});
+        check("ABAIXO preenchido: sem aviso", problem(d, withBelow, withBelow.moves[0], 120, 0, 60), "");
+
+        // atacante 40 px no ar, oponente no chao => ACIMA (offset 36)
+        p = problem(d, onlyNormal, onlyNormal.moves[0], 120, 40, 0);
+        check("ACIMA vazio: campo e diferenca", has(p, "PROJETIL_ANIM_ACIMA", "40 px acima"), true);
+        CharData withAbove = chr(move(new int[]{2, 40}, new int[]{4, 30}, new int[]{36, 30}), new byte[][] {});
+        check("ACIMA preenchido: sem aviso", problem(d, withAbove, withAbove.moves[0], 120, 40, 0), "");
+        // dentro da faixa NORMAL (30 px acima): usa NORMAL e nasce
+        check("30 px acima ainda e NORMAL: sem aviso", problem(d, onlyNormal, onlyNormal.moves[0], 120, 30, 0), "");
+
+        // limite de 8 projeteis vivos (BulletNum < 8)
+        A[] b = anos();
+        A burst = new A();
+        for (int i = 0; i < 12; i++) burst.mpt(new M().time(1).hit(0, 10, -30, 4, 4));
+        burst.mpt(new M().time(20));
+        b[40] = burst;
+        b[30] = new A().mpt(new M().time(250).speedX(1 << 15));
+        p = problem(dac(b), ok, ok.moves[0], 400, 0, 0);
+        check("9o projetil: o limite do jogo nao gera aviso na tela (so no AJUDA)", has(p, "8 vivos") || has(p, "BulletNum"), false);
+        // com 8 ou menos nao avisa
+        A[] c = anos();
+        A few = new A();
+        for (int i = 0; i < 8; i++) few.mpt(new M().time(1).hit(0, 10, -30, 4, 4));
+        few.mpt(new M().time(20));
+        c[40] = few;
+        c[30] = b[30];
+        check("8 projeteis cabem: sem aviso", problem(dac(c), ok, ok.moves[0], 400, 0, 0), "");
+
+        // tiro triplo: ANO+1 e ANO+2 precisam existir (aqui o DAC termina no ANO 45)
+        A[] t = new A[46];
+        for (int i = 0; i < 46; i++) t[i] = new A().mpt(new M().time(1));
+        t[40] = a[40];
+        t[45] = a[30];
+        CharData triple = chr(move(new int[]{0, 4}, new int[]{2, 40}, new int[]{4, 45}), new byte[][] {});
+        p = problem(dac(t), triple, triple.moves[0], 120, 0, 0);
+        check("tiro triplo com ANO+1 inexistente", has(p, "ANO 46", "tiro triplo"), true);
+        A[] t3 = new A[48];
+        for (int i = 0; i < 48; i++) t3[i] = new A().mpt(new M().time(1));
+        t3[40] = a[40];
+        t3[45] = a[30];
+        check("tiro triplo com os 3 ANOs: sem aviso", problem(dac(t3), triple, triple.moves[0], 120, 0, 0), "");
+
+        // projetil que aponta para ANO inexistente
+        CharData ghost = chr(move(new int[]{2, 40}, new int[]{4, 58}), new byte[][] {});
+        A[] g = new A[50];
+        for (int i = 0; i < 50; i++) g[i] = new A().mpt(new M().time(1));
+        g[40] = a[40];
+        p = problem(dac(g), ghost, ghost.moves[0], 120, 0, 0);
+        check("ANO do projetil nao existe", has(p, "ANO 58", "não existe"), true);
+
+        // ANO solto, sem golpe dono: os tres campos zerados
+        CharData.Move solto = CharData.genericFrom(40, null);
+        p = problem(d, ok, solto, 120, 0, 0);
+        check("ANO sem dono: explica", has(p, "não pertence a nenhum golpe"), true);
+        // ANO com dono: herda os campos do golpe e o projetil nasce
+        CharData.Move dono = CharData.genericFrom(40, ok.ownerOf(40));
+        check("ANO com dono: sem aviso", problem(d, ok, dono, 120, 0, 0), "");
+
+        // subprojetil: hit flag 0 dentro do ANO do projetil e SUBPROJETIL_ANIM_ID = 0
+        A[] sp = anos();
+        sp[40] = a[40];
+        sp[30] = new A().mpt(new M().time(3).hit(0, 0, 0, 0, 0)).mpt(new M().time(40).speedX(1 << 16));
+        p = problem(dac(sp), ok, ok.moves[0], 120, 0, 0);
+        check("subprojetil sem ID", has(p, "SUBPROJETIL_ANIM_ID"), true);
+        CharData withSub = chr(move(new int[]{2, 40}, new int[]{4, 30}, new int[]{18, 31}), new byte[][] {});
+        sp[31] = new A().mpt(new M().time(40).speedX(1 << 16));
+        check("subprojetil com ID: sem aviso", problem(dac(sp), withSub, withSub.moves[0], 120, 0, 0), "");
+
+        // regressao do 33: o hit de projetil no frame 0 do ANO do projetil (time 1) era pulado (o app andava um frame antes do 1o _ActReq do jogo)
+        for (int t0 = 1; t0 <= 3; t0++) {
+            A[] q = anos();
+            q[40] = a[40];
+            q[30] = new A().mpt(new M().time(t0).hit(0, 0, 0, 0, 0)).mpt(new M().time(40).speedX(1 << 16));
+            q[31] = new A().mpt(new M().time(40).speedX(1 << 16));
+            BattleSim sq = sim(dac(q), withSub, withSub.moves[0], 300, 0, 0);
+            int most = 0;
+            for (int i = 0; i < 12; i++) { sq.step(); most = Math.max(most, sq.projectileCount()); }
+            check("subprojetil no frame 0 do projetil (time " + t0 + ") nasce", most, 2);
+        }
+
+        // golpe sem hit de projetil nunca avisa, mesmo com os campos vazios
+        A[] nh = anos();
+        nh[40] = new A().mpt(new M().time(5)).mpt(new M().time(5));
+        CharData none = chr(move(new int[]{2, 40}), new byte[][] {});
+        check("sem hit de projetil: sem aviso", problem(dac(nh), none, none.moves[0], 120, 0, 0), "");
+
+        // ---- campos do golpe sao de 16 bits (HDAT 4): ANOs > 255 nao podem ser cortados em 255 (golpe 11: projetil 342)
+        {
+            CharData wide = chr(move(new int[]{2, 95}, new int[]{4, 342}, new int[]{34, 342}, new int[]{36, 342}, new int[]{10, 310}, new int[]{12, 368}), new byte[][] {});
+            CharData.Move wm = wide.moves[0];
+            check("HDAT 4 le 16 bits", wm.projNormal + ":" + wm.projAbaixo + ":" + wm.projAcima + ":" + wm.animSeqChao + ":" + wm.animEndChao, "342:342:342:310:368");
+            CharData.Move cm = wm.copy();
+            cm.clamp();
+            check("clamp nao corta ANO acima de 255", cm.projNormal + ":" + cm.projAbaixo + ":" + cm.projAcima + ":" + cm.animSeqChao, "342:342:342:310");
+            DacText.parseMove("$GOLPE_0:{ $ATK_FLAGS: 16, $ANIM_INICIAL: 95, $PROJETIL_ANIM_NORMAL: 342, $ANIM_SEQ_CHAO: 310 }", cm);
+            check("parseMove aceita ANO 342", cm.projNormal + ":" + cm.animSeqChao + ":" + cm.flags, "342:310:16");
+            A[] big = new A[346];
+            for (int i = 0; i < 346; i++) big[i] = new A().mpt(new M().time(1));
+            big[95] = a[40];
+            big[342] = a[30];
+            BattleSim bs = sim(dac(big), wide, wm, 120, 0, 0);
+            bs.measureLength();
+            BattleSim.oppHeightPx = 0;
+            bs.reset();
+            int ano = -1;
+            for (int i = 0; i < 40 && ano < 0; i++) {
+                bs.step();
+                for (BattleSim.Layer l : bs.layers()) if (l.owner == BattleSim.OWNER_PROJECTILE) ano = l.sim.root().ano.index;
+            }
+            check("projetil 342 nasce com o ANO 342 (nao o 255)", ano, 342);
+            check("golpe com ANO > 255: sem aviso", bs.spawnProblem(), "");
+        }
+
+        // ---- projetil que nasce na SEQ: so existe depois que o golpe acerta
+        {
+            A[] q = anos();
+            q[40] = new A().mpt(new M().time(3).hit(2, 20, -40, 40, 20).opt1(3)).mpt(new M().time(30));
+            q[31] = new A().mpt(new M().time(2).hit(0, 10, -30, 4, 4)).mpt(new M().time(10));
+            q[30] = a[30];
+            CharData seq = chr(move(new int[]{2, 40}, new int[]{4, 30}, new int[]{10, 31}, new int[]{14, 31}), new byte[][] {});
+            check("SEQ com projetil: acertou, sem aviso", problem(dac(q), seq, seq.moves[0], 30, 0, 0), "");
+            String miss = problem(dac(q), seq, seq.moves[0], 400, 0, 0);
+            check("SEQ com projetil: errou, explica", has(miss, "ANO 31", "ANIM_SEQ", "errou", "POS"), true);
+            BattleSim ms = sim(dac(q), seq, seq.moves[0], 400, 0, 0);
+            ms.measureLength();
+            check("SEQ errada: resolve pela distancia (POS)", ms.spawnProblemByHeight(), true);
+            BattleSim.lockFromTick = 0;
+            try {
+                String lock = problem(dac(q), seq, seq.moves[0], 30, 0, 0);
+                check("TRANSICAO travada: explica", has(lock, "TRAVADA", "ANO 31"), true);
+            } finally { BattleSim.lockFromTick = -1; }
+        }
+
+        System.out.println("SpawnDiagTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/ToolbarTest.java b/test/ToolbarTest.java
--- a/test/ToolbarTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/ToolbarTest.java	2026-10-23 11:03:57.390502225 +0000
@@ -0,0 +1,91 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** ToolbarOrder (ordem dos botoes do menu superior) e HelpText (menu AJUDA). */
+public class ToolbarTest {
+    static String s(List<String> l) { return ToolbarOrder.save(l); }
+
+    public static void main(String[] args) throws Exception {
+        List<String> def = ToolbarOrder.defaults();
+        check("padrao: SALVAR fixo no inicio", def.get(0), ToolbarOrder.SAVE);
+        check("padrao: SCREEN (TELA) no fim; AJUDA fica na barra de titulo", def.get(def.size() - 1) + ":" + def.contains("help"), "scr:false");
+        check("padrao: 15 botoes sem repeticao", def.size() + ":" + new HashSet<String>(def).size(), "14:14");
+
+        // restaurar
+        check("sem nada salvo: padrao", s(ToolbarOrder.restore(null, def)), s(def));
+        check("texto vazio: padrao", s(ToolbarOrder.restore("", def)), s(def));
+        check("ordem salva volta igual", s(ToolbarOrder.restore(s(ToolbarOrder.move(def, 0, 3)), def)), s(ToolbarOrder.move(def, 0, 3)));
+        List<String> junk = ToolbarOrder.restore("hide,xyz,hide, char ,save", def);
+        check("lixo: desconhecido e repetido saem, o resto vem na ordem de fabrica", s(junk),
+                "hide,char,save,spr,links,opt,hit,time,ctr,land,lock,flip,ghost,scr");
+        check("lixo: mantem 14 ids", junk.size(), 14);
+        List<String> older = Arrays.asList(ToolbarOrder.SAVE, ToolbarOrder.CHAR);
+        check("botao novo (nao salvo) entra no fim", s(ToolbarOrder.restore("char,save", ToolbarOrder.defaults())).endsWith(",scr"), true);
+        check("ordem salva de versao anterior com help: descartado", s(ToolbarOrder.restore("help,char,save", ToolbarOrder.defaults())).contains("help"), false);
+        check("botao ausente da build nao entra", s(ToolbarOrder.restore("char,save,scr", older)), "char,save");
+
+        // mover
+        check("mover para tras fica antes do alvo", s(ToolbarOrder.move(Arrays.asList("a", "b", "c", "d"), 3, 1)), "a,d,b,c");
+        check("mover para frente fica depois do alvo", s(ToolbarOrder.move(Arrays.asList("a", "b", "c", "d"), 0, 2)), "b,c,a,d");
+        check("mover para o slot fixo", s(ToolbarOrder.move(Arrays.asList("a", "b", "c", "d"), 2, 0)), "c,a,b,d");
+        check("mover para o mesmo lugar nao muda", s(ToolbarOrder.move(Arrays.asList("a", "b", "c"), 1, 1)), "a,b,c");
+        check("destino fora da lista prende na ponta", s(ToolbarOrder.move(Arrays.asList("a", "b", "c"), 0, 9)) + "|" + s(ToolbarOrder.move(Arrays.asList("a", "b", "c"), 2, -4)), "b,c,a|c,a,b");
+        check("origem invalida nao muda", s(ToolbarOrder.move(Arrays.asList("a", "b"), 5, 0)), "a,b");
+        check("lista vazia", ToolbarOrder.move(Arrays.<String>asList(), 0, 0).size(), 0);
+        List<String> orig = Arrays.asList("a", "b", "c");
+        ToolbarOrder.move(orig, 0, 2);
+        check("move devolve copia", s(orig), "a,b,c");
+        // salvar + restaurar com varios movimentos (arrastar o botao fixo, depois outro para o fixo)
+        List<String> o = ToolbarOrder.move(def, 0, def.size() - 1);
+        o = ToolbarOrder.move(o, 5, 0);
+        check("viagem de ida e volta", s(ToolbarOrder.restore(s(o), ToolbarOrder.defaults())), s(o));
+        check("o primeiro e o que foi solto no slot fixo", o.get(0), def.get(6));
+
+        // ajuda
+        Set<String> ids = new HashSet<String>();
+        for (HelpText.Section sec : HelpText.toolbar()) {
+            check("ajuda " + sec.title + ": tem texto", sec.body.length() > 40 && sec.title.length() > 0, true);
+            ids.add(sec.button);
+        }
+        check("ajuda: um item para cada botao do menu, na ordem de fabrica", HelpText.toolbar().size() + ":" + ids.containsAll(def), "14:true");
+        for (String id : def) check("ajuda do botao " + id, HelpText.forButton(id) != null, true);
+        check("ajuda de id desconhecido", HelpText.forButton("nao-existe"), null);
+        check("ajuda da tela nao tem botao do menu", HelpText.screen().get(0).button, null);
+        check("ajuda: tudo = menu + tela", HelpText.all().size(), HelpText.toolbar().size() + HelpText.screen().size());
+        check("ajuda: dica de reordenar fala em arrastar e no botao fixo", HelpText.REORDER_TIP.contains("arraste") && HelpText.REORDER_TIP.contains("fixo"), true);
+
