+    /**
+     * md 19: os corpos nao se atravessam. Com os dois perto do chao (altura do corpo), sem tremor de hitstop e sem a flag 16 do golpe
+     * (fantasma), quem andou para dentro do outro empurra o outro (metade do passo, passo inteiro se o outro esta em dano); se ainda
+     * sobrepoem, o outro e colocado a uma largura de corpo, respeitando os limites da tela. x[] e a posicao (16.16) dos dois.
+     */
+    private void bodySeparation(int[] x, int[] old, int[] h) {
+        int hA = atkChar == null ? 0 : atkChar.bodyHeight() << 16, hO = oppChar == null ? 0 : oppChar.bodyHeight() << 16;
+        int yA = pendA ? pendAY : atk.root().y;
+        boolean near = yA >= -hA && oppY >= -hO;
+        boolean shaking = defShaking;                                                                        // wObjFlag & 8 do md 876
+        boolean ghost = (move.flags & 16) != 0 && !attackOver && !idleMode;                                    // SpecialKind & 16
+        if (!near || shaking || ghost) return;
+        int w0 = atkChar == null || atkChar.bodyWidth() <= 0 ? h[0] >> 15 : atkChar.bodyWidth();
+        int w1 = oppChar == null || oppChar.bodyWidth() <= 0 ? h[1] >> 15 : oppChar.bodyWidth();
+        int n15 = ((w0 + w1) / 2) << 16;             // (largura0 + largura1) / 2 do HDAT 3, como o jogo (larguras impares)
+        for (int i = 0; i < 2; i++) {
+            int o = 1 - i;
+            int n17 = old[i] - x[i];
+            int n18 = (o == 1 && inDamage) ? n17 : ((n17 >> 16) / 2) << 16;
+            if (old[i] > x[i]) {
+                if (x[i] > x[o] && x[i] < x[o] + n15) {
+                    x[i] &= 0xFFFFFF80;
+                    x[o] &= 0xFFFFFF80;
+                    x[i] = x[o] + n15 - n18;
+                    x[o] -= n18;
+                }
+            } else if (old[i] < x[i] && x[i] < x[o] && x[i] > x[o] - n15) {
+                x[i] &= 0xFFFFFF80;
+                x[o] &= 0xFFFFFF80;
+                x[i] = x[o] - n15 - n18;
+                x[o] -= n18;
+            }
+        }
+        if (camXOff != 0) return;
+        int left = camLeft, right = camLeft + SCREEN_W;
+        boolean[] facingLeft = {atkFacingLeft(), oppFlip};
+        for (int i = 0; i < 2; i++) {
+            int o = 1 - i;
+            if (!(x[i] > x[o] - n15 && x[i] < x[o] + n15)) continue;
+            boolean grounded = i == 0 ? yA == 0 : oppY == 0;
+            if (x[i] == right - h[i] && grounded && facingLeft[i]) { x[o] = x[i] - n15; break; }
+            if (x[i] == left + h[i] && grounded && !facingLeft[i]) { x[o] = x[i] + n15; break; }
+            if (x[o] == right - h[o] && anoOfPlayer(i) != 88) { x[i] = x[o] - n15; break; }
+            if (x[o] == left + h[o] && anoOfPlayer(i) != 88) { x[i] = x[o] + n15; break; }
+            if (x[i] < x[o]) x[o] = x[i] + n15; else x[o] = x[i] - n15;
+            if (i == 1) {
+                if (x[o] >= right - h[o]) { x[o] = right - h[o]; x[i] = x[o] - n15; }
+                else if (x[o] <= left + h[o]) { x[o] = left + h[o]; x[i] = x[o] + n15; }
+            }
+            break;
+        }
+    }
