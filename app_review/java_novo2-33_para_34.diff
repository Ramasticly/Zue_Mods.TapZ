+    /** O defensor vira para o atacante. */
+    private void faceAttacker() {
+        AttackSim.Obj ar = atk.root();
+        int flipRef = (move.projectile || ar == null) ? refAtkX : ar.x;
+        if (oppX != flipRef) oppFlip = oppX >= flipRef;
+        applyFlip(opp, oppFlip);
+    }
