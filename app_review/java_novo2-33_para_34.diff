+    /** O campo do HDAT 4 escolhido pela altura esta vazio: diz qual, a diferenca de altura e o que fazer. */
+    private void noteNoBulletAno() {
+        if (move.generic && !move.hasProjectile()) {
+            noteSpawn("O hit de projétil (flag 0) não gerou nada: este ANO não pertence a nenhum golpe com projétil (os três PROJETIL_ANIM estão vazios). "
+                    + "Abra o golpe dono para ver o projétil nascer.", false);
+            return;
+        }
+        boolean normal = bulletField.equals("PROJETIL_ANIM_NORMAL");
+        if (normal) {
+            noteSpawn("O hit de projétil (flag 0) não gerou nada: PROJETIL_ANIM_NORMAL está vazio (0). Preencha o campo em DADOS / EDITAR > GOLPE.", false);
+            return;
+        }
+        int d = bulletRelPx;
+        noteSpawn("O hit de projétil (flag 0) não gerou nada: com o atacante " + Math.abs(d) + " px " + (d > 0 ? "abaixo" : "acima")
+                + " do oponente o jogo usa " + bulletField + ", que está vazio (0)"
+                + (move.projNormal != 0 ? ", e PROJETIL_ANIM_NORMAL = " + move.projNormal + " só vale com o atacante entre 37 px acima e 51 px abaixo do oponente" : "")
+                + ". Preencha o campo ou mude a altura em POS.", true);
+    }
