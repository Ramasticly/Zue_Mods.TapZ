+    /**
+     * md 883: quando o ANO do golpe termina (wActFlag&2, fora do hitstop) o jogo sai do loop de ataque
+     * (md 864 / 886): a partir dai o md 882 nao roda mais e nenhum hit tardio (projeteis ainda no ar)
+     * troca o ANO do atacante. Excecao: especiais 0/3/6 com repeticao (ANO 42, tiros extras).
+     */
+    private void checkAttackOver() {
+        if (attackOver || move.generic) return;
+        AttackSim.Obj r = atk.root();
+        if (r == null || !r.isDone() || hsAtk > 0) return;
+        boolean rapid = (specialType == 0 || specialType == 3 || specialType == 6) && move.maxRep != 0;
+        if (rapid) return;
+        attackOver = true;
+        lastHit += " [ataque terminou: md 864]";
+    }
+
+    public boolean attackOver() { return attackOver; }
+
+    /** Opcional (endOnSeqFinish): fim da SEQ leva a ANIM_END. */
+    private void checkEnd() {
+        if (!endOnSeqFinish || phase != 1) return;
+        AttackSim.Obj r = atk.root();
+        if (r == null || !r.isDone()) return;
+        boolean air = r.y != 0;
+        int end = air ? move.animEndAr : move.animEndChao;
+        phase = 2;
+        transKind = 1;
+        if (end > 0 && switchAtk(end)) lastHit += " -> ANIM_END " + end;
+    }
