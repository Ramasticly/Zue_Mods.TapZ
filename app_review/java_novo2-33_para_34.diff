+    private static final String LAND_MSG = "Animação/golpe acabou antes por causa do pouso. Experimente mudar a posição do personagem para ver o movimento completo.";
+    private boolean landSeen;                 // o pouso antecipado ja aconteceu na simulacao atual
+    private boolean measuredEarly;            // a medicao completa do golpe pousou antes do fim
+    private String warnKey = "", dismissedKey = "";
