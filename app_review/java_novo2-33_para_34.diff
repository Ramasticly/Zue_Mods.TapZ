+        this.scroll = scroll;
+        this.strip = strip;
+        this.buttons = buttons;
+        this.prefs = a.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        this.density = a.getResources().getDisplayMetrics().density;
