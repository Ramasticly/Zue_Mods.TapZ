+    // ---- busca ----
+
+    static final class Hit {
+        final Chapter chapter;
+        final Section section;
+        /** true = aba / menu (faixa "ABAS E MENUS"); false = texto dentro de um capitulo. */
+        final boolean tab;
+        final int score;
+        /** Trecho do texto onde a busca bateu (so nos textos); vazio nas abas. */
+        final String snippet;
+
+        Hit(Chapter chapter, Section section, boolean tab, int score, String snippet) {
+            this.chapter = chapter;
+            this.section = section;
+            this.tab = tab;
+            this.score = score;
+            this.snippet = snippet;
+        }
+    }
+
+    /** Minusculas e sem acentos, caractere por caractere (o tamanho nao muda, para os trechos do texto original baterem). */
+    static String norm(String s) {
+        if (s == null) return "";
+        StringBuilder b = new StringBuilder(s.length());
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            if (ch < 128) { b.append(Character.toLowerCase(ch)); continue; }
+            String n = java.text.Normalizer.normalize(String.valueOf(ch), java.text.Normalizer.Form.NFD);
+            char base = n.isEmpty() ? ch : n.charAt(0);
+            b.append(Character.toLowerCase(base));
+        }
+        return b.toString();
+    }
+
+    private static final java.util.regex.Pattern WORD = java.util.regex.Pattern.compile("[a-z0-9_]+");
+
+    private static String[] tokens(String normText) {
+        List<String> l = new ArrayList<String>();
+        java.util.regex.Matcher m = WORD.matcher(normText);
+        while (m.find()) l.add(m.group());
+        return l.toArray(new String[0]);
+    }
+
