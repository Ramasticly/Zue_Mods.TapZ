diff -ruN a/CharGrid.java b/CharGrid.java
--- a/CharGrid.java	1970-01-01 00:00:00.000000000 +0000
+++ b/CharGrid.java	2026-10-29 17:27:57.940274739 +0000
@@ -0,0 +1,61 @@
+package com.zue.attackeditor;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Logica pura da grade de escolha de personagens (atacante / oponente): nomes, ANO da previa, destaque e quais previas manter na memoria. */
+final class CharGrid {
+    private CharGrid() { }
+
+    /** ANO mostrada na previa de cada personagem. */
+    static final int PREVIEW_ANO = 76;
+    static final int COLUMNS = 3;
+    /** Quantas previas (DAC + CNV + sprites) ficam carregadas ao mesmo tempo. */
+    static final int KEEP = 15;
+
+    /** ANO da previa: a 76 se o personagem a tem; senao a 0 (parado); -1 se nem essa existe. */
+    static int previewAno(Dac d) {
+        if (d == null) return -1;
+        return usable(d.getAno(PREVIEW_ANO)) ? PREVIEW_ANO : usable(d.getAno(0)) ? 0 : -1;
+    }
+
+    private static boolean usable(Ano a) { return a != null && a.present && a.mpts.length > 0; }
+
+    /** Nomes das pastas, na ordem dada. */
+    static List<String> names(List<File> dirs) {
+        List<String> out = new ArrayList<String>();
+        for (File f : dirs) out.add(f.getName());
+        return out;
+    }
+
+    /** Indice do personagem pelo nome; -1 se nao esta na lista. */
+    static int indexOf(List<String> names, String name) {
+        return names.indexOf(name);
+    }
+
+    /** O cartao {@code i} e o personagem atual (vem destacado). */
+    static boolean isCurrent(int i, int selected) { return i == selected; }
+
+    /** Primeiro cartao a mostrar ao abrir: a linha do atual fica no topo (uma linha de folga acima, se houver). */
+    static int scrollTo(int selected, int count) {
+        if (selected < 0 || selected >= count) return 0;
+        int row = selected / COLUMNS;
+        return Math.max(0, row - 1) * COLUMNS;
+    }
+
+    /**
+     * Qual previa descarregar quando passa de {@link #KEEP}: a mais antiga (ordem de uso) que nao esta na tela; -1 se nada a descarregar.
+     * {@code attached}: para cada previa carregada, da mais antiga para a mais nova, se a View dela ainda esta na tela.
+     */
+    static int evict(List<Boolean> attached) {
+        if (attached.size() <= KEEP) return -1;
+        for (int i = 0; i < attached.size(); i++) if (!attached.get(i).booleanValue()) return i;
+        return -1;
+    }
+
+    /** Rotulo do cartao: nome da pasta, com marca no atual. */
+    static String label(String name, boolean current) {
+        return current ? "✓ " + name + "  (atual)" : name;
+    }
+}
diff -ruN a/CharPicker.java b/CharPicker.java
--- a/CharPicker.java	1970-01-01 00:00:00.000000000 +0000
+++ b/CharPicker.java	2026-10-30 01:22:05.747101112 +0000
@@ -0,0 +1,193 @@
+package com.zue.attackeditor;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.BaseAdapter;
+import android.widget.GridView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Escolha de personagem em grade escura: cada pasta charNN com a previa animada da ANO 76 dela (ou a 0). O DAC, o CNV e as sprites de cada um so
+ * carregam quando o cartao aparece (fora da thread da tela) e as mais antigas fora da tela sao descarregadas; tudo e liberado ao fechar.
+ */
+final class CharPicker {
+    interface Listener { void onPick(int index); }
+
+    private static final class Entry {
+        CharAssets assets;
+        AnimPreview view;
+    }
+
+    private final Activity a;
+    private final List<File> dirs;
+    private final int selected;
+    private final Listener listener;
+    private final float d;
+    private Dialog dlg;
+    private boolean closed;
+    private final ExecutorService pool = Executors.newSingleThreadExecutor();
+    private final Map<Integer, Entry> loaded = new LinkedHashMap<Integer, Entry>();
+
+    static void show(Activity a, String title, List<File> dirs, int selected, Listener l) {
+        new CharPicker(a, dirs, selected, l).open(title);
+    }
+
+    private CharPicker(Activity a, List<File> dirs, int selected, Listener l) {
+        this.a = a; this.dirs = dirs; this.selected = selected; this.listener = l;
+        this.d = a.getResources().getDisplayMetrics().density;
+    }
+
+    private int dp(int v) { return Math.round(v * d); }
+
+    private TextView tv(String s, int sp, int color, boolean bold) {
+        TextView t = new I18nTextView(a);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        return t;
+    }
+
+    private void open(String title) {
+        dlg = new Dialog(a, android.R.style.Theme_DeviceDefault_NoActionBar_Fullscreen);
+        LinearLayout root = new LinearLayout(a);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(LayoutManager.BG);
+        root.setPadding(dp(10), dp(12), dp(10), dp(10));
+        dlg.setContentView(root);
+        LinearLayout h = new LinearLayout(a);
+        h.setGravity(Gravity.CENTER_VERTICAL);
+        h.addView(tv(title, 17, LayoutManager.TEXT, true), new LinearLayout.LayoutParams(0, -2, 1f));
+        TextView x = tv("✕", 20, LayoutManager.TEXT, true);
+        x.setGravity(Gravity.CENTER);
+        x.setOnClickListener(new View.OnClickListener() { public void onClick(View v) { dlg.dismiss(); } });
+        h.addView(x, new LinearLayout.LayoutParams(dp(44), dp(40)));
+        root.addView(h);
+        TextView hint = tv("Cada personagem mostra a ANO " + CharGrid.PREVIEW_ANO + " dele (a ANO 0 se não tiver). Toque para escolher.", 11, LayoutManager.DIM, false);
+        hint.setPadding(dp(2), dp(2), dp(2), dp(8));
+        root.addView(hint);
+
+        final GridView gv = new GridView(a);
+        gv.setNumColumns(CharGrid.COLUMNS);
+        gv.setVerticalSpacing(dp(6));
+        gv.setHorizontalSpacing(dp(6));
+        final int side = (a.getResources().getDisplayMetrics().widthPixels - dp(20) - dp(12)) / CharGrid.COLUMNS - dp(8);
+        gv.setAdapter(new BaseAdapter() {
+            @Override public int getCount() { return dirs.size(); }
+            @Override public Object getItem(int i) { return Integer.valueOf(i); }
+            @Override public long getItemId(int i) { return i; }
+            @Override public View getView(final int i, View cv, ViewGroup parent) {
+                boolean cur = CharGrid.isCurrent(i, selected);
+                LinearLayout cell = new LinearLayout(a);
+                cell.setOrientation(LinearLayout.VERTICAL);
+                cell.setGravity(Gravity.CENTER_HORIZONTAL);
+                GradientDrawable g = new GradientDrawable();
+                g.setColor(cur ? LayoutManager.PANEL_HI : LayoutManager.PANEL);
+                g.setCornerRadius(dp(8));
+                if (cur) g.setStroke(dp(2), LayoutManager.ACCENT);
+                cell.setBackground(g);
+                cell.setPadding(dp(3), dp(3), dp(3), dp(3));
+                AnimPreview pv = new AnimPreview(a);
+                pv.setZoom(1.2f);
+                pv.setBackgroundColor(0xFF0D0F13);
+                pv.setLoading(true);
+                cell.addView(pv, new LinearLayout.LayoutParams(side, side));
+                TextView n = tv(CharGrid.label(dirs.get(i).getName(), cur), 11, cur ? LayoutManager.ACCENT : LayoutManager.TEXT, true);
+                n.setGravity(Gravity.CENTER);
+                cell.addView(n);
+                cell.setOnClickListener(new View.OnClickListener() { public void onClick(View v) { dlg.dismiss(); listener.onPick(i); } });
+                bind(i, pv);
+                return cell;
+            }
+        });
+        root.addView(gv, new LinearLayout.LayoutParams(-1, 0, 1f));
+        TextView back = tv("VOLTAR", 13, LayoutManager.DIM, true);
+        back.setGravity(Gravity.CENTER);
+        back.setPadding(dp(10), dp(12), dp(10), dp(12));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(LayoutManager.PANEL_HI);
+        bg.setCornerRadius(dp(8));
+        back.setBackground(bg);
+        back.setOnClickListener(new View.OnClickListener() { public void onClick(View v) { dlg.dismiss(); } });
+        root.addView(back);
+        dlg.setOnDismissListener(new android.content.DialogInterface.OnDismissListener() {
+            public void onDismiss(android.content.DialogInterface di) { closeAll(); }
+        });
+        dlg.show();
+        gv.setSelection(CharGrid.scrollTo(selected, dirs.size()));
+    }
+
+    /** Liga a View do cartao ao personagem {@code i}: usa o que ja esta carregado ou carrega em segundo plano. */
+    private void bind(final int i, final AnimPreview pv) {
+        Entry e = loaded.get(i);
+        if (e != null && e.assets != null) {
+            loaded.remove(i);                    // reinsere no fim: mais recente
+            loaded.put(i, e);
+            e.view = pv;
+            show(e.assets, pv);
+            return;
+        }
+        pool.execute(new Runnable() { public void run() {
+            if (closed) return;
+            CharAssets ca;
+            try { ca = CharAssets.loadPreview(dirs.get(i)); }
+            catch (Throwable t) { a.runOnUiThread(new Runnable() { public void run() { if (!closed) pv.setLoading(false); } }); return; }
+            final CharAssets got = ca;
+            a.runOnUiThread(new Runnable() { public void run() {
+                if (closed) { got.release(); return; }
+                Entry old = loaded.get(i);
+                if (old != null && old.assets != null) got.release();
+                else {
+                    Entry en = new Entry();
+                    en.assets = got;
+                    loaded.put(i, en);
+                    old = en;
+                }
+                old.view = pv;
+                show(old.assets, pv);
+                trim();
+            } });
+        } });
+    }
+
+    private static void show(CharAssets ca, AnimPreview pv) {
+        int ano = CharGrid.previewAno(ca.dac);
+        if (ano >= 0) pv.set(ca.dac, ca.sprites, ano);
+        else pv.setLoading(false);                   // terminou de carregar e nao ha ANO 76 nem 0: "sem animacao"
+    }
+
+    /** Passou de KEEP: descarrega as mais antigas cujo cartao ja saiu da tela. */
+    private void trim() {
+        while (true) {
+            List<Integer> keys = new ArrayList<Integer>(loaded.keySet());
+            List<Boolean> att = new ArrayList<Boolean>();
+            for (Integer k : keys) { Entry e = loaded.get(k); att.add(Boolean.valueOf(e.view != null && e.view.isAttachedToWindow())); }
+            int v = CharGrid.evict(att);
+            if (v < 0) return;
+            Entry e = loaded.remove(keys.get(v));
+            if (e != null && e.view != null) e.view.set(null, null, -1);        // a View nao desenha mais bitmaps liberados
+            if (e != null && e.assets != null) e.assets.release();
+        }
+    }
+
+    private void closeAll() {
+        closed = true;
+        pool.shutdownNow();
+        for (Entry e : loaded.values()) if (e.assets != null) e.assets.release();
+        loaded.clear();
+    }
+}
diff -ruN a/CineNotice.java b/CineNotice.java
--- a/CineNotice.java	1970-01-01 00:00:00.000000000 +0000
+++ b/CineNotice.java	2026-10-30 00:10:00.233581238 +0000
@@ -0,0 +1,36 @@
+package com.zue.attackeditor;
+
+/**
+ * Aviso da trava cinematica ao avancar tick pelo botao (Java puro), no estilo do {@link HitstopNotice}: o especial (9-12) congela tudo por
+ * N ticks (md 923/926 do jogo) com o zoom da camera; enquanto isso o contador de tick mostrado fica travado e o aviso (com o botao PULAR) diz
+ * quantos ticks faltam. Quando a trava acaba (ou e pulada) o aviso some e o tick e liberado.
+ */
+final class CineNotice {
+    private int left;
+    private int locked = -1;
+
+    /** Depois de um passo do botao: {@code tick} = tick da simulacao agora, {@code cineLeft} = ticks de trava que ainda faltam. */
+    void afterStep(int tick, int cineLeft) {
+        if (cineLeft > 0) {
+            if (left == 0) locked = tick;          // entrou na trava: o numero do tick fica neste
+            left = cineLeft;
+        } else {
+            left = 0;
+            locked = -1;
+        }
+    }
+
+    void clear() { left = 0; locked = -1; }
+
+    boolean active() { return left > 0; }
+    int left() { return left; }
+
+    /** Tick a mostrar: o travado durante a trava, o real no resto. */
+    int shownTick(int realTick) { return active() ? locked : realTick; }
+
+    /** Texto do aviso amarelo. */
+    String text() {
+        return "Trava cinemática: tudo fica congelado por mais " + left + (left == 1 ? " tick" : " ticks")
+                + " e a câmera dá zoom de 200%. PULAR passa pela trava e libera o tick.";
+    }
+}
