+    static Ano.Hit hit(int flag) {
+        Ano.Hit h = new Ano.Hit();
+        h.flag = flag;
+        return h;
+    }
+
+    static Ano.Mpt mpt(int hits, int flag) {
+        Ano.Mpt m = new Ano.Mpt();
+        m.hasTime = true;
+        m.time = 5;
+        m.image = 1;
+        m.hits = new Ano.Hit[hits];
+        for (int i = 0; i < hits; i++) m.hits[i] = hit(flag);
+        return m;
+    }
+
+    static Dac base(int n) throws Exception {
+        A[] a = new A[n];
+        for (int i = 0; i < n; i++) a[i] = new A().mpt(new M().time(1));
+        return dac(a);
+    }
+
+    static int count(List<GameRules.Issue> l, boolean fatal) {
+        int n = 0;
+        for (GameRules.Issue i : l) if (i.fatal == fatal) n++;
+        return n;
+    }
+
