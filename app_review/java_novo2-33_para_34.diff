+        return false;
+    }
+}
diff -ruN a/test/HelpSearchTest.java b/test/HelpSearchTest.java
--- a/test/HelpSearchTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/HelpSearchTest.java	2026-10-24 20:42:10.502743423 +0000
@@ -0,0 +1,94 @@
+package com.zue.attackeditor;
+
+import java.util.List;
+
+/** Busca da AJUDA: aproximacao (erros de digitacao), correlacao (sinonimos/tags) e abas antes de textos. Java puro. */
+public class HelpSearchTest {
+    static int fails = 0, oks = 0;
+
+    static void check(String name, Object got, Object want) {
+        boolean ok = got == null ? want == null : got.equals(want);
+        if (ok) { oks++; System.out.println("OK   " + name); }
+        else { fails++; System.out.println("FAIL " + name + " got=" + got + " want=" + want); }
+    }
+
+    static String first(String q) {
+        List<HelpText.Hit> h = HelpText.search(q);
+        return h.isEmpty() ? "-" : h.get(0).section.title + (h.get(0).tab ? "[aba]" : "[txt]");
+    }
+
+    static boolean tabsBeforeTexts(String q) {
+        boolean seenText = false;
+        for (HelpText.Hit h : HelpText.search(q)) {
+            if (!h.tab) seenText = true;
+            else if (seenText) return false;
+        }
+        return true;
+    }
+
+    public static void main(String[] a) {
+        check("distancia: insercao", HelpText.distance("sped", "speed"), 1);
+        check("distancia: troca", HelpText.distance("spped", "speed"), 1);
+        check("distancia: duplicada", HelpText.distance("spedd", "speed"), 1);
+        check("distancia: transposicao conta 1", HelpText.distance("sequnecia", "sequencia"), 1);
+        check("match: palavra curta so exata", HelpText.match("seg", "seq"), 0);
+        check("match: prefixo", HelpText.match("veloc", "velocidade") > 60, true);
+
+        for (String q : new String[] { "speed", "sped", "spped", "spedd", "speeed", "SPEED", "dash", "velocidade", "velocidde", "aceleracao" }) {
+            String f = first(q);
+            check("'" + q + "' poe a aba Movimento em primeiro", f, "Movimento[aba]");
+        }
+        check("correlacao: pixels", first("pixels"), "Movimento[aba]");
+        check("correlacao: gravidade", first("gravidade").endsWith("[aba]"), true);
+
+        check("erro: hitbx acha a aba HITBOX ou Hitbox/Hurtbox", first("hitbx").endsWith("[aba]") && HelpText.search("hitbx").get(0).section.title.toLowerCase().contains("hit"), true);
+        check("erro: reaçao (sem til)", HelpText.search("reaçao").size() > 3, true);
+        check("erro: sequnecia", HelpText.search("sequnecia").size() > 2, true);
+        check("sequnecia: aba de transicao/sequencia vem primeiro", first("sequnecia").endsWith("[aba]"), true);
+        check("combo leva as sequencias", HelpText.search("combo").size() > 0, true);
+        check("editor de reacoes aparece para 'knockback'", first("knockback").endsWith("[aba]"), true);
+
+        for (String q : new String[] { "speed", "reacao", "salvar", "sequencia", "hitbox", "som", "projetil", "tempo" })
+            check("abas sempre antes dos textos: " + q, tabsBeforeTexts(q), true);
+        boolean anyTab = false, anyText = false;
+        for (HelpText.Hit h : HelpText.search("speed")) { anyTab |= h.tab; anyText |= !h.tab; }
+        check("speed tem as duas faixas", anyTab && anyText, true);
+
+        boolean sn = true, any = false;
+        for (HelpText.Hit h : HelpText.search("limite")) if (!h.tab) { any = true; sn &= h.snippet.length() > 0 && h.snippet.length() < 220; }
+        check("textos trazem trecho curto", any && sn, true);
+        boolean tabNoSnippet = true;
+        for (HelpText.Hit h : HelpText.search("speed")) if (h.tab) tabNoSnippet &= h.snippet.isEmpty();
+        check("abas nao trazem trecho", tabNoSnippet, true);
+
+        check("dividir: a timeline do ANO vem primeiro e a barra da reacao logo depois (as duas sao abas)", first("dividir") + "|" + HelpText.search("dividir").get(1).section.title.contains("ferramentas"),
+                "DIVIDIR / DUPLICAR / EXCLUIR / DESFAZER[aba]|true");
+        check("erro: divdir acha as mesmas abas", first("divdir").endsWith("[aba]") && HelpText.search("divdir").get(1).section.title.contains("ferramentas"), true);
+        boolean warn = false;
+        for (HelpText.Hit h : HelpText.search("dividir")) warn |= h.section.body.contains("reinicia a animação");
+        check("a ajuda avisa que o ANO recomeca ao dividir", warn, true);
+        check("ia / chatgpt / TBRHelp levam a aba Ajuda de IA", first("chatgpt") + "|" + first("tbrhelp") + "|" + first("inteligencia artificial"),
+                "Ajuda de IA (TBRHelp.md)[aba]|Ajuda de IA (TBRHelp.md)[aba]|Ajuda de IA (TBRHelp.md)[aba]");
+        check("lixo nao acha nada", HelpText.search("xqzwkjv").size(), 0);
+        check("palavra extra inexistente zera", HelpText.search("speed palavraqueNaoExiste").size(), 0);
+        check("busca vazia", HelpText.search("   ").size(), 0);
+        check("varias palavras exigem todas (speed accel)", HelpText.search("speed accel").size() > 0, true);
+        check("bit 64 acha o capitulo speed", first("bit 64").length() > 1 && !first("bit 64").equals("-"), true);
+        boolean inSpeed = false;
+        for (HelpText.Hit h : HelpText.search("bit 64")) inSpeed |= h.chapter.id.equals("speed");
+        check("bit 64 inclui o capitulo speed", inSpeed, true);
+        check("palavra com underscore: SEQ_PROJETIL", HelpText.search("SEQ_PROJETIL").size() > 0, true);
+
+        int tabs = 0;
+        for (List<HelpText.Chapter> l = java.util.Collections.singletonList(null); l != null; l = null) {
+            for (HelpText.Chapter ch : HelpText.chapters()) for (HelpText.Section s : ch.sections) if (s.tab) tabs++;
+        }
+        check("ha abas marcadas (menu superior 14 + paginas)", tabs >= 30, true);
+        boolean toolbarTabs = true;
+        for (HelpText.Section s : HelpText.toolbar()) toolbarTabs &= s.tab && s.tags.length() > 5;
+        check("todo botao do menu superior e aba com tags", toolbarTabs, true);
+
+        System.out.println("HelpSearchTest ok=" + oks + " fails=" + fails);
+        if (fails > 0) System.exit(1);
+    }
+}
diff -ruN a/test/I18nCoverageTest.java b/test/I18nCoverageTest.java
--- a/test/I18nCoverageTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/I18nCoverageTest.java	2026-10-24 21:57:15.454040328 +0000
@@ -0,0 +1,114 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.io.File;
+import java.nio.charset.Charset;
+import java.nio.file.Files;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Cobertura do catalogo de idiomas: toda literal de texto das telas (nos .java do app) precisa estar no catalogo (PT) ou na lista de ignoradas
+ * (formatos, chaves, depuracao). Texto novo na interface sem traducao faz este teste falhar. Pula se nao achar as fontes.
+ * Alem disso confere o catalogo: placeholders iguais nas 3 colunas, nada vazio, EN/ES diferentes do PT quando ha letras.
+ */
+public class I18nCoverageTest {
+    static final Pattern LIT = Pattern.compile("\"((?:[^\"\\\\\\n]|\\\\.)*)\"");
+    static final Pattern FMT = Pattern.compile("%(?:\\d+\\$)?[-+0# ]*\\d*(?:\\.\\d+)?[sdfx]");
+    static final Pattern PLACE = Pattern.compile("\\{(\\d)\\}");
+
+    static String unesc(String s) {
+        Matcher m = Pattern.compile("\\\\u([0-9a-fA-F]{4})").matcher(s);
+        StringBuffer sb = new StringBuffer();
+        while (m.find()) m.appendReplacement(sb, Matcher.quoteReplacement(String.valueOf((char) Integer.parseInt(m.group(1), 16))));
+        m.appendTail(sb);
+        return sb.toString().replace("\\n", "\n").replace("\\\"", "\"").replace("\\\\", "\\").replace("\\'", "'").replace("\\t", "\t");
+    }
+
+    static String conv(String s) {
+        Matcher m = FMT.matcher(s);
+        StringBuffer sb = new StringBuffer();
+        int n = 0;
+        while (m.find()) m.appendReplacement(sb, Matcher.quoteReplacement("{" + (n++) + "}"));
+        m.appendTail(sb);
+        return sb.toString().replace("%%", "%");
+    }
+
+    static int placeholders(String s) {
+        Matcher m = PLACE.matcher(s);
+        int n = 0;
+        while (m.find()) n++;
+        return n;
+    }
+
+    static File sourceDir() {
+        String[] c = {".", "..", "../app", "../..", "src"};
+        for (String p : c) if (new File(p, "I18n.java").isFile()) return new File(p);
+        return null;
+    }
+
+    static int letters(String s) {
+        int n = 0;
+        for (int i = 0; i < s.length(); i++) if (Character.isLetter(s.charAt(i))) n++;
+        return n;
+    }
+
+    public static void main(String[] args) throws Exception {
+        // ---- catalogo coerente
+        List<String[]> cat = I18n.entries();
+        Set<String> keys = new HashSet<String>();
+        boolean shape = true, ph = true, differs = true, dup = true;
+        StringBuilder bad = new StringBuilder();
+        for (String[] e : cat) {
+            shape &= e.length == 3 && e[0].length() > 0 && e[1].length() > 0 && e[2].length() > 0;
+            if (e.length < 3) continue;
+            boolean same = placeholders(e[0]) == placeholders(e[1]) && placeholders(e[0]) == placeholders(e[2]);
+            if (!same) { ph = false; bad.append(e[0]).append(" | "); }
+            if (!keys.add(e[0])) { dup = false; bad.append("DUP ").append(e[0]).append(" | "); }
+            if (e[1].equals(e[0]) && e[2].equals(e[0]) && letters(e[0]) > 0) differs = false;
+        }
+        check("catalogo: " + cat.size() + " entradas, nenhuma vazia", shape, true);
+        check("catalogo: placeholders {n} iguais nas 3 colunas " + bad, ph, true);
+        check("catalogo: sem chave repetida", dup, true);
+        check("catalogo: nenhuma entrada igual nos 3 idiomas (seria inutil)", differs, true);
+
+        File dir = sourceDir();
+        if (dir == null) {
+            check("cobertura: fontes nao encontradas, pulada", true, true);
+            System.out.println("I18nCoverageTest fails=" + BattleTest.fails);
+            return;
+        }
+        Set<String> ignored = new HashSet<String>(java.util.Arrays.asList(I18nIgnored.LITERALS));
+        TreeSet<String> missing = new TreeSet<String>();
+        int files = 0, lits = 0;
+        File[] fs = dir.listFiles();
+        java.util.Arrays.sort(fs);
+        for (File f : fs) {
+            String n = f.getName();
+            if (!n.endsWith(".java") || n.startsWith("I18n") || n.equals("HelpText.java") || n.equals("AiHelp.java") || n.equals("AiHelpDoc.java")) continue;
+            files++;
+            for (String line : Files.readAllLines(f.toPath(), Charset.forName("UTF-8"))) {
+                String st = line.trim();
+                if (st.startsWith("//") || st.startsWith("*") || st.startsWith("/*")) continue;
+                Matcher m = LIT.matcher(line);
+                while (m.find()) {
+                    String s = unesc(m.group(1));
+                    if (letters(s) < 3) continue;
+                    lits++;
+                    if (!keys.contains(conv(s)) && !ignored.contains(s)) missing.add(n + ": " + s);
+                }
+            }
+        }
+        StringBuilder sb = new StringBuilder();
+        int shown = 0;
+        for (String s : missing) { if (shown++ < 12) sb.append("\n   ").append(s.replace("\n", "\\n")); }
+        check("cobertura: " + lits + " literais em " + files + " arquivos; sem traducao nem ignorar: " + missing.size() + sb, missing.isEmpty(), true);
+
+        System.out.println("I18nCoverageTest fails=" + BattleTest.fails);
+    }
+}
