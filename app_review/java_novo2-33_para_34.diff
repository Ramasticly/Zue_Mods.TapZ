+    private void afterGrabFrame() {
+        AttackSim.Obj g = grab == null ? null : grab.root();
+        if (g == null) return;
+        if (g.serial != grabSerial) {
+            grabSerial = g.serial;
+            grabArmed = g.hits.length > 0;
