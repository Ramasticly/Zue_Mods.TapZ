+++ app/CutsceneInfo.java	2026-10-21 20:34:36.994324536 +0000
@@ -0,0 +1,75 @@
+package com.zue.attackeditor;
+
+/**
+ * Texto do painel da flag 20 (cutscene): a linha do HDAT 13 decodificada como o md 996 do jogo a le, mais os avisos
+ * de campos que o jogo ignora. Java puro (testado sem Android).
+ */
+final class CutsceneInfo {
+    private CutsceneInfo() { }
+
+    /** Campos s16 da linha: +0 alvo, +2 sync, +4 z, +6 anim, +8 anim espelhada, +10 cam, +12 stun, +14 mapa. */
+    static String describe(CharData ch, int ev, int hx, int hy) {
+        if (ch == null) return "Sem dados do personagem: nao da para ler o HDAT 13.";
+        if (!ch.hasEvent(ev)) {
+            return "O evento " + ev + " nao existe no HDAT 13 deste personagem (tem " + ch.eventRows() + " linha"
+                    + (ch.eventRows() == 1 ? "" : "s") + "): o jogo encerra a task na hora e nada acontece.";
+        }
+        int alvo = ch.eventField(ev, 0), sync = ch.eventField(ev, 2), z = ch.eventField(ev, 4);
+        int animN = ch.eventField(ev, 6), animF = ch.eventField(ev, 8), cam = ch.eventField(ev, 10);
+        int stun = ch.eventField(ev, 12), mapa = ch.eventField(ev, 14);
+        StringBuilder b = new StringBuilder();
+        b.append("Evento ").append(ev).append(" (HDAT 13): ");
+        if (animN == 0) {
+            b.append("sem animacao (ANIM_ID = 0)");
+        } else {
+            b.append(packName(alvo)).append(" · ANO ").append(animN);
+            if (animF != animN) b.append(" (espelhada: ").append(animF).append(')');
+            b.append(" · camada ").append(zValue(ev, z));
+            b.append(" · ").append(cam == 0 ? "presa ao mundo" : cam == 1 ? "presa a tela (tela cheia)" : "presa a tela");
+        }
+        b.append('\n').append(sync > 0 ? "Dura " + sync + " frame(s) do ANO do golpe (frames, nao ticks)" : "Dura enquanto o ANO do golpe nao mudar")
+                .append(" ou ate o ANO acabar.");
+        if (stun != 0) b.append("\nCongela o outro lutador (md 925) ate acabar: projeteis, auras e agarrao tambem pausam.");
+        if (mapa != 0) b.append("\nFLAG ").append(mapa).append(": ").append(mapaName(mapa));
+        if (alvo >= 2) b.append("\nALVO ").append(alvo).append(" usa o pack bobjNN do cenario (precisa da pasta bobj* em assets).");
+        if (animN != 0 && cam != 0 && (hx != 0 || hy != 0) && mapa != 3)
+            b.append("\nAviso: com cam diferente de 0 o jogo posiciona a cena em (0, 0) da tela e ignora o x/y deste hit.");
+        if (animN != 0 && (ev == 8 || ev == 9) && cam != 0)
+            b.append("\nEventos 8 e 9 com cam diferente de 0: so no 1o tick vai para (0, 0) da tela; depois anda pela velocidade do proprio ANO.");
+        if (mapa == 3 && cam == 0) b.append("\nCom cam 0 a camera salta direto para o alvo e a cena nunca aparece.");
+        if (mapa == 3 && stun != 0) b.append("\nAviso: o stun do FLAG 3 nunca e desfeito pelo jogo (o alvo fica parado) e o x do hit vira o estado do alvo (~0 px).");
+        return b.toString();
+    }
+
+    private static String packName(int alvo) {
+        return alvo == 0 ? "effect.pac" : alvo == 1 ? "pack do personagem" : "bobj";
+    }
+
+    /** _SetObj da cutscene: 0 => 200 (10 nos eventos 8/9); 1 => 17/19/21; resto => 400. */
+    static int zValue(int ev, int z) {
+        if (z == 0) return (ev == 8 || ev == 9) ? 10 : 200;
+        if (z == 1) return ev == 8 ? 19 : (ev == 9 ? 21 : 17);
+        return 400;
+    }
+
+    static String mapaName(int m) {
+        switch (m) {
+            case 1: return "adia o fim da luta (KO) enquanto a cena existe";
+            case 2: return "esconde o alvo se ele estiver derrotado (para sempre)";
+            case 3: return "a camera vai ate o dono do golpe (10 px por tick; cam 0 = salta)";
+            case 4: return "trava a rolagem da camera para o dono";
+            case 5: return "a camera centraliza o alvo (outro lutador)";
+            case 6: return "forca parede: o alvo bate em qualquer ponto da tela";
+            case 7: return "tira o limite de tela do alvo e trava a rolagem do dono";
+            case 8: return "tira o limite de tela do dono e trava a rolagem do alvo";
+            case 9: return "tira o limite de tela dos dois e trava a rolagem";
+            case 10: return "prende o alvo, todo tick, a esquerda da tela";
+            case 11: return "prende o alvo, todo tick, a direita da tela";
+            case 12: return "prende o alvo, todo tick, acima da tela";
+            case 13: return "o dono vai para a esquerda da tela (so no 1o tick)";
+            case 14: return "o dono vai para a direita da tela (so no 1o tick)";
+            case 15: return "o dono vai para cima da tela (so no 1o tick)";
+            default: return "valor sem efeito no jogo";
+        }
+    }
+}
diff -ruN ../app/GameRules.java app/GameRules.java
--- ../app/GameRules.java	1970-01-01 00:00:00.000000000 +0000
+++ app/GameRules.java	2026-10-21 20:44:40.162310740 +0000
@@ -0,0 +1,99 @@
+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Limites do jogo que o editor deixaria passar: o simulador aceita, mas no jogo a ANO estoura um array (ArrayIndexOutOfBounds dentro do
+ * Run() do TCBManajer fecha o jogo) ou e ignorada. Java puro, sem Android.
+ */
+final class GameRules {
+    private GameRules() { }
+
+    /** Maximos do jogo (ObjReq.hit = int[50], ObjReq.lnk = ObjReq[13], MPT e time em 1 byte). */
+    static final int MAX_HITS = 10, MAX_LINKS = 13, MAX_MPTS = 255, MAX_TIME = 255, MAX_OPT1 = 249;
+
+    static final class Issue {
+        final int ano, mpt;
+        /** true = o jogo fecha ou le lixo; false = o jogo ignora o campo. */
+        final boolean fatal;
+        final String text;
+
+        Issue(int ano, int mpt, boolean fatal, String text) {
+            this.ano = ano;
+            this.mpt = mpt;
+            this.fatal = fatal;
+            this.text = text;
+        }
+
+        @Override public String toString() { return "ANO " + ano + (mpt >= 0 ? " MPT " + mpt : "") + ": " + text; }
+    }
+
+    /** cnvEntries <= 0 desliga a checagem de imagem. */
+    static List<Issue> check(Dac dac, java.util.Collection<Integer> anos, int cnvEntries) {
+        List<Issue> out = new ArrayList<Issue>();
+        if (dac == null) return out;
+        boolean[] isLink = new boolean[dac.size()];
+        for (int i = 0; i < dac.size(); i++) {
+            Ano a = dac.getAno(i);
+            if (a == null || !a.present) continue;
+            for (int k = 0; k < a.links.length; k++) {
+                int t = a.links[k].getAno();
+                if (t >= 0 && t < isLink.length) isLink[t] = true;
+            }
+        }
+        if (anos == null) {
+            for (int i = 0; i < dac.size(); i++) checkAno(dac, dac.getAno(i), isLink, cnvEntries, out);
+        } else {
+            for (Integer i : anos) if (i.intValue() >= 0 && i.intValue() < dac.size()) checkAno(dac, dac.getAno(i.intValue()), isLink, cnvEntries, out);
+        }
+        return out;
+    }
+
+    private static void checkAno(Dac dac, Ano a, boolean[] isLink, int cnvEntries, List<Issue> out) {
+        if (a == null || !a.present) return;
+        int ix = a.index;
+        if (a.mpts.length > MAX_MPTS)
+            out.add(new Issue(ix, -1, true, a.mpts.length + " frames: o DAC guarda a quantidade em 1 byte (maximo " + MAX_MPTS + ")"));
+        if (a.links.length > MAX_LINKS)
+            out.add(new Issue(ix, -1, true, a.links.length + " links: o jogo so tem " + MAX_LINKS + " (lnk[13]) e fecha ao criar o excedente"));
+        if (isLink[ix] && a.links.length > 0)
+            out.add(new Issue(ix, -1, false, "e link de outra ANO e tem links proprios: o jogo so tem 1 nivel de links (os links desta ANO nao nascem)"));
+        boolean linkHits = false;
+        for (int p = 0; p < a.mpts.length; p++) {
+            Ano.Mpt m = a.mpts[p];
+            if (m.hits.length > MAX_HITS)
+                out.add(new Issue(ix, p, true, m.hits.length + " caixas no frame: o jogo guarda no maximo " + MAX_HITS + " (hit[50]) e fecha ao ler o excedente"));
+            if (m.hasTime && m.time > MAX_TIME)
+                out.add(new Issue(ix, p, true, "tempo " + m.time + ": o campo e 1 byte (maximo " + MAX_TIME + ")"));
+            if (cnvEntries > 0 && m.image >= cnvEntries)
+                out.add(new Issue(ix, p, false, "imagem " + m.image + " nao existe no CNV (" + cnvEntries + " entradas): o frame fica sem desenho"));
+            if (m.hasOpt && m.optData[1] > MAX_OPT1 && hasHitbox(m))
+                out.add(new Issue(ix, p, true, "OPT 1 = " + m.optData[1] + " com hitbox: o grupo " + (m.optData[1] / 50) + " nao existe (maximo " + MAX_OPT1 + ")"));
+            if (m.hits.length > 0) linkHits |= isLink[ix];
+            if (m.hasOpt && m.optData[2] != 0 && m.time > 0 && p + 1 < a.mpts.length) {
+                Ano.Mpt n = a.mpts[p + 1];
+                if (n.hits.length != m.hits.length && (n.hasRaz || n.hasOpt))
+                    out.add(new Issue(ix, p, true, "interpolacao: o jogo le o frame seguinte pulando " + m.hits.length + " caixa(s) (as do frame ATUAL) em vez de " + n.hits.length
+                            + "; a rotacao/alfa/zoom do alvo saem errados"));
+            }
+        }
+        if (linkHits)
+            out.add(new Issue(ix, -1, false, "e link de outra ANO e tem caixas (hit/hurt/flags): so as da ANO raiz valem, as do link sao ignoradas"));
+    }
+
+    private static boolean hasHitbox(Ano.Mpt m) {
+        for (int i = 0; i < m.hits.length; i++) if (m.hits[i].flag == 2) return true;
+        return false;
+    }
+
+    /** Uma linha para a barra de avisos; "" se tudo certo. */
+    static String summary(List<Issue> issues) {
+        if (issues == null || issues.isEmpty()) return "";
+        int fatal = 0;
+        for (Issue i : issues) if (i.fatal) fatal++;
+        Issue first = issues.get(0);
+        for (Issue i : issues) if (i.fatal) { first = i; break; }
+        return (fatal > 0 ? "O JOGO FECHA/ERRA: " : "Aviso do jogo: ") + first + (issues.size() > 1 ? " (+" + (issues.size() - 1) + ")" : "");
+    }
+}
