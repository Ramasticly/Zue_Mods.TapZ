+    private void showLandWarning() {
+        if (!measuredEarly || warnKey.equals(dismissedKey)) return;
+        final String key = warnKey;
+        QuickNotice n = new QuickNotice(LAND_MSG)
+                .left("OCULTAR", new Runnable() { public void run() { dismissedKey = key; } })
+                .right("POS", new Runnable() { public void run() { if (posRequest != null) posRequest.run(); } });
+        showNotice(n);
