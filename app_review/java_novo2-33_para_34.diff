+    /** DIVIDIR: parte o passo onde esta o ponteiro em dois (o 2o mantem a velocidade; o ANO do oponente recomeca nele). */
+    private void splitAtPointer() {
+        final ReactionTable t = table();
+        ReactionTrace.Seg sg = tl.segAt(tl.pointerTick());
+        if (t == null || trace == null || !tl.isOwn(sg)) {
+            I18nUi.toast(c, "Ponha o ponteiro dentro de um passo desta reação", android.widget.Toast.LENGTH_SHORT).show();
+            return;
+        }
+        final int row = sg.row, k = tl.pointerTick() - sg.start;
+        final BattleSim.DamageTick endOfFirst = k >= 1 && sg.start + k - 1 < trace.ticks.size() ? trace.ticks.get(sg.start + k - 1) : null;
+        final boolean[] ok = {false};
+        // confere antes (a tabela so muda se couber): em uma copia
+        ReactionTable probe = t.copy();
+        if (!ReactionEdit.splitKeepingMotion(probe, row, air, k, endOfFirst)) {
+            I18nUi.toast(c, "Ponha o ponteiro depois do 1º tick e antes do fim do passo para dividir", android.widget.Toast.LENGTH_SHORT).show();
+            return;
+        }
+        view.editReaction(type, new Runnable() { public void run() { ok[0] = ReactionEdit.splitKeepingMotion(t, row, air, k, endOfFirst); } });
+        sel = row + 1;
+        selLane = ReactionTimelineView.LANE_PASSOS;
+        tl.setSelectedLane(selLane);
+        onChanged.run();
+        refresh();
+        I18nUi.toast(c, "Passo dividido em " + k + " + " + (t.u8(row + 1, ReactionEdit.durColumn(air)) == 255 ? "até pousar" : String.valueOf(t.u8(row + 1, ReactionEdit.durColumn(air)))) + " ticks (a animação do oponente recomeça no 2º passo)", android.widget.Toast.LENGTH_LONG).show();
+    }
+
+    /** EXCLUIR: o item selecionado (passo, bloco SPEED, voz, parede ou SEQ do passo). */
+    private void deleteSelected() {
+        final ReactionTable t = table();
+        if (t == null || sel < 0 || sel >= t.rows) return;
+        switch (selLane) {
+            case ReactionTimelineView.LANE_SPEED: {
+                final int run = ReactionRuns.runOf(t, air, sel);
+                if (run < 0) { I18nUi.toast(c, "Este passo não tem velocidade própria", android.widget.Toast.LENGTH_SHORT).show(); return; }
+                view.editReaction(type, new Runnable() { public void run() { ReactionRuns.removeRun(t, air, run); } });
+                onChanged.run();
+                refresh();
+                return;
+            }
+            case ReactionTimelineView.LANE_VOZ: setCell(13, 0); return;
+            case ReactionTimelineView.LANE_EFEITOS: setCell(12, 0); return;
+            case ReactionTimelineView.LANE_SEQ: setCell(11, 0); return;
+            default: delRow();
+        }
+    }
