+    /** Tudo que nao e o atacante parou: sem projeteis, efeitos, reacao nem hitstop. */
+    /** Fim estendido: o atacante so congela quando esta no chao (ou voa); no ar ele cai e pousa antes. */
+    private boolean grounded(AttackSim.Obj r) { return r.y >= 0 || flies || projRoot() || effectRoot(); }
+
+    /** Projetil ainda em jogo: vivo e dentro do mapa (com folga); fora dele ja desapareceu para o tempo estendido. */
+    private boolean projActive() {
+        int lo = mapLeft() - (200 << 16), hi = mapRight() + (200 << 16);
+        for (int i = 0; i < projs.size(); i++) {
+            Proj p = projs.get(i);
+            if (p.dead) continue;
+            AttackSim.Obj o = p.sim.root();
+            if (o != null && o.x >= lo && o.x <= hi && p.still < 60) return true;   // parado no ultimo frame ha 1 s: nao segura o tempo estendido
+        }
+        return false;
+    }
