+    /** Ponto (inicio de frame ou fim) sob o dedo, como {cadeia, indice do ponto}; null se nao ha. */
+    private int[] slHit(float sx, float sy) {
+        Ano a = currentAno();
+        if (!speedLineOn || a == null || sim == null) return null;
+        slPrepare(a);
+        float wx = (sx - originX) / scale, wy = (sy - originY) / scale;
+        double rad = 28f * density / scale, best = rad * rad;
+        int[] hit = null;
+        java.util.List<SpeedLine.Chain> chains = SpeedLine.chains(a.mpts);
+        for (int ci = 0; ci < chains.size() && ci < slAnchor.length; ci++) {
+            double[] an = slAnchor[ci];
+            if (an == null) continue;
+            SpeedLine.Chain ch = chains.get(ci);
+            for (int k = 0; k <= ch.frames(); k++) {
+                double[] w = slWorld(an, ch.vertex(k));
+                double d = (w[0] - wx) * (w[0] - wx) + (w[1] - wy) * (w[1] - wy);
+                if (d <= best) { best = d; hit = new int[] {ch.head, k}; }
+            }
+        }
+        return hit;
+    }
+
+    /** Alvo do arrasto no sistema da cadeia (relativo ao inicio dela, como se olhasse para a direita). */
+    private void slDragTo(float sx, float sy) {
+        Ano a = currentAno();
+        if (a == null) return;
+        Ano.Mpt[] base = a.mpts;
+        java.util.List<SpeedLine.Chain> chains = SpeedLine.chains(base);
+        for (int ci = 0; ci < chains.size() && ci < slAnchor.length; ci++) {
+            SpeedLine.Chain ch = chains.get(ci);
+            if (ch.head != slDragHead || slAnchor[ci] == null) continue;
+            double[] an = slAnchor[ci];
+            double rx = ((sx - originX) / scale - an[0]) / an[2], ry = ((sy - originY) / scale - an[1]) / an[3];
+            slWork = SpeedLine.dragTo(base, ch, slDragK, rx, ry);
+            invalidate();
+            return;
+        }
+    }
+
+    /** Chamado pela UI do menu do ponto: cadeia que comeca em {@code head} na ANO atual (ou null). */
+    SpeedLine.Chain speedLineChain(int head) {
+        Ano a = currentAno();
+        if (a == null) return null;
+        for (SpeedLine.Chain c : SpeedLine.chains(a.mpts)) if (c.head == head) return c;
+        return null;
+    }
