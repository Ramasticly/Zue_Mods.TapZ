+    /**
+     * Tasks 939-941 (prio 13696): o objeto "oponente sendo agarrado" nasce quando o defensor esta em dano (md 876/877) e o ANO que acertou
+     * (DamageHitActNo) esta entre 40 e 62, com SpecialType <= 12 e a coluna 24 do HDAT 4 preenchida; independe de SEQ/END. Acompanha a
+     * posicao do defensor, nunca vira (nao ha wObjFlag & 16) e morre quando o defensor sai de md 876/877/925. Em pausa (hitstop do atacante
+     * ou do objeto, md 925) o jogo refaz o _SetAct a cada tick: o objeto fica sem imagem e recomeca do frame 0.
+     */
+    private void stepGrab() {
+        if (grab == null) {
+            if (!inDamage || grabHitAno < 40 || grabHitAno > 62 || specialType > 12) return;
+            int a = move.oponenteAgarrado;
+            Ano an = a > 0 ? atkDac.getAno(a) : null;
+            if (an == null || !an.present) return;
+            AttackSim.Obj d0 = opp.root();
+            grab = new AttackSim(atkDac, a, false, d0 != null ? d0.x : oppX, d0 != null ? d0.y : oppY);
+            grab.rebaseLinks = true; grab.clearPause = true;
+            grabSerial = -1;
+            grabArmed = false;
+            grabHs = 0;
+            grabFresh = true;
+            grabNew = true;
+            grabPaused = true;
+        }
+        if (!(inDamage || stunned[1])) { grab = null; grabPaused = false; return; }
+        AttackSim.Obj d = opp.root();
+        int gx = d != null ? d.x : oppX, gy = d != null ? d.y : oppY;
+        boolean pause = grabNew || grabHs > 0 || hsAtk > 0 || stunAny();      // work[12] == 0 (tick de criacao) tambem pausa
+        grabNew = false;
+        if (pause) {
+            AttackSim.Obj g0 = grab.root();
+            int a = g0 == null ? move.oponenteAgarrado : g0.ano.index;
+            grab = new AttackSim(atkDac, a, false, gx, gy);
+            grab.rebaseLinks = true; grab.clearPause = true;
+            grabSerial = -1;
+            grabArmed = false;
+            grabFresh = true;
+            grabPaused = true;
+            return;
+        }
+        grabPaused = false;
+        grab.pinTo(gx, gy);                           // _SetXY(posicao do defensor) antes do _ActReq
+        if (grabFresh) grabFresh = false;             // 1a execucao depois do _SetAct: so carrega o frame 0 (o AttackSim ja fez)
+        else grab.step(false);
+        afterGrabFrame();
+        consumeSe(grab, 1);                           // ChrSePlay(gw, defensor)
+    }
