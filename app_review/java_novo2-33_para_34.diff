+    private void spawnSub(Proj parent, AttackSim.Obj o, Ano.Hit h) {
+        if (move.subId == 0) {
+            noteSpawn("Um hit de projétil (flag 0) dentro do ANO de projétil não gerou nada: SUBPROJETIL_ANIM_ID está vazio (0).", false);
+            return;
+        }
+        if (projs.size() >= MAX_PROJECTILES) return;      // idem: so no AJUDA
+        int dx = h.x << 16;
+        int x = (o.objFlags & 16) != 0 ? o.x - dx : o.x + dx;
+        int y = o.y + (h.y << 16);
+        Proj p = new Proj();
+        p.flip = (o.objFlags & 16) != 0;
+        p.hitAno = move.subAoAcertar;
+        p.hitAnim = move.subAoAcertar != 0;
+        p.globalAno = move.projGlobal;
+        p.groundAno = move.subChao;
+        p.sim = new AttackSim(atkDac, move.subId, p.flip, x, y);
+        p.sim.clearPause = true;
+        projs.add(p);
+    }
