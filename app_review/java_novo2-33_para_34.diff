+    /** Campos que o golpe generico (modo ANO) herda do dono: os mesmos de {@link CharData#genericFrom}. */
+    private static void syncGeneric(CharData.Move g, CharData.Move src) {
+        g.flags = src.flags;
+        g.projNormal = src.projNormal; g.projAbaixo = src.projAbaixo; g.projAcima = src.projAcima;
+        g.projGlobal = src.projGlobal; g.projAoAcertar = src.projAoAcertar; g.projChao = src.projChao;
+        g.homing = src.homing; g.homingSpeed = src.homingSpeed; g.maxRep = src.maxRep;
+        g.subId = src.subId; g.subAoAcertar = src.subAoAcertar; g.subChao = src.subChao;
+    }
