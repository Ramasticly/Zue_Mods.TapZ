+    /** Troca a ANO atual inteira (adicionar/remover frames, links). */
+    public void replaceMpts(Ano.Mpt[] mp, String undoKey) {
+        Ano old = currentAno();
+        if (old == null) return;
+        replaceAno(new Ano(old.index, true, old.flags, old.priority, old.links, mp), undoKey);
