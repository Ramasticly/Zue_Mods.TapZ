+    /** Parte "hit" de DamageChange. */
+    private static boolean hasFlag(AttackSim.Obj r, int flag) {
+        if (r == null) return false;
+        for (int i = 0; i < r.hits.length; i++) if (r.hits[i].flag == flag) return true;
+        return false;
+    }
