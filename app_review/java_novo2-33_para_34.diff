+    private static void applyFlip(AttackSim s, boolean flip) {
+        AttackSim.Obj r = s.root();
+        if (r == null) return;
+        r.objFlags = flip ? (r.objFlags | 16) : (r.objFlags & ~16);
+        AttackSim.Obj[] ch = s.children();
+        for (int i = 0; i < ch.length; i++) {
+            if (ch[i] != null) ch[i].objFlags = flip ? (ch[i].objFlags | 16) : (ch[i].objFlags & ~16);
+        }
+    }
