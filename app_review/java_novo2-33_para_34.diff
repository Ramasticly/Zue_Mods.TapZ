+    /**
+     * Edicao rapida de uma tabela de reacao (campo digitado ou - / + segurado): grava na hora, junta as edicoes seguidas de {@code key}
+     * numa unica entrada de desfazer e refaz a simulacao principal uma vez, 250 ms depois da ultima edicao (ou em {@link #flushReactionEdit}).
+     */
+    public void editReaction(int type, String key, Runnable change) {
+        final ReactionTable t = charReaction(type);
+        if (t == null) return;
+        final ReactionTable before = t.copy();
+        change.run();
+        pushUndo(key, UndoEdits.swapReaction(t, before));
+        editVersion++;
+        removeCallbacks(reactionRebuild);
+        reactionRebuildPending = true;
+        postDelayed(reactionRebuild, 250);
+    }
