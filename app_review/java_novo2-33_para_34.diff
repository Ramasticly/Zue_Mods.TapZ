+package com.zue.attackeditor;
+
+/** Textos da AJUDA em EN/ES, bloco 8 (gerado de i18n_src/h00*.py; nao editar a mao). So busca exata, nao entra nos fragmentos. */
+final class I18nHelpCatalog8 {
