+    static final class Hit {
+        final Chapter chapter;
+        final Section section;
+        /** true = aba / menu (faixa "ABAS E MENUS"); false = texto dentro de um capitulo. */
+        final boolean tab;
+        final int score;
+        /** Trecho do texto onde a busca bateu (so nos textos); vazio nas abas. */
+        final String snippet;
+
+        Hit(Chapter chapter, Section section, boolean tab, int score, String snippet) {
+            this.chapter = chapter;
+            this.section = section;
+            this.tab = tab;
+            this.score = score;
+            this.snippet = snippet;
+        }
+    }
+
+    /** Minusculas e sem acentos, caractere por caractere (o tamanho nao muda, para os trechos do texto original baterem). */
+    static String norm(String s) {
+        if (s == null) return "";
+        StringBuilder b = new StringBuilder(s.length());
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            if (ch < 128) { b.append(Character.toLowerCase(ch)); continue; }
+            String n = java.text.Normalizer.normalize(String.valueOf(ch), java.text.Normalizer.Form.NFD);
+            char base = n.isEmpty() ? ch : n.charAt(0);
+            b.append(Character.toLowerCase(base));
+        }
+        return b.toString();
+    }
+
+    private static final java.util.regex.Pattern WORD = java.util.regex.Pattern.compile("[a-z0-9_]+");
+
+    private static String[] tokens(String normText) {
+        List<String> l = new ArrayList<String>();
+        java.util.regex.Matcher m = WORD.matcher(normText);
+        while (m.find()) l.add(m.group());
+        return l.toArray(new String[0]);
+    }
+
+    /** Grupos de palavras relacionadas: quem busca uma acha as outras (com peso menor). Tudo normalizado. */
+    private static final String[][] SYNONYMS = {
+        {"speed", "velocidade", "dash", "mover", "movimento", "andar", "correr", "deslocar", "deslocamento", "pixels", "px", "avanco", "recuo", "impulso", "pulo", "salto", "velocity", "walk", "run", "displacement", "recoil", "jump", "leap", "caminar", "desplazar", "desplazamiento", "pixeles", "retroceso", "velocidad"},
+        {"accel", "aceleracao", "acelerar", "gravidade", "queda", "freio", "frear", "desacelerar", "acceleration", "accelerate", "brake", "gravity", "fall", "aceleracion", "gravedad", "caida", "freno", "frenar"},
+        {"hitbox", "hurtbox", "caixa", "caixas", "ataque", "dano", "alcance", "colisao", "box", "damage", "reach", "collision", "cajas", "ataque", "dano", "alcance", "colision"},
+        {"reacao", "reacoes", "knockback", "empurrao", "empurrar", "hitstun", "stun", "atordoamento", "lancamento", "reaction", "reactions", "pushback", "launch", "reacciones", "empuje", "aturdimiento", "lanzamiento"},
+        {"sequencia", "seq", "combo", "transicao", "cancel", "cancelar", "encadear", "encadeamento", "fluxo", "sequence", "chain", "transition", "flow", "secuencia", "encadenar", "transicion", "flujo"},
+        {"projetil", "projeteis", "tiro", "bala", "fireball", "bullet", "ramificacao", "ramo", "arvore", "perseguicao", "projectile", "projectiles", "shot", "branching", "tree", "homing", "proyectil", "proyectiles", "disparo", "ramificacion", "arbol", "persecucion"},
+        {"som", "audio", "sfx", "wav", "voz", "musica", "sons", "sound", "voice", "music", "sonido", "sonidos", "voz"},
+        {"salvar", "save", "gravar", "backup", "copia", "exportar", "runtime", "pasta", "write", "copy", "export", "folder", "escribir", "respaldo", "copia", "carpeta"},
+        {"imagem", "sprite", "sprites", "recorte", "cnv", "png", "folha", "thumb", "image", "crop", "sheet", "imagen", "recorte", "hoja", "miniatura"},
+        {"tempo", "duracao", "ticks", "tick", "frames", "frame", "time", "duration", "tiempo", "duracion"},
+        {"camera", "zoom", "tela", "tremor", "shake", "cutscene", "cena", "cenas", "camara", "screen", "scene", "scenes", "pantalla", "temblor", "escena", "escenas"},
+        {"link", "links", "filho", "aura", "sincronia", "child", "sync", "hijo"},
+        {"limite", "limites", "maximo", "aviso", "avisos", "erro", "crash", "alerta", "limit", "limits", "maximum", "warning", "warnings", "alert", "limite", "limites", "maximo", "aviso", "avisos"},
+        {"pouso", "chao", "aterrissar", "cair", "landing", "floor", "ground", "aterrizaje", "suelo", "piso", "caer"},
+        {"flip", "virar", "espelhar", "espelhado", "inverter", "rotacao", "mirror", "invert", "rotation", "voltear", "espejar", "invertir", "rotacion"},
+    };
+
+    /** Tolerancia de erro por tamanho da palavra buscada: ate 3 letras so exata, 4 a 6 uma troca, 7 ou mais duas. */
+    private static int maxDist(int len) { return len <= 3 ? 0 : len <= 6 ? 1 : 2; }
+
+    /** Distancia de edicao com transposicao (Damerau-Levenshtein "optimal string alignment"). */
+    static int distance(String a, String b) {
+        int n = a.length(), m = b.length();
+        int[][] d = new int[n + 1][m + 1];
+        for (int i = 0; i <= n; i++) d[i][0] = i;
+        for (int j = 0; j <= m; j++) d[0][j] = j;
+        for (int i = 1; i <= n; i++) {
+            for (int j = 1; j <= m; j++) {
+                int cost = a.charAt(i - 1) == b.charAt(j - 1) ? 0 : 1;
+                int v = Math.min(Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1), d[i - 1][j - 1] + cost);
+                if (i > 1 && j > 1 && a.charAt(i - 1) == b.charAt(j - 2) && a.charAt(i - 2) == b.charAt(j - 1)) v = Math.min(v, d[i - 2][j - 2] + 1);
+                d[i][j] = v;
+            }
+        }
+        return d[n][m];
+    }
+
+    /** Quanto a palavra buscada {@code w} bate com o termo {@code t} (0 = nao bate; 100 = igual). */
+    static int match(String w, String t) {
+        if (w.equals(t)) return 100;
+        int lw = w.length(), lt = t.length();
+        if (lw >= 3 && t.startsWith(w)) return 85;
+        if (lw == 2 && t.startsWith(w) && lt <= 4) return 60;
+        if (lw >= 4 && t.contains(w)) return 55;
+        int md = maxDist(lw);
+        if (md > 0 && Math.abs(lw - lt) <= md) {
+            int dd = distance(w, t);
+            if (dd <= md) return 75 - 5 * dd;
+        }
+        if (lw >= 5 && lt > lw && distance(w, t.substring(0, lw)) <= 1) return 60;
+        return 0;
+    }
+
+    /** Palavras da consulta com as relacionadas: [palavra, peso%]. A propria palavra pesa 100; as parentes, 70. */
+    private static List<Object[]> expand(String w) {
+        List<Object[]> out = new ArrayList<Object[]>();
+        out.add(new Object[] { w, 100 });
+        for (String[] g : SYNONYMS) {
+            boolean in = false;
+            for (String m : g) if (match(w, m) >= 75 || w.equals(m)) { in = true; break; }
+            if (!in) continue;
+            for (String m : g) if (!m.equals(w)) out.add(new Object[] { m, 70 });
+        }
+        return out;
+    }
+
+    /** O texto em PT, EN e ES, um depois do outro (so o PT se nao ha traducao). */
+    static String allLangs(String pt) {
+        if (pt == null || pt.isEmpty()) return "";
+        StringBuilder b = new StringBuilder(pt);
+        String en = I18n.trTo(pt, I18n.EN), es = I18n.trTo(pt, I18n.ES);
+        if (!en.equals(pt)) b.append(' ').append(en);
+        if (!es.equals(pt) && !es.equals(en)) b.append(' ').append(es);
+        return b.toString();
+    }
+
+    private static void prepare(Section s) {
+        if (s.tokBody != null) return;
+        // a busca vale nos tres idiomas: os termos do texto em PT, EN e ES entram juntos
+        s.tokTitle = tokens(norm(allLangs(s.title)));
+        s.tokTags = tokens(norm(allLangs(s.tags)));
+        s.tokBody = tokens(norm(allLangs(s.body)));
+    }
+
+    /** Melhor nota da palavra (com parentes) nos termos; {@code posWeight}: a primeira posicao pesa mais (tags). */
+    private static int best(List<Object[]> variants, String[] terms, boolean posWeight) {
+        int best = 0;
+        for (Object[] v : variants) {
+            String w = (String) v[0];
+            int pct = (Integer) v[1];
+            for (int i = 0; i < terms.length; i++) {
+                int m = match(w, terms[i]);
+                if (m == 0) continue;
+                int sc = m * pct / 100 - (posWeight ? Math.min(i, 20) : 0);
+                if (sc > best) best = sc;
+            }
+        }
+        return best;
+    }
+
+    /** Pesquisa: tolera erros de digitacao e acha palavras relacionadas; todas as palavras da consulta precisam bater. Abas e menus vem antes dos textos; cada faixa fica da melhor para a pior. */
+    static List<Hit> search(String query) {
+        List<Hit> tabs = new ArrayList<Hit>(), texts = new ArrayList<Hit>();
+        String q = norm(query).trim();
+        if (q.isEmpty()) return tabs;
+        String[] words = tokens(q);
+        if (words.length == 0) return tabs;
+        List<List<Object[]>> vars = new ArrayList<List<Object[]>>();
+        for (String w : words) vars.add(expand(w));
+        for (Chapter ch : chapters()) {
+            String[] chTitle = tokens(norm(allLangs(ch.title)));
+            for (Section sec : ch.sections) {
+                prepare(sec);
+                boolean allHead = true, allAny = true;
+                int sHead = 0, sAny = 0;
+                for (List<Object[]> v : vars) {
+                    int title = best(v, sec.tokTitle, false);
+                    int tag = sec.tab ? best(v, sec.tokTags, true) : 0;
+                    int head = Math.max(title + (sec.tab ? 25 : 10), tag + 15);
+                    if (title == 0 && tag == 0) head = 0;
+                    int chap = best(v, chTitle, false) / 2;
+                    int body = best(v, sec.tokBody, false) * 4 / 10;
+                    int inHead = Math.max(head, chap);
+                    if (inHead == 0) allHead = false;
+                    int any = Math.max(inHead, body);
+                    if (any == 0) { allAny = false; break; }
+                    sHead += inHead;
+                    sAny += any;
+                }
+                if (!allAny) continue;
+                if (sec.tab && allHead) tabs.add(new Hit(ch, sec, true, sHead, ""));
+                else texts.add(new Hit(ch, sec, false, sAny, snippet(sec, vars)));
+            }
+        }
+        sortHits(tabs);
+        sortHits(texts);
+        List<Hit> out = new ArrayList<Hit>(tabs);
+        out.addAll(texts);
+        return out;
+    }
+
+    private static void sortHits(List<Hit> l) {
+        // estavel: empates ficam na ordem dos capitulos
+        java.util.Collections.sort(l, new java.util.Comparator<Hit>() {
+            @Override public int compare(Hit a, Hit b) { return b.score - a.score; }
+        });
+    }
+
+    /** Trecho do texto em volta da melhor palavra que bateu; vazio se o titulo ja basta. */
+    private static String snippet(Section sec, List<List<Object[]>> vars) {
+        String body = I18n.tr(sec.body);
+        String nb = norm(body);
+        java.util.regex.Matcher m = WORD.matcher(nb);
+        int bestPos = -1, bestSc = 0;
+        while (m.find()) {
+            for (List<Object[]> v : vars) for (Object[] x : v) {
+                int sc = match((String) x[0], m.group()) * (Integer) x[1] / 100;
+                if (sc > bestSc) { bestSc = sc; bestPos = m.start(); }
+            }
+        }
+        if (bestPos < 0) {
+            // bateu so nos termos de outro idioma: mostra o comeco do texto no idioma atual
+            if (body.length() <= 160) return body;
+            int z0 = 160;
+            while (z0 > 80 && body.charAt(z0) != ' ') z0--;
+            return body.substring(0, z0).trim() + " …";
+        }
+        int a = Math.max(0, bestPos - 50), z = Math.min(body.length(), bestPos + 110);
+        while (a > 0 && a < bestPos && body.charAt(a - 1) != ' ') a++;
+        while (z < body.length() && z > bestPos && body.charAt(z) != ' ') z--;
+        return (a > 0 ? "… " : "") + body.substring(a, z).trim() + (z < body.length() ? " …" : "");
+    }
+}
diff -ruN a/HitstopNotice.java b/HitstopNotice.java
--- a/HitstopNotice.java	1970-01-01 00:00:00.000000000 +0000
+++ b/HitstopNotice.java	2026-10-29 16:18:36.325111352 +0000
@@ -0,0 +1,36 @@
+package com.zue.attackeditor;
+
+/**
+ * Estado do aviso de hitstop ao avancar tick pelo botao (Java puro). O acerto congela o atacante por N ticks (o jogo grava um contador fixo,
+ * nao espera o hitspark): enquanto isso o contador de tick mostrado fica travado e um aviso diz quantos ticks faltam. Quando o tick e
+ * liberado o aviso some. Timeline, barra de progresso e reproducao nao usam isto.
+ */
+final class HitstopNotice {
+    private int left;
+    private int locked = -1;
+
+    /** Depois de um passo do botao: {@code tick} = tick da simulacao agora, {@code hsLeft} = ticks de hitstop do atacante que ainda faltam. */
+    void afterStep(int tick, int hsLeft) {
+        if (hsLeft > 0) {
+            if (left == 0) locked = tick;          // entrou no congelamento: o numero do tick fica neste
+            left = hsLeft;
+        } else {
+            left = 0;
+            locked = -1;
+        }
+    }
+
+    void clear() { left = 0; locked = -1; }
+
+    boolean active() { return left > 0; }
+    int left() { return left; }
+
+    /** Tick a mostrar: o travado durante o hitstop, o real no resto. */
+    int shownTick(int realTick) { return active() ? locked : realTick; }
+
+    /** Texto do aviso amarelo. */
+    String text() {
+        return "Hitstop: o acerto congela o Frame por mais " + left + (left == 1 ? " tick" : " ticks")
+                + " (o hitspark continua tocando). O tick libera depois disso.";
+    }
+}
diff -ruN a/I18n.java b/I18n.java
--- a/I18n.java	1970-01-01 00:00:00.000000000 +0000
+++ b/I18n.java	2026-10-24 22:21:54.510991426 +0000
@@ -0,0 +1,215 @@
+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Idioma da interface (PT padrao, EN, ES latino). O codigo e os dados internos ficam em portugues; so o que vai para a tela passa por {@link #tr}.
+ * Resolucao, nesta ordem: 1) texto exato do catalogo; 2) modelo com {0}, {1}... (ex.: "Salvando em {0}") casado com o texto ja montado;
+ * 3) troca de fragmentos do catalogo por limite de palavra (maior primeiro), para textos concatenados. Sem traducao, devolve o proprio texto.
+ * Termos neutros (DAC, CNV, ANO, MPT, HDAT, OPT, SEQ, END) ficam iguais nas tres colunas do catalogo. Java puro.
+ */
+final class I18n {
+    private I18n() { }
+
+    static final int PT = 0, EN = 1, ES = 2;
+    static final String[] CODES = {"PT", "EN", "ES"};
+
+    private static int lang = PT;
+
+    static int lang() { return lang; }
+
+    static String code() { return CODES[lang]; }
+
+    static void set(int l) {
+        int n = (l < 0 || l > 2) ? PT : l;
+        if (n == lang) return;
+        lang = n;
+        cache.clear();
+    }
+
+    /** Proximo idioma da volta PT -> EN -> ES -> PT; devolve o novo. */
+    static int next() {
+        set((lang + 1) % 3);
+        return lang;
+    }
+
+    static int fromCode(String c) {
+        for (int i = 0; i < CODES.length; i++) if (CODES[i].equalsIgnoreCase(c)) return i;
+        return PT;
+    }
+
+    // ---- catalogo ----
+
+    private static boolean loaded;
+    private static final Map<String, String[]> exact = new HashMap<String, String[]>();
+    private static final List<Tpl> templates = new ArrayList<Tpl>();
+    private static final List<String[]> fragments = new ArrayList<String[]>();
+
+    private static final class Tpl {
+        final Pattern re;
+        final String[] to;
+        final int groups;
+
+        Tpl(Pattern re, String[] to, int groups) {
+            this.re = re;
+            this.to = to;
+            this.groups = groups;
+        }
+    }
+
+    private static final Pattern PLACE = Pattern.compile("\\{(\\d)\\}");
+
+    /** Todas as entradas {pt, en, es} do catalogo (varios blocos em I18nCatalog*). */
+    static List<String[]> entries() {
+        if (testEntries != null) return testEntries;
+        List<String[]> all = new ArrayList<String[]>();
+        for (String[][] block : I18nCatalog.blocks()) for (String[] e : block) all.add(e);
+        return all;
+    }
+
+    /** Textos da AJUDA {pt, en, es}: so busca exata (nao entram nos fragmentos). */
+    static List<String[]> helpEntries() {
+        if (testEntries != null) return new ArrayList<String[]>();
+        List<String[]> all = new ArrayList<String[]>();
+        for (String[][] block : I18nHelpCatalog.blocks()) for (String[] e : block) all.add(e);
+        return all;
+    }
+
+    private static synchronized void load() {
+        if (loaded) return;
+        loaded = true;
+        for (String[] e : entries()) {
+            if (e.length < 3 || e[0].length() == 0) continue;
+            if (PLACE.matcher(e[0]).find()) templates.add(template(e));
+            else {
+                exact.put(e[0], e);
+                if (e[0].length() >= 3 && !(e[0].equals(e[1]) && e[0].equals(e[2]))) fragments.add(e);
+            }
+        }
+        for (String[] e : helpEntries()) if (e.length >= 3 && e[0].length() > 0 && !exact.containsKey(e[0])) exact.put(e[0], e);   // so exata: texto longo nao vira fragmento
+        java.util.Collections.sort(fragments, new java.util.Comparator<String[]>() {
+            @Override public int compare(String[] a, String[] b) { return b[0].length() - a[0].length(); }
+        });
+        java.util.Collections.sort(templates, new java.util.Comparator<Tpl>() {
+            @Override public int compare(Tpl a, Tpl b) { return b.re.pattern().length() - a.re.pattern().length(); }
+        });
+    }
+
+    private static Tpl template(String[] e) {
+        StringBuilder re = new StringBuilder("^");
+        Matcher m = PLACE.matcher(e[0]);
+        int last = 0, groups = 0;
+        while (m.find()) {
+            re.append(Pattern.quote(e[0].substring(last, m.start())));
+            re.append("(.*?)");
+            last = m.end();
+            groups++;
+        }
+        re.append(Pattern.quote(e[0].substring(last))).append('$');
+        return new Tpl(Pattern.compile(re.toString(), Pattern.DOTALL), e, groups);
+    }
+
+    private static final Map<String, String> cache = new LinkedHashMap<String, String>(256, 0.75f, true) {
+        @Override protected boolean removeEldestEntry(Map.Entry<String, String> eldest) { return size() > 2048; }
+    };
+
+    static boolean hasLetters(String s) {
+        for (int i = 0; i < s.length(); i++) if (Character.isLetter(s.charAt(i))) return true;
+        return false;
+    }
+
+    /** Traduz um texto de interface para o idioma atual (PT = devolve igual). */
+    static synchronized String tr(String s) {
+        if (lang == PT || s == null || s.length() == 0 || !hasLetters(s)) return s;
+        String hit = cache.get(s);
+        if (hit != null) return hit;
+        String out = translate(s, lang, 0);
+        cache.put(s, out);
+        return out;
+    }
+
+    /** Como {@link #tr} para um idioma explicito (testes e geradores). */
+    static synchronized String trTo(String s, int l) {
+        int old = lang;
+        try {
+            if (l == PT || s == null) return s;
+            return translate(s, l, 0);
+        } finally { lang = old; }
+    }
+
+    private static String translate(String s, int l, int depth) {
+        load();
+        if (!hasLetters(s)) return s;
+        String[] e = exact.get(s);
+        if (e != null) return e[l];
+        String t = s.trim();
+        if (t.length() != s.length() && t.length() > 0) {            // mesmo texto com espacos nas pontas
+            String[] e2 = exact.get(t);
+            if (e2 != null) return s.substring(0, s.indexOf(t.charAt(0))) + e2[l] + s.substring(s.lastIndexOf(t.charAt(t.length() - 1)) + 1);
+        }
+        for (Tpl tp : templates) {
+            Matcher m = tp.re.matcher(s);
+            if (!m.matches()) continue;
+            String res = tp.to[l];
+            for (int g = 0; g < tp.groups; g++) {
+                String part = m.group(g + 1);
+                if (depth < 2 && hasLetters(part)) part = translate(part, l, depth + 1);
+                res = res.replace("{" + g + "}", part);
+            }
+            return res;
+        }
+        return fragmentsOf(s, l);
+    }
+
+    private static boolean isWord(char c) { return Character.isLetterOrDigit(c) || c == '_' || c == '$'; }
+
+    private static String fragmentsOf(String s, int l) {
+        StringBuilder cur = new StringBuilder(s);
+        List<String> marks = new ArrayList<String>();
+        boolean any = false;
+        for (String[] f : fragments) {
+            String key = f[0];
+            int from = 0;
+            while (true) {
+                int at = cur.indexOf(key, from);
+                if (at < 0) break;
+                int end = at + key.length();
+                boolean okL = !isWord(key.charAt(0)) || at == 0 || !isWord(cur.charAt(at - 1));
+                boolean okR = !isWord(key.charAt(key.length() - 1)) || end >= cur.length() || !isWord(cur.charAt(end));
+                if (!okL || !okR) { from = at + 1; continue; }
+                String mark = "" + marks.size() + "";
+                marks.add(f[l]);
+                cur.replace(at, end, mark);
+                from = at + mark.length();
+                any = true;
+            }
+        }
+        if (!any) return s;
+        String r = cur.toString();
+        for (int i = marks.size() - 1; i >= 0; i--) r = r.replace("" + i + "", marks.get(i));
+        return r;
+    }
+
+    private static List<String[]> testEntries;
+
+    /** So para testes: usa estas entradas no lugar do catalogo (null = catalogo real) e relê tudo. */
+    static synchronized void useEntries(List<String[]> e) {
+        testEntries = e;
+        reset();
+    }
+
+    /** So para testes: forca a releitura do catalogo. */
+    static synchronized void reset() {
+        loaded = false;
+        exact.clear();
+        templates.clear();
+        fragments.clear();
+        cache.clear();
+    }
+}
diff -ruN a/I18nBuilder.java b/I18nBuilder.java
--- a/I18nBuilder.java	1970-01-01 00:00:00.000000000 +0000
+++ b/I18nBuilder.java	2026-10-24 21:47:49.291790893 +0000
@@ -0,0 +1,41 @@
+package com.zue.attackeditor;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.DialogInterface;
+
+/** AlertDialog.Builder que traduz titulo, mensagem, botoes e itens ({@link I18n#tr}); o resto e igual. */
+final class I18nBuilder extends AlertDialog.Builder {
+    I18nBuilder(Context c) { super(c); }
+
+    I18nBuilder(Context c, int theme) { super(c, theme); }
+
+    private static CharSequence t(CharSequence s) { return s == null || I18n.lang() == I18n.PT ? s : I18n.tr(s.toString()); }
+
+    private static CharSequence[] t(CharSequence[] a) {
+        if (a == null || I18n.lang() == I18n.PT) return a;
+        CharSequence[] o = new CharSequence[a.length];
+        for (int i = 0; i < a.length; i++) o[i] = t(a[i]);
+        return o;
+    }
+
+    @Override public AlertDialog.Builder setTitle(CharSequence title) { return super.setTitle(t(title)); }
+
+    @Override public AlertDialog.Builder setMessage(CharSequence message) { return super.setMessage(t(message)); }
+
+    @Override public AlertDialog.Builder setPositiveButton(CharSequence text, DialogInterface.OnClickListener l) { return super.setPositiveButton(t(text), l); }
