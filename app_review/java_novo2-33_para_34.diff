diff -ruN a/ReactionTimelineView.java b/ReactionTimelineView.java
--- a/ReactionTimelineView.java	1970-01-01 00:00:00.000000000 +0000
+++ b/ReactionTimelineView.java	2026-10-24 23:58:06.038743387 +0000
@@ -0,0 +1,740 @@
+package com.zue.attackeditor;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.view.MotionEvent;
+import android.view.ScaleGestureDetector;
+import android.view.View;
+import java.util.List;
+
+/**
+ * Timeline de uma reacao de dano, no estilo da {@link TimelineView} (mesmas medidas de {@link ReactionLayout}): uma faixa de clipes
+ * (um por passo da tabela, com a miniatura do ANO do oponente) e, abaixo, as faixas SPEED (blocos em corridas), VOZ, EFEITOS (parede),
+ * SEQ (proxima reacao) e CURVA (x e y em px/tick, so leitura). Fechada, mostra so uma linha de resumo por faixa com dados.
+ * O ponteiro fica no centro; arrastar rola (e leva a previa junto); pinca faz zoom; arrastar na vertical rola as faixas.
+ * Tocar no clipe fechado abre as faixas; aberto, seleciona o passo. Tocar num item (ou celula vazia) de uma faixa abre o menu dele.
+ */
+final class ReactionTimelineView extends View {
+    static final int LANE_PASSOS = ReactionLayout.L_CLIP, LANE_SPEED = ReactionLayout.L_SPEED, LANE_VOZ = ReactionLayout.L_VOZ,
+            LANE_EFEITOS = ReactionLayout.L_EFEITOS, LANE_SEQ = ReactionLayout.L_SEQ, LANE_CURVA = ReactionLayout.L_CURVA;
+
+    interface Listener {
+        /** Tocou num passo da tabela editada (faixa aberta): selecionar e abrir o menu. */
+        void onSelectRow(int row);
+        /** Arrastou o ponteiro para o tick (estado depois de {@code tick} ticks). */
+        void onScrub(int tick);
+        /** Soltou a borda de um passo: nova duracao em ticks (no cenario atual). */
+        void onResize(int row, int ticks);
+        /** Tocou num item (ou celula vazia) de uma faixa que nao e a dos passos. */
+        void onOpenLane(int lane, int row);
+        /** Soltou a borda direita de um bloco SPEED: o bloco {@code run} (ver {@link ReactionRuns#runs}) passa a terminar no passo {@code newEnd} (exclusivo). */
+        void onResizeRun(int run, int newEnd);
+    }
+
+    private static final int C_CLIP = 0xFFE5C100, C_OTHER = 0xFF3A4150, C_SPEED = 0xFF3DDC84, C_VOICE = 0xFF3D8BFF, C_WALL = 0xFFFF9A3C, C_SEQ = 0xFFFF5D8F,
+            C_VX = 0xFFFF8A66, C_VY = 0xFF3DDC84;
+    private static final int[] LANE_COLORS = {C_CLIP, C_SPEED, C_VOICE, C_WALL, C_SEQ, 0xFF8A90A0};
+    private static final float HANDLE_DP = 16;
+
+    private final float d;
+    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint t = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rf = new RectF();
+    private final Rect sr = new Rect();
+    private final Path path = new Path();
+    private final ScaleGestureDetector scaler;
+    private Listener listener;
+
+    private ReactionTrace trace;
+    private ReactionTable table;
+    private boolean charSrc, air, editable;
+    private int type;
+    private Dac opDac;
+    private SpriteCache opSprites;
+    private int sel = -1;
+    private int selLane = LANE_PASSOS;
+    private float playTick;
+    private float ppt;
+
+    private final boolean[] show = {true, true, true, true, true};
+    private final boolean[] has = new boolean[ReactionLayout.LANES];
+    private boolean expanded = true;
+    private List<ReactionLayout.Row> rows = new java.util.ArrayList<ReactionLayout.Row>();
+    private float scrollDp, viewDp, maxDp;
+
+    private static final int M_NONE = 0, M_SCRUB = 1, M_RESIZE = 2, M_RUN = 3, M_VSCROLL = 4, M_PARENT = 5;
+    private int mode;
+    private float downX, downY, lastY, downTick;
+    private boolean moved, scaling;
+    private int resizeRow, resizeBase, resizeDur;
+    private int runIdx, runBase, runTarget;
+
+    ReactionTimelineView(Context c) {
+        super(c);
+        d = c.getResources().getDisplayMetrics().density;
+        ppt = 5f * d;
+        t.setTextSize(9f * d);
+        scaler = new ScaleGestureDetector(c, new ScaleGestureDetector.SimpleOnScaleGestureListener() {
+            @Override public boolean onScale(ScaleGestureDetector g) {
+                ppt = Math.max(1.2f * d, Math.min(16f * d, ppt * g.getScaleFactor()));
+                invalidate();
+                return true;
+            }
+        });
+    }
+
+    void setListener(Listener l) { listener = l; }
+
+    void setOpponent(Dac dac, SpriteCache sprites) { opDac = dac; opSprites = sprites; }
+
+    /** {@code table}: a tabela mostrada (type/charSrc a identificam); {@code air}: cenario que o trace simulou; {@code editable}: libera arrastar a duracao. */
+    void setData(ReactionTrace tr, ReactionTable table, boolean charSrc, int type, boolean air) {
+        this.trace = tr;
+        this.table = table;
+        this.charSrc = charSrc;
+        this.editable = charSrc;
+        this.type = type;
+        this.air = air;
+        rebuild();
+        invalidate();
+    }
+
+    void setSelected(int row) { if (row != sel) { sel = row; invalidate(); } }
+
+    /** Faixa do item selecionado (o passo selecionado fica destacado nessa faixa). */
+    void setSelectedLane(int lane) { if (lane != selLane) { selLane = lane; invalidate(); } }
+
+    boolean isExpanded() { return expanded; }
+
+    void setExpanded(boolean e) {
+        if (e == expanded) return;
+        expanded = e;
+        rebuild();
+        invalidate();
+    }
+
+    boolean isShown(int i) { return show[i]; }
+
+    void setShown(int i, boolean on) {
+        if (show[i] == on) return;
+        show[i] = on;
+        rebuild();
+        invalidate();
+    }
+
+    void showAll() {
+        for (int i = 0; i < show.length; i++) show[i] = true;
+        rebuild();
+        invalidate();
+    }
+
+    /** Teto de altura (px) conforme a area visivel da tela; 0 = so o teto padrao de 188 dp. */
+    void setMaxHeightPx(int px) {
+        float dp = px <= 0 ? ReactionLayout.CAP : Math.min(ReactionLayout.CAP, Math.max(px / d, 96f));
+        if (Math.abs(dp - maxDp) < 0.5f) return;
+        maxDp = dp;
+        rebuild();
+        invalidate();
+    }
+
+    /** Ponteiro em ticks (pode ser fracionario durante o play). */
+    void setPointer(float tick) {
+        float mx = Math.max(0, trace == null ? 0 : trace.ticks.size());
+        playTick = Math.max(0f, Math.min(mx, tick));
+        invalidate();
+    }
+
+    int pointerTick() { return Math.round(playTick); }
+
+    /** Trecho (da tabela editada) que processa o tick {@code tick}, ou null. */
+    ReactionTrace.Seg segAt(int tick) {
+        if (trace == null) return null;
+        for (ReactionTrace.Seg s : trace.segments) if (tick >= s.start && tick < s.end) return s;
+        return null;
+    }
+
+    boolean isOwn(ReactionTrace.Seg s) { return s != null && s.charSrc == charSrc && s.type == type; }
+
+    // ---- linhas (ReactionLayout) ----
+
+    private void rebuild() {
+        java.util.Arrays.fill(has, false);
+        if (table != null) {
+            has[LANE_SPEED] = !ReactionRuns.runs(table, air).isEmpty();
+            for (int r = 0; r < table.rows; r++) {
+                if (table.s8(r, 13) > 0) has[LANE_VOZ] = true;
+                if (table.u8(r, 12) > 0) has[LANE_EFEITOS] = true;
+                if (table.u8(r, 11) > 0) has[LANE_SEQ] = true;
+            }
+        }
+        if (maxDp <= 0) maxDp = ReactionLayout.CAP;
+        rows = ReactionLayout.body(show, expanded, has);
+        float want = ReactionLayout.viewH(rows, maxDp);
+        if (Math.abs(want - viewDp) > 0.5f) { viewDp = want; requestLayout(); }
+        scrollDp = ReactionLayout.clampScroll(rows, viewDp, scrollDp);
+        ReactionLayout.place(rows, scrollDp);
+    }
+
+    @Override protected void onMeasure(int ws, int hs) {
+        if (viewDp <= 0) rebuild();
+        setMeasuredDimension(MeasureSpec.getSize(ws), Math.round(viewDp * d));
+    }
+
+    private float gutter() { return 58f * d; }
+    private float contentW() { return Math.max(1f, getWidth() - gutter()); }
+    private float xOf(float tick) { return gutter() + contentW() / 2f + (tick - playTick) * ppt; }
+    private float tickAt(float x) { return playTick + (x - gutter() - contentW() / 2f) / ppt; }
+    private float bodyTopPx() { return ReactionLayout.bodyTop() * d; }
+
+    private ReactionLayout.Row rowOf(int lane) {
+        for (ReactionLayout.Row r : rows) if (r.lane == lane) return r;
+        return null;
+    }
+
+    private static String tok(int v) { return v == -1 ? "=" : v == -2 ? "½" : String.valueOf(v); }
+
+    private String clip(String s, float w) {
+        s = I18n.tr(s);
+        if (t.measureText(s) <= w) return s;
+        int n = s.length();
+        while (n > 1 && t.measureText(s, 0, n) + t.measureText("…") > w) n--;
+        return s.substring(0, n) + "…";
+    }
+
+    private ReactionTrace.Seg segOfRow(int row) {
+        if (trace == null) return null;
+        for (ReactionTrace.Seg s : trace.segments) if (isOwn(s) && s.row == row) return s;
+        return null;
+    }
+
+    // ---- desenho ----
+
+    @Override protected void onDraw(Canvas c) {
+        float W = getWidth(), H = getHeight(), g = gutter();
+        c.drawColor(0xFF12151A);
+        if (trace == null || table == null) {
+            t.setColor(0xFF4A505E);
+            I18nUi.drawText(c, "sem reação", g + 8 * d, 60 * d, t);
+            return;
+        }
+        int total = trace.ticks.size();
+        c.save();
+        c.clipRect(g, 0, W, H);
+        ruler(c, W, H);
+        // fora da reacao escurece
+        p.setColor(0x88000000);
+        c.drawRect(g, ReactionLayout.RULER * d, Math.min(W, xOf(0)), H, p);
+        if (xOf(total) < W) c.drawRect(Math.max(g, xOf(total)), ReactionLayout.RULER * d, W, H, p);
+        // passo sob o ponteiro
+        ReactionTrace.Seg cur = segAt(pointerTick());
+        if (cur != null) {
+            p.setColor(0x16FFFFFF);
+            c.drawRect(xOf(cur.start), ReactionLayout.RULER * d, xOf(cur.end), H, p);
+        }
+        clips(c);
+        c.save();
+        c.clipRect(g, bodyTopPx(), W, H);
+        for (ReactionLayout.Row r : rows) {
+            float top = r.top * d, bot = (r.top + r.h) * d;
+            if (bot < bodyTopPx() || top > H) continue;
+            stripe(c, top, bot);
+            switch (r.lane) {
+                case LANE_SPEED: speedRow(c, r); break;
+                case LANE_VOZ: chipRow(c, r, C_VOICE); break;
+                case LANE_EFEITOS: chipRow(c, r, C_WALL); break;
+                case LANE_SEQ: chipRow(c, r, C_SEQ); break;
+                default: curveRow(c, r, total); break;
+            }
+        }
+        // fronteiras do inicio e do fim da reacao
+        p.setColor(0x55FFFFFF);
+        p.setStrokeWidth(1f * d);
+        c.drawLine(xOf(0), ReactionLayout.RULER * d, xOf(0), H, p);
+        c.drawLine(xOf(total), ReactionLayout.RULER * d, xOf(total), H, p);
+        guides(c, W, H);
+        c.restore();
+        // ponteiro
+        float px = g + contentW() / 2f;
+        p.setColor(0xFFFFFFFF);
+        p.setStrokeWidth(1.5f * d);
+        c.drawLine(px, 0, px, H, p);
+        path.reset();
+        path.moveTo(px - 5 * d, 0);
+        path.lineTo(px + 5 * d, 0);
+        path.lineTo(px, 6 * d);
+        path.close();
+        c.drawPath(path, p);
+        c.restore();
+        gutterColumn(c, H);
+        scrollBar(c, W, H);
+    }
+
+    private void stripe(Canvas c, float top, float bot) {
+        p.setColor(0x0DFFFFFF);
+        c.drawRect(gutter(), top, getWidth(), bot - 1, p);
+    }
+
+    private void ruler(Canvas c, float W, float H) {
+        float g = gutter();
+        int[] steps = {1, 2, 5, 10, 30, 60, 120};
+        int step = 120;
+        for (int s : steps) if (s * ppt >= 26f * d) { step = s; break; }
+        int first = (int) Math.floor(tickAt(g) / step) * step;
+        t.setColor(0xFF8A90A0);
+        t.setTextSize(9.5f * d);
+        p.setColor(0x33FFFFFF);
+        p.setStrokeWidth(1f);
+        for (int k = Math.max(0, first); xOf(k) < W; k += step) {
+            float x = xOf(k);
+            if (x < g) continue;
+            c.drawLine(x, ReactionLayout.RULER * d - 4 * d, x, H, p);
+            I18nUi.drawText(c, k % 60 == 0 && k > 0 ? (k / 60) + "s" : String.valueOf(k), x + 2 * d, 11 * d, t);
+        }
+    }
+
+    /** Coluna dos nomes das faixas (como a da principal) e o cabecalho "REACAO n". */
+    private void gutterColumn(Canvas c, float H) {
+        float g = gutter();
+        p.setColor(0xFF0E1015);
+        c.drawRect(0, 0, g, H, p);
+        c.save();
+        c.clipRect(0, bodyTopPx(), g, H);
+        for (ReactionLayout.Row r : rows) {
+            float top = r.top * d, bot = (r.top + r.h) * d;
+            if (bot < bodyTopPx() || top > H) continue;
+            t.setColor(LANE_COLORS[r.lane]);
+            t.setTextSize(r.summary ? 7.5f * d : 9f * d);
+            c.drawText(clip(ReactionLayout.NAMES[r.lane], g - 8 * d), 4 * d, (top + bot) / 2f + 3f * d, t);
+        }
+        c.restore();
+        t.setColor(0xFFE6E8EC);
+        t.setTextSize(11f * d);
+        t.setFakeBoldText(true);
+        c.drawText(clip((charSrc ? "REAÇÃO " : "JOGO ") + type, g - 8 * d), 4 * d, ReactionLayout.RULER * d / 2f + 4 * d, t);
+        t.setFakeBoldText(false);
+        float top = ReactionLayout.RULER * d;
+        t.setColor(C_CLIP);
+        t.setTextSize(9.5f * d);
+        I18nUi.drawText(c, "PASSOS", 4 * d, top + ReactionLayout.CLIP * d / 2f - 2 * d, t);
+        t.setColor(0xFF6B7280);
+        t.setTextSize(8f * d);
+        I18nUi.drawText(c, expanded ? "toque p/ fechar" : "toque p/ abrir", 4 * d, top + ReactionLayout.CLIP * d / 2f + 9 * d, t);
+        t.setTextSize(9f * d);
+    }
+
+    private void scrollBar(Canvas c, float W, float H) {
+        float viewH = H - bodyTopPx();
+        float content = ReactionLayout.contentH(rows) * d;
+        if (content <= viewH + 1) return;
+        float th = Math.max(16 * d, viewH * viewH / content);
+        float ty = bodyTopPx() + (viewH - th) * (scrollDp * d / Math.max(1f, content - viewH));
+        p.setColor(0x55FFFFFF);
+        c.drawRoundRect(W - 3 * d, ty, W - 1 * d, ty + th, d, d, p);
+    }
+
+    // ---- faixa de clipes: passos ----
+
+    private void clips(Canvas c) {
+        float top = ReactionLayout.RULER * d, h = ReactionLayout.CLIP * d, g = gutter(), W = getWidth();
+        for (ReactionTrace.Seg s : trace.segments) {
+            boolean own = isOwn(s);
+            float x0 = xOf(s.start), x1 = xOf(s.end);
+            if (x1 < g || x0 > W) continue;
+            boolean isSel = own && s.row == sel && selLane == LANE_PASSOS;
+            p.setColor(own ? C_CLIP : C_OTHER);
+            p.setAlpha(isSel ? 255 : own ? (s.row == sel ? 230 : 185) : 255);
+            rf.set(x0 + 1, top + 2 * d, Math.max(x0 + 3 * d, x1 - 1), top + h - 2 * d);
+            c.drawRoundRect(rf, 4 * d, 4 * d, p);
+            p.setAlpha(255);
+            if (isSel) {
+                p.setStyle(Paint.Style.STROKE);
+                p.setColor(0xFFFFFFFF);
+                p.setStrokeWidth(1.5f * d);
+                c.drawRoundRect(rf, 4 * d, 4 * d, p);
+                p.setStyle(Paint.Style.FILL);
+            }
+            c.save();
+            c.clipRect(rf);
+            float tx = rf.left + 3 * d, box = h - 8 * d;
+            if (own) {
+                int ano = table.s8(s.row, 2);
+                if (rf.width() > box + 4 * d) {
+                    drawThumb(c, Math.abs(ano), tx, top + 4 * d, box, ano < 0);
+                    tx += box + 3 * d;
+                }
+                if (rf.right - tx > 14 * d) {
+                    t.setColor(0xFF1A1500);
+                    t.setFakeBoldText(true);
+                    t.setTextSize(9.5f * d);
+                    I18nUi.drawText(c, "passo " + (s.row + 1) + (ano < 0 ? " ⇄" : ""), tx, top + h / 2f - 2 * d, t);
+                    t.setFakeBoldText(false);
+                    t.setTextSize(8f * d);
+                    int dur = table.u8(s.row, ReactionEdit.durColumn(air));
+                    I18nUi.drawText(c, "ANO " + Math.abs(ano) + " · " + (dur == 255 ? "até pousar " : "") + s.length() + "t", tx, top + h / 2f + 9 * d, t);
+                    t.setTextSize(9f * d);
+                }
+            } else if (rf.width() > 14 * d) {
+                t.setColor(0xFFFFFFFF);
+                t.setTextSize(8f * d);
+                I18nUi.drawText(c, "→ " + (s.charSrc ? "pers. " : "jogo ") + s.type, tx, top + h / 2f + 3 * d, t);
+                t.setTextSize(9f * d);
+            }
+            c.restore();
+            // alca de duracao (borda direita): so no personagem e quando a duracao nao e o 255
+            if (own && editable) {
+                boolean can = ReactionEdit.canResize(table, s.row, air);
+                p.setColor(can ? 0xFF1A1500 : 0x66000000);
+                float hx = rf.right - 3 * d;
+                c.drawRoundRect(hx - 1.5f * d, rf.centerY() - 8 * d, hx + 1.5f * d, rf.centerY() + 8 * d, 2 * d, 2 * d, p);
+            }
+        }
+    }
