+    /**
+     * SE de um frame do DAC (_ActReqMain): id < 80 toca se_(id-1) na hora (id 8 -> se_07);
+     * id >= 80 e audio do personagem (80 = primeiro), tocado pelo ChrSePlay da raiz, com o
+     * deslocamento da quantidade de WAVs do atacante quando o dono e o jogador 1.
+     * SE de links so tocam se forem < 80 (o obj.se >= 80 de um link nunca e consumido).
+     */
+    private void consumeSe(AttackSim s, int owner) {
+        AttackSim.Obj r = s.root();
+        if (r == null) return;
+        if (r.pendingSe >= 0) {
+            int se = r.pendingSe;
+            r.pendingSe = -1;
+            // ChrSePlay: o jogador 1 soma ChrSoundCount[3] (n. de audios do jogador 0) a qualquer SE
+            pushSe(se, owner);
+        }
+        AttackSim.Obj[] ch = s.children();
+        for (int i = 0; i < ch.length; i++) {
+            AttackSim.Obj c = ch[i];
+            if (c == null || c.pendingSe < 0) continue;
+            int se = c.pendingSe;
+            c.pendingSe = -1;
+            int cn = SoundIds.commonOf(se);
+            if (cn >= 0) sounds.add(new Snd(true, cn, 0));      // links so tocam sons globais
+        }
+    }
+
+    /** SE do frame (byte sem sinal): 1..79 e 100..255 = global se_(id-1); 80..99 = audio do personagem (o jogador 1 soma os audios do jogador 0). */
+    private void pushSe(int se, int owner) {
+        if (SoundIds.isCharId(se)) {
+            int idx = se - SoundIds.CHAR_FIRST;
+            if (owner == 1 && atkWavCount > 0) idx += atkWavCount;
+            if (idx < atkWavCount) sounds.add(new Snd(false, idx, 0));
+            else sounds.add(new Snd(false, idx - atkWavCount, 1));
+            return;
+        }
+        int cn = SoundIds.commonOf(se);
+        if (cn >= 0) sounds.add(new Snd(true, cn, 0));
+    }
+
+    /** PushSE: < 80 = se_NN comum; >= 80 = audio de personagem na lista [atacante..., defensor...]. */
+    private void pushRaw(int id) {
+        if (id < 0) return;
+        if (id < 80) {
+            sounds.add(new Snd(true, id, 0));
+            return;
+        }
+        int idx = id - 80;
+        if (idx < atkWavCount) sounds.add(new Snd(false, idx, 0));
+        else sounds.add(new Snd(false, idx - atkWavCount, 1));
+    }
