+            AttackSim.Obj o = s.opponent().root();
+            check("oponente no frame 0 ao nascer a cutscene", o.pat, 0);
+            for (int i = 0; i < 10; i++) s.step();
+            o = s.opponent().root();
+            check("oponente congelado durante a cutscene (10 ticks)", o.pat + ":" + o.time, "0:3");
+            for (int i = 0; i < 3; i++) s.step();
+            o = s.opponent().root();
+            check("volta 1 tick depois da morte da task", o.pat, 1);
+        }
+
+        // ---- so o 1o stun devolve o md do alvo (work[7] != 925)
+        {
+            CharData ch = chrEv(new int[]{0, 1, 0, 20, 21, 0, 1, 0}, new int[]{0, 2, 0, 20, 21, 0, 1, 0});
+            BattleSim s = sim(ch, atkDac(new int[]{20, 0, 0, 0, 0}, new int[]{20, 0, 0, 1, 0}), fxDac());
+            check("duas cutscenes", s.cutsceneCount(), 2);
+            for (int i = 0; i < 13; i++) s.step();
+            check("a 1a morreu (sync 1), a 2a continua", s.cutsceneCount(), 1);
+            check("o 1o stun devolveu o oponente mesmo com a 2a viva", s.opponent().root().pat, 1);
+        }
+
+        // ---- mapa 3 com camera livre (cam 0): salta direto e a task morre no mesmo tick (nunca aparece)
+        {
+            CharData ch = chrEv(new int[]{0, 0, 0, 20, 21, 0, 0, 3});
