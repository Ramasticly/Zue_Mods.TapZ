+    /** Aplica o texto editado e recria a simulacao. Devolve null se deu certo ou a mensagem de erro. */
+    public String applyEdit(String tab, String text) {
+        if (sim == null || data == null) return "nada carregado";
+        AttackSim.Obj r = sim.attacker().root();
+        try {
+            if ("move".equals(tab)) {
+                final CharData.Move mv = data.move;
+                final CharData.Move before = mv.copy();
+                DacText.parseMove(text, mv);
+                pushUndo(null, UndoEdits.swapMove(mv, before, null));
+            } else {
+                if (r == null) return "sem ANO";
+                final Dac dac = data.attacker.dac;
+                final int idx = r.ano.index;
+                final Ano old = r.ano;
+                if ("frame".equals(tab)) {
+                    final int pat = r.pat;
+                    if (pat < 0 || pat >= old.mpts.length) return "frame fora da ANO";
+                    final Ano.Mpt m = DacText.parseMpt(text);
+                    final Ano.Mpt prev = old.mpts[pat];
+                    old.mpts[pat] = m;
+                    pushUndo(null, UndoEdits.swapMpts(old, new int[] {pat}, new Ano.Mpt[] {prev}));
+                } else if ("links".equals(tab)) {
+                    Ano.Link[] ls = DacText.parseLinks(text, old.links);
+                    int fl = ls.length > 0 ? (old.flags | 2) : (old.flags & ~2);
+                    dac.setAno(idx, new Ano(idx, true, fl, old.priority, ls, old.mpts));
+                    pushUndo(null, UndoEdits.swapAno(dac, idx, old));
+                } else {
+                    Ano na = DacText.parseAno(text, idx, old);
+                    dac.setAno(idx, na);
+                    pushUndo(null, UndoEdits.swapAno(dac, idx, old));
