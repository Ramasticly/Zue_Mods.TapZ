+    /** Port do task md 19: parede do mapa, rolagem da camera e limite de tela dos dois lutadores. */
+    private void tickCancel() {
+        if (hsAtk > 0) { if (cancelAtk == 0) cancelAtk = 20; } else if (cancelAtk > 0) cancelAtk--;
