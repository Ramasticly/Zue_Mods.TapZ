+    /** Hitbox com flag 38 no frame atual (PlayerState & 8388608 no jogo). */
+    private static boolean blocksSeq(AttackSim.Obj r) {
+        for (int i = 0; i < r.hits.length; i++) if (r.hits[i].flag == 38) return true;
+        return false;
+    }
+
+    /**
+     * Se true, a ANIM_END tambem toca quando a SEQ termina (como descreve o comentario do HDAT 4).
+     * No codigo do jogo (md 882) a END so toca num NOVO hit confirmado durante a SEQ.
+     */
+    public static boolean endOnSeqFinish = false;
+
+    private int curAno() {
+        AttackSim.Obj r = atk.root();
+        return r == null ? -1 : r.ano.index;
+    }
+
+    /**
+     * Port do bloco "Processamento de Impacto" do md 882 (CheckObjHit confirmou um hit).
+     * hitAno = DamageHitActNo do oponente: ANO do atacante no hit corpo a corpo, ANO do proprio
+     * projetil no hit de projetil (DamageChange recebe obj.ano do objeto que acertou).
+     * Melee: wFlag&1 -> work[10] = 1. Projetil (md 971): so se CancelTime do dono == 0 e for o 1o hit
+     * dele, ai liga wFlag&4096 (troca para ANIM_AO_ACERTAR) mas NAO liga work[10].
+     */
+    private void onHitConfirmed(boolean fromProjectile, int hitAno, Proj p) {
+        AttackSim.Obj r = atk.root();
+        if (r == null) return;
+        boolean flag4096 = false;
+        if (fromProjectile) {
+            if (p != null && !p.flagged && cancelAtk == 0) {
+                p.flagged = true;
+                flag4096 = true;
+                cancelAtk = 20;
+            }
+        }
+        everHit = true;
+        hitConfirmed = true;                       // wFlag|=1 (melee e projetil no laco de hits) -> work[10] = 1
+        if (attackOver) return;                    // fora do md 882: nenhum hit troca mais o ANO
+        boolean f38 = blocksSeq(r);
+        int animReacao = (!f38 && move.animAoAcertar != 0) ? move.animAoAcertar : hitAno;
+        int cur = curAno();
+        if (flag4096 && animReacao != cur && hitAno != animReacao) {
+            transKind = 2;
+            if (switchAtk(animReacao)) { cancelAtk = 0; lastHit += " -> ANIM_AO_ACERTAR " + animReacao; }
+            else if (probe && atk.root() != null) {        // sondagem: nao troca, mas registra onde a SEQ_PROJETIL (AO_ACERTAR) entraria
+                HitEvent h2 = new HitEvent();
+                h2.tick = ticks; h2.ano = cur; h2.pat = atk.root().pat; h2.kind = 2; h2.target = animReacao;
+                h2.air = atk.root().y != 0; h2.blocked = false; h2.projectile = fromProjectile;
+                hitEvents.add(h2);
+            }
+        }
+        cur = curAno();
+        // PlayerState & 8388608 e relido depois da troca: o SetAct + PlayerTail do jogo recalculam os flags do ANO novo
+        f38 = blocksSeq(atk.root());
+        if ((hitAno == cur || animReacao == cur) && hitConfirmed) {
+            AttackSim.Obj ev = atk.root();
+            if (ev != null) {                            // registra o hit para o marcador de sequencia da timeline
+                boolean evAir = ev.y != 0;
+                int evSeq = evAir ? move.animSeqAr : move.animSeqChao;
+                int evEnd = evAir ? move.animEndAr : move.animEndChao;
+                int kind = -1, tgt = 0;
+                if (evEnd != 0 && cur == evSeq) { kind = 1; tgt = evEnd; }
+                else if (evSeq != 0 && cur != evSeq && cur != evEnd) { kind = 0; tgt = evSeq; }
+                if (kind >= 0) {
+                    HitEvent he = new HitEvent();
+                    he.tick = ticks; he.ano = cur; he.pat = ev.pat; he.kind = kind; he.target = tgt;
+                    he.air = evAir; he.blocked = f38; he.projectile = fromProjectile;
+                    hitEvents.add(he);
+                }
+            }
+            if (f38) {
+                hitConfirmed = false;
+                lastHit += " [flag 38: sem troca neste frame]";
+                return;
+            }
+            AttackSim.Obj rr = atk.root();
+            boolean air = rr != null && rr.y != 0;
+            int seq = air ? move.animSeqAr : move.animSeqChao;
+            int end = air ? move.animEndAr : move.animEndChao;
+            if (end != 0 && cur == seq) {
+                transKind = 1;
+                if (switchAtk(end)) { phase = 2; cancelAtk = 0; lastHit += " -> ANIM_END " + end; }
+            } else if (seq != 0 && cur != seq && cur != end) {
+                transKind = 0;
+                if (switchAtk(seq)) {
+                    phase = 1;
+                    cancelAtk = 0;
+                    lastHit += " -> ANIM_SEQ " + seq;
+                    if (end != 0) hitConfirmed = false;
+                }
+            }
+        }
+    }
+
+    private boolean attackOver;
+
+    /**
+     * Agarrao dos golpes com ATK_FLAGS 8 / 128 (md 882, "Reposicionamento"): no ANO inicial do golpe, quando ele termina
+     * ou num frame com a janela 512, o atacante vai para o lado do oponente (distancia = HDAT 3, byte 5), na altura dele,
+     * e segue para o ANO seguinte (ANIM_INICIAL + 1). A flag 8 puxa mesmo sem acertar; a 128 so se o oponente ainda
+     * estiver em reacao de dano deste golpe (e o numero do golpe for 0..12, que e o que o jogo grava no oponente).
+     */
+    private void tryPull() {
+        if (probe || attackOver || idleMode) return;
+        AttackSim.Obj r = atk.root();
+        if (r == null || r.ano.index != move.animInicial || move.generic) return;
+        boolean g8 = (move.flags & 8) != 0;
+        boolean g128 = (move.flags & 128) != 0 && inDamage && hitConfirmed && specialType <= 12;      // -1 = desconhecido: nao bloqueia
+        if (!g8 && !g128) return;
+        if (!r.isDone() && (r.optFlag & 512) == 0) return;
+        int next = r.ano.index + 1;
+        Ano na = atkDac.getAno(next);
+        if (na == null || !na.present) return;
+        int ox = r.x, oy = r.y;
+        int dist = (atkChar == null ? 0 : atkChar.pullDistance()) * PX;
+        r.x = r.x < oppX ? oppX - dist : oppX + dist;
+        r.y = oppY;
+        transKind = -1;
+        if (switchAtk(next)) {
+            hitConfirmed = false;                 // work[10] = 0
+            scrollLock = true;                    // bScrollLock = true no md 882
+            lastHit += " [agarrao: atacante -> oponente, ANO " + next + "]";
+        } else {
+            r.x = ox;
+            r.y = oy;
+        }
+    }
