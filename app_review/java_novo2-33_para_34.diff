+    /**
+     * Roda uma copia a partir da ANO {@code ano} sem trocas de ANO e devolve todos os hits que conectam
+     * e disparariam sequencia/fim (um por frame). Vazio para ANOs avulsas (sem golpe).
+     */
+    public List<HitEvent> probeHits(int ano) {
+        List<HitEvent> out = new ArrayList<HitEvent>();
+        if (move.generic) return out;
+        CharData.Move m2 = move.copy();
+        m2.animInicial = ano;
+        BattleSim s = new BattleSim(atkDac, atkChar, m2, atkLeft, defDac, fxDac, gd, distancePx, heightPx, atkWavCount);
+        s.oppChar = oppChar;
+        s.specialType = specialType;
+        s.bobjDac = bobjDac;
+        if (charfDac != null) s.setCharfDac(charfDac); else s.reset();
+        s.probe = true;
+        for (int t = 0; t < 1800; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r == null) break;
+            s.step();
+            r = s.atk.root();
+            if (r == null || r.isDone() || s.atk.hasWrapped()) break;
+        }
+        return s.hitEvents;
+    }
