+
+        System.out.println("AiHelpTest fails=" + BattleTest.fails);
+    }
+
+    static int countOf(String s, String sub) {
+        int n = 0, i = 0;
+        while ((i = s.indexOf(sub, i)) >= 0) { n++; i += sub.length(); }
+        return n;
+    }
+
+    /** O bloco de codigo (entre cercas) que contem {@code marker}. */
+    static String block(String doc, String marker) {
+        int at = doc.indexOf(marker);
+        int a = doc.lastIndexOf("```", at);
+        int z = doc.indexOf("```", at);
+        return doc.substring(doc.indexOf('\n', a) + 1, z);
+    }
