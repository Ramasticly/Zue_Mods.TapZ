+        public int tick, fromAno, fromPat, toAno, kind;
+    }
+    private final List<Trans> trans = new ArrayList<Trans>();
+    private int transKind = -1;
+    private List<Trans> realTrans = new ArrayList<Trans>();
+    /** Trocas reais da execucao completa (calculadas em measureLength). */
+    public List<Trans> transitions() { return realTrans; }
