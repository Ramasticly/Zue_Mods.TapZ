+    /** undoKey != null: edicoes seguidas com a mesma chave (4 s) viram um unico desfazer. */
+    public void replaceAno(Ano na, String undoKey) {
+        final Ano old = currentAno();
+        if (old == null || data == null) return;
+        na = withLoopKept(old, na);
+        final Dac dac = data.attacker.dac;
+        final int idx = old.index;
+        dac.setAno(idx, na);
+        pushUndo(undoKey, UndoEdits.swapAno(dac, idx, old));
+        editVersion++;
+        rebuild(frame);
+    }
