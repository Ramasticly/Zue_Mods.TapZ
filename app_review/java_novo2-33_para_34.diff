+    /** Ticks ate o ANO do atacante terminar (ignora o tempo estendido: so o ANO, sem a fisica depois dele). */
+    public int measureAnoLength() {
+        BattleSim s = fresh();
+        for (int t = 1; t <= 3600; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r == null) return 1;
+            s.step();
+            r = s.atk.root();
+            if (r == null || r.isDone() || s.atk.hasWrapped()) return t;
+        }
+        return 3600;
+    }
+
+    public int measureLength() {
+        BattleSim s = fresh();
+        try { return measure(s); } finally {
+            realTrans = new ArrayList<Trans>(s.trans);
+            measuredLandedEarly = s.landedEarly;
+            measuredLandTick = s.landTick;
+            s.explainUnreachedSpawn();
+            measuredSpawnProblem = s.spawnProblem;
+            measuredSpawnByHeight = s.spawnByHeight;
+        }
+    }
+
+    private int measure(BattleSim s) {
+        for (int t = 1; t <= 3600; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r == null) { looping = false; return 1; }
+            s.step();
+            r = s.atk.root();
+            if (r == null) { looping = false; return t; }
+            if (s.atk.hasWrapped() && !s.idleMode) { looping = true; return t; }
+            if (extendTime) {
+                if ((r.isDone() || s.idleMode) && s.extSettled()) { looping = false; return t; }
+            } else if (r.isDone()) { looping = false; return t; }
+        }
+        looping = false;
+        return 3600;
+    }
