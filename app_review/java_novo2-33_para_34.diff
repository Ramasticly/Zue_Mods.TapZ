+    // ============================================================ deteccao de hit
+
+    private void detect() {
+        AttackSim.Obj def = opp.root();
+        if (def == null || defShaking) return;          // md 935: wObjFlag & 8 do defensor (tremor do hitstop) impede a deteccao neste tick
+        // projeteis
+        for (int i = 0; i < projs.size(); i++) {
+            Proj p = projs.get(i);
+            if (p.dead || !p.armed) continue;
+            AttackSim.Obj o = p.sim.root();
+            int[] pos = checkObjHit(o, def);
+            if (pos == null) continue;
+            p.armed = false;
+            p.hitFlag = true;
+            Opt1 op = new Opt1(o.optData[1]);
+            if (op.hitstopMode != 2) {
+                p.hs = HIT_STOP / 2;
+                hsDef = HIT_STOP;
+            }
+            hitTargetDef = true;
+            if (hitOrGuard(op, pos, "projetil", o.optData[0], o.ano.index)) onHitConfirmed(true, o.ano.index, p);
+        }
+        detectGrab(def);
+        // corpo a corpo
+        AttackSim.Obj r = atk.root();
+        if (armed && r != null && !atkFrozen && lifeA > 0 && lifeO > 0) {      // md 935: golpe corpo a corpo so com os dois vivos
+            int[] pos = checkObjHit(r, def);
+            if (pos != null) {
+                armed = false;
+                Opt1 op = new Opt1(r.optData[1] & 255);
+                int hs = op.hitstopTicks(HIT_STOP, true);
+                if (hs > 0) {
+                    hsAtk = hs;
+                    hsDef = hs;
+                }
+                hitTargetDef = false;
+                if (hitOrGuard(op, pos, "golpe", r.optData[0], r.ano.index)) onHitConfirmed(false, r.ano.index, null);
+            }
+        }
+    }
