+    /** Modos automaticos: ajusta zoom e posicao a cada desenho. */
+    private void applyCamera() {
+        if (centerMode == 0 || sim == null || getWidth() == 0 || getHeight() == 0) return;
+        float x0, x1, y0, y1;
+        if (centerMode == 1) {
+            float sl = sim.screenLeft() / 65536f;
+            float st = sim.screenTop() / 65536f;
+            x0 = sl; x1 = sl + 480f; y0 = st; y1 = st + 320f;
+            float[] zr = sim.zoomRect();         // com zoom ativo, a tela segue o retangulo amarelo (o que o jogo realmente mostra)
+            if (zr != null) { x0 = zr[0]; y0 = zr[1]; x1 = zr[2]; y1 = zr[3]; }
+        } else {
+            float ax = sim.attackerX(), ox = sim.opponentX();
+            AttackSim.Obj r = sim.attacker().root();
+            float ay = r == null ? 0f : r.y / 65536f;
+            float body = 30f, margin = 50f;
+            x0 = Math.min(ax, ox) - body - margin;
+            x1 = Math.max(ax, ox) + body + margin;
+            y0 = Math.min(0f, ay) - 100f - margin;
+            y1 = 30f;
+        }
+        float s = Math.min(getWidth() / (x1 - x0), getHeight() / (y1 - y0));
+        scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, s));
+        originX = getWidth() * 0.5f - (x0 + x1) * 0.5f * scale;
+        originY = getHeight() * 0.5f - (y0 + y1) * 0.5f * scale;
+        originSet = true;
+    }
+
+    public void recenter() {
+        originX = getWidth() * 0.5f;
+        originY = getHeight() * 0.55f;
+        scale = Math.max(1f, density);
+        // padrao: enquadra o mapa inteiro (bordas vermelhas visiveis); depois pan/zoom seguem livres
+        if (sim != null && getWidth() > 0) {
+            float ml = sim.mapLeft() / 65536f, mr = sim.mapRight() / 65536f;
+            if (mr - ml > 50f) {
+                float w = mr - ml + 40f;
+                scale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, getWidth() / w));
+                originX = getWidth() * 0.5f - (ml + mr) * 0.5f * scale;
+            }
+        }
+        originSet = true;
+        invalidate();
+    }
