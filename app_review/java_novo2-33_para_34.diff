+    /** Editor: trava as trocas automaticas de ANO (sequencia, fim, pouso, queda) para editar uma ANO sem o fluxo interferir. */
+    /** Altura do oponente em px acima do chao (editor: POS > OPONENTE). */
+    public static int oppHeightPx = 0;
+    /** Editor: POUSO ligado simula pouso/queda (troca de ANO); desligado, so zera a velocidade no chao e segue na mesma ANO. */
+    public static boolean landingOn = true;
+    public static int lockFromTick = -1;       // -1 = livre; >= 0: trocas so acontecem ate este tick (o que ja tinha trocado fica)
