+    private void tickDamage(int depth) {
+        if (lifeO <= 0 && !dCharSrc && dType == 2) { dType = 29; dIdx = 0; }     // md 876: Life <= 0 e DamageType 2 -> 29
+        ReactionTable tb = table(dCharSrc, dType);
+        if (tb == null || !tb.has(dIdx) || depth > 6) {
+            endDamage(864, -1);
+            return;
+        }
+        boolean hs = hsDef > 0;
+
+        if (dTime == 0) {
+            int ano = tb.s8(dIdx, 2);
+            int voice = tb.s8(dIdx, 13);
+            if (voice > 0) pushRaw(voice >= 80 ? voice + atkWavCount : voice - 1);
+            int a = ano;
+            if (ano < 0) {
+                oppFlip = !oppFlip;
+                a = -ano;
+            }
+            if (dCharSrc && opp.root() != null && a == opp.root().ano.index) setOppAct(0);
+            setOppAct(a);
+            int v = oppY < 0 ? 7 : 3;
+            int xs = tb.s8(dIdx, v), ys = tb.s8(dIdx, v + 1), xa = tb.s8(dIdx, v + 2), ya = tb.s8(dIdx, v + 3);
+            ReactionTable old = table(dCharSrc, dOldType);
+            if (xs == -2) dXs = (old == null ? 0 : old.u8(dOldIdx, 3)) / 2;
+            else if (xs != -1) dXs = xs * 128 / 10;
+            if (ys == -2) dYs = (old == null ? 0 : old.u8(dOldIdx, 4)) / 2;
+            else if (ys != -1) dYs = ys * 128 / 10;
+            if (xa == -2) dXa = dXa / 2;
+            else if (xa != -1) dXa = xa * 128 / 10;
+            if (ya == -2) dYa = dYa / 2;
+            else if (ya != -1) dYa = ya * 128 / 10;
+            dTime++;
+        } else if (!hs) {
+            int old = dXs;
+            dXs += dXa;
+            dYs += dYa;
+            if ((old >= 0 && dXs < 0) || (old <= 0 && dXs > 0) || dXs == 0) {
+                dXs = 0;
+                dXa = 0;
+            }
+        }
+        if (!hs) {
+            if (oppFlip) oppX -= dXs << 9; else oppX += dXs << 9;
+            oppY += dYs << 9;
+        }
+
+        // PlayerTail: DamageMove, anima o defensor (pausa no hitstop) e toca o SE do frame
+        if (dMove != 0) {
+            if (oppFlip) oppX += dMove << 15; else oppX -= dMove << 15;
+            dMove -= 2;
+            if (dMove < 0) dMove = 0;
+        }
+        AttackSim.Obj r = opp.root();
+        if (r != null) {
+            r.x = oppX;
+            r.y = oppY;
+            opp.step(hs);
+            oppX = r.x;
+            oppY = r.y;
+            consumeSe(opp, 1);
+        }
+        if (hs) return;
+
+        int comp = tb.u8(dIdx, 11);
+        int wall = tb.u8(dIdx, 12);
+        if (comp > 0 && comp < 50) {
+            if (wall != 2 && wall != 3 && !forceWall) {
+                if (comp == 11) {
+                    if (oppY > 0 || (dYs <= 0 && dYa <= 0)) {
+                        oppY = 0;
+                        endDamage(888, 24);
+                        return;
+                    }
+                } else if (oppY >= 0) {
+                    oppY = 0;
+                    sounds.add(new Snd(true, 11, 0));
+                    if (comp >= 30) {
+                        if (!dCharSrc) { endDamage(864, -1); return; }
+                        dType = comp - 30;
+                    } else {
+                        dCharSrc = false;
+                        dType = comp;
+                    }
+                    dIdx = 0;
+                    dTime = 0;
+                    tickDamage(depth + 1);
+                    return;
+                }
+            } else if (oppY > 0) {
+                sounds.add(new Snd(true, 11, 0));
+                oppY = 0;
+                dOldIdx = 0;
+                dOldType = dCharSrc ? 16 : comp;
+                dCharSrc = false;
+                dType = 12;
+                dIdx = 0;
+                dTime = 0;
+                tickDamage(depth + 1);
+                return;
+            } else if (atWall(wall) && !sceneHidden()) {
+                // encostou na parede com WALL 2/3: reinicia a reacao no tipo COMP (DamageWall = true)
+                dmgWall = true;
+                if (comp < 30) { dCharSrc = false; dType = comp; }
+                else if (dCharSrc) dType = comp - 30;
+                else { endDamage(864, -1); return; }
+                lastHit += " -> PAREDE tipo " + comp;
+                dIdx = 0;
+                dTime = 0;
+                tickDamage(depth + 1);
+                return;
+            }
+        } else if (comp != 0) {
+            if (oppY > 0) {
+                sounds.add(new Snd(true, 12, 0));
+                oppY = 0;
+                endDamage(893, 13);
+                return;
+            }
+        } else if (oppY > 0) {
+            oppY = 0;
+        }
+
+        int dur = tb.u8(dIdx, oppY != 0 ? 1 : 0);
+        if (dTime >= dur) {
+            if (dur == 255) {
+                dType = 2;
+                dIdx = 0;
+                dTime = 0;
+                tickDamage(depth + 1);
+            } else {
+                dIdx++;
+                dTime = 0;
+                if (dIdx >= tb.rows) {
+                    if (dYs != 0) {
+                        dCharSrc = false;
+                        if (lifeO <= 0) {                       // derrotado: continua caindo na reacao de KO
+                            oppFlip = oppX > (move.projectile ? refAtkX : atk.root().x) ? false : true;
+                            dType = 2;
+                            dOldType = 2;
+                            dOldIdx = dIdx;
+                        } else {
+                            dType = 13;
+                        }
+                        dIdx = 0;
+                        tickDamage(depth + 1);
+                    } else {
+                        endDamage(864, -1);
+                    }
+                }
+            }
+        } else {
+            dTime++;
+        }
+    }
