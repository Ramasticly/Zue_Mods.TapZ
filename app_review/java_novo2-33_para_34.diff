+    private volatile boolean building;
+
+    /**
+     * Como rebuild(), mas a simulacao nova (e as medicoes completas do golpe) sao feitas fora da UI thread; a tela nao desenha ate terminar.
+     * {@code done} roda na UI thread no fim. Para edicoes grandes (muitos frames de uma vez).
+     */
+    public void rebuildAsync(final int keepFrame, final Runnable done) {
+        if (data == null || building) { rebuild(keepFrame); if (done != null) done.run(); return; }
+        building = true;
+        final AttackData d = data;
+        final boolean fl = facingLeft;
+        final int dist = distance, hgt = height;
+        new Thread(new Runnable() {
+            @Override public void run() {
+                BattleSim ns = null;
+                int len = 1, land = -1, aEnd = 1, target = 0;
+                boolean lp = false;
+                Throwable err = null;
+                try {
+                    ns = new BattleSim(d.attacker.dac, d.attacker.data, d.move, fl, d.opponent.dac, d.effects == null ? null : d.effects.dac,
+                            d.gameData, dist, hgt, d.attacker.wavCount);
+                    ns.setOpponentChar(d.opponent.data);
+                    ns.setSpecialType(d.moveIndex);
+                    if (d.charf != null) ns.setCharfDac(d.charf.dac);
+                    if (d.bobj != null) ns.setBobjDac(d.bobj.dac);
+                    len = Math.max(1, ns.measureLength());
+                    land = ns.measuredLandTick();
+                    aEnd = Math.min(len, Math.max(1, ns.measureAnoLength()));
+                    target = Math.min(keepFrame, len - 1);
+                    ns.reset();
+                    for (int i = 0; i < target; i++) ns.step();
+                    if (target > 0) ns.drainSounds();
+                } catch (Throwable t) { err = t; }
+                final BattleSim fs = ns;
+                final int flen = len, fland = land, fend = aEnd, ft = target;
+                final Throwable ferr = err;
+                post(new Runnable() {
+                    @Override public void run() {
+                        building = false;
+                        if (ferr != null || fs == null) { rebuild(keepFrame); if (done != null) done.run(); return; }
+                        ghostKey = "";
+                        ghostSim = null;
+                        sim = fs;
+                        length = flen;
+                        landStop = fland;
+                        checkLandWarning();
+                        if (!measuredEarly) checkRules();
+                        anoEnd = fend;
+                        loops = sim.loops();
+                        stopSounds();
+                        frame = ft;
+                        landSeen = sim.landedEarly();
+                        acc = 0;
+                        lastMs = 0;
+                        notifyUi();
+                        invalidate();
+                        if (done != null) done.run();
+                    }
+                });
+            }
+        }).start();
+    }
+
+    /** Troca a ANO atual inteira reconstruindo em segundo plano (veja rebuildAsync). */
+    public void replaceAnoAsync(Ano na, Runnable done) {
+        final Ano old = currentAno();
+        if (old == null || data == null) { if (done != null) done.run(); return; }
+        na = withLoopKept(old, na);
+        final Dac dac = data.attacker.dac;
+        final int idx = old.index;
+        dac.setAno(idx, na);
+        pushUndo(null, UndoEdits.swapAno(dac, idx, old));
+        editVersion++;
+        rebuildAsync(frame, done);
+    }
+
+    /** Troca varias ANOs do DAC do atacante de uma vez (um unico desfazer), reconstruindo em segundo plano. */
+    public void replaceAnosAsync(final java.util.List<Ano> list, Runnable done) {
+        if (data == null || list.isEmpty()) { if (done != null) done.run(); return; }
+        final Dac dac = data.attacker.dac;
+        final java.util.ArrayList<Ano> olds = new java.util.ArrayList<Ano>();
+        for (Ano na : list) { olds.add(dac.getAno(na.index)); dac.setAno(na.index, na); }
+        pushUndo(null, UndoEdits.swapAnos(dac, olds));
+        editVersion++;
+        rebuildAsync(frame, done);
+    }
