+    /**
+     * Fim do tick do jogo: tremor (CheckOptFlag nao consome os hits 3-5: enquanto o frame estiver carregado o tremor volta a 12 a cada tick),
+     * cutscenes (md 996, 13729), contagem do cancelamento, camera (md 19, 13745), tremor decrementado pelo md 935, camera vertical e zoom.
+     * O reset() tambem passa por aqui: ele e o 1o tick do jogo, que roda a camera depois da cutscene.
+     */
+    private void endPhase() {
+        for (int i = 0; i < projs.size(); i++) if (!projs.get(i).dead && projs.get(i).hs <= 0 && !stunAny()) shakeFlags(projs.get(i).sim.root(), 0);
+        shakeFlags(atk.root(), 0);
+        shakeFlags(opp.root(), 1);
+        stepCuts();                                   // md 996 (13729): depois dos lutadores/projeteis/hit e antes da camera (13745)
+        tickCancel();
+        camera();
+        if (camShake != 0) camShake--;                // Game6#case935 (antes da task da camera no mesmo frame)
+        updateCamY();
+        zoomTick();
+    }
