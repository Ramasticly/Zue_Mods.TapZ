+    /** Tudo que nao e o atacante parou: sem projeteis, efeitos, reacao nem hitstop. */
+    /** Fim estendido: o atacante so congela quando esta no chao (ou voa); no ar ele cai e pousa antes. */
+    private boolean grounded(AttackSim.Obj r) { return r.y >= 0 || flies || projRoot() || effectRoot(); }
