+        oppX = x[1];
+        AttackSim.Obj dr = opp.root();
+        if (dr != null) dr.x += oppX - ox0;           // so a correcao da camera: um teleporte deste tick aparece no PlayerTail seguinte
+        oldAx = x[0];
+        oldOx = x[1];
+    }
