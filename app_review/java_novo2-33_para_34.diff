+    private void buildPage() {
+        if (!drawerOpen) return;
+        pageBox.removeAllViews();
+        updaters.clear();
+        ReactionTable t = table();
+        if (t == null || sel < 0 || sel >= t.rows) return;
+        String head = (page == P_GRID ? "Passo " : PAGES[page] + "  ·  passo ") + (page == P_TOTAL ? "" : (sel + 1) + " de " + t.rows)
+                + (editable ? "" : "  ·  só leitura") + "  ·  " + (air ? "AR" : "CHÃO");
+        sheet.setTitle(head);
+        switch (page) {
+            case P_GRID: grid(); break;
+            case P_ANIM: pageAnimation(t); break;
+            case P_TIME: pageTime(t); break;
+            case P_SPEED: pageMove(t); break;
+            case P_VOICE: pageVoice(t); break;
+            case P_EFFECTS: pageEffects(t); break;
+            case P_SEQ: pageSeq(t); break;
+            default: pageTotal(t); break;
+        }
+    }
