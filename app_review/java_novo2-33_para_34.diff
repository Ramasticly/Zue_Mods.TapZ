+    /** true enquanto o usuario liga/desliga o loop: ai a normalizacao do loop nao pode desfazer o gesto. */
+    private boolean rawLoopEdit;
+
+    /** O loop e do ANO: se estava no ultimo frame, acompanha o novo ultimo frame depois de qualquer edicao. */
+    private Ano withLoopKept(Ano old, Ano na) {
+        if (rawLoopEdit || old == null || na == null) return na;
+        Ano.Mpt[] fixed = FrameOps.normalizeLoop(old.mpts, na.mpts);
+        return fixed == na.mpts ? na : new Ano(na.index, na.present, na.flags, na.priority, na.links, fixed);
+    }
+
+    /** Liga/desliga o loop da ANO atual (unico caminho que pode desligar o loop). */
+    public void setLoop(boolean on) {
+        Ano old = currentAno();
+        if (old == null) return;
+        rawLoopEdit = true;
+        try { replaceMpts(ObjModel.setLoop(old.mpts, on)); } finally { rawLoopEdit = false; }
+    }
