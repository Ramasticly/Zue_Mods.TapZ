+    /** Troca um MPT da ANO atual (coalescendo edicoes seguidas do mesmo frame). */
+    /** Depois de algo mexer no DAC/sprites por fora do editor de frames (lista de sprites): refaz a simulacao. */
+    public void refreshAfterExternalEdit() {
+        editVersion++;
+        if (data != null) rebuild(frame);
+        invalidate();
+    }
