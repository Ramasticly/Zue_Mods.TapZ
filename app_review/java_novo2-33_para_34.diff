+    // ============================================================ atacante / projetil
+
+    private void afterAtkFrame() {
+        AttackSim.Obj r = atk.root();
+        if (r == null) return;
+        if (r.serial != lastSerial) {
+            lastSerial = r.serial;
+            armed = r.hits.length > 0;     // iHitCount = (iHitNum > 0)
+        }
+        if (spawnedSerial != r.serial) {
+            spawnedSerial = r.serial;
+            visitedAnos.add(r.ano.index);
+            for (int i = 0; i < r.hits.length; i++) {
+                if (r.hits[i].flag == 0) spawnMain(r, r.hits[i]);
+            }
+            if (!optAbort(r, 0)) {                       // CheckOptFlag: OPT 2048 fora de uma parede encerra a funcao antes de olhar os hits
+                teleportFlags(r, 0, 1);
+                if (cutscenes) cutsceneFlags(r, 0, null);
+                if (hasFlag(r, 32) && lifeA > 0 && lifeO > 0) selfDamage(r.optData[0]);
+            }
+        }
+    }
