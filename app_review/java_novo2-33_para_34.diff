+    private void endDamage(int state, int anim) {
+        if (lifeO <= 0) {                           // Life <= 0: ANO 24 e fica deitado (md 888 / 889), sem DamageEnd
+            state = 889;
+            anim = 24;
+            dead = true;
+            oppY = 0;
+        } else {
+            combo = 0;                              // DamageEnd: ComboCount do atacante zera
+        }
+        inDamage = false;
+        endState = state;
+        dmgNote = "fim: md " + state;
+        if (anim >= 0) {
+            endAnim = anim;
+            setOppAct(0);
+            setOppAct(anim);
+        } else {
+            endAnim = -1;
+            setOppAct(0);
+        }
+    }
