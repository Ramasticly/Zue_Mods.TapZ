+        // altura variavel: o conteudo rola dentro da gaveta
+        body = new LinearLayout(c);
+        body.setOrientation(LinearLayout.VERTICAL);
+        body.setPadding(dp(8), 0, dp(8), dp(24));
+        scroll = new ScrollView(c);
+        scroll.setFillViewport(false);
+        scroll.addView(body, new ViewGroup.LayoutParams(-1, -2));
+        root.addView(scroll, new LinearLayout.LayoutParams(-1, 0, 1f));
+        root.setVisibility(View.GONE);
+    }
+
+    private int dp(int v) { return Math.round(v * d); }
+
+    private int peekH() { return dp(HANDLE_DP + 44); }
+
+    private int maxH() { return Math.max(peekH() + dp(60), geo.maxH()); }
+
+    void setTitle(String s) { title.setText(s); }
+
+    boolean isOpen() { return root.getVisibility() == View.VISIBLE; }
+
+    void show() {
+        root.setVisibility(View.VISIBLE);
