+    private void detectGrab(AttackSim.Obj def) {
+        AttackSim.Obj g = grab == null ? null : grab.root();
+        if (g == null || !grabArmed || grabPaused) return;
+        int[] pos = checkObjHit(g, def);
+        if (pos == null) return;
+        grabArmed = false;
+        // md 941 entra em tcbReqHit como um projetil: o defensor leva o hitstop inteiro, o objeto metade e o atacante nenhum
+        Opt1 op = new Opt1(g.optData[1]);
+        if (op.hitstopMode != 2) { grabHs = HIT_STOP / 2; hsDef = HIT_STOP; }
+        hitTargetDef = true;
+        applyHit(op, pos, "agarrar", g.optData[0], g.ano.index);
+        if (inDamage) onHitConfirmed(true, g.ano.index, null);
+        if (cancelAtk == 0) cancelAtk = 20;           // md 941: o objeto pausado que acertou liga CancelTime[atacante] = 20
+    }
+
+    /** CheckObjHit: hitbox (flag 2) do atacante contra hurtbox (flag 1) do alvo; devolve o centro do impacto em px. */
+    private static int[] checkObjHit(AttackSim.Obj a, AttackSim.Obj t) {
+        int af = (a.actFlags & 48) ^ (a.objFlags & 48);
+        int tf = (t.actFlags & 48) ^ (t.objFlags & 48);
+        for (int i = 0; i < a.hits.length; i++) {
+            Ano.Hit ha = a.hits[i];
+            if (ha.flag != 2) continue;
+            int aL, aR, aT, aB;
+            if ((af & 16) != 0) { aR = (a.x >> 16) - ha.x; aL = aR - ha.width; }
+            else { aL = (a.x >> 16) + ha.x; aR = aL + ha.width; }
+            if ((af & 32) != 0) { aB = (a.y >> 16) - ha.y; aT = aB - ha.height; }
+            else { aT = (a.y >> 16) + ha.y; aB = aT + ha.height; }
+            for (int j = 0; j < t.hits.length; j++) {
+                Ano.Hit ht = t.hits[j];
+                if (ht.flag != 1) continue;
+                int tL, tR, tT, tB;
+                if ((tf & 16) != 0) { tR = (t.x >> 16) - ht.x; tL = tR - ht.width; }
+                else { tL = (t.x >> 16) + ht.x; tR = tL + ht.width; }
+                if ((tf & 32) != 0) { tB = (t.y >> 16) - ht.y; tT = tB - ht.height; }
+                else { tT = (t.y >> 16) + ht.y; tB = tT + ht.height; }
+                if (aL < tR && tL < aR && aT < tB && tT < aB) {
+                    int x = ((aR - aL) / 2 + aL + tL + (tR - tL) / 2) / 2;
+                    int y = ((aB - aT) / 2 + aT + tT + (tB - tT) / 2) / 2;
+                    return new int[] {x, y};
+                }
+            }
+        }
+        return null;
+    }
+
+    /** Parte "hit" de DamageChange. */
+    private static boolean hasFlag(AttackSim.Obj r, int flag) {
+        if (r == null) return false;
+        for (int i = 0; i < r.hits.length; i++) if (r.hits[i].flag == flag) return true;
+        return false;
+    }
+
+    /** LIFE_DEC: o jogo so tira vida se o outro lutador ainda esta vivo. */
+    private void lifeDec(boolean toOpp, int d) {
+        if (toOpp) { if (lifeA > 0) lifeO = Math.max(0, lifeO - d); }
+        else { if (lifeO > 0) lifeA = Math.max(0, lifeA - d); }
+    }
+
+    /**
+     * DamageChange (parte do dano): OptData[0] com ataque/defesa (a menos da flag 28), escala por combo
+     * (HDAT 5 do gamedata), limite pela vida restante, LIFE_DEC e ComboCount (nao conta com a flag 37).
+     */
+    private void applyDamage(Opt1 op, int dmg, int hitAno) {
+        AttackSim.Obj ar = atk.root();
+        boolean f28 = hasFlag(ar, 28), f37 = hasFlag(ar, 37);
+        int d = dmg;
+        if (!f28 && d != 0) {
+            int def = oppChar == null ? 0 : oppChar.defenceMul(LEVEL);
+            if (def < 0) def = 0;
+            int atkMul = atkChar == null ? 100 : atkChar.attackMul(LEVEL);
+            d = atkMul * d / 100 * (100 - def) / 100;
+            if (d < 2) d = 2;
+        }
+        if (hitAno == 92) d = 0;
+        int idx = combo;
+        if (combo >= 2) idx = Math.min(combo, 15) - 2;
+        if (d != 0 && gd != null) {
+            d = gd.comboScale(idx) * d / 100;
+            if (d == 0) d = 1;
+        }
+        if (lifeO < d) d = lifeO;
+        totalDamage += d;
+        lastDamage = d;
+        lifeDec(true, d);
+        if (op.effectAno == 0 || op.effectAno == 1) {      // o jogo so conta combo quando o efeito e o Ano 0 ou 1
+            if (!f37) { combo = Math.min(99, combo + 1); }
+        }
+    }
+
+    /** SelfDamage (hitbox flag 32): o atacante perde OptData[0] de vida, mas nunca morre (fica com 1). */
+    private void selfDamage(int d) {
+        if (lifeA <= d) lifeA = 1; else lifeDec(false, d);
+        lastSelf = d;
+    }
+
+    private void applyHit(Opt1 op, int[] pos, String who, int dmg, int hitAno) {
+        lastHit = who + " - " + op.describe();
+        if (!op.valid) return;
+        if (lifeA > 0) {
+            applyDamage(op, dmg, hitAno);
+            lastHit += " [dano " + lastDamage + ", vida " + lifeO + "/" + maxO + ", combo " + combo + "]";
+        }
+        ReactionTable tb = table(op.fromChar, op.type);
+        if (tb == null || tb.rows == 0) {
+            lastHit += " [tabela ausente]";
+            return;
+        }
+        // efeito e som de impacto
+        if (op.effectAno >= 0 && fxDac != null) {
+            fxs.add(newFx(new AttackSim(fxDac, op.effectAno, false, pos[0] * PX, pos[1] * PX)));
+        }
+        if (op.sound >= 0) sounds.add(new Snd(true, op.sound, 0));
+        enterDamage(op, hitAno);
+    }
