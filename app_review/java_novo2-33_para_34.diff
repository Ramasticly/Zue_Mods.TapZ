+    private void advance() {
+        long now = SystemClock.uptimeMillis();
+        if (lastMs == 0) lastMs = now;
+        acc += (now - lastMs) * speed;
+        lastMs = now;
+        int steps = 0;
+        while (acc >= TICK_MS && steps < MAX_STEPS_PER_DRAW) {
+            if (atLandStop()) { playing = false; acc = 0; lastMs = 0; notifyUi(); return; }
+            if (frame + 1 >= length) {
+                seekInternal(0);
+                // ANO sem wActFlag 1: volta ao frame 0 e espera o play
+                if (!loops || (!BattleSim.flyMode && landStop >= 0)) { playing = false; acc = 0; lastMs = 0; notifyUi(); return; }
+            } else { liveStep(); frame++; watchLanding(); }
+            playSounds();
+            acc -= TICK_MS;
+            steps++;
+        }
+        if (steps == MAX_STEPS_PER_DRAW) acc = 0;
+        if (steps > 0) notifyUi();
+    }
