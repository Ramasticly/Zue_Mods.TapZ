+    private void camera() {
+        if (edgeMode == 0) return;
+        AttackSim.Obj ra = atk.root();
+        if (ra == null) return;
+        int[] x = {pendA ? pendAX : ra.x, oppX};      // PlayerXPos: o teleporte pendente do atacante ja vale para a camera
+        int ox0 = oppX;
+        int[] old = {oldAx, oldOx};
+        int[] h = {halfA * PX, halfO * PX};
+        boolean[] left = {atkFacingLeft(), oppFlip};
+        // 1. parede do mapa (camera encostada na ponta do mapa); com a camera de deslocamento ativa (iBackXOffset != 0) nao ha parede
+        for (int i = 0; i < 2; i++) {
+            if (anoOfPlayer(i) == 88 || edgeOff[i] || camXOff != 0) continue;
+            int lo = camLeft + h[i], hi = camLeft + SCREEN_W - h[i];
+            int o = 1 - i;
+            if (camBase == 0 && x[i] < lo) {
+                if (i == 1 && !hitTargetDef && old[i] > x[i] && cancelAtk != 0) x[o] += (old[i] - x[i]) * 4 / 5;
+                x[i] = lo;
+            } else if (camBase == MAP_BASE_MAX && x[i] > hi) {
+                if (i == 1 && !hitTargetDef && old[i] < x[i] && cancelAtk != 0) x[o] += (old[i] - x[i]) * 4 / 5;
+                x[i] = hi;
+            }
+        }
+        bodySeparation(x, old, h);
+        // 2. rolagem (iBackXOffset != 0: a camera nao rola, so segue o alvo)
+        int[] d = new int[2];
+        boolean freeze = inDamage && !dCharSrc && hsDef > 0;
+        for (int i = 0; i < 2; i++) {
+            int a = anoOfPlayer(i);
+            d[i] = ((i == 1 && freeze) || a == 74 || a == 75 || scrollOff[i] || hidden[i] || scrollLock) ? 0 : x[i] - old[i];
+        }
+        scrollLock = false;
+        for (int i = 0; i < 2; i++) {
+            int o = 1 - i;
+            int ho = h[o] >> 16;
+            int ox = x[o];
+            boolean alive = (i == 0 ? lifeA : lifeO) > 0;
+            if (camXOff != 0) { d[i] = 0; continue; }
+            if (camBase + d[i] <= 0) d[i] = -camBase;
+            if (camBase + d[i] >= MAP_BASE_MAX) d[i] = MAP_BASE_MAX - camBase;
+            if (x[i] >= camLeft + 4587520) {
+                if (x[i] >= camLeft + 26869760) {
+                    if (d[i] < 0 && ox >= camLeft + 4587520 && alive) d[i] = 0;
+                    else if (d[i] > 0 && ox <= camLeft + h[o] && alive) d[i] = 0;
+                } else d[i] = 0;
+            } else if (((d[i] > 0 && ox < camLeft + 26869760) || (d[i] < 0 && ox >= camLeft + ((480 - ho - 1) << 16))) && alive) {
+                d[i] = 0;
+            }
+        }
+        int scroll = 0;
+        for (int i = 0; i < 2; i++) {
+            int thr = left[i] ? 26869760 : 4587520;
+            if ((x[i] < camLeft + thr && d[i] > 0) || (x[i] >= camLeft + 26869760 && d[i] < 0)) d[i] >>= 1;
+            scroll += d[i];
+        }
+        camBase += scroll;
+        camLeft += scroll;
+        // 2b. camera de deslocamento (iBackXOffset): segue iScrollTarget (mapa 5) ou o defensor que bateu na parede numa reacao WALL 1
+        int tgt = -1;
+        boolean wall3 = false;
+        if (inDamage) {
+            int wall = curWall();
+            if (wall == 3) { wall3 = true; camBase += camXOff; }
+            else if (wall == 1 && dmgWall) tgt = 1;
+        }
+        if (scrollTarget != -1) tgt = scrollTarget;
+        int n6 = tgt == -1 ? 0 : (tgt == 0 ? x[0] : x[1]) - camLeft - 15728640;
+        if (n6 == 0 && (camXOff != 0 || lifeA <= 0 || lifeO <= 0)) {
+            camLeft += camXOff;                       // sem alvo: o deslocamento passa para iBackXPos (a tela nao salta)
+            camXOff = 0;
+        }
+        if (camXOff <= n6 - 1048576) camXOff += 786432;
+        else if (camXOff <= n6 - 786432) camXOff += 524288;
+        else if (camXOff <= n6 - 393216) camXOff += 262144;
+        else if (camXOff <= n6 - 262144) camXOff += 131072;
+        else if (camXOff < n6) camXOff = n6;
+        else if (camXOff >= 1048576 + n6) camXOff -= 786432;
+        else if (camXOff >= 786432 + n6) camXOff -= 524288;
+        else if (camXOff >= 393216 + n6) camXOff -= 262144;
+        else if (camXOff >= 262144 + n6) camXOff -= 131072;
+        else if (camXOff > n6) camXOff = n6;
