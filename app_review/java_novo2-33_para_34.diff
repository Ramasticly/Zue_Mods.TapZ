+            check("tremor continua no tick 50 (nao decai em 12 ticks)", s.screenTop() != -15728640, true);
+        }
+
+        // ---- zoom 30/31: FRAMES = 0 e ignorado
+        for (int fr = 0; fr < 2; fr++) {
+            A[] a = new A[45];
+            for (int i = 0; i < 45; i++) a[i] = new A().mpt(new M().time(1));
+            a[40] = new A().mpt(new M().time(100).hit(30, 0, 0, 150, fr == 0 ? 0 : 10));
+            CharData ch = chr(move(new int[]{2, 40}), new byte[][] {});
+            BattleSim s = new BattleSim(dac(a), ch, ch.moves[0], false, defDac(), fxDac(), g, 100, 0, 0);
+            for (int i = 0; i < 30; i++) s.step();
