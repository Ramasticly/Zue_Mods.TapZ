+        Ano.Mpt m = ch.mpts[childPat(ch)];
+        lab("FRAME " + (childPat(ch) + 1) + " DA ANO " + ch.index + " — SPRITE");
+        AttackData ad = view.attackData();
+        int maxImg = ad != null && ad.attacker.cnv != null ? Math.max(0, ad.attacker.cnv.size() - 1) : 9999;
+        put(new Stepper(a).range(-1, maxImg).step(1).keyboard(new Stepper.OnValue() { public void on(final double v) {
