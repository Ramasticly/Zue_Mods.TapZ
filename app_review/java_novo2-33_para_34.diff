+    private void detectGrab(AttackSim.Obj def) {
+        AttackSim.Obj g = grab == null ? null : grab.root();
+        if (g == null || !grabArmed || grabPaused) return;
+        int[] pos = checkObjHit(g, def);
+        if (pos == null) return;
+        grabArmed = false;
+        // md 941 entra em tcbReqHit como um projetil: o defensor leva o hitstop inteiro, o objeto metade e o atacante nenhum
+        Opt1 op = new Opt1(g.optData[1]);
+        if (op.hitstopMode != 2) { grabHs = HIT_STOP / 2; hsDef = HIT_STOP; }
+        hitTargetDef = true;
+        applyHit(op, pos, "agarrar", g.optData[0], g.ano.index);
+        if (inDamage) onHitConfirmed(true, g.ano.index, null);
+        if (cancelAtk == 0) cancelAtk = 20;           // md 941: o objeto pausado que acertou liga CancelTime[atacante] = 20
+    }
