+        if (camXOff == 0 && tgt == -1) {
+            for (int i = 0; i < 2; i++) {
+                if (edgeOff[i] || (i == 0 ? lifeO : lifeA) <= 0) continue;
+                int rel = x[i] - camLeft;
+                if (rel < h[i]) x[i] = camLeft + h[i];
+                if (rel > SCREEN_W - h[i]) x[i] = camLeft + SCREEN_W - h[i];
