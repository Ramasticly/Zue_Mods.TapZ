+    /** Editor: trava as trocas automaticas de ANO (sequencia, fim, pouso, queda) para editar uma ANO sem o fluxo interferir. */
+    /** Altura do oponente em px acima do chao (editor: POS > OPONENTE). */
+    public static int oppHeightPx = 0;
+    /** Editor: POUSO ligado simula pouso/queda (troca de ANO); desligado, so zera a velocidade no chao e segue na mesma ANO. */
+    public static boolean landingOn = true;
+    public static int lockFromTick = -1;       // -1 = livre; >= 0: trocas so acontecem ate este tick (o que ja tinha trocado fica)
+
+    private boolean switchAtk(int ano) {
+        if (probe) return false;
+        if (lockFromTick >= 0 && ticks > lockFromTick && !(landingOn && (transKind == 3 || transKind == 4))) return false;
+        AttackSim.Obj r = atk.root();
+        Ano a = atkDac.getAno(ano);
+        if (r == null || a == null || !a.present) return false;
+        Trans tr = new Trans();
+        tr.tick = ticks; tr.fromAno = r.ano.index; tr.fromPat = Math.max(0, r.pat); tr.toAno = ano; tr.kind = transKind;
+        trans.add(tr);
+        if ((transKind == 3 || transKind == 4) && physHold == null && !idleMode) physHold = atk;
+        transKind = -1;
+        atk = new AttackSim(atkDac, ano, atkLeft, r.x, r.y);
+        atk.rebaseLinks = true; atk.clearPause = true;
+        lastSerial = -1;
+        spawnedSerial = -1;
+        armed = false;
+        afterAtkFrame();
+        consumeSe(atk, 0);
+        return true;
+    }
