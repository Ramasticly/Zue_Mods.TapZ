+    private void initCamera() {
+        zCurW = 100f; zTgtW = 100f; zLeft = 0;
+        camShake = 0; camShakeType = 0; lastOppSerial = -1; lastOppObj = null;
+        halfA = atkChar == null ? 30 : atkChar.halfWidth;
+        halfO = oppChar == null ? 30 : oppChar.halfWidth;
+        cancelAtk = 0;
+        AttackSim.Obj ra = atk.root();
+        int ax = ra == null ? 0 : ra.x;
+        refAtkX = ax;
+        if (edgeMode == 0) { camLeft = 0; camBase = 0; oldAx = ax; oldOx = oppX; return; }
+        // camera centrada na origem (x = 0 e o centro da tela de 480 px), no meio do mapa
+        camBase = SCREEN_FULL;
+        camLeft = -SCREEN_FULL / 2;
+        int ha = halfA * PX, ho = halfO * PX;
+        // o oponente fica no lugar pedido (ou na borda); se a distancia nao couber, o atacante recua, ainda dentro da borda
+        // spawn do jogo (md 720): oponente fixo a 360 px da borda esquerda da tela (x = +120 px do centro; espelhado se o atacante olha para a
+        // esquerda) e o atacante a "distancia" dele (distancia 240 => 120 px / 360 px, como no jogo; golpe 4 do log: atacante a 256 px = distancia 104)
+        oppX = (atkLeft ? -1 : 1) * (120 * PX);
+        oppX = Math.max(camLeft + ho, Math.min(camLeft + SCREEN_W - ho, oppX));
+        if (ra != null) {
+            int want = atkLeft ? oppX + distancePx * PX : oppX - distancePx * PX;
+            int nx = Math.max(camLeft + ha, Math.min(camLeft + SCREEN_W - ha, want));
+            if (nx != want) {
+                // o atacante nao cabe na distancia pedida: o oponente se afasta para manter a distancia, sempre dentro da borda
+                oppX = Math.max(camLeft + ho, Math.min(camLeft + SCREEN_W - ho, atkLeft ? nx - distancePx * PX : nx + distancePx * PX));
+            }
+            ra.x = nx;
+            atk.settle();           // os links ja nasceram na posicao antiga: acompanham o atacante
+            refAtkX = ra.x;
+        }
+        oldAx = ra == null ? 0 : ra.x;
+        oldOx = oppX;
+    }
