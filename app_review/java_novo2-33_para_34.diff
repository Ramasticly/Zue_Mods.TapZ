+        if (r.y < -CEILING) r.y = -CEILING;
+        if (oppY < -CEILING) oppY = -CEILING;
+        // acabou a animacao no ar e o personagem nao voa: cai (ANO 89)
+        if (r.y < 0 && phase != 4 && phase != 5 && r.isDone() && !flies && landingOn) {
+            transKind = 4;
