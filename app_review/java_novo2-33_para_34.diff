+    private void clampAttacker() {
+        AttackSim.Obj r = atk.root();
+        if (r == null) return;
+        if (effectRoot()) return;                              // efeito: sem chao, sem pouso, sem queda
+        if (projRoot()) { projFloor(r); return; }              // projetil: so o chao do md 971
+        // md 883: y > chao com velocidade Y > 0 pousa, mesmo que o golpe tenha comecado no chao
+        // ANO avulso (md 886 / 891): pousa assim que y > chao fora do hitstop, sem exigir velocidade Y
+        boolean lands = move.generic ? (r.y > 0 && hsAtk == 0) : (r.y > 0 && r.speedY > 0);
+        // editor com POUSO desligado: o chao continua valendo (zera a velocidade), mas nao troca de ANO nem para a timeline
+        if (lands && !landingOn) {
+            r.y = 0;
+            r.speedY = 0;
+            r.accelY = 0;
+            r.speedX = 0;
+            r.accelX = 0;
+            return;
+        }
+        if (lands) {
+            if (!move.generic && phase != 5 && !r.isDone() && !everHit && hasAttack(r.ano) && hasYMove(r.ano)) landedEarly = true;   // golpe com movimento vertical que pousou sem acertar (hitbox/projetil errou ou nem chegou a ser usado)
