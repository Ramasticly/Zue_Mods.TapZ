diff -ruN a/test/TeleportBehindTest.java b/test/TeleportBehindTest.java
--- a/test/TeleportBehindTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/TeleportBehindTest.java	2026-10-29 12:32:37.524965024 +0000
@@ -0,0 +1,90 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.List;
+
+/** Teleportar atras do oponente = Puxar oponente (flag 40, x < 0) + Flip X no mesmo frame, tratados como um so. */
+public class TeleportBehindTest {
+    static Ano.Mpt[] mpts(int n) {
+        Ano.Mpt[] m = new Ano.Mpt[n];
+        for (int i = 0; i < n; i++) { m[i] = new Ano.Mpt(); m[i].flags = 0x20; m[i].hasTime = true; m[i].time = 5; }
+        return m;
+    }
+
+    static boolean flip(Ano.Mpt m) { return ObjModel.spriteBit(m, ObjModel.FLIP_H); }
+
+    public static void main(String[] args) throws Exception {
+        Ano.Mpt[] base = mpts(4);
+        Ano.Mpt[] ab = ObjModel.addBehind(base, 1, 2);
+        check("addBehind: hit 40 com x -120 e Flip X nos frames 1 e 2", ab[1].hits[0].flag + ":" + ab[1].hits[0].x + ":" + flip(ab[1]) + "|" + ab[2].hits[0].x + ":" + flip(ab[2]), "40:-120:true|-120:true");
+        check("addBehind: frames de fora intactos", ab[0] == base[0] && ab[3] == base[3], true);
+        check("addBehind nao muda o original", base[1].hits.length + ":" + flip(base[1]), "0:false");
+
+        List<ObjModel.Obj> objs = ObjModel.objects(ab);
+        check("um objeto so, reconhecido como Teleportar atras", objs.size() + ":" + objs.get(0).behind + ":" + objs.get(0).f0 + "-" + objs.get(0).f1, "1:true:1-2");
+        check("nome e linha proprios", ObjModel.nameOf(objs.get(0)) + ":" + ObjModel.laneFlag(objs.get(0)), "Teleportar atras do oponente:" + ObjModel.ACT_BEHIND);
+
+        // apagar leva o Flip X junto
+        Ano.Mpt[] gone = ObjModel.remove(ab, objs.get(0));
+        check("apagar: some o hit e o Flip X", ObjModel.hasBehind(gone[1]) + ":" + flip(gone[1]) + ":" + flip(gone[2]) + ":" + gone[1].hits.length, "false:false:false:0");
+
+        // Puxar comum (x >= 0) com Flip X NAO e Teleportar atras; sem limite de x
+        Ano.Mpt[] pull = ObjModel.add(mpts(2), 0, 0, hit40(25));
+        pull[0] = ObjModel.setSpriteBit(pull[0], ObjModel.FLIP_H, true);
+        List<ObjModel.Obj> po = ObjModel.objects(pull);
+        check("Puxar com x positivo + Flip continua Puxar comum", po.size() + ":" + po.get(0).behind + ":" + ObjModel.nameOf(po.get(0)), "1:false:Puxar oponente");
+        Ano.Mpt[] pull2 = ObjModel.add(mpts(2), 0, 0, hit40(-30));
+        List<ObjModel.Obj> po2 = ObjModel.objects(pull2);
+        check("Puxar com x negativo sem Flip continua Puxar comum", po2.get(0).behind, false);
+        check("apagar um Puxar comum nao mexe no Flip", flip(ObjModel.remove(pull, po.get(0))[0]), true);
+
+        // Puxar comum no mesmo frame do Teleportar atras fica oculto na timeline
+        Ano.Mpt[] mix = ObjModel.add(ab, 1, 1, hit40(50));
+        List<ObjModel.Obj> mo = ObjModel.objects(mix);
+        int behinds = 0, pulls = 0;
+        for (ObjModel.Obj o : mo) if (o.flag == 40) { if (o.behind) behinds++; else pulls++; }
+        check("Puxar oculto onde ha Teleportar atras", behinds + ":" + pulls, "1:0");
+
+        // lista de adicionar
+        boolean[] has = new boolean[2];
+        for (int f : ObjModel.actionFlagsFor(null, -1, base[1])) { if (f == 40) has[0] = true; if (f == ObjModel.ACT_BEHIND) has[1] = true; }
+        check("frame comum: Puxar e Teleportar atras na lista", has[0] + ":" + has[1], "true:true");
+        has = new boolean[2];
+        for (int f : ObjModel.actionFlagsFor(null, -1, ab[1])) { if (f == 40) has[0] = true; if (f == ObjModel.ACT_BEHIND) has[1] = true; }
+        check("frame com Teleportar atras: nenhum dos dois na lista", has[0] + ":" + has[1], "false:false");
+        int[] full = ObjModel.actionFlagsFor(null, -1, null);
+        int i40 = -1, iB = -1;
+        for (int i = 0; i < full.length; i++) { if (full[i] == 40) i40 = i; if (full[i] == ObjModel.ACT_BEHIND) iB = i; }
+        check("Teleportar atras vem logo depois do Puxar oponente", iB, i40 + 1);
+
+        // mover / esticar levam o Flip
+        ObjModel.Obj ob = objs.get(0);
+        Ano.Mpt[] ext = ObjModel.trim(ab, ob, 1, 3);
+        check("esticar: o frame novo recebe o hit e o Flip", ObjModel.hasBehind(ext[3]) + ":" + flip(ext[3]), "true:true");
+        Ano.Mpt[] shr = ObjModel.trim(ab, ob, 1, 1);
+        check("encolher: o frame que sai perde o hit e o Flip", ObjModel.hasBehind(shr[2]) + ":" + flip(shr[2]), "false:false");
+        Ano.Mpt[] mv = ObjModel.move(ab, ob, 0);
+        check("mover: Flip acompanha", flip(mv[0]) + ":" + flip(mv[1]) + ":" + flip(mv[2]), "true:true:false");
+
+        // fidelidade: onde o oponente fica na simulacao
+        {
+            A[] a = new A[45];
+            for (int i = 0; i < 45; i++) a[i] = new A().mpt(new M().time(1));
+            a[40] = new A().mpt(new M().time(5).hit(40, -120, 0, 0, 0).act(16)).mpt(new M().time(5));
+            CharData ch = chr(move(new int[]{2, 40}), new byte[][] {});
+            BattleSim.edgeMode = 1;
+            BattleSim s = new BattleSim(dac(a), ch, ch.moves[0], false, CutsceneTest.defDac(), CutsceneTest.fxDac(), gd(new byte[][] {}), 200, 0, 0);
+            int dx = s.opponentX() - (s.attacker().root().x >> 16);
+            System.out.println("INFO opponentX - attackerX com flag 40 x=-120 + Flip X = " + dx);
+            check("o oponente vai para tras do atacante (que olhava para a direita) e o Flip X faz o atacante olhar para ele", dx < 0, true);
+        }
+        System.out.println("TeleportBehindTest fails=" + fails);
+    }
+
+    static Ano.Hit hit40(int x) {
+        Ano.Hit h = ObjModel.defaultHit(40);
+        h.x = x;
+        return h;
+    }
+}
diff -ruN a/test/TickDisplayTest.java b/test/TickDisplayTest.java
--- a/test/TickDisplayTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/TickDisplayTest.java	2026-10-30 01:21:17.478809893 +0000
@@ -0,0 +1,36 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** Contador do botao +1 tick: congelamentos (trava cinematica, hitstop) travam o numero e a contagem continua sem somar os ticks parados. */
+public class TickDisplayTest {
+    public static void main(String[] args) throws Exception {
+        TickDisplay t = new TickDisplay();
+        t.afterStep(1, false);
+        check("sem congelamento: tick real", t.shown(1), 1);
+        t.afterStep(2, true);
+        check("entrou na trava em 2: fica 2", t.shown(2) + ":" + t.stalled(), "2:true");
+        for (int r = 3; r < 122; r++) t.afterStep(r, true);
+        check("durante a trava o numero nao muda", t.shown(121), 2);
+        t.afterStep(122, false);
+        check("liberou no tick 122: mostra 3 (nao 122)", t.shown(122), 3);
+        t.afterStep(123, false);
+        t.afterStep(124, false);
+        check("segue 4, 5...", t.shown(123) + ":" + t.shown(124), "4:5");
+        // segundo congelamento (hitstop de 10 ticks) depois da trava
+        t.afterStep(125, true);
+        check("hitstop trava no numero atual", t.shown(125), 6);
+        for (int r = 126; r < 135; r++) t.afterStep(r, true);
+        t.afterStep(135, false);
+        check("liberou o hitstop: proximo numero (7), somando os dois congelamentos", t.shown(135), 7);
+        t.afterStep(136, false);
+        check("e continua", t.shown(136), 8);
+        // congelamentos seguidos (trava e logo hitstop) valem como um so
+        TickDisplay u = new TickDisplay();
+        u.afterStep(1, true); u.afterStep(2, true); u.afterStep(3, true); u.afterStep(4, false);
+        check("congelamentos colados: um so", u.shown(4), 2);
+        t.reset();
+        check("reset: volta ao tick real", t.shown(50) + ":" + t.stalled(), "50:false");
+        System.out.println("TickDisplayTest fails=" + fails);
+    }
+}
diff -ruN a/test/TickMapTest.java b/test/TickMapTest.java
--- a/test/TickMapTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/TickMapTest.java	2026-10-29 16:30:07.664826718 +0000
@@ -0,0 +1,51 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** Os ticks da timeline sao so os dos frames: o hitstop (ticks so da simulacao) nao ocupa lugar nela. */
+public class TickMapTest {
+    public static void main(String[] args) throws Exception {
+        A[] a = new A[45];
+        for (int i = 0; i < 45; i++) a[i] = new A().mpt(new M().time(1));
+        // frame 0 acerta (hitstop), frame 1 normal
+        a[40] = new A().mpt(new M().time(30).hit(2, -40, -40, 400, 100)).mpt(new M().time(20));
+        CharData ch = chr(move(new int[]{2, 40}), new byte[][] {});
+        BattleSim.edgeMode = 1;
+        BattleSim s = new BattleSim(dac(a), ch, ch.moves[0], false, CutsceneTest.defDac(), CutsceneTest.fxDac(), gd(new byte[][] {}), 20, 0, 0);
+        int[][] t = s.firstTicksElapsed(40, new int[] {30, 20}, 400);
+        check("frame 0 tem 30 pontos e o frame 1 tem 20", t[0].length + ":" + t[1].length, "30:20");
+        boolean all = true, inc = true;
+        int maxJump = 0;
+        for (int p = 0; p < 2; p++) for (int e = 0; e < t[p].length; e++) {
+            if (t[p][e] < 0) all = false;
+            int prev = e > 0 ? t[p][e - 1] : (p > 0 ? t[p - 1][t[p - 1].length - 1] : -1);
+            if (t[p][e] <= prev) inc = false;
+            if (prev >= 0) maxJump = Math.max(maxJump, t[p][e] - prev);
+        }
+        check("todo ponto (frame, tick) ocorre na simulacao", all, true);
+        check("a ordem logica e crescente", inc, true);
+        check("o hitstop abre um salto de 10 ticks de simulacao entre dois ticks da timeline", maxJump, 11);
+
+        // cada ponto aponta para o tick certo: no tick mapeado o atacante esta nesse frame e nesse tick dele
+        boolean exact = true;
+        for (int p = 0; p < 2; p++) for (int e = 0; e < t[p].length; e += 3) {
+            BattleSim c = s.copyAt(t[p][e]);
+            AttackSim.Obj r = c.attacker().root();
+            int dur = p == 0 ? 30 : 20;
+            if (r.pat != p || dur - r.time != e) exact = false;
+        }
+        check("copyAt(tick mapeado) cai no frame e no tick pedidos", exact, true);
+
+        // sem acerto: tabela = inicio do frame + tick (nada muda)
+        A[] b = new A[45];
+        for (int i = 0; i < 45; i++) b[i] = new A().mpt(new M().time(1));
+        b[40] = new A().mpt(new M().time(8)).mpt(new M().time(6));
+        BattleSim q = new BattleSim(dac(b), ch, ch.moves[0], false, CutsceneTest.defDac(), CutsceneTest.fxDac(), gd(new byte[][] {}), 20, 0, 0);
+        int[][] u = q.firstTicksElapsed(40, new int[] {8, 6}, 100);
+        int[] first = q.firstTicks(40, 2, 100);
+        boolean same = true;
+        for (int p = 0; p < 2; p++) for (int e = 0; e < u[p].length; e++) if (u[p][e] != first[p] + e) same = false;
+        check("sem hitstop: tabela = inicio do frame + tick", same, true);
+        System.out.println("TickMapTest fails=" + fails);
+    }
+}
diff -ruN a/test/TimelineEditTest.java b/test/TimelineEditTest.java
--- a/test/TimelineEditTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/TimelineEditTest.java	2026-10-28 15:04:11.928020142 +0000
@@ -0,0 +1,139 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+/** Edicao na timeline: o loop e do ANO (acompanha o ultimo frame), frame sem TIME, clique dentro do clipe e divisao de velocidade. */
+public class TimelineEditTest {
+    static Dac with(Dac d, int idx, Ano.Mpt[] mp) {
+        d.setAno(idx, new Ano(idx, true, 0, 0, new Ano.Link[0], mp));
+        return d;
+    }
+
+    static int len(Dac d) throws Exception {
+        CharData ch = chr(move(new int[]{2, 40}), new byte[][] {});
+        return SpawnDiagTest.sim(d, ch, ch.moves[0], 200, 0, 0).measureLength();
+    }
+
+    static boolean loopBit(Ano.Mpt m) { return (m.flags & 2) != 0 && (m.wActFlag & 1) != 0; }
+
+    static int loopCount(Ano.Mpt[] m) { int n = 0; for (Ano.Mpt x : m) if (loopBit(x)) n++; return n; }
+
+    public static void main(String[] args) throws Exception {
+        A[] a = SpawnDiagTest.anos();
+        a[40] = new A().mpt(new M().time(4)).mpt(new M().time(4)).mpt(new M().time(4).act(1));
+        Dac d = dac(a);
+        Ano.Mpt[] mp = d.getAno(40).mpts;
+        check("ANO com loop no ultimo frame: 12 ticks", len(d), 12);
+
+        // ---- adicionar / duplicar no fim: o loop vai para o novo ultimo frame e a duracao cresce
+        Ano.Mpt[] dup = FrameOps.duplicate(mp, 2);
+        check("duplicar o ultimo: sem normalizar o loop ficaria no antigo (bug)", loopBit(dup[2]) && !loopBit(dup[3]), true);
+        Ano.Mpt[] fixed = FrameOps.normalizeLoop(mp, dup);
+        check("duplicar o ultimo: loop so no novo ultimo", loopBit(fixed[3]) && loopCount(fixed) == 1, true);
+        check("duplicar o ultimo: duracao 16 ticks", len(with(dac(a), 40, fixed)), 16);
+        check("duplicar o ultimo sem normalizar travava em 12", len(with(dac(a), 40, dup)), 12);
+
+        Ano.Mpt[] ins = FrameOps.insertSprites(mp, 2, new int[]{7, 8}, new int[]{3, 3});
+        Ano.Mpt[] insFixed = FrameOps.normalizeLoop(mp, ins);
+        check("inserir sprites no fim: loop no ultimo", loopBit(insFixed[4]) && loopCount(insFixed) == 1, true);
+        check("inserir sprites no fim: duracao 18", len(with(dac(a), 40, insFixed)), 18);
+
+        // ---- apagar o ultimo: o loop passa para o novo ultimo
+        Ano.Mpt[] del = FrameOps.delete(mp, 2);
+        check("apagar o ultimo perde o loop sem normalizar", loopCount(del), 0);
+        Ano.Mpt[] delFixed = FrameOps.normalizeLoop(mp, del);
+        check("apagar o ultimo: loop no novo ultimo", loopBit(delFixed[1]) && loopCount(delFixed) == 1, true);
+        // dividir o ultimo frame: a metade final continua com o loop
+        FrameOps.Split sp = FrameOps.splitAt(mp, 10);
+        check("dividir o ultimo: loop na metade final", loopBit(sp.mpts[3]) && !loopBit(sp.mpts[2]), true);
+
+        // ---- so o usuario desliga
+        Ano.Mpt[] off = ObjModel.setLoop(mp, false);
+        check("setLoop(false) desliga", ObjModel.loops(off), false);
+        check("depois de desligado, editar nao liga de novo", ObjModel.loops(FrameOps.normalizeLoop(off, FrameOps.duplicate(off, 2))), false);
+        // loop no meio (ANO importado) nao e mexido
+        Ano.Mpt[] mid = mp.clone();
+        mid[2] = mp[2].copy(); mid[2].wActFlag = 0; mid[2].flags &= ~2;
+        mid[1] = mp[1].copy(); mid[1].flags |= 2; mid[1].wActFlag |= 1;
+        Ano.Mpt[] midDup = FrameOps.duplicate(mid, 2);
+        check("loop no meio fica onde esta", FrameOps.normalizeLoop(mid, midDup) == midDup, true);
+        check("sem mudanca: devolve o mesmo array", FrameOps.normalizeLoop(mp, mp) == mp, true);
+
+        // ---- frame sem TIME segura para sempre: ao por um sprite depois dele, ele passa a durar o que a timeline mostra
+        A[] b = SpawnDiagTest.anos();
+        b[40] = new A().mpt(new M().time(4)).mpt(new M());
+        Ano.Mpt[] hold = dac(b).getAno(40).mpts;
+        check("frame sem TIME e segurado", hold[1].hasTime, false);
+        Ano.Mpt[] dh = FrameOps.duplicate(hold, 1);
+        check("duplicar o frame que segura: ele ganha 3 ticks", dh[1].hasTime && dh[1].time == 3, true);
+        check("duplicar o frame que segura: o novo ultimo e quem segura", !dh[2].hasTime, true);
+        Ano.Mpt[] dm = FrameOps.duplicate(hold, 0);
+        check("duplicar no meio: a copia dura o mesmo que o original", dm[1].hasTime && dm[1].time == 4, true);
+        Ano.Mpt[] ih = FrameOps.insertSprites(hold, 1, new int[]{9}, new int[]{5});
+        check("inserir depois do frame que segura", ih[1].hasTime && ih[1].time == 3 && ih[2].time == 5, true);
+        check("a ANO com sprite depois do frame que segura agora chega ao novo frame (total 12 ticks)", FrameOps.total(ih), 4 + 3 + 5);
+
+        // ---- clique num clipe: dentro nao mexe, antes vai ao inicio, depois ao ultimo tick
+        check("clipTarget dentro", FrameOps.clipTarget(7, 4, 12), 7);
+        check("clipTarget no inicio", FrameOps.clipTarget(4, 4, 12), 4);
+        check("clipTarget antes", FrameOps.clipTarget(2, 4, 12), 4);
+        check("clipTarget depois", FrameOps.clipTarget(12, 4, 12), 11);
+        check("clipTarget bem depois", FrameOps.clipTarget(30, 4, 12), 11);
+        check("clipTarget vazio", FrameOps.clipTarget(30, 4, 4), 4);
+
+        // ---- velocidade: eixos e divisao do trecho
+        A[] c = SpawnDiagTest.anos();
+        c[40] = new A().mpt(new M().time(10).speedX(2 << 16)).mpt(new M().time(10)).mpt(new M().time(10)).mpt(new M().time(10));
+        Ano.Mpt[] sp0 = dac(c).getAno(40).mpts;
+        Ano.Mpt[] run = FrameOps.setMoveRun(sp0, 0, 2);
+        check("eixos: so X", FrameOps.moveAxes(run, 0), 1);
+        Ano.Mpt yOnly = FrameTools.setSpeed(sp0[3], 1, 1.5, true);
+        check("eixos: so Y", FrameOps.moveAxes(new Ano.Mpt[]{yOnly}, 0), 2);
+        Ano.Mpt both = FrameTools.setAccel(FrameTools.setSpeed(sp0[3], 1, 1.0, true), 0, 0.25);
+        check("eixos: speed Y + accel X = X e Y", FrameOps.moveAxes(new Ano.Mpt[]{both}, 0), 3);
+        check("sem velocidade: nenhum eixo", FrameOps.moveAxes(sp0, 1), 0);
+        Ano.Mpt e = sp0[1].copy();
+        FrameOps.defaultsMove(e, 1);
+        check("celula vazia na faixa Y cria speed Y", e.moveMask, 2);
+
+        double[] before = FrameTools.totalPixels(run, 0, 2);
+        check("dividir no meio do 2o frame do trecho", FrameOps.splitMove(run, 15) != null, true);
+        FrameOps.Split sm = FrameOps.splitMove(run, 15);
+        check("dividir velocidade: um frame a mais e o corte vira cabeca", sm.mpts.length == 5 && FrameOps.isMoveHead(sm.mpts[2]) && sm.index == 2, true);
+        check("a cabeca nova mantem a velocidade (2 px/tick) e o bit 64", sm.mpts[2].speedX == (2 << 16) && (sm.mpts[2].wActFlag & 64) != 0, true);
+        double[] after = FrameTools.totalPixels(sm.mpts, 0, 3);
+        check("dividir velocidade nao muda o deslocamento (" + before[0] + ")", before[0] == after[0] && before[1] == after[1], true);
+        check("agora sao dois trechos", FrameOps.moveHeadOf(sm.mpts, 1) == 0 && FrameOps.moveHeadOf(sm.mpts, 3) == 2 && FrameOps.moveHeadOf(sm.mpts, 2) == 2, true);
+        check("dividir no inicio da cabeca: nao ha o que dividir", FrameOps.splitMove(run, 0), null);
+        check("dividir fora do trecho (frame sem velocidade)", FrameOps.splitMove(run, 35), null);
+        check("dividir exatamente no inicio de um frame de continuacao", FrameOps.splitMove(run, 10) != null && FrameOps.splitMove(run, 10).mpts.length == 4, true);
+
+        // com aceleracao: o 2o trecho comeca com a velocidade ja acumulada e a deslocamento total e igual
+        Ano.Mpt acc = FrameTools.setAccel(sp0[0], 0, 0.25);
+        Ano.Mpt[] ar = FrameOps.setMoveRun(new Ano.Mpt[]{acc, sp0[1], sp0[2], sp0[3]}, 0, 2);
+        double[] ab = FrameTools.totalPixels(ar, 0, 2);
+        FrameOps.Split as = FrameOps.splitMove(ar, 13);
+        double[] aa = FrameTools.totalPixels(as.mpts, 0, 3);
+        check("accel: deslocamento igual depois de dividir", Math.abs(ab[0] - aa[0]) < 1e-9, true);
+        check("accel: o 2o trecho comeca em 4.5 + 0.25*3 = 5.25 px/tick", as.mpts[as.index].speedX, (int) Math.round(5.25 * 65536.0));
+
+        // POSE: o ANO 0 do atacante desenhado na mesma ancora do golpe
+        AttackSim pose = new AttackSim(dac(SpawnDiagTest.anos()), 0, false, 7 << 16, -(3 << 16));
+        check("POSE: o ANO 0 nasce na ancora pedida", (pose.root().x >> 16) + "," + (pose.root().y >> 16), "7,-3");
+        check("POSE: espelhada quando o golpe esta espelhado", (new AttackSim(dac(SpawnDiagTest.anos()), 0, true, 0, 0).root().objFlags & 16) != 0, true);
+
+        // ---- DIVIDIR objeto: so na divisa de frames mais proxima do ponteiro
+        int[] bst = {0, 4, 8, 20, 24};                       // frames 0..4
+        ObjModel.Obj bo = new ObjModel.Obj(); bo.f0 = 1; bo.f1 = 3;   // cobre os frames 1..3
+        check("divisa: ponteiro perto do inicio do frame 2", ObjModel.splitBoundary(bst, bo, 9), 2);
+        check("divisa: ponteiro perto do inicio do frame 3 (meio de frame grande)", ObjModel.splitBoundary(bst, bo, 17), 3);
+        check("divisa: ponteiro no meio de frame grande vai para a mais proxima", ObjModel.splitBoundary(bst, bo, 11), 2);
+        check("divisa: ponteiro no inicio do objeto vai para a primeira divisa dentro dele", ObjModel.splitBoundary(bst, bo, 4), 2);
+        check("divisa: ponteiro no fim do objeto vai para a ultima divisa dentro dele", ObjModel.splitBoundary(bst, bo, 23), 3);
+        check("divisa: empate fica com a anterior", ObjModel.splitBoundary(bst, bo, 14), 2);
+        bo.f1 = 1;
+        check("divisa: objeto de um frame so nao divide", ObjModel.splitBoundary(bst, bo, 5), -1);
+
+        System.out.println("TimelineEditTest fails=" + fails);
+    }
+}
diff -ruN a/test/TimelineLabelsTest.java b/test/TimelineLabelsTest.java
