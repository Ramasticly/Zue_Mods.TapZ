+    private static final boolean[] SIGNED = {false, false, true, true, true, true, true, true, true, true, true, false, false, false};
+
+    /** Colunas de 1 byte: o jogo le o ANO e a voz com sinal, entao a voz acima de 127 nunca toca. */
+    private static int limit(int col, int v) {
+        if (col == 13) return Math.max(0, Math.min(127, v));
+        return SIGNED[col] ? Math.max(-128, Math.min(127, v)) : Math.max(0, Math.min(255, v));
+    }
+
+    private boolean lightPending;
+    private final Runnable lightRun = new Runnable() { public void run() { lightPending = false; refreshLight(); } };
+
+    /** Grava uma celula no lugar: so atualiza os campos abertos agora; timeline, previa e simulacao seguem logo depois (no maximo a cada ~150 ms). Uma entrada de desfazer por celula. */
+    private void setCell(final int col, int value) {
+        if (!editable) return;
+        final int v = limit(col, value);
+        final ReactionTable t = table();
+        final int row = sel;
+        if (t == null || row < 0 || row >= t.rows) return;
+        if (SIGNED[col] ? t.s8(row, col) == v : t.u8(row, col) == v) return;
+        view.editReaction(type, "reacao:" + type + ":" + row + ":" + col, new Runnable() { public void run() { t.set(row, col, v); } });
+        runUpdaters();
+        if (!lightPending) { lightPending = true; pageBox.postDelayed(lightRun, 150); }
+    }
+
+    /** Recalcula simulacao, timeline e previa sem recriar a pagina aberta. */
+    private void refreshLight() {
+        ReactionTable t = table();
+        if (t == null) return;
+        sel = Math.max(0, Math.min(sel, t.rows - 1));
+        trace = recordTrace();
+        tl.setData(trace, t, editable, type, air);
+        tl.setSelected(sel);
+        preview.setMaxTick(trace.ticks.size());
+        preview.setValue(optValue);
+        preview.seek(tl.pointerTick());
+        updateLabel();
+        runUpdaters();
+        onChanged.run();
+    }
