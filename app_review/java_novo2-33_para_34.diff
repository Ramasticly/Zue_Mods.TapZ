+            frameLabel.setText("Frame " + (frame + 1) + (frame < c.last ? " → " + (frame + 2) : " → fim") + "  (" + (frame - c.head + 1) + " de " + c.frames() + ")  ·  " + FrameTools.ticks(work[frame]) + " ticks");
+            if (!rebuildFields) return;
+            stepHolder.removeAllViews();
+            addAccel("aceleracao x  (px por tick²)", 0);
+            addAccel("aceleracao y", 1);
+        }
+
+        private void addAccel(String name, final int axis) {
+            TextView t = new I18nTextView(a);
+            t.setText(name);
+            t.setTextColor(LayoutManager.DIM);
+            t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
+            t.setPadding(0, dp(a, 6), 0, 0);
+            stepHolder.addView(t);
+            Ano.Mpt m = work[frame];
+            double cur = (m.flags & 4) != 0 && (m.moveMask & (axis == 0 ? 4 : 8)) != 0 ? (axis == 0 ? m.accelX : m.accelY) / FrameTools.ONE : 0;
+            stepHolder.addView(new Stepper(a).range(-99, 99).step(0.1).keyboard(new Stepper.OnValue() { public void on(double x) {
+                Ano.Mpt[] n = work.clone();
+                n[frame] = FrameTools.setAccel(work[frame], axis, x);
+                work = n;
+                base = work;
+                refresh(false);
+            } }).value(cur).view());
+        }
+    }
+}
