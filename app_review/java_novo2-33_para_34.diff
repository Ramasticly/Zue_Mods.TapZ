+    private void projFloor(AttackSim.Obj r) {
+        if (r.y <= 0) return;
+        int cur = r.ano.index;
+        int ground = move.animInicial == move.subId && move.subId != 0 ? move.subChao : move.projChao;
+        if (ground != 0 && ground != cur && switchAtk(ground)) {
+            lastHit += " -> CHAO " + ground;
+            AttackSim.Obj nr = atk.root();
+            if (nr != null && nr.y > 0) nr.y = 0;
+            return;
+        }
+        r.y = 0;
+    }
