+    /** Edicao cuja reversao registra {@code onRevert} e devolve uma inversa que registra {@code onBack}. */
+    static UndoHistory.Edit mark(final List<String> log, final String onRevert, final String onBack) {
+        return new UndoHistory.Edit() {
+            @Override public UndoHistory.Edit revert() { log.add(onRevert); return mark(log, onBack, onRevert); }
+        };
+    }
