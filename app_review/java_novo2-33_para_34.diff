+    /** Combate parado no primeiro tick do frame vizinho do atual, ou null. */
+    private BattleSim ghost() {
+        Ano a = currentAno();
+        if (sim == null || a == null) return null;
+        int target = currentPat() + (ghostMode == 1 ? 1 : -1);
+        if (target < 0 || target >= a.mpts.length) return null;
+        int base = tickTableFor(a)[target];
+        if (base < 0) return null;
+        String key = tickTableKey + ":" + target;
+        if (!key.equals(ghostKey)) {
+            ghostSim = sim.copyAt(base);
+            ghostKey = key;
+        }
+        return ghostSim;
+    }
