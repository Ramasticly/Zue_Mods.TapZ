+    private boolean atWall(int wall) {
+        if (edgeMode == 0) return false;
+        int h = halfO * PX;
+        boolean force = (wall == 3 && dCharSrc) || forceWall;      // md 877 usa WALL 3 como parede forcada; bForceWall (mapa 6) vale para os dois
+        boolean l = oppX <= camLeft + h && (camBase <= h || force);
+        boolean r = oppX >= camLeft + SCREEN_W - h && (camBase + h >= MAP_BASE_MAX || force);
+        return (l || r) && (dCharSrc || dYs <= 0);
+    }
