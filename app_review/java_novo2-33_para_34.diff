+        // CheckOptFlag liga PlayerState |= 1 antes do aborto por OPT 2048 e so os lutadores contam (o PlayerTail apaga o que os projeteis ligaram)
+        AttackSim.Obj a = atk.root(), o = opp.root();
+        return (a != null && (a.optFlag & 1024) != 0) || (o != null && (o.optFlag & 1024) != 0);
+    }
