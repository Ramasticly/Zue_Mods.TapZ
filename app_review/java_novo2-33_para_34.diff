--- a/ReactionLayout.java	1970-01-01 00:00:00.000000000 +0000
+++ b/ReactionLayout.java	2026-10-24 21:48:20.108827897 +0000
@@ -0,0 +1,87 @@
+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Geometria da timeline de reacoes (em dp), a mesma da timeline principal: regua 14, faixa de clipes 40, resumo 10, linha 22, teto 188.
+ * Java puro: o desenho e o toque da {@link ReactionTimelineView} usam as mesmas linhas, entao o que se ve e o que se toca nunca discordam.
+ */
+final class ReactionLayout {
+    private ReactionLayout() { }
+
+    /** Faixas: clipes (passos) e as que abrem sob demanda. */
+    static final int L_CLIP = 0, L_SPEED = 1, L_VOZ = 2, L_EFEITOS = 3, L_SEQ = 4, L_CURVA = 5;
+    static final int LANES = 6;
+    /** Rotulos da coluna da esquerda, por faixa. */
+    static final String[] NAMES = {"PASSOS", "SPEED", "VOZ", "EFEITOS", "SEQ", "CURVA"};
+    /** Filtro "#" (as faixas abaixo dos clipes): indice = faixa - 1. */
+    static final String[] FILTER_NAMES = {"Speed (blocos)", "Voz", "Efeitos (parede)", "Seq (próxima reação)", "Curva de velocidade (x, y)"};
+
+    static final float RULER = 14, CLIP = 40, SUMMARY = 10, ROW = 22, CURVE = 40, CAP = 188, PAD = 3;
+
+    static final class Row {
+        final int lane;
+        final boolean summary;
+        final float h;
+        float top;                // relativo ao topo da view, ja descontada a rolagem
+
+        Row(int lane, boolean summary, float h) {
+            this.lane = lane;
+            this.summary = summary;
+            this.h = h;
+        }
+    }
+
+    /**
+     * Linhas abaixo dos clipes. Aberta: toda faixa ligada no filtro (celulas vazias tambem, para poder criar); a curva e mais alta.
+     * Fechada: uma linha de resumo (10) so para as faixas que tem dados ({@code has[faixa]}). {@code show[i]}: faixa i+1 ligada no filtro.
+     */
+    static List<Row> body(boolean[] show, boolean expanded, boolean[] has) {
+        List<Row> out = new ArrayList<Row>();
+        for (int lane = L_SPEED; lane <= L_CURVA; lane++) {
+            if (!show[lane - 1]) continue;
+            if (expanded) out.add(new Row(lane, false, lane == L_CURVA ? CURVE : ROW));
+            else if (lane != L_CURVA && has[lane]) out.add(new Row(lane, true, SUMMARY));
+        }
+        return out;
+    }
+
+    static float bodyTop() { return RULER + CLIP; }
+
+    static float contentH(List<Row> rows) {
+        float h = 0;
+        for (Row r : rows) h += r.h;
+        return h;
+    }
+
+    /** Altura da view: regua + clipes + linhas, ate o teto {@code cap} (a view rola por dentro). */
+    static float viewH(List<Row> rows, float cap) { return Math.min(cap, bodyTop() + contentH(rows) + PAD); }
+
+    static float maxScroll(List<Row> rows, float viewH) { return Math.max(0, contentH(rows) - (viewH - bodyTop())); }
+
+    static float clampScroll(List<Row> rows, float viewH, float scroll) { return Math.max(0, Math.min(maxScroll(rows, viewH), scroll)); }
+
+    /** Poe o {@code top} de cada linha (rolagem em dp). */
+    static void place(List<Row> rows, float scroll) {
+        float y = bodyTop() - scroll;
+        for (Row r : rows) {
+            r.top = y;
+            y += r.h;
+        }
+    }
+
+    /** Faixa na altura {@code y} (dp): clipes, uma linha do corpo ou -1 (regua / fora). Linhas rolaram para baixo da regua nao contam. */
+    static int laneAt(List<Row> rows, float y) {
+        if (y < RULER) return -1;
+        if (y < bodyTop()) return L_CLIP;
+        for (Row r : rows) if (y >= r.top && y < r.top + r.h) return r.lane;
+        return -1;
+    }
+
+    /** O passo (indice na tabela) cujo trecho {@code [start, end)} contem {@code tick}; -1 se nenhum. {@code segs[i] = {start, end, row}}. */
+    static int rowAtTick(int[][] segs, int tick) {
+        for (int[] s : segs) if (tick >= s[0] && tick < s[1]) return s[2];
+        return -1;
+    }
+}
