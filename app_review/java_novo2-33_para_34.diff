+        if (r == null || r.pat < 0 || r.mpts.length == 0) return 0;
+        if (r.pat >= r.mpts.length) {                  // ANO acabou (so fisica depois): trava no fim do ultimo frame
+            Ano.Mpt lm = r.mpts[r.mpts.length - 1];
