+    /** Arrastar a timeline: vai para {@code elapsed} ticks dentro do frame {@code pat} da ANO atual (pausa). */
+    public void seekToPatTick(int pat, int elapsed) {
+        Ano a = currentAno();
+        if (sim == null || a == null || pat < 0 || pat >= a.mpts.length) return;
+        int base = tickTableFor(a)[pat];
+        int tt = transitionTick(a);
+        int limit = tt < 0 ? Integer.MAX_VALUE : tt - 1;     // arrastar nunca faz a troca: trava no ultimo tick antes dela
+        int[][] te = tickElapsedFor(a);
+        int exact = elapsed >= 0 && pat < te.length && elapsed < te[pat].length ? te[pat][elapsed] : -1;     // ticks so da simulacao (hitstop) nao contam
+        int target = exact >= 0 ? Math.min(exact, limit) : (base < 0 ? limit : Math.min(base + elapsed, limit));
+        if (target == Integer.MAX_VALUE || target < 0) return;
+        pause();
+        seekTo(target);
+    }
+
+    /** Tick em que a primeira troca real de ANO sai desta ANO, ou -1. */
+    private int transitionTick(Ano a) {
+        if (sim == null) return -1;
+        int best = -1;
+        for (BattleSim.Trans t : sim.transitions()) if (t.kind <= SeqMark.HIT && t.fromAno == a.index && (best < 0 || t.tick < best)) best = t.tick;
+        return best;
+    }
