+    /** Entra no estado de dano (md 876/877) com a reacao do OPT 1. */
+    private void enterDamage(Opt1 op, int hitAno) {
+        faceAttacker();
+        guardActive = false;
+        gMove = 0;
+        gTime = 0;
+        inDamage = true;
+        grabHitAno = hitAno;                        // DamageHitActNo
+        dmgWall = false;                            // DamageChange zera DamageWall (jogo:2386)
+        stunned[1] = false;                         // DamageChange troca o md do defensor por 876/877: o stun (md 925) acaba
+        endAnim = -1;
+        dCharSrc = op.fromChar;
+        dType = op.type;
+        dIdx = 0;
+        dTime = 0;
+        dOldType = op.type;
+        dOldIdx = 0;
+        dMove = op.pushes ? hitBack : 0;
+        dead = false;
+        if (lifeO <= 0) {                           // KO: o jogo troca a reacao pelo tipo 2 do gamedata (md 876)
+            dCharSrc = false;
+            dType = 2;
+            dOldType = 2;
+        }
