+    private void rebuild(int keepFrame) {
+        if (data == null) {
+            sim = null;
+            length = 1;
+            frame = 0;
+        } else {
+            ghostKey = "";
+            ghostSim = null;
+            ObjModel.setWindowContext(data.move, data.moveIndex);
+            ObjModel.setGameContext(data.gameData);
+            sim = new BattleSim(data.attacker.dac, data.attacker.data, data.move, facingLeft,
+                    data.opponent.dac, data.effects == null ? null : data.effects.dac, data.gameData,
+                    distance, height, data.attacker.wavCount);
+            sim.setOpponentChar(data.opponent.data);
+            sim.setSpecialType(data.moveIndex);
+            if (data.charf != null) sim.setCharfDac(data.charf.dac);
+            if (data.bobj != null) sim.setBobjDac(data.bobj.dac);
+            length = Math.max(1, sim.measureLength());
+            landStop = sim.measuredLandTick();
+            checkLandWarning();
+            if (!measuredEarly) checkRules();
+            anoEnd = Math.min(length, Math.max(1, sim.measureAnoLength()));
+            loops = sim.loops();
+            seekInternal(Math.min(keepFrame, length - 1));
+        }
+        acc = 0;
+        lastMs = 0;
+        notifyUi();
+        invalidate();
+    }
