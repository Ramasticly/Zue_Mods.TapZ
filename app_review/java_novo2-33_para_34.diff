+    public void seekTo(int target) {
+        if (sim == null) return;
+        int tg = Math.max(0, Math.min(length - 1, target));
+        seekInternal(tg);
+        acc = 0;
+        lastMs = 0;
+        notifyUi();
+        invalidate();
+    }
+
+    private void seekInternal(int target) {
+        clearHitstopNotice();                      // timeline, barra de progresso e voltar tick ignoram o aviso
+        stopSounds();
+        sim.reset();
+        seekSnd.clear();
+        seekTick.clear();
+        for (int i = 0; i < target; i++) {
+            sim.step();
+            if (!sim.hasSounds()) continue;
+            java.util.List<BattleSim.Snd> l = sim.drainSounds();      // sons dos frames pulados: nao tocam, mas os ainda audiveis voltam em finishSeek
+            for (int k = 0; k < l.size(); k++) { seekSnd.add(l.get(k)); seekTick.add(Integer.valueOf(i + 1)); }
+        }
+        frame = target;
+        landSeen = sim.landedEarly();
+    }
+
+    private final java.util.List<BattleSim.Snd> seekSnd = new java.util.ArrayList<BattleSim.Snd>();
+    private final java.util.List<Integer> seekTick = new java.util.ArrayList<Integer>();
+
+    /** Moveu a linha do tempo: os sons que ja tinham comecado e ainda estariam tocando entram a partir do ponto certo. */
+    /** Soltou a barra da timeline: so agora entram os sons que ja estariam tocando nesse ponto (durante o arrasto nada toca, para nao pesar). */
+    public void finishSeek() { startSeekSounds(frame, 0); }
+
+    private void startSeekSounds(int target, int limitMs) {
+        if (sound == null || !soundOn || data == null) return;
+        for (int i = 0; i < seekSnd.size(); i++) {
+            BattleSim.Snd s = seekSnd.get(i);
+            int elapsed = (int) ((target - seekTick.get(i).intValue()) * 1000L / AttackSim.TICKS_PER_SECOND);
+            if (elapsed < 0) continue;
+            if (s.common) sound.playCommonFrom(s.id, elapsed, limitMs);
+            else sound.playCharFrom(s.owner == 0 ? data.attacker.dir : data.opponent.dir, s.id, elapsed, limitMs);
+        }
+    }
+
+    private void playSounds() {
+        playSounds(sim.drainSounds());
+    }
+
+    /** Toca sons ja tirados de uma simulacao (a previa da reacao usa o mesmo mapeamento: comum / do personagem do dono). */
+    public void playSounds(java.util.List<BattleSim.Snd> l) {
+        if (sound == null || !soundOn || data == null) return;
+        for (int i = 0; i < l.size(); i++) {
+            BattleSim.Snd s = l.get(i);
+            if (s.common) sound.playCommon(s.id);
+            else sound.playChar(s.owner == 0 ? data.attacker.dir : data.opponent.dir, s.id);
+        }
+    }
