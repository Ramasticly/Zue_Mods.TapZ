diff -ruN a/I18nTextView.java b/I18nTextView.java
--- a/I18nTextView.java	1970-01-01 00:00:00.000000000 +0000
+++ b/I18nTextView.java	2026-10-24 21:48:08.857708693 +0000
@@ -0,0 +1,42 @@
+package com.zue.attackeditor;
+
+import android.content.Context;
+import android.text.Spanned;
+import android.widget.TextView;
+
+/**
+ * TextView que traduz o que o app escreve nele ({@link I18n#tr}). Guarda o texto original (em portugues) para retraduzir ao trocar o idioma
+ * e para que {@code getText()} continue devolvendo o original (a logica do app nao enxerga a traducao). Textos com spans nao sao traduzidos.
+ */
+class I18nTextView extends TextView {
+    private CharSequence src;
+    private boolean noTr;
+
+    I18nTextView(Context c) { super(c); }
+
+    /** Desliga a traducao deste campo (dados, texto do usuario, nomes). */
+    I18nTextView noTranslate() {
+        noTr = true;
+        return this;
+    }
+
+    private CharSequence tr(CharSequence t) {
+        if (noTr || t == null || t instanceof Spanned || I18n.lang() == I18n.PT) return t;
+        return I18n.tr(t.toString());
+    }
+
+    @Override public void setText(CharSequence text, BufferType type) {
+        src = text;
+        super.setText(tr(text), type);
+    }
+
+    @Override public CharSequence getText() {
+        return src != null && !noTr && !(src instanceof Spanned) ? src : super.getText();
+    }
+
+    /** Reaplica o idioma atual ao texto e a dica. */
+    void retranslate() {
+        if (noTr) return;
+        if (src != null && !(src instanceof Spanned)) super.setText(tr(src), BufferType.NORMAL);
+    }
+}
diff -ruN a/I18nUi.java b/I18nUi.java
--- a/I18nUi.java	1970-01-01 00:00:00.000000000 +0000
+++ b/I18nUi.java	2026-10-24 22:22:36.501875952 +0000
@@ -0,0 +1,68 @@
+package com.zue.attackeditor;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+import android.widget.Toast;
+
+/** Parte Android do idioma: preferencia salva, toasts traduzidos e retraducao das telas abertas. */
+final class I18nUi {
+    private I18nUi() { }
+
+    private static final String PREFS = "lang", KEY = "code";
+
+    /** Carrega o idioma salvo (chamar antes de montar a interface). */
+    static void init(Context c) {
+        try {
+            SharedPreferences p = c.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            I18n.set(I18n.fromCode(p.getString(KEY, "PT")));
+        } catch (Exception ignored) { }
+    }
+
+    static void save(Context c) {
+        try { c.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY, I18n.code()).apply(); } catch (Exception ignored) { }
+    }
+
+    private static final java.util.Map<TextView, Boolean> LANG_LABELS = new java.util.WeakHashMap<TextView, Boolean>();
+
+    /** Registra um botao de idioma: o rotulo (PT/EN/ES) acompanha a troca, de onde ela vier. */
+    static void registerLang(TextView t) {
+        if (t instanceof I18nTextView) ((I18nTextView) t).noTranslate();
+        t.setText(I18n.code());
+        LANG_LABELS.put(t, Boolean.TRUE);
+    }
+
+    /** Proximo idioma (PT, EN, ES): grava a escolha, atualiza os botoes de idioma e retraduz a tela da activity. */
+    static void cycle(Context c) {
+        I18n.next();
+        save(c);
+        for (TextView t : new java.util.ArrayList<TextView>(LANG_LABELS.keySet())) t.setText(I18n.code());
+        if (c instanceof Activity) retranslate((Activity) c);
+    }
+
+    /** Substitui Toast.makeText: o texto passa por {@link I18n#tr}. */
+    static Toast toast(Context c, CharSequence text, int duration) {
+        return Toast.makeText(c, text == null || I18n.lang() == I18n.PT ? text : I18n.tr(text.toString()), duration);
+    }
+
+    /** Substitui Canvas.drawText nos desenhos proprios: o texto passa por {@link I18n#tr}. */
+    static void drawText(android.graphics.Canvas c, String text, float x, float y, android.graphics.Paint p) {
+        c.drawText(I18n.lang() == I18n.PT || text == null ? text : I18n.tr(text), x, y, p);
+    }
+
+    /** Reaplica o idioma atual a todos os textos da arvore de views. */
+    static void retranslate(View v) {
+        if (v == null) return;
+        if (v instanceof I18nTextView) ((I18nTextView) v).retranslate();
+        else if (v instanceof I18nCheckBox) ((I18nCheckBox) v).retranslate();
+        if (v instanceof ViewGroup) {
+            ViewGroup g = (ViewGroup) v;
+            for (int i = 0; i < g.getChildCount(); i++) retranslate(g.getChildAt(i));
+        }
+    }
+
+    static void retranslate(Activity a) { retranslate(a.getWindow().getDecorView()); }
+}
diff -ruN a/IconView.java b/IconView.java
--- a/IconView.java	1970-01-01 00:00:00.000000000 +0000
+++ b/IconView.java	2026-10-24 21:48:20.067701652 +0000
@@ -0,0 +1,100 @@
+package com.zue.attackeditor;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.view.View;
+
+/** Icones simples da grade da sprite, desenhados em Canvas (sem imagens): imagem, relogio, alto-falante, setas, brilho, copia. */
+final class IconView extends View {
+    static final int IMAGE = 0, CLOCK = 1, SOUND = 2, MOVE = 3, FX = 4, COPY = 5;
+
+    private final int kind;
+    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path path = new Path();
+    private final RectF r = new RectF();
+
+    IconView(Context c, int kind, int color) {
+        super(c);
+        this.kind = kind;
+        p.setColor(color);
+    }
+
+    @Override protected void onDraw(Canvas cv) {
+        float w = getWidth(), h = getHeight(), s = Math.min(w, h), u = s / 10f;
+        float ox = (w - s) / 2f, oy = (h - s) / 2f;
+        cv.translate(ox, oy);
+        p.setStrokeWidth(u * 0.8f);
+        p.setStrokeCap(Paint.Cap.ROUND);
+        p.setStrokeJoin(Paint.Join.ROUND);
+        switch (kind) {
+            case IMAGE:
+                p.setStyle(Paint.Style.STROKE);
+                r.set(1 * u, 1.5f * u, 9 * u, 8.5f * u);
+                cv.drawRoundRect(r, u, u, p);
+                p.setStyle(Paint.Style.FILL);
+                cv.drawCircle(3.4f * u, 4f * u, 0.9f * u, p);
+                path.reset();
+                path.moveTo(1.8f * u, 8f * u); path.lineTo(4.5f * u, 5.2f * u); path.lineTo(6.2f * u, 7f * u);
+                path.lineTo(7.2f * u, 6f * u); path.lineTo(8.4f * u, 8f * u); path.close();
+                cv.drawPath(path, p);
+                break;
+            case CLOCK:
+                p.setStyle(Paint.Style.STROKE);
+                cv.drawCircle(5 * u, 5 * u, 4 * u, p);
+                cv.drawLine(5 * u, 5 * u, 5 * u, 2.6f * u, p);
+                cv.drawLine(5 * u, 5 * u, 6.8f * u, 5.9f * u, p);
+                break;
+            case SOUND:
+                p.setStyle(Paint.Style.FILL);
+                path.reset();
+                path.moveTo(1 * u, 3.8f * u); path.lineTo(3.2f * u, 3.8f * u); path.lineTo(5.6f * u, 1.6f * u);
+                path.lineTo(5.6f * u, 8.4f * u); path.lineTo(3.2f * u, 6.2f * u); path.lineTo(1 * u, 6.2f * u); path.close();
+                cv.drawPath(path, p);
+                p.setStyle(Paint.Style.STROKE);
+                r.set(4.4f * u, 3.2f * u, 7.4f * u, 6.8f * u);
+                cv.drawArc(r, -50, 100, false, p);
+                r.set(3.6f * u, 1.8f * u, 8.8f * u, 8.2f * u);
+                cv.drawArc(r, -50, 100, false, p);
+                break;
+            case MOVE:
+                p.setStyle(Paint.Style.STROKE);
+                cv.drawLine(1 * u, 5 * u, 9 * u, 5 * u, p);
+                cv.drawLine(5 * u, 1 * u, 5 * u, 9 * u, p);
+                arrow(cv, 9 * u, 5 * u, -1, 0, u);
+                arrow(cv, 1 * u, 5 * u, 1, 0, u);
+                arrow(cv, 5 * u, 1 * u, 0, 1, u);
+                arrow(cv, 5 * u, 9 * u, 0, -1, u);
+                break;
+            case FX:
+                p.setStyle(Paint.Style.FILL);
+                star(cv, 4.2f * u, 5.8f * u, 3.6f * u, u);
+                star(cv, 7.8f * u, 2.6f * u, 1.7f * u, u);
+                break;
+            default:
+                p.setStyle(Paint.Style.STROKE);
+                r.set(1 * u, 3 * u, 6.2f * u, 9 * u);
+                cv.drawRoundRect(r, u * 0.8f, u * 0.8f, p);
+                r.set(3.8f * u, 1 * u, 9 * u, 7 * u);
+                cv.drawRoundRect(r, u * 0.8f, u * 0.8f, p);
+                break;
+        }
+    }
+
+    /** Ponta de seta em (x, y) apontando para o lado oposto de (dx, dy). */
+    private void arrow(Canvas cv, float x, float y, int dx, int dy, float u) {
+        float k = 1.5f * u;
+        cv.drawLine(x, y, x + dx * k + dy * k, y + dy * k + dx * k, p);
+        cv.drawLine(x, y, x + dx * k - dy * k, y + dy * k - dx * k, p);
+    }
+
+    private void star(Canvas cv, float cx, float cy, float R, float u) {
+        float in = R * 0.28f;
+        path.reset();
+        path.moveTo(cx, cy - R); path.lineTo(cx + in, cy - in); path.lineTo(cx + R, cy); path.lineTo(cx + in, cy + in);
+        path.lineTo(cx, cy + R); path.lineTo(cx - in, cy + in); path.lineTo(cx - R, cy); path.lineTo(cx - in, cy - in); path.close();
+        cv.drawPath(path, p);
+    }
+}
