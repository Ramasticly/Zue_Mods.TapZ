+import android.view.View;
+import android.view.Window;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+/**
+ * Tela cheia da ajuda: lista de capitulos (titulo + resumo), cada um abre o texto dele; a busca por palavra mostra as secoes de qualquer capitulo.
+ * O botao voltar do aparelho volta da secao para a lista antes de fechar.
+ */
+final class HelpScreen {
+    private final Context c;
+    private final float d;
+    private final Runnable resetToolbar;
+    private Dialog dlg;
+    private LinearLayout root;
+    private LinearLayout body;
+    private ScrollView sv;
+    private EditText search;
+    private TextView backBtn, titleView;
+    private HelpText.Chapter open;
+
+    HelpScreen(Context c, Runnable resetToolbar) {
+        this.c = c;
+        this.resetToolbar = resetToolbar;
+        this.d = c.getResources().getDisplayMetrics().density;
+    }
+
+    private int dp(int v) { return Math.round(v * d); }
+
+    void show() {
+        dlg = new Dialog(c, android.R.style.Theme_DeviceDefault_NoActionBar) {
+            @Override public void onBackPressed() {
+                if (open != null || search.getText().length() > 0) { search.setText(""); open = null; render(); } else super.onBackPressed();
+            }
+        };
+        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        root = new LinearLayout(c);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(LayoutManager.BG);
+        root.setPadding(dp(10), dp(26), dp(10), dp(8));
+
+        LinearLayout head = new LinearLayout(c);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        backBtn = btn("◀", false, new View.OnClickListener() { public void onClick(View v) { search.setText(""); open = null; render(); } });
+        head.addView(backBtn);
+        titleView = new I18nTextView(c);
