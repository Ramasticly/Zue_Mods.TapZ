+    /**
+     * Hitbox flags 39 / 40 (CheckOptFlag): uma vez por frame carregado, em qualquer objeto (lutador ou projetil) do jogador {@code p}.
+     * 39 = p vai para a posicao (logica) do outro; 40 = o outro vai para a de p + COORDS[x, y] (x espelhado pelo flip do objeto).
+     * Com o alvo morto (Life <= 0) o jogo nao teleporta e encerra o ANO (wActFlag |= 2).
+     * {@code order} = ordem da task de origem (0 projetil 13312, 1 atacante 13569, 2 oponente 13570): o alvo so aparece no mesmo tick se o
+     * PlayerTail dele roda depois (ordem maior); senao o _SetXY dele ja passou e a posicao desenhada muda no tick seguinte (pendente).
+     */
+    private void teleportFlags(AttackSim.Obj r, int p, int order) {
+        int np = 1 - p;
+        for (int i = 0; i < r.hits.length; i++) {
+            Ano.Hit h = r.hits[i];
+            if (h.flag != 39 && h.flag != 40) continue;
+            if ((np == 0 ? lifeA : lifeO) <= 0) {
+                r.actFlags |= 2;
+                lastHit = "flag " + h.flag + ": alvo derrotado, o ANO termina";
+                continue;
+            }
+            int tx, ty, who;
+            if (h.flag == 39) {
+                who = p;
+                tx = logX(np);
+                ty = logY(np);
+                lastHit = "flag 39: " + (p == 0 ? "atacante -> oponente" : "oponente -> atacante");
+            } else {
+                who = np;
+                int cx = (r.objFlags & 16) != 0 ? -h.x : h.x;
+                tx = logX(p) + (cx << 16);
+                ty = logY(p) + (h.y << 16);
+                if (np == 1 && ty > 0) ty = 0;
+                lastHit = "flag 40: " + (np == 1 ? "oponente -> atacante" : "atacante -> oponente") + " + (" + cx + "," + h.y + ")";
+            }
+            movePlayer(who, true, tx, true, ty);
+            int whoOrder = who == 0 ? 1 : 2;
+            if (whoOrder > order) {                         // o PlayerTail do alvo ainda vai rodar neste tick: ja aparece na nova posicao
+                AttackSim.Obj d = who == 0 ? atk.root() : opp.root();
+                if (who == 0) { pendA = false; if (d != null) { d.x = tx; d.y = ty; } }
+                else if (d != null) { d.x = tx; d.y = ty; }
+            }
+        }
+    }
+
+    // posicao logica dos jogadores (PlayerXPos/PlayerYPos): a do atacante pode estar pendente ate o proximo PlayerTail
+    private boolean pendA;
+    private int pendAX, pendAY;
+
+    private int logX(int pl) {
+        if (pl == 1) return oppX;
+        if (pendA) return pendAX;
+        AttackSim.Obj r = atk.root();
+        return r == null ? 0 : r.x;
+    }
+
+    private int logY(int pl) {
+        if (pl == 1) return oppY;
+        if (pendA) return pendAY;
+        AttackSim.Obj r = atk.root();
+        return r == null ? 0 : r.y;
+    }
+
+    /** Muda PlayerXPos/YPos depois do _SetXY do tick: a posicao desenhada so muda no PlayerTail do tick seguinte (atacante). */
+    private void movePlayer(int pl, boolean setX, int x, boolean setY, int y) {
+        if (pl == 1) {
+            if (setX) oppX = x;
+            if (setY) oppY = y;
+            return;
+        }
+        AttackSim.Obj r = atk.root();
+        if (r == null) return;
+        if (!pendA) { pendA = true; pendAX = r.x; pendAY = r.y; }
+        if (setX) pendAX = x;
+        if (setY) pendAY = y;
+    }
+
+    /** _SetXY do PlayerTail (inicio do tick, depois do hit-detect do tick anterior): o atacante vai para a posicao logica. */
+    private void applyPendingMoves() {
+        if (!pendA) return;
+        pendA = false;
+        AttackSim.Obj r = atk.root();
+        if (r != null) { r.x = pendAX; r.y = pendAY; }
+    }
+
+    /**
+     * Flag 20: cria a task 996 (evento HDAT 13 do dono da animacao, linha = COORDS[2]). player = lutador dono do ANO
+     * (0 atacante, 1 oponente); src = projetil dono do ANO (md 971/972 tambem chamam CheckOptFlag), ou null.
+     * A ancora (work[5], work[6]) e a posicao do objeto + COORDS[x, y] (x espelhado pelo flip do objeto).
+     */
+    private void cutsceneFlags(AttackSim.Obj r, int player, Proj src) {
+        CharData ch = player == 0 ? atkChar : oppChar;
+        if (ch == null) return;
+        for (int i = 0; i < r.hits.length; i++) {
+            Ano.Hit h = r.hits[i];
+            if (h.flag != 20) continue;
+            int ev = h.width;
+            if (!ch.hasEvent(ev)) { lastHit = "flag 20: evento " + ev + " inexistente"; continue; }
+            Cut c = new Cut();
+            c.ev = ev;
+            c.player = player;
+            c.src = src;
+            int alvo = ch.eventField(ev, 0);
+            int animN = ch.eventField(ev, 6);
+            int animF = ch.eventField(ev, 8);
+            c.flipped = (r.objFlags & 16) != 0;
+            c.sync = ch.eventField(ev, 2);
+            int zCfg = ch.eventField(ev, 4);
+            c.camMode = ch.eventField(ev, 10);
+            c.stun = ch.eventField(ev, 12);
+            c.mapa = ch.eventField(ev, 14);
+            c.startAno = r.ano.index;
+            c.startPat = r.pat;
+            int cx = c.flipped ? -h.x : h.x;
+            c.wx = r.x + (cx << 16);
+            c.wy = r.y + (h.y << 16);
+            c.offX = cx << 16;
+            int anim = c.flipped ? animF : animN;
+            String why = "";
+            if (animN == 0) why = " (sem animação: ANIM_ID = 0)";
+            else {
+                // acttype do jogo: 0 = effect (5), 1 = pack do proprio personagem (p+3), qualquer outro = bobj (2)
+                String packName = alvo == 0 ? "effect" : alvo == 1 ? "do personagem" : "bobj";
+                Dac d = alvo == 0 ? fxDac : alvo == 1 ? (player == 0 ? atkDac : defDac) : bobjDac;
+                if (d == null) why = alvo >= 2 ? " (ALVO " + alvo + " = bobj: nenhuma pasta bobjNN em assets, nada é desenhado)" : " (pack " + packName + " não carregado)";
+                else {
+                    c.sim = new AttackSim(d, anim, false, c.wx, c.wy);
+                    if (c.sim.root() == null) { c.sim = null; why = " (ANO " + anim + " do " + packName + " vazia/inexistente)"; }
+                    else why = " (ALVO " + alvo + ", ANO " + anim + ", cam " + c.camMode + ", FLAG " + c.mapa + ")";
+                }
+                c.owner = alvo == 0 ? OWNER_EFFECT : alvo == 1 ? (player == 0 ? OWNER_ATTACKER : OWNER_DEFENDER) : OWNER_BOBJ;
+            }
+            if (zCfg == 0) c.z = (ev != 8 && ev != 9) ? 200 : 10;
+            else if (zCfg == 1) c.z = ev == 8 ? 19 : (ev == 9 ? 21 : 17);
+            else c.z = 400;
+            c.screenLock = c.camMode != 0;
+            cuts.add(c);
+            lastHit = "flag 20: cutscene " + ev + why;
+        }
+    }
+
+    /** CheckOptFlag: wOptFlag & 2048 sem DamageWall do dono volta antes de processar os hits (o atacante/projetil nunca esta em dano). */
+    private boolean optAbort(AttackSim.Obj o, int player) {
+        return (o.optFlag & 2048) != 0 && !(player == 1 && dmgWall);
+    }
+
+    /** ptr.obj da task 996: objeto do lutador ou do projetil que carrega o ANO da flag 20 (null = ja morreu). */
+    private AttackSim.Obj srcRoot(Cut c) {
+        if (c.src != null) return c.src.dead || !projs.contains(c.src) ? null : c.src.sim.root();
+        return (c.player == 0 ? atk : opp).root();
+    }
+
+    /** md 925 em qualquer dos jogadores: projeteis, auras e agarrao do jogo pausam (wActFlag |= 4). */
+    private boolean stunAny() { return stunned[0] || stunned[1]; }
+
+    /**
+     * Task md 996 (prio 13729) de todas as cutscenes, da mais antiga para a mais nova: uma cutscene criada neste tick
+     * (PlayerTail/projetil, prio menor) roda a primeira vez agora. Antes, o md 935 (13728) limpa ScreenEdgeOff/ScrollCheckOff.
+     */
+    private void stepCuts() {
+        edgeOff[0] = edgeOff[1] = scrollOff[0] = scrollOff[1] = false;
+        scrollTarget = -1;
+        forceWall = false;
+        for (int i = 0; i < cuts.size(); i++) {
+            if (runCut(cuts.get(i))) cuts.remove(i--);
+        }
+    }
+
+    /** Um tick da task 996. true = a task terminou (_TKill: o objeto some da lista de desenho ja neste tick). */
+    private boolean runCut(Cut c) {
+        int p = c.player, t = 1 - p, m = c.mapa;
+        AttackSim.Obj ptr = srcRoot(c);
+        if (ptr == null) return true;                                 // dono morreu: o jogo mata a task sem devolver o md do alvo
+        boolean first = !c.init;
+        if (first) {
+            if (c.stun != 0) {                                        // work[7] = md do alvo; md = 925 (so a primeira cutscene devolve)
+                c.stunSaved = !stunned[t];
+                stunned[t] = true;
+                c.offX = 0;                                           // work[7] passa a guardar o md: o mapa 3 soma ~0 px, nao o x do hit
+            }
+            if (m == 3) c.target = logX(p) + c.offX - (c.flipped ? SCREEN_FULL : 0);
+        }
+        if (c.sim != null) {
+            boolean freeScreen = c.screenLock && (c.ev == 8 || c.ev == 9);
+            if (c.screenLock && (first || !freeScreen)) {             // _SetXY(0, 0): raiz e links (eventos 8/9 so no 1o tick)
+                c.curL = screenLeft();
+                c.curT = screenTop();
+                c.sim.pinTo(c.curL, c.curT);
+            } else if (!c.screenLock) {
+                c.sim.pinTo(c.wx, c.wy);                              // _SetXY(ancora - camera) antes do _ActReq
+            }
+            if (!first) c.sim.step(false);                            // a 1a execucao so carrega o frame (o AttackSim ja fez)
+            consumeSe(c.sim, p);                                      // ChrSePlay depois do _ActReq (tambem no tick em que a task morre)
+        }
+        boolean end = false;
+        if (m != 0) {
+            if (m == 2 && (t == 0 ? lifeA : lifeO) <= 0) hidden[t] = true;        // PlayerState |= 0x1000000: o alvo derrotado some para sempre
+            if (m == 5) scrollTarget = t;                                          // a camera passa a centralizar o alvo
+            if (m == 6) forceWall = true;                                          // paredes valem em qualquer ponto da tela
+            if (m == 7 || m == 9) edgeOff[t] = true;
+            if (m == 8 || m == 9) edgeOff[p] = true;
+            if (edgeMode != 0) {
+                if (m >= 10 && m <= 12) {                             // o P-alvo e preso a borda a cada tick
+                    movePlayer(t, m != 12, m == 10 ? camLeft - 7864320 : camLeft + 39321600, m == 12, camYFix - 17825792);
+                    if (first) { if (t == 0) oldAx = logX(0); else oldOx = oppX; }
+                } else if (m >= 13 && m <= 15 && first) {            // so no 1o tick
+                    movePlayer(p, m != 15, m == 13 ? camLeft - 7864320 : camLeft + 39321600, m == 15, camYFix - 17825792);
+                    if (p == 0) oldAx = logX(0); else oldOx = oppX;
+                }
+            }
+            if (m >= 10 && m <= 12) edgeOff[t] = true;
+            if (m >= 13 && m <= 15) edgeOff[p] = true;
+            if (m == 3 || m == 4 || m == 7 || m == 9) scrollOff[p] = true;
+            if (m == 8 || m == 9) scrollOff[t] = true;
+        }
+        c.init = true;
+        if (m == 3) {
+            // a camera anda 10 px por tick ate o alvo (camMode 0: salta direto e a task morre no mesmo tick; camBase fica como esta)
+            if (edgeMode == 0) end = true;
+            else {
+                if (c.camMode == 0) camLeft = c.target;
+                if (c.target < camLeft) {
+                    camLeft -= 655360;
+                    if (c.target > camLeft) camLeft = c.target;
+                } else if (c.target > camLeft) {
+                    camLeft += 655360;
+                    if (c.target < camLeft) camLeft = c.target;
+                } else end = true;
+            }
+        } else if (ptr.ano.index != c.startAno) {
+            end = true;
+        } else if (c.sync > 0 && ptr.pat >= c.startPat + c.sync) {
+            end = true;
+        }
+        if (end && m != 3 && c.stun != 0 && c.stunSaved) stunned[t] = false;   // mapa 3 nunca devolve o md do alvo
+        return end;
+    }
+
+    /** Cutscenes de tela travada acompanham a camera: no jogo ficam no canto da tela, sem passar pela rolagem. */
+    private void syncScreenCuts() {
+        for (int i = 0; i < cuts.size(); i++) {
+            Cut c = cuts.get(i);
+            if (!c.screenLock || c.sim == null) continue;
+            int l = screenLeft(), t = screenTop();
+            if (l != c.curL || t != c.curT) {
+                c.sim.translate(l - c.curL, t - c.curT);
+                c.curL = l;
+                c.curT = t;
+            }
+        }
+    }
+
+    private void spawnMain(AttackSim.Obj r, Ano.Hit h) {
+        if (bulletAno == 0) { noteNoBulletAno(); return; }
+        if (projs.size() >= MAX_PROJECTILES) return;      // limite do jogo (BulletNum < 8): sem aviso na tela, so no AJUDA
+        int count = (move.flags & 4) != 0 ? 3 : 1;
+        for (int k = 0; k < count; k++) {
+            int x, y;
+            if ((move.flags & 32) != 0) {
+                x = oppX;
+                y = oppY;
+            } else if ((move.flags & 64) != 0) {
+                x = oppX;
+                y = 0;
+            } else {
+                int flip = (r.actFlags & 16) ^ (r.objFlags & 16);
+                x = flip != 0 ? r.x - (h.x << 16) : r.x + (h.x << 16);
+                y = r.y + (h.y << 16);
+            }
+            boolean facingLeft = (r.objFlags & 16) != 0;
+            if (!facingLeft && x < r.x) x = r.x + PROJ_FAR;
+            else if (facingLeft && x > r.x) x = r.x - PROJ_FAR;
+
+            Proj p = new Proj();
+            p.main = true;
+            p.bornTick = ticks;
+            p.flip = facingLeft;
+            p.hitAno = move.projAoAcertar;
+            p.hitAnim = move.projAoAcertar != 0;
+            p.globalAno = move.projGlobal;
+            p.groundAno = move.projChao;
+            p.sim = new AttackSim(atkDac, bulletAno + k, p.flip, x, y);
+            p.sim.clearPause = true;
+            if (p.sim.root() == null)
+                noteSpawn("O projétil nasce, mas o ANO " + (bulletAno + k) + (k > 0 ? " (tiro triplo: ANO inicial + " + k + ")" : " (" + bulletField + ")")
+                        + " não existe ou está vazio no DAC: ele morre sem aparecer. "
+                        + (k > 0 ? "Com \"Lançar 3 projéteis\" os ANOs ANO, ANO+1 e ANO+2 precisam existir." : "Crie esse ANO ou aponte o campo para outro."), false);
+            projs.add(p);
+            spawnedAny = true;
+        }
+    }
