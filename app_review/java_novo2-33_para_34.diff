+    /** SPEEDLINE: dedo num ponto = arrastar (muda a speed) ou tocar (menu); devolve true se o gesto e do ponto. */
+    private boolean slTouch(MotionEvent e) {
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN: {
+                int[] h = slHit(e.getX(), e.getY());
+                if (h == null) return false;
+                slDragHead = h[0];
+                slDragK = h[1];
+                slDownX = e.getX();
+                slDownY = e.getY();
+                slMoved = false;
+                return true;
+            }
+            case MotionEvent.ACTION_MOVE:
+                if (slDragHead < 0) return false;
+                if (e.getPointerCount() > 1) { slWork = null; slDragHead = -1; return false; }
+                if (!slMoved && Math.hypot(e.getX() - slDownX, e.getY() - slDownY) < 10f * density) return true;
+                slMoved = true;
+                if (slDragK >= 1) slDragTo(e.getX(), e.getY());
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL: {
+                if (slDragHead < 0) return false;
+                int head = slDragHead, k = slDragK;
+                slDragHead = -1;
+                Ano.Mpt[] work = slWork;
+                slWork = null;
+                if (e.getActionMasked() == MotionEvent.ACTION_UP) {
+                    if (slMoved && work != null) { replaceMpts(work, "speedline"); }
+                    else if (!slMoved && getContext() instanceof android.app.Activity) {
+                        int[] loc = new int[2];
+                        getLocationOnScreen(loc);
+                        SpeedLineMenu.show((android.app.Activity) getContext(), this, head, k, loc[0] + (int) e.getX(), loc[1] + (int) e.getY());
+                    }
+                }
+                invalidate();
+                return true;
+            }
+            default:
+                return false;
+        }
+    }
+
+    @Override public boolean onTouchEvent(MotionEvent e) {
+        if (e.getActionMasked() == MotionEvent.ACTION_DOWN && noticeTouch(e.getX(), e.getY())) return true;
+        if (speedLineOn && slTouch(e)) return true;
+        if (centerMode != 0) return true;       // camera automatica: sem arrastar nem zoom
+        scaler.onTouchEvent(e);
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                lastX = e.getX();
+                lastY = e.getY();
+                dragging = true;
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+                dragging = false;
+                break;
+            case MotionEvent.ACTION_POINTER_UP: {
+                int keep = e.getActionIndex() == 0 ? 1 : 0;
+                lastX = e.getX(keep);
+                lastY = e.getY(keep);
+                dragging = e.getPointerCount() == 2;
+                break;
+            }
+            case MotionEvent.ACTION_MOVE:
+                if (dragging && !scaler.isInProgress() && e.getPointerCount() == 1) {
+                    originX += e.getX() - lastX;
+                    originY += e.getY() - lastY;
+                    lastX = e.getX();
+                    lastY = e.getY();
+                    invalidate();
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                dragging = false;
+                break;
+            default:
+                break;
+        }
+        return true;
+    }
+}
