+                n.flags = t.flags; n.time = t.time;
+            } });
+        } }).value(FrameTools.ticks(m)));
+        lab("POSIÇÃO DA SPRITE DO LINK (centro x / y)");
+        LinearLayout r2 = new LinearLayout(a);
+        r2.setGravity(Gravity.CENTER_VERTICAL);
+        body.addView(r2);
+        r2.addView(tv("x", 12, LayoutManager.DIM, false));
+        r2.addView(new Stepper(a).range(-9999, 9999).step(1).keyboard(new Stepper.OnValue() { public void on(final double v) {
+            editChild(new Mut() { public void apply(Ano.Mpt n) { if ((n.flags & 1) == 0) { n.flags |= 1; n.midY = 0; } n.midX = (int) v; } });
