+    }
+
+    private String totalText() {
+        StringBuilder sb = new StringBuilder();
+        int n = trace.ticks.size();
+        int[] all = trace.displacement(n);
+        sb.append("Cenário ").append(air ? "AR (oponente a " + ReactionPreview.AIR_HEIGHT + " px do chão)" : "CHÃO").append(": ").append(n).append(" ticks = ")
+                .append(String.format(java.util.Locale.US, "%.2f", n / 60.0)).append("s, deslocamento total x ").append(all[0]).append(" px, y ").append(all[1]).append(" px")
+                .append(trace.ended ? "." : " (parou no limite de 420 ticks).").append("\n\n");
+        for (ReactionTrace.Seg s : trace.segments) {
+            int[] a = trace.displacement(s.start), bb = trace.displacement(s.end);
+            boolean own = s.charSrc == editable && s.type == type;
+            sb.append(own ? "passo " + (s.row + 1) : "→ reação " + (s.charSrc ? "do personagem " : "do jogo ") + s.type + " passo " + (s.row + 1)).append(": ticks ").append(s.start).append("–").append(s.end - 1)
+                    .append(" (").append(s.length()).append("), Δx ").append(bb[0] - (s.start == 0 ? 0 : a[0])).append(" Δy ").append(bb[1] - (s.start == 0 ? 0 : a[1])).append(" px\n");
+        }
+        return sb.toString();
+    }
