+package com.zue.attackeditor;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Texto do menu AJUDA: o que cada botao do menu superior e da tela faz, visto pela utilidade em editar e executar um golpe.
+ * Java puro (testado sem Android). Os ids dos botoes do menu superior sao os de {@link ToolbarOrder}.
+ */
+final class HelpText {
+    private HelpText() { }
+
+    static final class Section {
+        /** id de {@link ToolbarOrder} se a secao descreve um botao do menu superior; null nas demais. */
+        final String button;
+        final String title, body;
+
+        Section(String button, String title, String body) {
+            this.button = button;
+            this.title = title;
+            this.body = body;
+        }
+    }
+
+    /** Dica de como mexer na propria barra (vai no topo da ajuda). */
+    static final String REORDER_TIP =
+            "ORDEM DOS BOTÕES: segure um botão do menu superior e arraste para frente ou para trás para mudar a ordem; "
+            + "perto da borda a barra rola sozinha. O primeiro botão fica fixo no início da linha (hoje, por padrão, o SALVAR): "
+            + "solte qualquer botão em cima dele para ele virar o fixo. A ordem fica salva no aparelho. "
+            + "RESTAURAR ORDEM volta ao padrão.";
+
+    /** Menu superior, na ordem de fabrica. */
+    static List<Section> toolbar() {
+        List<Section> s = new ArrayList<Section>();
+        s.add(new Section(ToolbarOrder.SAVE, "SALVAR",
+                "Grava as edições em .txt: o golpe atual (HDAT 4 + os ANOs dele), só o ANO atual, todos os golpes, todos os ANOs ou tudo. "
+                + "Dá para salvar numa pasta separada (não mexe no original) ou sobrescrever os .txt do Runtime. "
+                + "Ao salvar, o app confere os limites do jogo (hitboxes por frame, links, tempo...) e avisa o que faria o jogo fechar."));
+        s.add(new Section(ToolbarOrder.CHAR, "CHAR",
+                "Escolhe o ATACANTE e o OPONENTE (cada um com os próprios dados e sprites). POS ajusta a distância entre eles e a altura de cada um "
+                + "arrastando na tela (as linhas são as posições do jogo: perto, médio, longe) e tem o FLY, que deixa o atacante voando em vez de cair. "
+                + "CHAR OBJ mostra a caixa do corpo (HDAT 3) e as âncoras dos sprites, hurtboxes, hitboxes, efeitos e projéteis, e permite mudar o tamanho do corpo. "
+                + "Use para testar o golpe contra outros lutadores e em outras alturas: a altura relativa decide qual ANO de projétil nasce (normal, de baixo ou de cima)."));
+        s.add(new Section(ToolbarOrder.SPRITES, "SPRITES",
+                "Lista os sprites (SPR_0, SPR_1...) do personagem atacante, já recortados pelo CNV; as folhas ficam intactas no disco. "
+                + "Serve para adicionar, substituir e remover sprites, mudar o recorte e o índice, e para escolher qual sprite entra num frame do golpe."));
+        s.add(new Section(ToolbarOrder.LINKS, "LINKS",
+                "Mostra e edita os links do ANO atual: objetos filhos (efeitos, partes do corpo, auras) que o jogo cria junto com a animação e que seguem o pai. "
+                + "O jogo aceita no máximo 13 por ANO e só 1 nível (link de link não nasce). Use para montar efeitos que acompanham o golpe."));
+        s.add(new Section(ToolbarOrder.MOVE, "GOLPE SET",
+                "Opções do golpe (ATK_FLAGS do HDAT 4): agarrão (ao fim do ANO inicial ou só durante o hit), projétil nascendo no oponente ou embaixo dele, "
+                + "lançar 3 projéteis (usa ANO, ANO+1 e ANO+2), projétil que só explode no chão, hitbox que destrói as do oponente e atravessar o oponente. "
+                + "Só vale para o ANO inicial de um golpe. Define como o golpe é executado no jogo, não como ele é desenhado."));
+        s.add(new Section(ToolbarOrder.HITBOX, "HITBOX",
+                "Liga e desliga o desenho das caixas na preview: vermelha = hitbox (onde o golpe acerta), azul = hurtbox (onde o personagem leva dano) "
+                + "e amarela = as demais caixas de flag. Ligado ajuda a posicionar o alcance; desligado deixa ver só a arte."));
+        s.add(new Section(ToolbarOrder.TIME, "TEMPO",
+                "Muda como o tempo corre na simulação. NORMAL: o golpe roda como no jogo e a preview termina quando tudo acaba. "
+                + "ESTENDIDO: o atacante fica parado no último frame quando o ANO acaba, para você ver projéteis e a reação do oponente até o fim. "
