+    private ReactionTrace recordTrace() {
+        int old = BattleSim.oppHeightPx;
+        BattleSim.oppHeightPx = air ? ReactionPreview.AIR_HEIGHT : 0;
+        BattleSim s;
+        try { s = view.newReactionSim(); } finally { BattleSim.oppHeightPx = old; }
+        return ReactionTrace.record(s, optValue, 420);
+    }
+
+    /** Recalcula a simulacao e refaz timeline, previa e aba (depois de qualquer edicao ou troca de cenario). */
+    private void refresh() {
+        ReactionTable t = table();
+        if (t == null) return;
+        sel = Math.max(0, Math.min(sel, t.rows - 1));
+        trace = recordTrace();
+        tl.setData(trace, t, editable, type, air);
+        tl.setSelected(sel);
+        preview.setAir(air);
+        preview.setMaxTick(trace.ticks.size());
+        preview.setValue(optValue);
+        preview.seek(tl.pointerTick());
+        updateLabel();
+        buildPage();
+    }
+
+    private void setAir(boolean on) {
+        if (air == on) return;
+        air = on;
+        styleToggle(btnGround, !air);
+        styleToggle(btnAir, air);
+        refresh();
+    }
+
+    private void goTo(int tick) {
+        int max = trace == null ? 0 : trace.ticks.size();
+        tick = Math.max(0, Math.min(max, tick));
+        tl.setPointer(tick);
+        preview.seek(tick);
+        followRow(tick);
+        updateLabel();
+        stopPlayUi();
+    }
+
+    private void togglePlay() {
+        if (preview.isPlaying()) { preview.pause(); stopPlayUi(); return; }
+        if (tl.pointerTick() >= (trace == null ? 0 : trace.ticks.size())) { tl.setPointer(0); preview.seek(0); }
+        preview.play();
+        playBtn.setText("PAUSAR");
+    }
+
+    private void stopPlayUi() { if (!preview.isPlaying()) playBtn.setText("TOCAR"); }
+
+    private void onPlayTick() {
+        tl.setPointer(preview.tickNow());
+        followRow(preview.tickNow());
+        updateLabel();
+        stopPlayUi();
+    }
+
+    private void updateLabel() {
+        int n = trace == null ? 0 : trace.ticks.size();
+        int tk = tl.pointerTick();
+        int[] dsp = trace == null ? new int[]{0, 0} : trace.displacement(tk);
+        tickLabel.setText(tk + "/" + n + "  Δ " + dsp[0] + "," + dsp[1]);
+        seekFromCode = true;
+        seek.setMax(Math.max(1, n));
+        seek.setProgress(tk);
+        seekFromCode = false;
+    }
