+    /** {esquerda, topo, direita, base} do retangulo da camera em px do mundo durante o zoom; null se normal. */
+    public float[] zoomRect() {
+        if (zCurW == 100f || zCurW <= 0f) return null;
+        float w = 480f * 100f / zCurW, h = 320f * 100f / zCurW;
+        return new float[]{zCurX - w / 2, zCurY - h / 2, zCurX + w / 2, zCurY + h / 2};
+    }
