+    /**
+     * Duracao em ticks do ANO atual do atacante: ate a raiz terminar (fim dos frames) ou, se o ANO
+     * repete (wActFlag 1), ate o primeiro retorno ao frame 0. Ticks de hitstop contam.
+     */
+    private BattleSim fresh() {
+        BattleSim s = new BattleSim(atkDac, atkChar, move, atkLeft, defDac, fxDac, gd, distancePx, heightPx, atkWavCount);
+        s.oppChar = oppChar;
