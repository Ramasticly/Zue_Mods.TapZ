+        label(box, name);
+        if (editable) {
+            final Stepper st = new Stepper(c).range(lo, hi).step(1);
+            st.keyboard(new Stepper.OnValue() { public void on(double nv) { setCell(col, (int) nv); } }).live(true);
+            box.addView(st.view());
+            upd(new Runnable() { public void run() { st.value(cell(col)); } });
+        } else {
+            final TextView ro = text("", LayoutManager.TEXT, 14, true);
