+    private String rulesDismissed = "";
+
+    private void checkRules() {
+        if (data == null || data.attacker == null) return;
+        java.util.TreeSet<Integer> anos = Saver.anosOfMove(data.attacker.dac, data.move, data.attacker.data);
+        java.util.List<GameRules.Issue> iss = GameRules.check(data.attacker.dac, anos, data.attacker.cnv == null ? 0 : data.attacker.cnv.size());
+        boolean fatal = false;
+        for (GameRules.Issue i : iss) fatal |= i.fatal;
+        // prioridade: o que fecha o jogo > projetil que nao nasceu > avisos do jogo
+        String spawn = sim == null ? "" : sim.spawnProblem();
+        boolean showSpawn = !fatal && spawn.length() > 0;
+        final String msg = showSpawn ? spawn : GameRules.summary(iss);
+        if (msg.isEmpty() || msg.equals(rulesDismissed)) return;
+        StringBuilder all = new StringBuilder();
+        if (spawn.length() > 0) all.append(spawn);
+        String det = GameRules.details(iss);
+        if (det.length() > 0) all.append(all.length() > 0 ? "\n" : "").append(det);
+        QuickNotice n = new QuickNotice(msg).full(all.toString()).duration(showSpawn ? 9000 : 7000).left("OCULTAR", new Runnable() { public void run() { rulesDismissed = msg; } });
+        if (showSpawn && sim.spawnProblemByHeight()) n.right("POS", new Runnable() { public void run() { if (posRequest != null) posRequest.run(); } });
+        if (!fatal) n.colors(QuickNotice.AMBER, QuickNotice.AMBER_BTN);
+        showNotice(n);
+    }
