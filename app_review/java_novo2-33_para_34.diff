+    // zoom de camera (hit 30/31): a camera vai ate o alvo em "frames" ticks e, quando o hit acaba, volta ao normal em 12 ticks
+    private float zCurW = 100f, zCurX, zCurY, zTgtW = 100f, zTgtX, zTgtY, zDW, zDX, zDY;
+    private int zLeft;
+
+    private void zoomTick() {
+        float nx = screenLeft() / 65536f + 240f, ny = -80f + (camYFix >> 16);
+        float tw = 100f, tx = nx, ty = ny;
+        int n = 12;
+        AttackSim.Obj r = atk.root();
+        boolean action = false;
+        // CheckOptFlag grava iActionZoom* a cada tick, em qualquer objeto (projetil fora da pausa, atacante, oponente: nessa ordem de task);
+        // o ultimo hit 30/31 vale. So com FRAMES > 0 o md do zoom usa a acao; com W = 100 ela nao muda nada (o alvo atual segue)
+        float[] last = null;                                     // {w, frames, x, y} em px do mundo
+        for (int i = 0; i <= projs.size() + 1; i++) {
+            AttackSim.Obj o;
+            if (i < projs.size()) { Proj pr = projs.get(i); o = pr.dead || pr.hs > 0 || stunAny() ? null : pr.sim.root(); }
+            else o = i == projs.size() ? r : opp.root();
+            if (o == null) continue;
+            for (int k = 0; k < o.hits.length; k++) {
+                Ano.Hit h = o.hits[k];
+                if (h.flag != 30 && h.flag != 31) continue;
+                int cx = (o.objFlags & 16) != 0 ? -h.x : h.x;
+                last = new float[]{h.width, h.height, (o.x + (cx << 16)) / 65536f, (o.y + (h.y << 16)) / 65536f};
+            }
+        }
+        if (last != null && last[1] > 0) {
+            action = true;
+            if (last[0] == 100f) { tw = zTgtW; tx = zTgtX; ty = zTgtY; }
+            else { tw = last[0]; tx = last[2]; ty = last[3]; n = (int) last[1]; }
+        }
+        if (!action && tw == 100f && r != null) {
+            // md 29 do jogo sem zoom de acao: lutadores a mais de 320 px na horizontal ou 200 px na vertical => zoom out 90% em 16 ticks
+            int adx = Math.abs(r.x - oppX) >> 16, ady = Math.abs(r.y - oppY) >> 16;
+            if (adx > 320 || ady > 200) { tw = 90f; n = 16; }
+        }
+        if (tw != zTgtW || tx != zTgtX || ty != zTgtY) {
+            zTgtW = tw; zTgtX = tx; zTgtY = ty;
+            zLeft = n;
+            zDW = (tw - zCurW) / n; zDX = (tx - zCurX) / n; zDY = (ty - zCurY) / n;
+        }
+        if (zLeft > 0) {
+            zLeft--;
+            if (zLeft == 0) { zCurW = zTgtW; zCurX = zTgtX; zCurY = zTgtY; }
+            else { zCurW += zDW; zCurX += zDX; zCurY += zDY; }
+        }
+        if (zTgtW == 100f && zLeft == 0) { zCurX = nx; zCurY = ny; }
+    }
