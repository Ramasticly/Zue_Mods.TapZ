--- a/test/UndoEditsTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/UndoEditsTest.java	2026-10-29 14:54:43.551947309 +0000
@@ -0,0 +1,69 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Fabricas de edicao do desfazer: ida e volta com DAC, golpe e tabela de reacao reais. */
+public class UndoEditsTest {
+    static int firstTime(Dac d, int idx) { return d.getAno(idx).mpts[0].time; }
+
+    public static void main(String[] args) throws Exception {
+        A[] a = SpawnDiagTest.anos();
+        a[40] = new A().mpt(new M().time(4)).mpt(new M().time(5));
+        a[41] = new A().mpt(new M().time(7));
+        Dac d = dac(a);
+
+        // swapAno
+        Ano old = d.getAno(40);
+        Ano na = new Ano(40, true, 0, 0, new Ano.Link[0], new Ano.Mpt[] {old.mpts[0].copy()});
+        na.mpts[0].time = 9;
+        d.setAno(40, na);
+        UndoHistory.Edit e = UndoEdits.swapAno(d, 40, old);
+        UndoHistory.Edit back = e.revert();
+        check("swapAno: desfaz", d.getAno(40) == old, true);
+        back.revert();
+        check("swapAno: refaz (a ANO nova volta)", d.getAno(40) == na, true);
+
+        // swapAnos (varias ANOs de uma vez)
+        Ano o40 = d.getAno(40), o41 = d.getAno(41);
+        List<Ano> olds = new ArrayList<Ano>();
+        olds.add(o40); olds.add(o41);
+        Ano n40 = new Ano(40, true, 0, 0, new Ano.Link[0], o40.mpts), n41 = new Ano(41, true, 0, 0, new Ano.Link[0], o41.mpts);
+        d.setAno(40, n40); d.setAno(41, n41);
+        UndoHistory.Edit b2 = UndoEdits.swapAnos(d, olds).revert();
+        check("swapAnos: desfaz as duas", d.getAno(40) == o40 && d.getAno(41) == o41, true);
+        b2.revert();
+        check("swapAnos: refaz as duas", d.getAno(40) == n40 && d.getAno(41) == n41, true);
+
+        // swapMpts (troca no proprio array)
+        Ano an = new Ano(42, true, 0, 0, new Ano.Link[0], new Ano.Mpt[] {old.mpts[0].copy(), old.mpts[0].copy()});
+        Ano.Mpt p0 = an.mpts[0], p1 = an.mpts[1];
+        Ano.Mpt q0 = p0.copy(), q1 = p1.copy();
+        q0.time = 11; q1.time = 12;
+        an.mpts[0] = q0; an.mpts[1] = q1;
+        UndoHistory.Edit b3 = UndoEdits.swapMpts(an, new int[] {0, 1}, new Ano.Mpt[] {p0, p1}).revert();
+        check("swapMpts: desfaz", an.mpts[0] == p0 && an.mpts[1] == p1, true);
+        b3.revert();
+        check("swapMpts: refaz", an.mpts[0] == q0 && an.mpts[1] == q1, true);
+
+        // swapMove / swapPull / swapReaction com dados reais
+        CharData ch = chr(move(new int[] {2, 40}), new byte[][] {});
+        CharData.Move mv = ch.moves[0];
+        CharData.Move before = mv.copy();
+        int origPull = ch.pullDistance();
+        ch.setPullDistance(origPull + 5);
+        UndoHistory.Edit pb = UndoEdits.swapPull(ch, origPull).revert();
+        check("swapPull: desfaz", ch.pullDistance(), origPull);
+        pb.revert();
+        check("swapPull: refaz", ch.pullDistance(), origPull + 5);
+        final int[] syncs = {0};
+        mv.clamp();
+        UndoHistory.Edit mb = UndoEdits.swapMove(mv, before, new Runnable() { public void run() { syncs[0]++; } }).revert();
+        check("swapMove: desfaz roda o sync", syncs[0], 1);
+        mb.revert();
+        check("swapMove: refaz roda o sync de novo", syncs[0], 2);
+        System.out.println("UndoEditsTest fails=" + fails);
+    }
+}
diff -ruN a/test/UndoHistoryTest.java b/test/UndoHistoryTest.java
--- a/test/UndoHistoryTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/UndoHistoryTest.java	2026-10-29 14:54:18.896317936 +0000
@@ -0,0 +1,146 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Desfazer/refazer por hierarquias: a sessao (menu) e a pilha externa (menus aplicados). */
+public class UndoHistoryTest {
+    /** Estado de teste: x e hurtbox. */
+    static final class St { int x = 30; int hurt = 0; }
+
+    static UndoHistory.Edit swapX(final St s, final int old) {
+        return new UndoHistory.Edit() { @Override public UndoHistory.Edit revert() { int cur = s.x; s.x = old; return swapX(s, cur); } };
+    }
+    static UndoHistory.Edit swapHurt(final St s, final int old) {
+        return new UndoHistory.Edit() { @Override public UndoHistory.Edit revert() { int cur = s.hurt; s.hurt = old; return swapHurt(s, cur); } };
+    }
+    static void setX(UndoHistory h, St s, String key, long t, int v) { UndoHistory.Edit e = swapX(s, s.x); s.x = v; h.push(key, t, e); }
+    static void setHurt(UndoHistory h, St s, int v) { UndoHistory.Edit e = swapHurt(s, s.hurt); s.hurt = v; h.push(null, 0, e); }
+    static String st(St s) { return s.x + "/" + s.hurt; }
+
+    public static void main(String[] args) throws Exception {
+        // ---- fora de sessao: cada acao e uma entrada; refazer apagado por acao nova
+        {
+            UndoHistory h = new UndoHistory();
+            St s = new St();
+            setX(h, s, null, 0, 40); setX(h, s, null, 0, 50); setX(h, s, null, 0, 60);
+            check("externo: 3 entradas", h.count(), 3);
+            h.undo(); h.undo();
+            check("externo: desfez 2", st(s) + ":" + h.canRedo(), "40/0:true");
+            h.redo();
+            check("externo: refez 1", st(s), "50/0");
+            setX(h, s, null, 0, 99);
+            check("externo: acao nova apaga o refazer", h.canRedo() + ":" + h.redo(), "false:false");
+            check("externo: nada para desfazer vazio", new UndoHistory().undo(), false);
+        }
+
+        // ---- sessao: x 30 -> 40, aplicar hurtbox a todas; passo a passo ate o original e refaz tudo
+        {
+            UndoHistory h = new UndoHistory();
+            St s = new St();
+            h.begin();
+            setX(h, s, "x", 1000, 40);
+            setHurt(h, s, 7);
+            check("sessao: 2 passos", h.count() + ":" + st(s), "2:40/7");
+            h.undo();
+            check("sessao: desfaz so a hurtbox (campo/botao)", st(s), "40/0");
+            h.undo();
+            check("sessao: desfaz o x ate o original", st(s) + ":" + h.canUndo(), "30/0:false");
+            check("sessao: nada mais para desfazer", h.undo(), false);
+            h.redo(); h.redo();
+            check("sessao: refaz tudo", st(s) + ":" + h.canRedo(), "40/7:false");
+            // desfaz um e muda outra coisa: o refazer some
+            h.undo();
