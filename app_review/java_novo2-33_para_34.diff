+    /** Troca de ANO que realmente aconteceu na simulacao (kind: 0 SEQ, 1 END, 2 HIT, 3 POUSO, 4 QUEDA, -1 outra). */
+    public static final class Trans {
+        public int tick, fromAno, fromPat, toAno, kind;
+    }
+    private final List<Trans> trans = new ArrayList<Trans>();
+    private int transKind = -1;
+    private List<Trans> realTrans = new ArrayList<Trans>();
+    /** Trocas reais da execucao completa (calculadas em measureLength). */
+    public List<Trans> transitions() { return realTrans; }
+
+    /** Um hit confirmado que levaria a ANIM_SEQ / ANIM_END (para os marcadores de sequencia da timeline). */
+    public static final class HitEvent {
+        public int tick, ano, pat, kind, target, target2;
+        public boolean air, blocked, projectile;
+    }
+
+    private final List<HitEvent> hitEvents = new ArrayList<HitEvent>();
+    /** Modo de sondagem: nenhuma troca de ANO acontece, entao cada frame com hit que conecta e registrado. */
+    private boolean probe;
+    private boolean landRec, fallRec;
+    private boolean landedEarly;
+    private int landTick = -1, measuredLandTick = -1;
+    /** Tick (indice de frame da preview) do primeiro pouso, ou -1. */
+    public int landTick() { return landTick; }
+    /** Resultado da medicao completa do golpe: tick do primeiro pouso, ou -1. */
+    public int measuredLandTick() { return measuredLandTick; }
+    /** Modo de tempo ATAQUE: a reproducao para no pouso (a barra de tempo continua livre). */
+    public static boolean attackStop = false;
+    /** O personagem pousou antes da animacao do golpe terminar (o resto do golpe/transicoes nao acontece nessa altura). */
+    public boolean landedEarly() { return landedEarly; }
+    private boolean measuredLandedEarly;
+    /** Resultado da medicao completa do golpe (measureLength): houve pouso antes do fim da animacao? */
+    public boolean measuredLandedEarly() { return measuredLandedEarly; }
+    public List<HitEvent> hitEvents() { return hitEvents; }
+
+    /**
+     * Roda uma copia a partir da ANO {@code ano} sem trocas de ANO e devolve todos os hits que conectam
+     * e disparariam sequencia/fim (um por frame). Vazio para ANOs avulsas (sem golpe).
+     */
+    public List<HitEvent> probeHits(int ano) {
+        List<HitEvent> out = new ArrayList<HitEvent>();
+        if (move.generic) return out;
+        CharData.Move m2 = move.copy();
+        m2.animInicial = ano;
+        BattleSim s = new BattleSim(atkDac, atkChar, m2, atkLeft, defDac, fxDac, gd, distancePx, heightPx, atkWavCount);
+        s.oppChar = oppChar;
+        s.specialType = specialType;
+        s.bobjDac = bobjDac;
+        if (charfDac != null) s.setCharfDac(charfDac); else s.reset();
+        s.probe = true;
+        for (int t = 0; t < 1800; t++) {
+            AttackSim.Obj r = s.atk.root();
+            if (r == null) break;
+            s.step();
+            r = s.atk.root();
+            if (r == null || r.isDone() || s.atk.hasWrapped()) break;
+        }
+        return s.hitEvents;
+    }
