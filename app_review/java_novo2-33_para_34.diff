+    // ---- chao do atacante, pouso e queda (md 883 / 886 / 887 do jogo)
+
+    /**
+     * O chao e a linha dos pes (y = 0; 15728640 no jogo).
+     * - Pousar (y > chao com velocidade Y > 0 e sem hitstop): SE 12, POUSO_AO_ACERTAR se houve hit confirmado
+     *   (work[10]) senao POUSO_AO_ERRAR; se for 0 toca a ANO 13 (pouso padrao) e o ataque acaba.
+     * - Animacao terminou no ar e o personagem nao voa: toca a ANO 89 (queda) e pousa na ANO 13.
+     */
+    /** A ANO tem hitbox de ataque (flag 2) ou disparo de projetil (flag 0) em algum frame? */
+    private static boolean hasAttack(Ano a) {
+        for (Ano.Mpt m : a.mpts) {
+            if (m.hits == null) continue;
+            for (Ano.Hit h : m.hits) if (h.flag == 0 || h.flag == 2) return true;
+        }
+        return false;
+    }
+
+    /** A ANO muda a velocidade ou a aceleracao vertical (yspeed / yaccel diferentes de 0)? Ai o pouso pode vir antes do fim. */
+    private static boolean hasYMove(Ano a) {
+        for (Ano.Mpt m : a.mpts) {
+            if ((m.moveMask & 2) != 0 && m.speedY != 0) return true;
+            if ((m.moveMask & 8) != 0 && m.accelY != 0) return true;
+        }
+        return false;
+    }
+
+    /** ANO de projetil aberto sozinho no editor (md 970/971): a raiz e o projetil, nao o personagem. */
+    private boolean projRoot() { return move != null && move.generic && move.rootKind == CharData.Move.ROOT_PROJ; }
