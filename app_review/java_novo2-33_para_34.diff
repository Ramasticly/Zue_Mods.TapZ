+        m.getMenu().add(0, 2, 2, "Voz neste passo");
+        m.getMenu().add(0, 3, 3, "Efeito de parede neste passo");
+        m.getMenu().add(0, 4, 4, "Próxima reação (SEQ) neste passo");
