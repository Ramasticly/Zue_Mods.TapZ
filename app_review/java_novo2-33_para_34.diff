+
+        System.out.println("SpawnDiagTest fails=" + BattleTest.fails);
+    }
+}
diff -ruN a/test/SpeedLineTest.java b/test/SpeedLineTest.java
--- a/test/SpeedLineTest.java	1970-01-01 00:00:00.000000000 +0000
+++ b/test/SpeedLineTest.java	2026-10-30 00:13:34.109278899 +0000
@@ -0,0 +1,163 @@
+package com.zue.attackeditor;
+
+import static com.zue.attackeditor.BattleTest.*;
+
+import java.util.List;
+
+/** SPEEDLINE: pontos da trajetoria, posicao por tick (confere com o AttackSim), arrastar so muda speed, remover/zerar e presets. */
+public class SpeedLineTest {
+    static final int P = 65536;
+
+    static Ano.Mpt f(int time) { Ano.Mpt m = new Ano.Mpt(); m.flags = 0x20; m.hasTime = true; m.time = time; return m; }
+    static Ano.Mpt keep(Ano.Mpt m) { m.flags |= 2; m.wActFlag |= 64; return m; }
+    static Ano.Mpt mv(Ano.Mpt m, double sx, double sy, double ax, double ay) {
+        if (sx != 0) m = FrameTools.setSpeed(m, 0, sx, true);
+        if (sy != 0) m = FrameTools.setSpeed(m, 1, sy, true);
+        if (ax != 0) m = FrameTools.setAccel(m, 0, ax);
+        if (ay != 0) m = FrameTools.setAccel(m, 1, ay);
+        return m;
+    }
+
+    static String pts(SpeedLine.Chain c) {
+        StringBuilder b = new StringBuilder();
+        for (SpeedLine.Pt p : c.pts) b.append(p.kind).append('@').append(p.frame).append(':').append(p.tick).append('(').append(FrameTools.px(p.x)).append(',').append(FrameTools.px(p.y)).append(") ");
+        return b.toString().trim();
+    }
+
+    public static void main(String[] args) throws Exception {
+        // um frame so: 2 pontos
+        Ano.Mpt[] one = {mv(f(4), 5, 0, 0, 0), f(3)};
+        List<SpeedLine.Chain> ch = SpeedLine.chains(one);
+        check("1 frame de movimento = 1 cadeia com 2 pontos", ch.size() + ":" + ch.get(0).pts.size() + ":" + pts(ch.get(0)), "1:2:0@0:0(0,0) 3@1:0(20,0)");
+
+        // frame com subida e queda (accel y): 3 pontos
+        Ano.Mpt[] arc = {mv(f(6), 2, -3, 0, 1), f(2)};
+        SpeedLine.Chain ca = SpeedLine.chains(arc).get(0);
+        int apex = 0;
+        for (SpeedLine.Pt p : ca.pts) if (p.kind == SpeedLine.APEX) apex++;
+        check("altura que muda de sentido ganha 1 ponto (3 no total)", apex + ":" + ca.pts.size(), "1:3");
+        check("o ponto final do arco", FrameTools.px(ca.vertex(1).x) + "," + FrameTools.px(ca.vertex(1).y), "12,-3");
+
+        // mantem velocidade: a linha continua conectando os frames
+        Ano.Mpt[] run = {mv(f(2), 10, 0, 0, 0), keep(f(2)), keep(f(3)), f(2)};
+        SpeedLine.Chain cr = SpeedLine.chains(run).get(0);
+        check("3 frames mantendo velocidade: 4 pontos conectados", cr.head + "-" + cr.last + ":" + cr.pts.size() + ":" + pts(cr), "0-2:4:0@0:0(0,0) 1@1:0(20,0) 1@2:0(40,0) 3@3:0(70,0)");
+        check("posicao dentro de um frame", FrameTools.px(cr.posAt(run, 2, 1)[0]) + ":" + FrameTools.px(cr.posAt(run, 2, 3)[0]), "50:70");
+        double[][] vs = SpeedLine.velocities(run, cr);
+        check("velocidade por tick", vs[0].length + ":" + FrameTools.px(vs[0][0]) + ":" + FrameTools.px(vs[0][6]), "7:10:10");
+
+        // dois trechos colados formam uma linha so; separados por frame parado, duas
+        Ano.Mpt[] two = {mv(f(2), 4, 0, 0, 0), mv(f(2), 8, 0, 0, 0), f(2), mv(f(2), 1, 0, 0, 0)};
+        check("trechos colados = 1 cadeia; depois do frame parado, outra", SpeedLine.chains(two).size() + ":" + SpeedLine.chains(two).get(0).last + ":" + SpeedLine.chains(two).get(1).head, "2:1:3");
+
+        // confere com o AttackSim (a conta do jogo): posicao no inicio de cada frame
+        {
+            A[] a = new A[45];
+            for (int i = 0; i < 45; i++) a[i] = new A().mpt(new M().time(1));
+            Dac d = dac(a);
+            d.setAno(40, new Ano(40, true, 0, 0, new Ano.Link[0], new Ano.Mpt[] {mv(f(4), 3, -2, 0.5, 0.25), keep(f(3)), mv(keep(f(5)), 0, 0, -1, 0), f(2)}));
+            Ano ano = d.getAno(40);
+            SpeedLine.Chain c = SpeedLine.chains(ano.mpts).get(0);
+            AttackSim sim = new AttackSim(d, 40, false);
+            int x0 = sim.root().x, y0 = sim.root().y;
+            StringBuilder exp = new StringBuilder(), got = new StringBuilder();
+            int tick = 0;
+            for (int fr = 0; fr <= 4; fr++) {
+                int pat = Math.min(fr, 3);
+                while (fr < 4 && sim.root().pat != pat && tick < 40) { sim.step(); tick++; }
+                if (fr == 4) while (sim.root().pat == 3 && sim.root().time > 0 && tick < 60) { sim.step(); tick++; }
+                SpeedLine.Pt v = c.vertex(fr);
+                if (v == null) break;
+                exp.append(FrameTools.px(v.x)).append(',').append(FrameTools.px(v.y)).append(' ');
