@@ -0,0 +1,921 @@
+package com.zue.attackeditor;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.Window;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+/**
+ * Editor de reacao no layout da tela principal: cabecalho, previa quadrada de largura cheia, abaixo (numa area que rola) a barra de tempo,
+ * os botoes DIVIDIR / DUPLICAR / EXCLUIR / DESFAZER e a timeline (clipes + faixas sob demanda, abas ＋ e #), o transporte fixo na base e a gaveta
+ * flutuante (grade de paginas, como a da sprite). A edicao e na propria timeline; a gaveta abre ao tocar num passo ou num item de faixa.
+ * Os dados vem de {@link ReactionTrace} (a simulacao real). Cenario CHAO | AR escolhe qual duracao/velocidade a timeline simula e mostra.
+ * Reacoes do personagem sao editaveis (desfazer pelo editor principal); as do jogo, so leitura.
+ */
+final class ReactionScreen {
+    private static final String[] PAGES = {"ANIMAÇÃO", "TEMPO", "SPEED", "VOZ", "EFEITOS", "SEQ", "TOTAL"};
+    private static final int P_GRID = -1, P_ANIM = 0, P_TIME = 1, P_SPEED = 2, P_VOICE = 3, P_EFFECTS = 4, P_SEQ = 5, P_TOTAL = 6;
+    private static final int C_BLUE = 0xFF4C8DFF, C_AMBER = 0xFFFFB454;
+    private static final String[] SPEED_NAMES = {"1x", "0.5x", "0.25x", "2x"};
+    private static final float[] SPEEDS = {1f, 0.5f, 0.25f, 2f};
+
+    private final Context c;
+    private final AttackView view;
+    private final Runnable onChanged;
+    private final boolean editable;
+    private final int type;                 // 0..29 jogo ou 0..19 personagem
+    private final int optValue;             // valor de OPT 1 que representa esta reacao (0..29 / 30..49)
+    private final float d;
+
+    private Dialog dlg;
+    private ReactionPreview preview;
+    private ReactionTimelineView tl;
+    private ReactionSheet sheet;
+    private LinearLayout pageBox, transport;
+    private android.widget.FrameLayout frame;
+    private LayoutManager.SquareHolder holder;
+    private android.widget.SeekBar seek;
+    private boolean seekFromCode;
+    private TextView tickLabel, playBtn, speedBtn, btnGround, btnAir, title;
+    private int speedIndex;
+    private boolean drawerOpen;
+    private int selLane = ReactionTimelineView.LANE_PASSOS;
+    private ReactionTrace trace;
+    private boolean air;
+    private int sel, page = P_GRID;
+
+    ReactionScreen(Context c, AttackView view, int optIndex, Runnable onChanged) {
+        this.c = c;
+        this.view = view;
+        this.onChanged = onChanged;
+        this.editable = optIndex >= 30;
+        this.type = optIndex >= 30 ? optIndex - 30 : optIndex;
+        this.optValue = optIndex;
+        this.d = c.getResources().getDisplayMetrics().density;
+    }
+
+    private int dp(int v) { return Math.round(v * d); }
+
+    private ReactionTable table() { return editable ? view.charReaction(type) : view.gameReaction(type); }
+
+    // ---- tela ----
+
+    void show() {
+        if (table() == null) return;
+        dlg = new Dialog(c, android.R.style.Theme_DeviceDefault_NoActionBar) {
+            @Override public void onBackPressed() { if (drawerOpen) sheetBack(); else super.onBackPressed(); }
+        };
+        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        dlg.getWindow().setSoftInputMode(android.view.WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+        frame = new android.widget.FrameLayout(c);
+        LinearLayout root = new LinearLayout(c);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(LayoutManager.BG);
+        root.setPadding(dp(10), dp(26), dp(10), dp(10));
+        frame.addView(root, new android.widget.FrameLayout.LayoutParams(-1, -1));
+
+        // cabecalho (no lugar do menu superior)
+        LinearLayout head = new LinearLayout(c);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        title = new I18nTextView(c);
+        title.setText(editable ? "Reação do personagem " + type : "Reação do jogo " + type + "  ·  só leitura");
+        title.setTextColor(LayoutManager.TEXT);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        head.addView(title, new LinearLayout.LayoutParams(0, -2, 1f));
+        btnGround = btn("CHÃO", true, new View.OnClickListener() { public void onClick(View v) { setAir(false); } });
+        btnAir = btn("AR", false, new View.OnClickListener() { public void onClick(View v) { setAir(true); } });
+        head.addView(btnGround);
+        head.addView(btnAir);
+        head.addView(btn("FECHAR", true, new View.OnClickListener() { public void onClick(View v) { close(); } }));
+        root.addView(head, mlp(-1, -2, 0, 0, 0, 4));
+
+        // previa quadrada de largura cheia
+        preview = new ReactionPreview(c, view);
+        preview.setControlled(true);
+        preview.setValue(optValue);
+        preview.setOnTick(new Runnable() { public void run() { onPlayTick(); } });
+        preview.setBackground(round(0xFF0D0F13, 10));
+        holder = new LayoutManager.SquareHolder(c);
+        holder.addView(preview, new android.widget.FrameLayout.LayoutParams(-1, -1));
+        root.addView(holder, new LinearLayout.LayoutParams(-1, -2));
+
+        // tudo abaixo da previa desliza
+        final ScrollView scroll = new ScrollView(c);
+        scroll.setFillViewport(false);
+        scroll.setVerticalScrollBarEnabled(false);
+        LinearLayout sc = new LinearLayout(c);
+        sc.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(sc, new ViewGroup.LayoutParams(-1, -2));
+        root.addView(scroll, new LinearLayout.LayoutParams(-1, 0, 1f));
+
+        // barra de tempo + rotulo
+        LinearLayout trow = new LinearLayout(c);
+        trow.setGravity(Gravity.CENTER_VERTICAL);
+        seek = new android.widget.SeekBar(c);
+        seek.setOnSeekBarChangeListener(new android.widget.SeekBar.OnSeekBarChangeListener() {
+            @Override public void onProgressChanged(android.widget.SeekBar s2, int progress, boolean fromUser) { if (fromUser && !seekFromCode) goTo(progress); }
+            @Override public void onStartTrackingTouch(android.widget.SeekBar s2) { preview.pause(); stopPlayUi(); }
+            @Override public void onStopTrackingTouch(android.widget.SeekBar s2) { }
+        });
+        trow.addView(seek, new LinearLayout.LayoutParams(0, -2, 1f));
+        tickLabel = new I18nTextView(c);
+        tickLabel.setTextColor(LayoutManager.TEXT);
+        tickLabel.setTypeface(Typeface.MONOSPACE);
+        tickLabel.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        trow.addView(tickLabel, mlp(-2, -2, 8, 0, 0, 0));
+        sc.addView(trow, mlp(-1, -2, 0, 4, 0, 4));
+
+        // DIVIDIR / DUPLICAR / EXCLUIR / DESFAZER (4 botoes iguais, como o da timeline do ANO)
+        if (editable) {
+            LinearLayout bar = new LinearLayout(c);
+            String[] names = {"\u2702 DIVIDIR", "DUPLICAR", "\u2715 EXCLUIR", "\u21B6 DESFAZER"};
+            final Runnable[] acts = {new Runnable() { public void run() { splitAtPointer(); } }, new Runnable() { public void run() { dupRow(); } },
+                    new Runnable() { public void run() { deleteSelected(); } }, new Runnable() { public void run() { undo(); } }};
+            for (int q = 0; q < names.length; q++) {
+                final Runnable act = acts[q];
+                TextView b2 = mbtn(names[q], false);
+                b2.setTextSize(TypedValue.COMPLEX_UNIT_SP, 10.5f);
+                b2.setPadding(dp(2), dp(7), dp(2), dp(7));
+                b2.setOnClickListener(new View.OnClickListener() { public void onClick(View v) { act.run(); } });
+                bar.addView(b2, lpw(1f, q == 0 ? 0 : 3, 0, q == names.length - 1 ? 0 : 3, 0));
+            }
+            sc.addView(bar, mlp(-1, -2, 0, 0, 0, 4));
+        }
+
+        // timeline + abas ＋ e # coladas a direita
+        tl = new ReactionTimelineView(c);
+        tl.setOpponent(view.opponentDac(), view.opponentSprites());
+        tl.setListener(new ReactionTimelineView.Listener() {
+            @Override public void onSelectRow(int row) { selLane = ReactionTimelineView.LANE_PASSOS; tl.setSelectedLane(selLane); sel = row; tl.setSelected(row); openDrawer(P_GRID); }
+            @Override public void onScrub(int tick) { preview.seek(tick); followRow(tick); updateLabel(); stopPlayUi(); }
+            @Override public void onResize(int row, int ticks) {
+                int[] r = ReactionEdit.resize(table(), row, air, ticks);
+                if (r == null) return;
+                selectRow(row);
+                setCell(r[0], r[1]);
+            }
+            @Override public void onOpenLane(int lane, int row) {
+                ReactionTable t = table();
+                if (lane == ReactionTimelineView.LANE_SPEED && t != null) {
+                    int run = ReactionRuns.runOf(t, air, row);
+                    if (run >= 0) row = ReactionRuns.runs(t, air).get(run)[0];
+                }
+                selLane = lane;
+                tl.setSelectedLane(lane);
