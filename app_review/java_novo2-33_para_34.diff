+    private void updateCamY() {
+        AttackSim.Obj ra = atk.root();
+        if (ra == null) return;
+        if (edgeMode == 0) { camYFix = 0; camYOff = 0; return; }
+        int a = Math.min(240, ra.y >> 16), b = Math.min(240, oppY >> 16);
+        camYOff = camTgt != -1 ? (camTgt == 0 ? ra.y : oppY) >> 16 : (a + b) / 2;      // iBackYOffset segue o alvo da camera de deslocamento
+        int y = camYOff < -40 ? camYOff * 2 / 3 + 13 : 0;
+        if (camShake != 0) y += SHAKE_POS[camShakeType * 7 + camShake / 2];
+        if (y > 0) y = 0;
+        camYFix = y << 16;
+    }
