+        check("remover o primeiro ponto ou cadeia de 1 frame pede confirmacao", SpeedLine.removesAll(cp, 0) + ":" + SpeedLine.removesAll(SpeedLine.chains(one).get(0), 1), "true:true");
+        Ano.Mpt[] ra = SpeedLine.removePoint(rp, cp, 0);
+        check("remover o primeiro: sem speed nenhuma", SpeedLine.chains(ra).size(), 0);
+        Ano.Mpt[] re = SpeedLine.removePoint(dr, cd, cd.frames());
+        check("remover o ponto final encurta a cadeia em 1 frame", SpeedLine.chains(re).get(0).last, 1);
+
+        // zerar speed: de verdade (sem manter e sem speed)
+        Ano.Mpt[] zs = SpeedLine.zeroSpeed(dr, cd, 1);
+        check("zerar: speed propria 0, sem manter", FrameTools.keeps(zs, 1) + ":" + zs[1].speedX + ":" + zs[1].speedY + ":" + FrameOps.isMoveHead(zs[1]), "false:0:0:true");
+        check("zerar: os que mantem herdam 0", FrameTools.px(FrameTools.startSpeed(zs, 2)[0]), "0");
+
+        // presets mantem o deslocamento total e a escala diminui o movimento
+        Ano.Mpt[] pr = {mv(f(4), 8, -2, 0, 0), keep(f(4)), keep(f(4)), f(1)};
+        SpeedLine.Chain cpr = SpeedLine.chains(pr).get(0);
+        double totX = cpr.vertex(3).x, totY = cpr.vertex(3).y;
+        for (int pset = 0; pset < AccelPresets.NAMES.length; pset++) {
